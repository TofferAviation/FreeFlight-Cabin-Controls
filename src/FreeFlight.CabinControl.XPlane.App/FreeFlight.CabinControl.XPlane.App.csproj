<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FreeFlight.CabinControl.XPlane.App</RootNamespace>
    <AssemblyName>Ember.XPlane</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Version>0.5.67</Version>
    <Company>FreeFlightLTD</Company>
    <Description>Ember X-Plane operations for Linux and macOS.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup Condition="Exists('../../xplane-plugin/dist/FreeFlightCabinBridge/64/lin.xpl')">
    <Content Include="../../xplane-plugin/dist/FreeFlightCabinBridge/64/lin.xpl">
      <Link>xplane-plugin/FreeFlightCabinBridge/64/lin.xpl</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup Condition="Exists('../../xplane-plugin/dist/FreeFlightCabinBridge/64/mac.xpl')">
    <Content Include="../../xplane-plugin/dist/FreeFlightCabinBridge/64/mac.xpl">
      <Link>xplane-plugin/FreeFlightCabinBridge/64/mac.xpl</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../FreeFlight.CabinControl.Core/FreeFlight.CabinControl.Core.csproj" />
    <!-- The X-Plane bridge is platform-neutral. Link the existing implementation
         so Windows and the new desktop host exercise the same telemetry and
         cabin-control behaviour without touching the WPF application. -->
    <Compile Include="../FreeFlight.CabinControl.App/Services/FileLogService.cs"
             Link="Services/FileLogService.cs" />
    <Compile Include="../FreeFlight.CabinControl.App/Services/XPlaneWebApiBridgeService.cs"
             Link="Services/XPlaneWebApiBridgeService.cs" />
    <AvaloniaResource Include="../FreeFlight.CabinControl.App/Assets/FreeFlightAppIcon.png"
                      Link="Assets/FreeFlightAppIcon.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../../CHANGELOG.md">
      <Link>CHANGELOG.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="../../LICENSE.txt">
      <Link>LICENSE.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
