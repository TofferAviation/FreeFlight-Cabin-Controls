<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>FreeFlight.CabinControl.MsfsRelay</RootNamespace>
    <AssemblyName>Ember.MsfsRelay</AssemblyName>
    <Version>0.5.76</Version>
    <Company>FreeFlightLTD</Company>
    <Description>Private Ember relay for Microsoft Flight Simulator telemetry.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../FreeFlight.CabinControl.Core/FreeFlight.CabinControl.Core.csproj" />
    <Compile Include="../FreeFlight.CabinControl.App/Services/FileLogService.cs"
             Link="Services/FileLogService.cs" />
    <Compile Include="../FreeFlight.CabinControl.App/Services/Msfs2024SimConnectBridgeService.cs"
             Link="Services/Msfs2024SimConnectBridgeService.cs" />
    <Content Include="../FreeFlight.CabinControl.App/Native/SimConnect.dll">
      <Link>SimConnect.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
