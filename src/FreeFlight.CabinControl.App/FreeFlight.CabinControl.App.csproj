<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>FreeFlight.CabinControl.App</RootNamespace>
    <AssemblyName>FreeFlight.CabinControl</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('Assets/FreeFlight.ico')">Assets/FreeFlight.ico</ApplicationIcon>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../FreeFlight.CabinControl.Core/FreeFlight.CabinControl.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\Ff777CabinLayout.png" />
    <Resource Include="Assets\FreeFlightBrand.png" />
    <Resource Include="Assets\AirlineLogos\*.png" />
  </ItemGroup>
  <ItemGroup Condition="Exists('..\..\content-packs\private\british-airways\media\safety-video.mp4')">
    <Content Include="..\..\content-packs\private\british-airways\media\safety-video.mp4">
      <Link>content-packs\british-airways\media\safety-video.mp4</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
