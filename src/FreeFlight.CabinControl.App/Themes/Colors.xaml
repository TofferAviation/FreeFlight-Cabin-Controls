<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Concept refresh: a quiet, light operational workspace framed by a
         deep-navy navigation rail. Individual live-operation states retain
         their own high-contrast colours. -->
    <Color x:Key="AppBackgroundColor">#F2F6FA</Color>
    <Color x:Key="SidebarColor">#062B4C</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceRaisedColor">#F8FAFD</Color>
    <Color x:Key="BorderColor">#D8E2EC</Color>
    <Color x:Key="BorderSoftColor">#E8EEF4</Color>
    <Color x:Key="PrimaryColor">#0B73B9</Color>
    <Color x:Key="PrimaryDeepColor">#07528E</Color>
    <Color x:Key="CyanColor">#117DBC</Color>
    <Color x:Key="SuccessColor">#13865B</Color>
    <Color x:Key="WarningColor">#B66A09</Color>
    <Color x:Key="DangerColor">#C42F52</Color>
    <Color x:Key="TextPrimaryColor">#102A43</Color>
    <Color x:Key="TextSecondaryColor">#52677D</Color>
    <Color x:Key="TextMutedColor">#7A8DA1</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderSoftBrush" Color="{StaticResource BorderSoftColor}" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryDeepBrush" Color="{StaticResource PrimaryDeepColor}" />
    <SolidColorBrush x:Key="CyanBrush" Color="{StaticResource CyanColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="InfoSurfaceBrush" Color="#EAF5FF" />
    <SolidColorBrush x:Key="InfoBorderBrush" Color="#B8DDF5" />
    <SolidColorBrush x:Key="SuccessSurfaceBrush" Color="#EAF8F1" />
    <SolidColorBrush x:Key="SuccessBorderBrush" Color="#62BE93" />
    <SolidColorBrush x:Key="SuccessTextBrush" Color="#0C704C" />

    <!-- Shared product surfaces. The sidebar remains deep navy in both
         appearances so Ember keeps a recognisable operational spine. -->
    <LinearGradientBrush x:Key="SidebarGradientBrush" StartPoint="0,0" EndPoint="0.85,1">
        <GradientStop Color="#041E38" Offset="0" />
        <GradientStop Color="#062B4C" Offset="0.48" />
        <GradientStop Color="#0A426C" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PremiumHeroBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#082E50" Offset="0" />
        <GradientStop Color="#0A659E" Offset="0.62" />
        <GradientStop Color="#1D93C9" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1689CF" Offset="0" />
        <GradientStop Color="#07518C" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MetallicBrandTextBrush" StartPoint="0,0" EndPoint="1,0.35">
        <GradientStop Color="#0B73B9" Offset="0" />
        <GradientStop Color="#FFFFFF" Offset="0.33" />
        <GradientStop Color="#E7B34A" Offset="0.52" />
        <GradientStop Color="#FFFFFF" Offset="0.68" />
        <GradientStop Color="#0B73B9" Offset="1" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="AmbientGlowBrush" Center="0.72,0.78" GradientOrigin="0.72,0.78" RadiusX="0.65" RadiusY="0.65">
        <GradientStop Color="#142F73B9" Offset="0" />
        <GradientStop Color="#0BF2F6FA" Offset="0.42" />
        <GradientStop Color="#00F2F6FA" Offset="1" />
    </RadialGradientBrush>
</ResourceDictionary>
