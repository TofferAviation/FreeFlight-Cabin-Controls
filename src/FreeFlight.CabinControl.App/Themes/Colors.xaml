<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AppBackgroundColor">#020817</Color>
    <Color x:Key="SidebarColor">#030C1A</Color>
    <Color x:Key="SurfaceColor">#071426</Color>
    <Color x:Key="SurfaceRaisedColor">#0A192D</Color>
    <Color x:Key="BorderColor">#29394F</Color>
    <Color x:Key="BorderSoftColor">#17263A</Color>
    <Color x:Key="PrimaryColor">#1476FF</Color>
    <Color x:Key="PrimaryDeepColor">#084FC9</Color>
    <Color x:Key="CyanColor">#00C2E8</Color>
    <Color x:Key="SuccessColor">#5EEF8B</Color>
    <Color x:Key="WarningColor">#FF9B42</Color>
    <Color x:Key="DangerColor">#FF6475</Color>
    <Color x:Key="TextPrimaryColor">#F7F9FC</Color>
    <Color x:Key="TextSecondaryColor">#AFBBD0</Color>
    <Color x:Key="TextMutedColor">#77879F</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderSoftBrush" Color="{StaticResource BorderSoftColor}" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryDeepBrush" Color="{StaticResource PrimaryDeepColor}" />
    <SolidColorBrush x:Key="CyanBrush" Color="{StaticResource CyanColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1986FF" Offset="0" />
        <GradientStop Color="#0849C5" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MetallicBrandTextBrush" StartPoint="0,0" EndPoint="1,0.35">
        <GradientStop Color="#59B8FF" Offset="0" />
        <GradientStop Color="#F5F8FC" Offset="0.33" />
        <GradientStop Color="#F4B84D" Offset="0.52" />
        <GradientStop Color="#FFFFFF" Offset="0.68" />
        <GradientStop Color="#178CFF" Offset="1" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="AmbientGlowBrush" Center="0.72,0.78" GradientOrigin="0.72,0.78" RadiusX="0.65" RadiusY="0.65">
        <GradientStop Color="#16214D93" Offset="0" />
        <GradientStop Color="#00122040" Offset="0.42" />
        <GradientStop Color="#00020817" Offset="1" />
    </RadialGradientBrush>
</ResourceDictionary>
