<Window x:Class="FreeFlight.CabinControl.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:viewModels="clr-namespace:FreeFlight.CabinControl.App.ViewModels"
        xmlns:views="clr-namespace:FreeFlight.CabinControl.App.Views"
        mc:Ignorable="d"
        Title="FreeFlight Cabin Control"
        Width="1540"
        Height="900"
        MinWidth="1120"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource AppBackgroundBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="7"
                            CornerRadius="10"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModels:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:AudioViewModel}">
            <views:AudioView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:PerformanceViewModel}">
            <views:PerformanceView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.ColumnSpan="2" IsHitTestVisible="False">
                <Rectangle Fill="{StaticResource AmbientGlowBrush}" />
            </Grid>

            <Border Grid.Column="0"
                    Background="#D9030C1A"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="152" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="54" />
                    </Grid.RowDefinitions>

                    <Grid Margin="28,30,24,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Canvas Width="36" Height="44" VerticalAlignment="Top" Margin="0,3,0,0">
                            <Polygon Points="2,37 12,37 25,13 16,13" Fill="#1781FF" />
                            <Polygon Points="13,37 23,37 34,18 25,18" Fill="#1469DC" />
                            <Polygon Points="22,18 29,18 36,5 29,5" Fill="#268EFF" />
                        </Canvas>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="FreeFlight"
                                       FontFamily="Segoe UI Variable Display, Segoe UI"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       FontStyle="Italic"
                                       Foreground="White" />
                            <TextBlock Text="C A B I N   C O N T R O L"
                                       Margin="1,3,0,0"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" VerticalAlignment="Top" Margin="0,8,0,0">
                        <RadioButton Style="{StaticResource NavRadioStyle}"
                                     Content="Dashboard"
                                     Tag="&#xE80F;"
                                     GroupName="Navigation"
                                     IsChecked="True"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Dashboard" />
                        <RadioButton Style="{StaticResource NavRadioStyle}"
                                     Content="Audio"
                                     Tag="&#xE767;"
                                     GroupName="Navigation"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Audio" />
                        <RadioButton Style="{StaticResource NavRadioStyle}"
                                     Content="Performance"
                                     Tag="&#xE9D2;"
                                     GroupName="Navigation"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Performance" />
                        <RadioButton Style="{StaticResource NavRadioStyle}"
                                     Content="Settings"
                                     Tag="&#xE713;"
                                     GroupName="Navigation"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Settings" />
                    </StackPanel>

                    <TextBlock Grid.Row="2"
                               Text="v0.1.0-dev"
                               Margin="30,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="12" />
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="42" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,4,5,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource WindowButtonStyle}" Content="&#xE921;" Click="MinimizeButton_Click" ToolTip="Minimize" />
                    <Button Style="{StaticResource WindowButtonStyle}" Content="&#xE922;" Click="MaximizeButton_Click" ToolTip="Maximize or restore" />
                    <Button Style="{StaticResource CloseWindowButtonStyle}" Content="&#xE8BB;" Click="CloseButton_Click" ToolTip="Close" />
                </StackPanel>

                <ContentControl Grid.Row="1"
                                Content="{Binding CurrentPage}"
                                Margin="36,4,36,30" />
            </Grid>
        </Grid>
    </Border>
</Window>
