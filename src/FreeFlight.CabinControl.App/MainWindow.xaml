<Window x:Class="FreeFlight.CabinControl.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:viewModels="clr-namespace:FreeFlight.CabinControl.App.ViewModels"
        xmlns:views="clr-namespace:FreeFlight.CabinControl.App.Views"
        mc:Ignorable="d"
        Title="FreeFlight Cabin Control"
        Width="1540"
        Height="900"
        MinWidth="1120"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource AppBackgroundBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="7"
                            CornerRadius="10"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModels:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:AirlinersViewModel}">
            <views:AirlinersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:CabinControlPanelViewModel}">
            <views:CabinControlPanelView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:AudioViewModel}">
            <views:AudioView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:PerformanceViewModel}">
            <views:PerformanceView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.ColumnSpan="2" IsHitTestVisible="False">
                <Rectangle Fill="{StaticResource AmbientGlowBrush}" />
            </Grid>

            <Border Grid.Column="0"
                    Background="#D9030C1A"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="152" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="54" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="26,15,24,14">
                        <Image Source="pack://application:,,,/FreeFlight.CabinControl;component/Assets/FreeFlightBrand.png"
                               Width="202"
                               Height="93"
                               Stretch="Uniform" />
                        <TextBlock Text="C A B I N   C O N T R O L"
                                   Margin="12,-5,0,0"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   FontStyle="Italic"
                                   Foreground="{StaticResource MetallicBrandTextBrush}">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#258DFF" BlurRadius="7" ShadowDepth="0" Opacity="0.42" />
                            </TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Row="1" VerticalAlignment="Top" Margin="0,8,0,0">
                        <RadioButton Style="{StaticResource NavRadioStyle}"
                                     Content="Dashboard"
                                     Tag="&#xE80F;"
                                     GroupName="Navigation"
                                     IsChecked="{Binding ActivePage, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Dashboard, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Dashboard" />
                        <RadioButton Style="{StaticResource NavRadioStyle}"
                                     Content="Airliners"
                                     Tag="&#xE709;"
                                     GroupName="Navigation"
                                     IsChecked="{Binding ActivePage, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Airliners, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Airliners" />
                        <RadioButton Style="{StaticResource NavRadioStyle}"
                                     Content="Cabin Panel"
                                     Tag="&#xE7F4;"
                                     GroupName="Navigation"
                                     IsChecked="{Binding ActivePage, Converter={StaticResource StringEqualsConverter}, ConverterParameter=CabinPanel, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="CabinPanel"
                                     ToolTip="Cabin Area Control Panel" />
                        <RadioButton Style="{StaticResource NavRadioStyle}"
                                     Content="Audio"
                                     Tag="&#xE767;"
                                     GroupName="Navigation"
                                     IsChecked="{Binding ActivePage, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Audio, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Audio" />
                        <RadioButton Style="{StaticResource NavRadioStyle}"
                                     Content="Performance"
                                     Tag="&#xE9D2;"
                                     GroupName="Navigation"
                                     IsChecked="{Binding ActivePage, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Performance, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Performance" />
                        <RadioButton Style="{StaticResource NavRadioStyle}"
                                     Content="Settings"
                                     Tag="&#xE713;"
                                     GroupName="Navigation"
                                     IsChecked="{Binding ActivePage, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Settings, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Settings" />
                    </StackPanel>

                    <TextBlock Grid.Row="2"
                               Text="v0.1.0-dev"
                               Margin="30,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="12" />
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="42" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,4,5,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource WindowButtonStyle}" Content="&#xE921;" Click="MinimizeButton_Click" ToolTip="Minimize" />
                    <Button Style="{StaticResource WindowButtonStyle}" Content="&#xE922;" Click="MaximizeButton_Click" ToolTip="Maximize or restore" />
                    <Button Style="{StaticResource CloseWindowButtonStyle}" Content="&#xE8BB;" Click="CloseButton_Click" ToolTip="Close" />
                </StackPanel>

                <ContentControl Grid.Row="1"
                                Content="{Binding CurrentPage}"
                                Margin="36,4,36,30" />
            </Grid>
        </Grid>
    </Border>
</Window>
