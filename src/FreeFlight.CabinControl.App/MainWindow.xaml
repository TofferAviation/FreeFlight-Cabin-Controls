<Window x:Class="FreeFlight.CabinControl.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:FreeFlight.CabinControl.App.Views"
        mc:Ignorable="d"
        Title="Ember"
        Width="1540"
        Height="900"
        MinWidth="1120"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource AppBackgroundBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            ResizeBorderThickness="7"
                            CornerRadius="10"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="WorkspaceNavStyle" TargetType="RadioButton" BasedOn="{StaticResource NavRadioStyle}">
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="9,2" />
            <Setter Property="Padding" Value="15,0" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="WorkspaceNavLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8FAECD" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="24,17,0,5" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
        <Grid>
            <!-- A verified BAV session is always required before Ember exposes a flight workspace. -->
            <Grid Visibility="{Binding IsBavAuthenticated, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="224" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="#174C7191" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="112" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="90" />
                        </Grid.RowDefinitions>

                        <StackPanel Margin="22,19,18,0">
                            <Image Source="pack://application:,,,/FreeFlight.CabinControl;component/Assets/BritishAirwaysVirtual.png"
                                   Width="158" Height="50" Stretch="Uniform" HorizontalAlignment="Left" />
                            <TextBlock Text="EMBER · FLIGHT COMPANION" Foreground="#9BC5E6" FontSize="9" FontWeight="SemiBold" Margin="3,10,0,0" />
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,3,0,10">
                                <TextBlock Text="WORKSPACE" Style="{StaticResource WorkspaceNavLabelStyle}" />
                                <RadioButton Style="{StaticResource WorkspaceNavStyle}" Content="Overview" Tag="&#xE80F;" GroupName="Navigation"
                                             IsChecked="{Binding ActivePage, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Dashboard, Mode=OneWay}"
                                             Command="{Binding NavigateCommand}" CommandParameter="Dashboard" />
                                <RadioButton Style="{StaticResource WorkspaceNavStyle}" Content="My flight" Tag="&#xE70F;" GroupName="Navigation"
                                             IsChecked="{Binding ActivePage, Converter={StaticResource StringEqualsConverter}, ConverterParameter=CabinAccount, Mode=OneWay}"
                                             Command="{Binding NavigateCommand}" CommandParameter="CabinAccount" />
                                <RadioButton Style="{StaticResource WorkspaceNavStyle}" Content="Service" Tag="&#xED56;" GroupName="Navigation"
                                             IsChecked="{Binding ActivePage, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Catering, Mode=OneWay}"
                                             Command="{Binding NavigateCommand}" CommandParameter="Catering" />
                                <RadioButton Style="{StaticResource WorkspaceNavStyle}" Content="Passengers" Tag="&#xE77B;" GroupName="Navigation"
                                             IsChecked="{Binding ActivePage, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Passengers, Mode=OneWay}"
                                             Command="{Binding NavigateCommand}" CommandParameter="Passengers" />

                                <TextBlock Text="OPERATIONS" Style="{StaticResource WorkspaceNavLabelStyle}" />
                                <RadioButton Style="{StaticResource WorkspaceNavStyle}" Content="Fleet" Tag="&#xE709;" GroupName="Navigation"
                                             IsChecked="{Binding ActivePage, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Fleet, Mode=OneWay}"
                                             Command="{Binding NavigateCommand}" CommandParameter="Fleet" />
                                <RadioButton Style="{StaticResource WorkspaceNavStyle}" Content="Reports" Tag="&#xE9D2;" GroupName="Navigation"
                                             IsChecked="{Binding ActivePage, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Performance, Mode=OneWay}"
                                             Command="{Binding NavigateCommand}" CommandParameter="Performance" />
                                <RadioButton Style="{StaticResource WorkspaceNavStyle}" Content="iGate" Tag="&#xE8A5;" GroupName="Navigation"
                                             IsChecked="{Binding ActivePage, Converter={StaticResource StringEqualsConverter}, ConverterParameter=IportDcs, Mode=OneWay}"
                                             Command="{Binding NavigateCommand}" CommandParameter="IportDcs" />

                                <TextBlock Text="PERSONAL" Style="{StaticResource WorkspaceNavLabelStyle}" />
                                <RadioButton Style="{StaticResource WorkspaceNavStyle}" Content="FlightLogger" Tag="&#xE774;" GroupName="Navigation"
                                             IsChecked="{Binding ActivePage, Converter={StaticResource StringEqualsConverter}, ConverterParameter=FlightLogger, Mode=OneWay}"
                                             Command="{Binding NavigateCommand}" CommandParameter="FlightLogger" />
                                <RadioButton Style="{StaticResource WorkspaceNavStyle}" Content="Settings" Tag="&#xE713;" GroupName="Navigation"
                                             IsChecked="{Binding ActivePage, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Settings, Mode=OneWay}"
                                             Command="{Binding NavigateCommand}" CommandParameter="Settings" />
                            </StackPanel>
                        </ScrollViewer>

                        <Border Grid.Row="2" BorderBrush="#174C7191" BorderThickness="0,1,0,0" Padding="19,13" ToolTip="{Binding Status.ConnectionDetail}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center" Fill="{Binding Status.ConnectionColor}" />
                                    <TextBlock Text="{Binding Status.ConnectionLabel}" Foreground="#EAF5FF" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Grid Grid.Row="1" Margin="15,5,0,0">
                                    <TextBlock Text="{Binding Status.ConnectionSource}" Foreground="#A3B8CB" FontSize="9" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Settings.Version}" HorizontalAlignment="Right" Foreground="#A3B8CB" FontSize="9" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Flight context, appearance and account controls live in the Overview header.
                         This thin title area remains only for native window movement and controls. -->
                    <Border Background="Transparent" Panel.ZIndex="3" />

                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,6,0" shell:WindowChrome.IsHitTestVisibleInChrome="True" Panel.ZIndex="4">
                        <Button Style="{StaticResource WindowButtonStyle}" Content="&#xE921;" Click="MinimizeButton_Click" ToolTip="Minimize" />
                        <Button Style="{StaticResource WindowButtonStyle}" Content="&#xE922;" Click="MaximizeButton_Click" ToolTip="Maximize or restore" />
                        <Button Style="{StaticResource CloseWindowButtonStyle}" Content="&#xE8BB;" Click="CloseButton_Click" ToolTip="Close" />
                    </StackPanel>

                    <!-- Page instances stay alive: cabin state, telemetry and live service progress are never reset by navigation. -->
                    <Grid Grid.Row="1" Margin="26,20,26,24" Panel.ZIndex="2">
                        <views:CabinAccountView DataContext="{Binding Account}" Visibility="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=CabinAccount}" />
                        <views:DashboardView DataContext="{Binding}" ThemeToggleRequested="DashboardThemeToggleRequested" Visibility="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Dashboard}" />
                        <views:PassengerFlowView DataContext="{Binding Passengers}" Visibility="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Passengers}" />
                        <views:CateringView DataContext="{Binding Catering}" Visibility="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Catering}" />
                        <views:FleetView DataContext="{Binding Fleet}" Visibility="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Fleet}" />
                        <views:PerformanceView DataContext="{Binding Performance}" Visibility="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Performance}" />
                        <views:IportDcsView DataContext="{Binding IportDcs}" Visibility="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=IportDcs}" />
                        <views:FlightLoggerView DataContext="{Binding FlightLogger}" Visibility="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=FlightLogger}" />
                        <views:SettingsView DataContext="{Binding Settings}" PreviewUpdateRequested="SettingsView_PreviewUpdateRequested" CheckForUpdatesRequested="SettingsView_CheckForUpdatesRequested" Visibility="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Settings}" />
                    </Grid>
                </Grid>
            </Grid>

            <!-- Standalone signed-out experience: unchanged BAV authentication is the entry point to the rebuilt workspace. -->
            <Grid Visibility="{Binding IsBavAuthenticated, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="54" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Rectangle Fill="{StaticResource AmbientGlowBrush}" IsHitTestVisible="False" />
                <Border Grid.Row="0" Background="{StaticResource SidebarBrush}" BorderBrush="#174C7191" BorderThickness="0,0,0,1">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                            <Image Source="pack://application:,,,/FreeFlight.CabinControl;component/Assets/BritishAirwaysVirtual.png" Width="166" Height="42" Stretch="Uniform" />
                            <TextBlock Text="EMBER SECURE SIGN-IN" Foreground="#9BC5E6" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Margin="20,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,7,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button Style="{StaticResource WindowButtonStyle}" Content="&#xE921;" Click="MinimizeButton_Click" ToolTip="Minimize" />
                            <Button Style="{StaticResource WindowButtonStyle}" Content="&#xE922;" Click="MaximizeButton_Click" ToolTip="Maximize or restore" />
                            <Button Style="{StaticResource CloseWindowButtonStyle}" Content="&#xE8BB;" Click="CloseButton_Click" ToolTip="Close" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid Grid.Row="1">
                    <views:CabinAccountView DataContext="{Binding Account}" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
