<Window x:Class="FreeFlight.CabinControl.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:FreeFlight.CabinControl.App.Views"
        mc:Ignorable="d"
        Title="FreeFlight Cabin Control"
        Width="1540"
        Height="900"
        MinWidth="1120"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource AppBackgroundBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="7"
                            CornerRadius="10"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="CompactNavRadioStyle" TargetType="RadioButton" BasedOn="{StaticResource NavRadioStyle}">
            <Setter Property="Height" Value="48" />
            <Setter Property="Margin" Value="8,2" />
            <Setter Property="Padding" Value="17,0" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.ColumnSpan="2" IsHitTestVisible="False">
                <Rectangle Fill="{StaticResource AmbientGlowBrush}" />
            </Grid>

            <Border Grid.Column="0"
                    Background="#D9030C1A"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="132" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="116" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="12,4,12,5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top">
                        <Image Source="pack://application:,,,/FreeFlight.CabinControl;component/Assets/FreeFlightHeaderMark.png"
                               Width="184"
                               Height="64"
                               HorizontalAlignment="Center"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <Image Source="pack://application:,,,/FreeFlight.CabinControl;component/Assets/FreeFlightHeaderWordmark.png"
                               Width="218"
                               Height="54"
                               Margin="0,-2,0,0"
                               HorizontalAlignment="Center"
                               Stretch="Uniform"
                               SnapsToDevicePixels="True"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel VerticalAlignment="Top" Margin="0,5,0,0">
                        <RadioButton Style="{StaticResource CompactNavRadioStyle}"
                                     Content="Overview"
                                     Tag="&#xE80F;"
                                     GroupName="Navigation"
                                     IsChecked="{Binding ActivePage, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Dashboard, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Dashboard" />
                        <RadioButton Style="{StaticResource CompactNavRadioStyle}"
                                     Content="Settings"
                                     Tag="&#xE713;"
                                     GroupName="Navigation"
                                     IsChecked="{Binding ActivePage, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Settings, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Settings" />
                        <TextBlock Text="GATE OPERATIONS" Foreground="#61758E" FontSize="9" FontWeight="SemiBold" Margin="24,11,0,4" />
                        <RadioButton Style="{StaticResource CompactNavRadioStyle}"
                                     Content="{Binding GateLogin.NavigationLabel}"
                                     Tag="&#xE77B;"
                                     GroupName="Navigation"
                                     IsChecked="{Binding ActivePage, Converter={StaticResource StringEqualsConverter}, ConverterParameter=GateLogin, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="GateLogin" />
                        <StackPanel Visibility="{Binding GateLogin.IsAuthenticated, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <RadioButton Style="{StaticResource CompactNavRadioStyle}"
                                         Content="Iport DCS"
                                         Tag="&#xE8A5;"
                                         GroupName="Navigation"
                                         Margin="22,1,8,1"
                                         Padding="14,0"
                                         IsChecked="{Binding ActivePage, Converter={StaticResource StringEqualsConverter}, ConverterParameter=IportDcs, Mode=OneWay}"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="IportDcs"
                                         ToolTip="Advanced departure-control system" />
                            <RadioButton Style="{StaticResource CompactNavRadioStyle}"
                                         Content="Gate Desk"
                                         Tag="&#xE716;"
                                         GroupName="Navigation"
                                         Margin="22,1,8,1"
                                         Padding="14,0"
                                         IsChecked="{Binding ActivePage, Converter={StaticResource StringEqualsConverter}, ConverterParameter=GateDesk, Mode=OneWay}"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="GateDesk" />
                            <RadioButton Style="{StaticResource CompactNavRadioStyle}"
                                         Content="Passenger Manifest"
                                         Tag="&#xE8A5;"
                                         GroupName="Navigation"
                                         Margin="22,1,8,1"
                                         Padding="14,0"
                                         IsChecked="{Binding ActivePage, Converter={StaticResource StringEqualsConverter}, ConverterParameter=PassengerManifest, Mode=OneWay}"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="PassengerManifest" />
                            <RadioButton Style="{StaticResource CompactNavRadioStyle}"
                                         Content="Boarding Passes"
                                         Tag="&#xE8C7;"
                                         GroupName="Navigation"
                                         Margin="22,1,8,1"
                                         Padding="14,0"
                                         IsChecked="{Binding ActivePage, Converter={StaticResource StringEqualsConverter}, ConverterParameter=BoardingPasses, Mode=OneWay}"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="BoardingPasses" />
                        </StackPanel>

                        <TextBlock Text="CABIN SYSTEMS" Foreground="#61758E" FontSize="9" FontWeight="SemiBold" Margin="24,11,0,4" />
                        <RadioButton Style="{StaticResource CompactNavRadioStyle}"
                                     Content="Live Cabin"
                                     Tag="&#xE7C8;"
                                     GroupName="Navigation"
                                     IsChecked="{Binding ActivePage, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Passengers, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Passengers"
                                     ToolTip="Live cabin overview for gate, taxi and flight operations" />
                        <RadioButton Style="{StaticResource CompactNavRadioStyle}"
                                     Content="Airliners"
                                     Tag="&#xE709;"
                                     GroupName="Navigation"
                                     IsChecked="{Binding ActivePage, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Airliners, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Airliners" />
                        <RadioButton Style="{StaticResource CompactNavRadioStyle}"
                                     Content="Cabin Panel"
                                     Tag="&#xE7F4;"
                                     GroupName="Navigation"
                                     IsChecked="{Binding ActivePage, Converter={StaticResource StringEqualsConverter}, ConverterParameter=CabinPanel, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="CabinPanel"
                                     ToolTip="Cabin Area Control Panel" />
                        <RadioButton Style="{StaticResource CompactNavRadioStyle}"
                                     Content="Audio"
                                     Tag="&#xE767;"
                                     GroupName="Navigation"
                                     IsChecked="{Binding ActivePage, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Audio, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Audio" />
                        <RadioButton Style="{StaticResource CompactNavRadioStyle}"
                                     Content="Diagnostics"
                                     Tag="&#xE9D2;"
                                     GroupName="Navigation"
                                     IsChecked="{Binding ActivePage, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Performance, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Performance" />
                        <TextBlock Text="REAL TRACKER" Foreground="#61758E" FontSize="9" FontWeight="SemiBold" Margin="24,11,0,4" />
                        <RadioButton Style="{StaticResource CompactNavRadioStyle}"
                                     Content="FlightLogger"
                                     Tag="&#xE774;"
                                     GroupName="Navigation"
                                     IsChecked="{Binding ActivePage, Converter={StaticResource StringEqualsConverter}, ConverterParameter=FlightLogger, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="FlightLogger"
                                     ToolTip="Open the FlightLogger real-world flight tracker" />
                    </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="20,10,18,8"
                            ToolTip="{Binding Status.ConnectionDetail}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="9"
                                         Height="9"
                                         Margin="0,0,8,0"
                                         VerticalAlignment="Center"
                                         Fill="{Binding Status.ConnectionColor}" />
                                <TextBlock Text="{Binding Status.ConnectionLabel}"
                                           Foreground="{Binding Status.ConnectionColor}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Grid Grid.Row="1" Margin="17,5,0,0">
                                <TextBlock Text="{Binding Status.ConnectionSource}"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="10"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Settings.Version}"
                                           HorizontalAlignment="Right"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="10" />
                            </Grid>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="17,8,0,0">
                                <Button Content="Check Updates"
                                        Click="SettingsView_CheckForUpdatesRequested"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Height="27"
                                        Padding="8,2"
                                        FontSize="10" />
                                <Button Content="Changelog"
                                        Click="OpenChangelogButton_Click"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Height="27"
                                        Padding="8,2"
                                        Margin="6,0,0,0"
                                        FontSize="10" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="82" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#9A061326" BorderBrush="#263A52" BorderThickness="0,0,0,1">
                    <Grid Margin="20,0,145,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="270" /><ColumnDefinition Width="1" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="140" /><ColumnDefinition Width="1" /><ColumnDefinition Width="195" /><ColumnDefinition Width="215" /></Grid.ColumnDefinitions>
                        <Image Source="pack://application:,,,/FreeFlight.CabinControl;component/Assets/AirlineLogos/BAW.png"
                               Width="245"
                               Height="48"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Stretch="Uniform"
                               Tag="HeaderBritishAirwaysWordmark" />
                        <Rectangle Grid.Column="1" Fill="#263A52" Margin="0,14" />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="20,0"><TextBlock Text="{Binding Operations.FlightNumber}" FontSize="21" FontWeight="SemiBold" /><TextBlock Text="{Binding Operations.RouteSummary}" Style="{StaticResource MutedTextStyle}" /></StackPanel>
                        <Rectangle Grid.Column="3" Fill="#263A52" Margin="0,14" />
                        <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="GATE" Tag="GateHeaderLabel" FontSize="9" FontWeight="SemiBold" Foreground="#7F93AA" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding Operations.GateHeader}" FontSize="13" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,3,0,0" />
                        </StackPanel>
                        <Rectangle Grid.Column="5" Fill="#263A52" Margin="0,14" />
                        <TextBlock Grid.Column="6" Text="{Binding Operations.AircraftName}" FontSize="16" VerticalAlignment="Center" Margin="20,0" />
                        <StackPanel Grid.Column="7" VerticalAlignment="Center" HorizontalAlignment="Right"><TextBlock Text="{Binding Operations.SimBriefConnectionLabel}" FontSize="15" HorizontalAlignment="Right" /><TextBlock Text="{Binding Operations.SimBriefImportLabel}" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Right" /></StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,4,5,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource WindowButtonStyle}" Content="&#xE921;" Click="MinimizeButton_Click" ToolTip="Minimize" />
                    <Button Style="{StaticResource WindowButtonStyle}" Content="&#xE922;" Click="MaximizeButton_Click" ToolTip="Maximize or restore" />
                    <Button Style="{StaticResource CloseWindowButtonStyle}" Content="&#xE8BB;" Click="CloseButton_Click" ToolTip="Close" />
                </StackPanel>

                <!-- Keep page instances alive so long-running cabin media is not restarted by navigation. -->
                <Grid Grid.Row="1" Margin="20,12,20,20">
                    <views:GateLoginView DataContext="{Binding GateLogin}"
                                         Visibility="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=GateLogin}" />
                    <views:DashboardView DataContext="{Binding Dashboard}"
                                         Visibility="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Dashboard}" />
                    <views:AirlinersView DataContext="{Binding Airliners}"
                                        Visibility="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Airliners}" />
                    <views:PassengerFlowView DataContext="{Binding Passengers}"
                                             Visibility="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Passengers}" />
                    <views:CabinControlPanelView DataContext="{Binding CabinPanel}"
                                                 Visibility="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=CabinPanel}" />
                    <views:AudioView DataContext="{Binding Audio}"
                                     Visibility="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Audio}" />
                    <views:PerformanceView DataContext="{Binding Performance}"
                                           Visibility="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Performance}" />
                    <views:SettingsView DataContext="{Binding Settings}"
                                        PreviewUpdateRequested="SettingsView_PreviewUpdateRequested"
                                        CheckForUpdatesRequested="SettingsView_CheckForUpdatesRequested"
                                        Visibility="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Settings}" />
                    <views:GateDeskView DataContext="{Binding Operations}"
                                        Visibility="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=GateDesk}" />
                    <views:IportDcsView DataContext="{Binding IportDcs}"
                                        Visibility="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=IportDcs}" />
                    <views:PassengerManifestView DataContext="{Binding Operations}"
                                                 Visibility="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=PassengerManifest}" />
                    <views:BoardingPassesView DataContext="{Binding Operations}"
                                               Visibility="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=BoardingPasses}" />
                    <views:FlightLoggerView DataContext="{Binding FlightLogger}"
                                            Visibility="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=FlightLogger}" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
