<UserControl x:Class="FreeFlight.CabinControl.App.Views.PassengerManifestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.7*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="390" /></Grid.ColumnDefinitions>
        <Border Style="{StaticResource CardStyle}" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="48" /><RowDefinition Height="38" /><RowDefinition Height="*" /><RowDefinition Height="42" /></Grid.RowDefinitions>
            <Grid><StackPanel Orientation="Horizontal"><TextBlock Text="Passenger Manifest" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="{Binding TotalPassengers, StringFormat={}{0} passengers}" Style="{StaticResource MutedTextStyle}" Margin="16,8,0,0" /></StackPanel><Button Content="Export Manifest" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" MinHeight="32" Padding="13,4" /></Grid>
            <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions><TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search passengers" /><ComboBox Grid.Column="1" ItemsSource="{Binding CabinFilters}" SelectedItem="{Binding SelectedCabinFilter}" Margin="8,0,0,0" /></Grid>
            <Border Grid.Row="2" Background="#102039" CornerRadius="5" Padding="9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.45*" /><ColumnDefinition Width="90" /><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="58" /><ColumnDefinition Width="100" /><ColumnDefinition Width="90" /><ColumnDefinition Width="105" /><ColumnDefinition Width="95" /></Grid.ColumnDefinitions><TextBlock Text="PASSENGER" Style="{StaticResource MetricLabelStyle}" /><TextBlock Grid.Column="1" Text="BOOKING" Style="{StaticResource MetricLabelStyle}" /><TextBlock Grid.Column="2" Text="CABIN" Style="{StaticResource MetricLabelStyle}" /><TextBlock Grid.Column="3" Text="SEAT" Style="{StaticResource MetricLabelStyle}" /><TextBlock Grid.Column="4" Text="CHECK-IN" Style="{StaticResource MetricLabelStyle}" /><TextBlock Grid.Column="5" Text="BOARDING" Style="{StaticResource MetricLabelStyle}" /><TextBlock Grid.Column="6" Text="BAGGAGE" Style="{StaticResource MetricLabelStyle}" /><TextBlock Grid.Column="7" Text="ASSISTANCE" Style="{StaticResource MetricLabelStyle}" /></Grid></Border>
            <ListBox Grid.Row="3" ItemsSource="{Binding VisiblePassengers}" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Background" Value="Transparent" /></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Button Command="{Binding DataContext.SelectPassengerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" BorderBrush="#203954" BorderThickness="0,0,0,1" Padding="9,8" HorizontalContentAlignment="Stretch"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.45*" /><ColumnDefinition Width="90" /><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="58" /><ColumnDefinition Width="100" /><ColumnDefinition Width="90" /><ColumnDefinition Width="105" /><ColumnDefinition Width="95" /></Grid.ColumnDefinitions><TextBlock Text="{Binding FullName}" /><TextBlock Grid.Column="1" Text="{Binding BookingReference}" /><TextBlock Grid.Column="2" Text="{Binding CabinMarketingName}" FontSize="10" /><TextBlock Grid.Column="3" Text="{Binding SeatNumber}" Foreground="#8FC8FF" FontWeight="SemiBold" /><TextBlock Grid.Column="4" Text="{Binding CheckInLabel}" Foreground="{Binding CheckInColor}" FontSize="10" /><TextBlock Grid.Column="5" Text="{Binding BoardingLabel}" Foreground="{Binding BoardingColor}" FontSize="10" /><TextBlock Grid.Column="6" Text="{Binding BaggageLabel}" Foreground="{Binding BaggageColor}" FontSize="9" /><TextBlock Grid.Column="7" Text="{Binding AssistanceLabel}" Foreground="#B88CFF" FontSize="9" TextTrimming="CharacterEllipsis" /></Grid></Button></DataTemplate></ListBox.ItemTemplate></ListBox>
            <Grid Grid.Row="4"><TextBlock Text="{Binding VisiblePassengers.Count, StringFormat={}{0} matching passengers}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" /><TextBlock Text="Sorted by boarding group and passenger number" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
        </Grid></Border>

        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
            <Grid Height="70"><Grid.ColumnDefinitions><ColumnDefinition Width="60" /><ColumnDefinition /></Grid.ColumnDefinitions><Border Width="50" Height="50" CornerRadius="25" Background="#26364D"><TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons" FontSize="24" Foreground="#8DA0B8" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding SelectedPassenger.FullName}" FontSize="21" FontWeight="SemiBold" /><TextBlock Text="{Binding SelectedPassenger.BookingReference, StringFormat=Booking reference  {0}}" Style="{StaticResource MutedTextStyle}" /></StackPanel></Grid>
            <Grid Margin="0,8,0,14"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="CABIN" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding SelectedPassenger.CabinMarketingName}" FontWeight="SemiBold" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="SEAT" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding SelectedPassenger.SeatNumber}" FontSize="20" FontWeight="SemiBold" Foreground="#8FC8FF" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="GROUP" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding SelectedPassenger.BoardingGroup}" FontSize="20" FontWeight="SemiBold" /></StackPanel></Grid>
            <UniformGrid Columns="3" Margin="0,0,0,16"><Button Content="Check In" Command="{Binding CheckInPassengerCommand}" CommandParameter="{Binding SelectedPassenger}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,0" /><Button Content="Board" Command="{Binding BoardPassengerCommand}" CommandParameter="{Binding SelectedPassenger}" Style="{StaticResource PrimaryButtonStyle}" Margin="4,0" /><Button Content="Bag State" Command="{Binding ToggleBagLoadedCommand}" CommandParameter="{Binding SelectedPassenger}" Style="{StaticResource SecondaryButtonStyle}" Margin="4,0,0,0" /></UniformGrid>
            <Separator Background="#29415E" />
            <TextBlock Text="Operational Status" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,5" />
            <Grid Height="42"><TextBlock Text="Check-in" /><TextBlock Text="{Binding SelectedPassenger.CheckInLabel}" Foreground="{Binding SelectedPassenger.CheckInColor}" HorizontalAlignment="Right" /></Grid><Grid Height="42"><TextBlock Text="Boarding" /><TextBlock Text="{Binding SelectedPassenger.BoardingLabel}" Foreground="{Binding SelectedPassenger.BoardingColor}" HorizontalAlignment="Right" /></Grid><Grid Height="42"><TextBlock Text="Baggage" /><TextBlock Text="{Binding SelectedPassenger.BaggageLabel}" Foreground="{Binding SelectedPassenger.BaggageColor}" HorizontalAlignment="Right" /></Grid><Grid Height="42"><TextBlock Text="Special Assistance" /><TextBlock Text="{Binding SelectedPassenger.AssistanceLabel}" Foreground="#B88CFF" HorizontalAlignment="Right" /></Grid>
            <Separator Background="#29415E" />
            <TextBlock Text="Passenger Details" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,6" />
            <Grid Height="36"><TextBlock Text="Date of Birth" Style="{StaticResource MutedTextStyle}" /><TextBlock Text="{Binding SelectedPassenger.DateOfBirth}" HorizontalAlignment="Right" /></Grid><Grid Height="36"><TextBlock Text="Nationality" Style="{StaticResource MutedTextStyle}" /><TextBlock Text="{Binding SelectedPassenger.Nationality}" HorizontalAlignment="Right" /></Grid><Grid Height="36"><TextBlock Text="Document" Style="{StaticResource MutedTextStyle}" /><TextBlock Text="{Binding SelectedPassenger.DocumentNumber}" HorizontalAlignment="Right" /></Grid><Grid Height="36"><TextBlock Text="Frequent Flyer" Style="{StaticResource MutedTextStyle}" /><TextBlock Text="{Binding SelectedPassenger.ClubMembershipLabel}" HorizontalAlignment="Right" /></Grid><Grid Height="36"><TextBlock Text="Executive Club No." Style="{StaticResource MutedTextStyle}" /><TextBlock Text="{Binding SelectedPassenger.ExecutiveClubNumber}" HorizontalAlignment="Right" /></Grid><Grid Height="36"><TextBlock Text="Email" Style="{StaticResource MutedTextStyle}" /><TextBlock Text="{Binding SelectedPassenger.Email}" HorizontalAlignment="Right" FontSize="10" /></Grid><Grid Height="36"><TextBlock Text="Phone" Style="{StaticResource MutedTextStyle}" /><TextBlock Text="{Binding SelectedPassenger.Phone}" HorizontalAlignment="Right" /></Grid>
        </StackPanel></ScrollViewer></Border>
    </Grid>
</UserControl>
