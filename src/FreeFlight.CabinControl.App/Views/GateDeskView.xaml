<UserControl x:Class="FreeFlight.CabinControl.App.Views.GateDeskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FreeFlight.CabinControl.App.Views">
    <Grid><Grid.RowDefinitions><RowDefinition Height="105" /><RowDefinition Height="58" /><RowDefinition Height="12" /><RowDefinition Height="*" /><RowDefinition Height="68" /></Grid.RowDefinitions>
        <UniformGrid Columns="4">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,6,0"><StackPanel><TextBlock Text="{Binding TotalPassengers}" FontSize="27" FontWeight="SemiBold" /><TextBlock Text="Total Passengers" /><TextBlock Text="From SimBrief / manifest" Style="{StaticResource MutedTextStyle}" FontSize="10" /></StackPanel></Border>
            <Border Style="{StaticResource CardStyle}" Margin="6,0"><StackPanel><TextBlock Text="{Binding CheckedInPassengers}" FontSize="27" FontWeight="SemiBold" /><TextBlock Text="Checked In" /><TextBlock Text="{Binding CheckedInPercent, StringFormat={}{0}% of total}" Style="{StaticResource MutedTextStyle}" FontSize="10" /></StackPanel></Border>
            <Border Style="{StaticResource CardStyle}" Margin="6,0"><StackPanel><TextBlock Text="{Binding BoardedPassengers}" FontSize="27" FontWeight="SemiBold" /><TextBlock Text="Boarded" /><TextBlock Text="{Binding BoardedPercent, StringFormat={}{0}% of total}" Style="{StaticResource MutedTextStyle}" FontSize="10" /></StackPanel></Border>
            <Border Style="{StaticResource CardStyle}" Margin="6,0,0,0"><StackPanel><TextBlock Text="{Binding LoadedBags}" FontSize="27" FontWeight="SemiBold" /><TextBlock Text="Bags Loaded" /><TextBlock Text="{Binding BagsLoadedPercent, StringFormat={}{0}% of bags}" Style="{StaticResource MutedTextStyle}" FontSize="10" /></StackPanel></Border>
        </UniformGrid>
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="18,10" Margin="0,10,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition /><ColumnDefinition Width="115" /></Grid.ColumnDefinitions><TextBlock Text="{Binding BoardingStatusLabel}" Foreground="{Binding BoardingStatusColor}" FontWeight="SemiBold" VerticalAlignment="Center" /><ProgressBar Grid.Column="1" Value="{Binding BoardedPercent, Mode=OneWay}" Maximum="100" Height="9" Margin="8,0,22,0" VerticalAlignment="Center" /><StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="{Binding BoardedPercent, StringFormat={}{0}%}" Foreground="#70E05B" FontSize="18" /><TextBlock Text="{Binding BoardingProgressText}" Margin="15,3,0,0" Style="{StaticResource MutedTextStyle}" /></StackPanel></Grid></Border>

        <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="1.06*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="0.94*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="44" /><RowDefinition Height="36" /><RowDefinition /></Grid.RowDefinitions><TextBlock Text="Passenger Manifest" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="{Binding TotalPassengers, StringFormat={}{0} passengers}" HorizontalAlignment="Right" Style="{StaticResource MutedTextStyle}" />
                <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="170" /></Grid.ColumnDefinitions><TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search name, booking reference, or seat" MinHeight="34" /><ComboBox Grid.Column="1" ItemsSource="{Binding CabinFilters}" SelectedItem="{Binding SelectedCabinFilter}" MinHeight="34" Margin="8,0,0,0" /></Grid>
                <Border Grid.Row="2" Background="#102039" CornerRadius="5" Padding="8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="85" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="55" /><ColumnDefinition Width="95" /><ColumnDefinition Width="85" /></Grid.ColumnDefinitions><TextBlock Text="PASSENGER" Style="{StaticResource MetricLabelStyle}" /><TextBlock Grid.Column="1" Text="BOOKING" Style="{StaticResource MetricLabelStyle}" /><TextBlock Grid.Column="2" Text="CABIN" Style="{StaticResource MetricLabelStyle}" /><TextBlock Grid.Column="3" Text="SEAT" Style="{StaticResource MetricLabelStyle}" /><TextBlock Grid.Column="4" Text="CHECK-IN" Style="{StaticResource MetricLabelStyle}" /><TextBlock Grid.Column="5" Text="BOARDING" Style="{StaticResource MetricLabelStyle}" /></Grid></Border>
                <ListBox Grid.Row="3" ItemsSource="{Binding VisiblePassengers}" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Background" Value="Transparent" /></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Button Command="{Binding DataContext.SelectPassengerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" BorderBrush="#203954" BorderThickness="0,0,0,1" Padding="8,7" HorizontalContentAlignment="Stretch"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="85" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="55" /><ColumnDefinition Width="95" /><ColumnDefinition Width="85" /></Grid.ColumnDefinitions><TextBlock Text="{Binding FullName}" /><TextBlock Grid.Column="1" Text="{Binding BookingReference}" /><TextBlock Grid.Column="2" Text="{Binding CabinMarketingName}" FontSize="10" /><TextBlock Grid.Column="3" Text="{Binding SeatNumber}" Foreground="#8FC8FF" FontWeight="SemiBold" /><TextBlock Grid.Column="4" Text="{Binding CheckInLabel}" Foreground="{Binding CheckInColor}" FontSize="10" /><TextBlock Grid.Column="5" Text="{Binding BoardingLabel}" Foreground="{Binding BoardingColor}" FontSize="10" /></Grid></Button></DataTemplate></ListBox.ItemTemplate></ListBox>
            </Grid></Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="84" /><RowDefinition Height="72" /><RowDefinition Height="30" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="56" /><ColumnDefinition /></Grid.ColumnDefinitions><Border Width="48" Height="48" CornerRadius="24" Background="#26364D"><TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons" FontSize="23" Foreground="#8DA0B8" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding SelectedPassenger.FullName}" FontSize="19" FontWeight="SemiBold" /><StackPanel Orientation="Horizontal"><TextBlock Text="Booking " Style="{StaticResource MutedTextStyle}" /><TextBlock Text="{Binding SelectedPassenger.BookingReference}" /><TextBlock Text="   Seat " Style="{StaticResource MutedTextStyle}" /><TextBlock Text="{Binding SelectedPassenger.SeatNumber}" FontWeight="SemiBold" /></StackPanel><TextBlock Text="{Binding SelectedPassenger.CabinMarketingName}" Foreground="#8FC8FF" /></StackPanel></Grid>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="0.8*" /><ColumnDefinition Width="1.65*" /><ColumnDefinition Width="0.8*" /></Grid.ColumnDefinitions>
                    <Button Content="Check In" Command="{Binding CheckInPassengerCommand}" CommandParameter="{Binding SelectedPassenger}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,18" MinHeight="40" />
                    <Grid Grid.Column="1" Margin="4,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="0.85*" /><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="34" /></Grid.ColumnDefinitions>
                        <Button Content="Print Pass" Command="{Binding PrintBoardingPassCommand}" CommandParameter="{Binding SelectedPassenger}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,18" MinHeight="40" FontSize="11" Padding="3" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding AvailablePrinters}" SelectedItem="{Binding SelectedPrinter}" DisplayMemberPath="DisplayLabel" Margin="0,0,4,18" MinHeight="40" ToolTip="Select an installed Windows printer" />
                        <Button Grid.Column="2" Content="&#xE72C;" FontFamily="Segoe Fluent Icons" Command="{Binding RefreshPrintersCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="4" Margin="0,0,0,18" ToolTip="Refresh Windows printers" />
                        <TextBlock Grid.ColumnSpan="3" Text="{Binding PrinterStatusMessage}" Style="{StaticResource MutedTextStyle}" FontSize="9" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" ToolTip="{Binding PrinterStatusMessage}" />
                    </Grid>
                    <Button Grid.Column="2" Content="Board" Command="{Binding BoardPassengerCommand}" CommandParameter="{Binding SelectedPassenger}" Style="{StaticResource PrimaryButtonStyle}" Margin="4,0,0,18" MinHeight="40" />
                </Grid>
                <Grid Grid.Row="2"><TextBlock Text="Boarding Pass Preview" FontWeight="SemiBold" VerticalAlignment="Bottom" /><TextBlock Text="{Binding SelectedPassenger.BoardingPassStatus}" Foreground="{Binding SelectedPassenger.BoardingPassStatusColor}" HorizontalAlignment="Right" VerticalAlignment="Bottom" /></Grid>
                <Viewbox Grid.Row="3" Stretch="Uniform" Margin="0,9,0,0"><views:BoardingPassCardView Width="780" Height="300" /></Viewbox>
            </Grid></Border>
        </Grid>
        <Grid Grid.Row="4" Margin="0,10,0,0"><TextBlock Text="{Binding OperationMessage}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /><Button Command="{Binding ToggleGateCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Margin="0,0,286,0" MinWidth="260"><TextBlock Text="{Binding GateActionLabel}" /></Button><Button Content="Start / Manage Boarding  →" Command="{Binding StartManageBoardingCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" MinWidth="270" Background="#C81D2A" BorderBrush="#EC3944" /></Grid>
    </Grid>
</UserControl>
