<UserControl x:Class="FreeFlight.CabinControl.App.Views.PassengerFlowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="820"
             d:DesignWidth="1200">
    <UserControl.Resources>
        <Style x:Key="PassengerMetricCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="16,12" />
        </Style>

        <Style x:Key="MetricLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
            <Setter Property="FontSize" Value="25" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#55AEFF" />
        </Style>

        <Style x:Key="DoorToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="70" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Foreground" Value="#FFE0BD" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="DoorBorder"
                                Background="#D5251B17"
                                BorderBrush="#FF9D45"
                                BorderThickness="1.5"
                                CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="DoorLamp"
                                         Width="8"
                                         Height="8"
                                         Fill="#FF9D45"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Center" />
                                <ContentPresenter Grid.Column="1"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="DoorBorder" Property="Background" Value="#D5113028" />
                                <Setter TargetName="DoorBorder" Property="BorderBrush" Value="#58E68A" />
                                <Setter TargetName="DoorLamp" Property="Fill" Value="#58E68A" />
                                <Setter Property="Foreground" Value="#D7FFE4" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DoorBorder" Property="Opacity" Value="0.88" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PassengerCanvasItemStyle" TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding CanvasLeft}" />
            <Setter Property="Canvas.Top" Value="{Binding CanvasTop}" />
            <Setter Property="Panel.ZIndex" Value="3" />
        </Style>

        <Style x:Key="OverlayBorderStyle" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Background" Value="#FA061326" />
            <Setter Property="BorderBrush" Value="#36506E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.55" Color="#000000" />
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="94" />
                <RowDefinition Height="14" />
                <RowDefinition Height="420" />
                <RowDefinition Height="14" />
                <RowDefinition Height="118" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#122D4E" BorderBrush="#2D78C5" BorderThickness="1" CornerRadius="12" Padding="11,5" Margin="0,0,18,0">
                        <TextBlock Text="NO SIMULATOR REQUIRED" Foreground="#63B9FF" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                    <Ellipse Width="12" Height="12" Fill="{Binding BoardingStateColor}" Margin="0,0,9,0" />
                    <TextBlock Text="{Binding BoardingStateLabel}" Foreground="{Binding BoardingStateColor}" FontSize="13" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition Width="1.3*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource PassengerMetricCardStyle}" Margin="0,0,7,0">
                    <StackPanel>
                        <TextBlock Text="BOOKED" Style="{StaticResource MetricLabelStyle}" />
                        <TextBlock Text="{Binding BookedPassengerCount}" Style="{StaticResource MetricValueStyle}" />
                        <TextBlock Text="{Binding CapacitySummary}" Style="{StaticResource MetricLabelStyle}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource PassengerMetricCardStyle}" Margin="7,0">
                    <StackPanel>
                        <TextBlock Text="SEATED" Style="{StaticResource MetricLabelStyle}" />
                        <TextBlock Text="{Binding BoardedPassengerCount}" Style="{StaticResource MetricValueStyle}" Foreground="#58E68A" />
                        <TextBlock Text="Seat belts secured" Style="{StaticResource MetricLabelStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource PassengerMetricCardStyle}" Margin="7,0">
                    <StackPanel>
                        <TextBlock Text="IN CABIN" Style="{StaticResource MetricLabelStyle}" />
                        <TextBlock Text="{Binding InCabinPassengerCount}" Style="{StaticResource MetricValueStyle}" Foreground="#F0C64E" />
                        <TextBlock Text="{Binding InCabinSummary}" Style="{StaticResource MetricLabelStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource PassengerMetricCardStyle}" Margin="7,0">
                    <StackPanel>
                        <TextBlock Text="REMAINING" Style="{StaticResource MetricLabelStyle}" />
                        <TextBlock Text="{Binding RemainingPassengerCount}" Style="{StaticResource MetricValueStyle}" />
                        <TextBlock Text="{Binding WaitingPassengerSummary}" Style="{StaticResource MetricLabelStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource PassengerMetricCardStyle}" Margin="7,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="20" /></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding OperationProgressLabel}" Style="{StaticResource MetricLabelStyle}" />
                                <TextBlock Text="{Binding OperationProgress, StringFormat={}{0:F0}%}" Style="{StaticResource MetricValueStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" Margin="8,0,0,0">
                                <TextBlock Text="PREVIEW ETA" Style="{StaticResource MetricLabelStyle}" HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding OperationEta}" FontSize="18" Foreground="#F0C64E" HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>
                        <ProgressBar Grid.Row="1" Minimum="0" Maximum="100" Value="{Binding OperationProgress, Mode=OneWay}" Height="7" Foreground="#2088FF" Background="#1D2B3E" />
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3.5*" MinWidth="460" />
                    <ColumnDefinition Width="1.1*" MinWidth="220" MaxWidth="330" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0" Padding="16,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="82" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="42" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36" />
                                <RowDefinition Height="44" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Live Cabin" Style="{StaticResource SectionTitleStyle}" />
                                    <ComboBox ItemsSource="{Binding CabinLayoutProfiles}"
                                              SelectedItem="{Binding SelectedCabinLayoutProfile}"
                                              Width="205"
                                              Height="31"
                                              Margin="12,-3,0,0"
                                              ToolTip="Choose the cabin shown in the live preview" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="Open Manifest"
                                        Command="{Binding OpenManifestCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        MinHeight="30"
                                        Padding="12,4"
                                        Visibility="{Binding IsOperationalCabinLayout, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Background="#332A1020"
                                    BorderBrush="#F0C64E"
                                    BorderThickness="1"
                                    CornerRadius="11"
                                    Padding="7,3"
                                    Margin="0,2,10,2"
                                    HorizontalAlignment="Center"
                                    ToolTip="{Binding BoardingGroupDetail}"
                                    Visibility="{Binding IsOperationalCabinLayout, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <Button Width="72"
                                            Height="30"
                                            Margin="0,0,7,0"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding ToggleSeatbeltSignCommand}"
                                            ToolTip="{Binding SeatbeltControlStatus}">
                                    <Border CornerRadius="5">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#131D2B" />
                                                <Setter Property="BorderBrush" Value="#536375" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SeatbeltSignOn}" Value="True">
                                                        <Setter Property="Background" Value="#6A4510" />
                                                        <Setter Property="BorderBrush" Value="#FFC54D" />
                                                        <Setter Property="Effect">
                                                            <Setter.Value><DropShadowEffect Color="#FFB52B" BlurRadius="9" ShadowDepth="0" Opacity="0.65" /></Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Viewbox Margin="4" Stretch="Uniform">
                                            <Canvas Width="66" Height="22">
                                                <Path Data="F0 M 1,7 L 10,7 L 14,3 L 31,3 L 31,19 L 14,19 L 10,15 L 1,15 Z M 17,7 L 27,7 L 27,15 L 17,15 Z">
                                                    <Path.Style>
                                                        <Style TargetType="Path"><Setter Property="Fill" Value="#687585" /><Style.Triggers><DataTrigger Binding="{Binding SeatbeltSignOn}" Value="True"><Setter Property="Fill" Value="#FFD384" /></DataTrigger></Style.Triggers></Style>
                                                    </Path.Style>
                                                </Path>
                                                <Path Data="F0 M 45,3 L 52,3 L 55,7 L 65,7 L 65,15 L 55,15 L 52,19 L 45,19 L 45,14 L 41,14 L 41,8 L 45,8 Z M 45,9 L 50,9 L 50,13 L 45,13 Z">
                                                    <Path.Style>
                                                        <Style TargetType="Path"><Setter Property="Fill" Value="#687585" /><Style.Triggers><DataTrigger Binding="{Binding SeatbeltSignOn}" Value="True"><Setter Property="Fill" Value="#FFD384" /></DataTrigger></Style.Triggers></Style>
                                                    </Path.Style>
                                                </Path>
                                                <Path Data="M 39,5 L 32,11 L 39,17 L 39,14 L 44,14 L 44,8 L 39,8 Z">
                                                    <Path.Style>
                                                        <Style TargetType="Path"><Setter Property="Fill" Value="#6B4650" /><Style.Triggers><DataTrigger Binding="{Binding SeatbeltSignOn}" Value="True"><Setter Property="Fill" Value="#FF365F" /></DataTrigger></Style.Triggers></Style>
                                                    </Path.Style>
                                                </Path>
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    </Button>
                                    <StackPanel>
                                        <TextBlock Text="{Binding BoardingGroupStatus}" Foreground="#F0C64E" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding BoardingGroupDetail}" Foreground="#C6B56F" FontSize="8" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding SeatbeltControlStatus}" Foreground="#8FC8FF" FontSize="7" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding SeatbeltResponseStatus}" Foreground="#FFB85C" FontSize="7" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <StackPanel Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding IsOperationalCabinLayout, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding ActiveDoorSummary}"
                                           Foreground="#58E68A"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding LiveCabinStatus}"
                                           Foreground="#8FC8FF"
                                           FontSize="8"
                                           TextAlignment="Right"
                                           TextWrapping="Wrap"
                                           ToolTip="{Binding LiveCabinStatus}" />
                                <TextBlock Text="{Binding CrewRestStatus}"
                                           Foreground="#AFA2FF"
                                           FontSize="8"
                                           TextAlignment="Right"
                                           TextWrapping="Wrap"
                                           ToolTip="{Binding CrewRestStatus}" />
                            </StackPanel>
                            </Grid>
                        </Grid>

                        <Viewbox Grid.Row="1" Stretch="Uniform">
                            <Canvas Width="1033" Height="230" ClipToBounds="False">
                                <Border Canvas.Left="0"
                                        Canvas.Top="0"
                                        Width="1033"
                                        Height="192"
                                        Panel.ZIndex="0"
                                        Visibility="{Binding IsFlightFactorCabinLayout, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Border.Background>
                                        <ImageBrush ImageSource="pack://application:,,,/FreeFlight.CabinControl;component/Assets/Ff777CabinLayout.png"
                                                    Viewbox="0,62,1033,192"
                                                    ViewboxUnits="Absolute"
                                                    Stretch="Fill" />
                                    </Border.Background>
                                </Border>

                                <Border Canvas.Left="0"
                                        Canvas.Top="0"
                                        Width="1033"
                                        Height="192"
                                        Panel.ZIndex="0"
                                        Visibility="{Binding IsBritishAirways777200Er, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding SelectedCabinLayoutProfile.LivePreviewUri}"
                                                    Viewbox="{Binding SelectedCabinLayoutProfile.LivePreviewViewbox}"
                                                    ViewboxUnits="Absolute"
                                                    Stretch="{Binding SelectedCabinLayoutProfile.LivePreviewStretch}"
                                                    AlignmentX="Center"
                                                    AlignmentY="Center" />
                                    </Border.Background>
                                </Border>

                                <Border Canvas.Left="0"
                                        Canvas.Top="0"
                                        Width="1033"
                                        Height="192"
                                        Panel.ZIndex="0"
                                        Visibility="{Binding IsBritishAirways777300, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding SelectedCabinLayoutProfile.LivePreviewUri}"
                                                    Viewbox="{Binding SelectedCabinLayoutProfile.LivePreviewViewbox}"
                                                    ViewboxUnits="Absolute"
                                                    Stretch="{Binding SelectedCabinLayoutProfile.LivePreviewStretch}"
                                                    AlignmentX="Center"
                                                    AlignmentY="Center" />
                                    </Border.Background>
                                </Border>

                                <Canvas Canvas.Left="{Binding SelectedSeatCanvasLeft}"
                                        Canvas.Top="{Binding SelectedSeatCanvasTop}"
                                        Width="24"
                                        Height="24"
                                        Panel.ZIndex="4"
                                        IsHitTestVisible="False"
                                        Visibility="{Binding IsSeatHighlightVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Ellipse Width="24" Height="24" Fill="#25101927" Stroke="#FFD54A" StrokeThickness="2.5" />
                                    <Ellipse Canvas.Left="9.5" Canvas.Top="9.5" Width="5" Height="5" Fill="#FFF4B0" />
                                    <Border Background="#E8091628"
                                            BorderBrush="#FFD54A"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="5,2"
                                            Canvas.Left="26"
                                            Canvas.Top="-3">
                                        <TextBlock Text="{Binding SelectedSeatLabel}"
                                                   Foreground="#FFF4B0"
                                                   FontSize="8"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="NoWrap" />
                                    </Border>
                                </Canvas>

                                <ItemsControl Canvas.Left="0"
                                              Canvas.Top="0"
                                              Width="1033"
                                              Height="192"
                                              ItemsSource="{Binding CabinCrewMarkers}"
                                              ItemContainerStyle="{StaticResource PassengerCanvasItemStyle}"
                                              Panel.ZIndex="4"
                                              IsHitTestVisible="True">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Width="12" Height="12" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                    ToolTip="{Binding ToolTip}"
                                                    Command="{Binding DataContext.SelectCrewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                            <Grid Width="12" Height="12">
                                                <Ellipse Width="5" Height="5" Fill="#0B3D78" Stroke="#A9D2FF" StrokeThickness="0.8" HorizontalAlignment="Center" VerticalAlignment="Top" />
                                                <Border Width="8" Height="7" CornerRadius="4,4,3,3" Background="#0B3D78" BorderBrush="#A9D2FF" BorderThickness="0.8" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                                                <Ellipse Width="12" Height="12" Stroke="#FFFFFF" StrokeThickness="1" Fill="Transparent">
                                                    <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsSecured}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                                                </Ellipse>
                                                <Ellipse Width="12" Height="12" Stroke="#B49CFF" StrokeThickness="1.5" Fill="Transparent">
                                                    <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsResting}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                                                </Ellipse>
                                            </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl Canvas.Left="0"
                                              Canvas.Top="0"
                                              Width="1033"
                                              Height="230"
                                              ItemsSource="{Binding PassengerMarkers}"
                                              ItemContainerStyle="{StaticResource PassengerCanvasItemStyle}"
                                              Panel.ZIndex="3">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Width="{Binding MarkerSize}"
                                                    Height="{Binding MarkerSize}"
                                                    Padding="0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    ToolTip="{Binding ToolTip}"
                                                    Command="{Binding DataContext.SelectPassengerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Grid>
                                                            <Ellipse x:Name="PassengerHead" Width="5" Height="5" Fill="{Binding MarkerColor}" Stroke="{Binding MarkerBorderColor}" StrokeThickness="0.7" Opacity="0.9" HorizontalAlignment="Center" VerticalAlignment="Top" />
                                                            <Border x:Name="PassengerBody" Width="8" Height="7" Background="{Binding MarkerColor}" BorderBrush="{Binding MarkerBorderColor}" BorderThickness="0.7" CornerRadius="4,4,3,3" Opacity="0.9" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                                                            <Ellipse x:Name="WalkingRing"
                                                                     Stroke="#FFFFFF"
                                                                     StrokeThickness="1.2"
                                                                     Fill="Transparent"
                                                                     Visibility="Collapsed" />
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="PassengerHead" Property="StrokeThickness" Value="1.5" />
                                                                <Setter TargetName="PassengerBody" Property="BorderThickness" Value="1.5" />
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsWalking}" Value="True">
                                                                <Setter TargetName="PassengerHead" Property="Opacity" Value="1" /><Setter TargetName="PassengerBody" Property="Opacity" Value="1" />
                                                                <Setter TargetName="WalkingRing" Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ToggleButton Canvas.Left="{Binding L1DoorCanvasLeft}"
                                              Canvas.Top="{Binding DoorControlCanvasTop}"
                                              Panel.ZIndex="5"
                                              Content="L1"
                                              IsChecked="{Binding L1DoorOpen}"
                                              Style="{StaticResource DoorToggleStyle}"
                                              ToolTip="Open or close passenger door L1" />
                                <ToggleButton Canvas.Left="{Binding L2DoorCanvasLeft}"
                                              Canvas.Top="{Binding DoorControlCanvasTop}"
                                              Panel.ZIndex="5"
                                              Content="L2"
                                              IsChecked="{Binding L2DoorOpen}"
                                              Style="{StaticResource DoorToggleStyle}"
                                              ToolTip="Open or close passenger door L2" />
                            </Canvas>
                        </Viewbox>

                        <Grid Grid.Row="2">
                            <TextBlock Text="{Binding DoorRoutingSummary}"
                                       Style="{StaticResource MutedTextStyle}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding IsOperationalCabinLayout, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding IsOperationalCabinLayout, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Ellipse Width="8" Height="8" Fill="#2E90FF" Margin="0,0,5,0" /><TextBlock Text="Walking" Style="{StaticResource MutedTextStyle}" Margin="0,0,12,0" />
                                <Ellipse Width="8" Height="8" Fill="#FF9D45" Margin="0,0,5,0" /><TextBlock Text="Occupying seat" Style="{StaticResource MutedTextStyle}" Margin="0,0,12,0" />
                                <Ellipse Width="8" Height="8" Fill="#58E68A" Margin="0,0,5,0" /><TextBlock Text="Secured" Style="{StaticResource MutedTextStyle}" />
                                <Ellipse Width="8" Height="8" Fill="#0B3D78" Stroke="#A9D2FF" Margin="12,0,5,0" /><TextBlock Text="Cabin crew" Style="{StaticResource MutedTextStyle}" />
                                <Ellipse Width="8" Height="8" Fill="#0B3D78" Stroke="#B49CFF" StrokeThickness="1.5" Margin="12,0,5,0" /><TextBlock Text="Crew rest" Style="{StaticResource MutedTextStyle}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="1"
                        Style="{StaticResource CardStyle}"
                        Margin="8,0,0,0"
                        Padding="17,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36" />
                            <RowDefinition Height="78" />
                            <RowDefinition Height="74" />
                            <RowDefinition Height="62" />
                            <RowDefinition Height="56" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Cabin Operation" Style="{StaticResource SectionTitleStyle}" />

                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions><RowDefinition Height="30" /><RowDefinition /></Grid.RowDefinitions>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Booked passengers" Style="{StaticResource MutedTextStyle}" /><TextBlock Text="{Binding PassengerLoadSourceLabel}" Foreground="#55AEFF" FontSize="8" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /></StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding BookedPassengerCount}" FontSize="18" Foreground="#55AEFF" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </Grid>
                            <Slider Grid.Row="1"
                                    Minimum="0"
                                    Maximum="{Binding PassengerInputMaximum}"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    IsEnabled="{Binding CanAdjustPassengerLoad}"
                                    Value="{Binding BookedPassengerCount}" />
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,4,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="50%" Command="{Binding SetLoadPresetCommand}" CommandParameter="50" IsEnabled="{Binding CanAdjustPassengerLoad}" Style="{StaticResource SecondaryButtonStyle}" MinHeight="34" Padding="8,4" Margin="0,0,4,0" />
                            <Button Grid.Column="1" Content="75%" Command="{Binding SetLoadPresetCommand}" CommandParameter="75" IsEnabled="{Binding CanAdjustPassengerLoad}" Style="{StaticResource SecondaryButtonStyle}" MinHeight="34" Padding="8,4" Margin="4,0" />
                            <Button Grid.Column="2" Content="100%" Command="{Binding SetLoadPresetCommand}" CommandParameter="100" IsEnabled="{Binding CanAdjustPassengerLoad}" Style="{StaticResource SecondaryButtonStyle}" MinHeight="34" Padding="8,4" Margin="4,0,0,0" />
                        </Grid>

                        <Grid Grid.Row="3">
                            <Grid.RowDefinitions><RowDefinition Height="24" /><RowDefinition /></Grid.RowDefinitions>
                            <TextBlock Text="Passenger doors" Style="{StaticResource MutedTextStyle}" />
                            <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <StackPanel><ToggleButton Content="L1" IsChecked="{Binding L1DoorOpen}" Style="{StaticResource DoorToggleStyle}" HorizontalAlignment="Left" /><TextBlock Text="{Binding L1PassengerCount, StringFormat={}{0} routed}" Style="{StaticResource MutedTextStyle}" FontSize="9" Margin="2,2,0,0" /></StackPanel>
                                <StackPanel Grid.Column="1"><ToggleButton Content="L2" IsChecked="{Binding L2DoorOpen}" Style="{StaticResource DoorToggleStyle}" HorizontalAlignment="Left" /><TextBlock Text="{Binding L2PassengerCount, StringFormat={}{0} routed}" Style="{StaticResource MutedTextStyle}" FontSize="9" Margin="2,2,0,0" /></StackPanel>
                            </Grid>
                        </Grid>

                        <Grid Grid.Row="4" Margin="0,7,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="74" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <TextBlock Text="Speed" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding SpeedOptions}"
                                      SelectedItem="{Binding SelectedSpeedOption}"
                                      DisplayMemberPath="Label" />
                        </Grid>

                        <Grid Grid.Row="5" VerticalAlignment="Bottom">
                            <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="44" /></Grid.RowDefinitions>
                            <Button Grid.Row="0" Command="{Binding StartPauseCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding PrimaryActionGlyph}" FontFamily="Segoe Fluent Icons" FontSize="15" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding PrimaryActionLabel}" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Row="1" Content="Reset Preview" Command="{Binding ResetCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,8,0,0" MinHeight="36" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="1.35*" /><ColumnDefinition Width="1.6*" /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0" Padding="16,12">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="28" /><RowDefinition /></Grid.RowDefinitions>
                        <TextBlock Text="Cabin Manifest" Style="{StaticResource SectionTitleStyle}" FontSize="16" />
                        <Button Content="View all"
                                Command="{Binding OpenManifestCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Right"
                                MinHeight="26"
                                Padding="10,2" />
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"><TextBlock Text="FIRST" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding FirstClassCount}" FontSize="20" Foreground="#C978ED" /></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Text="BUSINESS" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding BusinessClassCount}" FontSize="20" Foreground="#2E90FF" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="PREM ECON" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding PremiumEconomyClassCount}" FontSize="20" Foreground="#F0C64E" /></StackPanel>
                            <StackPanel Grid.Column="3"><TextBlock Text="ECONOMY" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding EconomyClassCount}" FontSize="20" Foreground="#21CED8" /></StackPanel>
                        </Grid>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0" Padding="16,10">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="26" /><RowDefinition Height="34" /><RowDefinition /></Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="SimBrief OFP" Style="{StaticResource SectionTitleStyle}" FontSize="16" />
                            <CheckBox Content="Auto-sync"
                                      IsChecked="{Binding SimBriefAutoSync}"
                                      HorizontalAlignment="Right"
                                      Foreground="#8DA0B8"
                                      FontSize="11" />
                        </Grid>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition /><ColumnDefinition Width="88" /><ColumnDefinition Width="76" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Pilot ID" Foreground="#8DA0B8" FontSize="10" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding SimBriefPilotId, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Numeric Pilot ID from SimBrief Account Settings"
                                     Padding="9,5" />
                            <Button Grid.Column="2"
                                    Content="Sync OFP"
                                    Command="{Binding SyncSimBriefCommand}"
                                    IsEnabled="{Binding CanEditPassengerLoad}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    MinHeight="30"
                                     Padding="8,4"
                                     Margin="8,0,0,0" />
                            <Button Grid.Column="3"
                                    Content="Unload"
                                    Command="{Binding UnloadFlightCommand}"
                                    IsEnabled="{Binding HasPassengerManifest}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    MinHeight="30"
                                    Padding="8,4"
                                    Margin="8,0,0,0" />
                        </Grid>
                        <StackPanel Grid.Row="2" Margin="0,5,0,0">
                            <TextBlock Text="{Binding SimBriefFlightSummary}" Foreground="#55AEFF" FontSize="11" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding SimBriefStatus}" Foreground="#8DA0B8" FontSize="10" TextWrapping="Wrap" MaxHeight="28" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="8,0,0,0" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="128" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Latest Activity" Style="{StaticResource SectionTitleStyle}" FontSize="16" />
                            <TextBlock Text="{Binding CabinActivitySummary}" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding ActivityLog}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="#B7C4D7" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,1" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>

    <Grid Panel.ZIndex="20">
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsManifestOpen}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Border Background="#B8000712" />
        <Border Width="920" Height="650" Style="{StaticResource OverlayBorderStyle}" Visibility="Visible">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="55" /><RowDefinition Height="34" /><RowDefinition /></Grid.RowDefinitions>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Passenger Manifest" FontSize="25" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ManifestSummary}" Style="{StaticResource MutedTextStyle}" FontSize="11" />
                    </StackPanel>
                    <Button Content="Close"
                            Command="{Binding CloseManifestCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Right"
                            MinHeight="34"
                            Padding="16,5" />
                </Grid>
                <Border Grid.Row="1" Background="#101F33" CornerRadius="5" Padding="10,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="78" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="65" />
                            <ColumnDefinition Width="110" /><ColumnDefinition Width="65" /><ColumnDefinition Width="65" />
                            <ColumnDefinition Width="1.4*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="ID" Style="{StaticResource MetricLabelStyle}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="PASSENGER" Style="{StaticResource MetricLabelStyle}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="SEAT" Style="{StaticResource MetricLabelStyle}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="CABIN" Style="{StaticResource MetricLabelStyle}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="GROUP" Style="{StaticResource MetricLabelStyle}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="5" Text="DOOR" Style="{StaticResource MetricLabelStyle}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="6" Text="STATUS" Style="{StaticResource MetricLabelStyle}" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                    <ItemsControl ItemsSource="{Binding PassengerManifest}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectPassengerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding PassengerId}"
                                        Background="Transparent"
                                        BorderBrush="#263A52"
                                        BorderThickness="0,0,0,1"
                                        Padding="10,8"
                                        HorizontalContentAlignment="Stretch"
                                        Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="78" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="65" />
                                            <ColumnDefinition Width="110" /><ColumnDefinition Width="65" /><ColumnDefinition Width="65" />
                                            <ColumnDefinition Width="1.4*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding PassengerNumber}" Foreground="#8DA0B8" FontSize="11" />
                                        <TextBlock Grid.Column="1" Text="{Binding FullName}" Foreground="#EEF5FF" FontSize="12" />
                                        <TextBlock Grid.Column="2" Text="{Binding SeatNumber}" Foreground="#55AEFF" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="3" Text="{Binding CabinClassName}" Foreground="#B7C4D7" FontSize="11" />
                                        <TextBlock Grid.Column="4" Text="{Binding BoardingGroup}" Foreground="#B7C4D7" />
                                        <TextBlock Grid.Column="5" Text="{Binding DoorLabel}" Foreground="#B7C4D7" />
                                        <TextBlock Grid.Column="6" Text="{Binding StatusLabel}" Foreground="{Binding StatusColor}" FontSize="11" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>

    <Grid Panel.ZIndex="30" IsHitTestVisible="True">
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPassengerDetailsOpen}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Border Background="#65000712" />
        <Border Width="390" Style="{StaticResource OverlayBorderStyle}" Visibility="Visible" HorizontalAlignment="Right" Margin="0,0,34,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Passenger Profile" Foreground="#8DA0B8" FontSize="12" />
                        <TextBlock Text="{Binding SelectedPassenger.FullName}" FontSize="25" FontWeight="SemiBold" Margin="0,4,0,0" />
                    </StackPanel>
                    <Button Content="Close" Command="{Binding ClosePassengerDetailsCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" MinHeight="32" Padding="13,4" />
                </Grid>
                <Border Grid.Row="1" Background="#101F33" BorderBrush="#28415F" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,18,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="SEAT" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding SelectedPassenger.SeatNumber}" FontSize="24" Foreground="#55AEFF" /></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Text="CURRENT STATUS" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding SelectedPassenger.StatusLabel}" Foreground="{Binding SelectedPassenger.StatusColor}" FontSize="14" Margin="0,5,0,0" /></StackPanel>
                    </Grid>
                </Border>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="PASSENGER ID" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding SelectedPassenger.PassengerNumber}" Margin="0,2,0,14" />
                        <TextBlock Text="AGE" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding SelectedPassenger.Age}" Margin="0,2,0,14" />
                        <TextBlock Text="NATIONALITY" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding SelectedPassenger.Nationality}" Margin="0,2,0,14" />
                        <TextBlock Text="TRAVEL PURPOSE" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding SelectedPassenger.TravelPurpose}" Margin="0,2,0,14" />
                        <TextBlock Text="BOARDING GROUP" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding SelectedPassenger.BoardingGroup}" Margin="0,2,0,14" />
                        <TextBlock Text="EMAIL" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding SelectedPassenger.Email}" TextWrapping="Wrap" FontSize="11" Margin="0,2,0,14" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="BOOKING REFERENCE" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding SelectedPassenger.BookingReference}" Margin="0,2,0,14" />
                        <TextBlock Text="CABIN" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding SelectedPassenger.CabinClassName}" Margin="0,2,0,14" />
                        <TextBlock Text="EXECUTIVE CLUB" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding SelectedPassenger.FrequentFlyerTier}" Margin="0,2,0,14" />
                        <TextBlock Text="CHECKED BAGS" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding SelectedPassenger.CheckedBags}" Margin="0,2,0,14" />
                        <TextBlock Text="ASSISTANCE" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding SelectedPassenger.Assistance}" TextWrapping="Wrap" Margin="0,2,0,14" />
                        <TextBlock Text="CURRENT ACTIVITY" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding SelectedPassenger.CurrentActivity}" Foreground="#8FC8FF" TextWrapping="Wrap" Margin="0,2,0,14" />
                        <TextBlock Text="SEAT BELT" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding SelectedPassenger.SeatbeltStatus}" Foreground="{Binding SelectedPassenger.SeatbeltColor}" Margin="0,2,0,14" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
    <Grid Panel.ZIndex="35" IsHitTestVisible="True">
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCrewDetailsOpen}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Border Background="#65000712" />
        <Border Width="390" Style="{StaticResource OverlayBorderStyle}" Visibility="Visible" HorizontalAlignment="Right" Margin="0,0,34,0">
            <StackPanel>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Cabin Crew Profile" Foreground="#8DA0B8" FontSize="12" />
                        <TextBlock Text="{Binding SelectedCrew.FullName}" FontSize="25" FontWeight="SemiBold" Margin="0,4,0,0" />
                    </StackPanel>
                    <Button Content="Close" Command="{Binding CloseCrewDetailsCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" MinHeight="32" Padding="13,4" />
                </Grid>
                <Border Background="#101F33" BorderBrush="#28415F" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,18,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="CREW ID" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding SelectedCrew.CrewId}" FontSize="22" Foreground="#55AEFF" /></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Text="AGE" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding SelectedCrew.Age}" FontSize="22" Foreground="#EEF5FF" /></StackPanel>
                    </Grid>
                </Border>
                <TextBlock Text="ROLE" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding SelectedCrew.Role}" Margin="0,3,0,14" FontSize="15" />
                <TextBlock Text="CURRENT DUTY" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding SelectedCrew.Activity}" Margin="0,3,0,14" Foreground="#8FC8FF" TextWrapping="Wrap" />
                <TextBlock Text="Crew identities are fictional and generated consistently from the passenger seed." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
        </Border>
    </Grid>
    </Grid>
</UserControl>
