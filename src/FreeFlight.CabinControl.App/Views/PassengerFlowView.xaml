<UserControl x:Class="FreeFlight.CabinControl.App.Views.PassengerFlowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="820"
             d:DesignWidth="1200">
    <UserControl.Resources>
        <Style x:Key="PassengerMetricCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="16,12" />
        </Style>

        <Style x:Key="MetricLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
            <Setter Property="FontSize" Value="25" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#55AEFF" />
        </Style>

        <Style x:Key="DoorToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="70" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Foreground" Value="#FFE0BD" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="DoorBorder"
                                Background="#D5251B17"
                                BorderBrush="#FF9D45"
                                BorderThickness="1.5"
                                CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="DoorLamp"
                                         Width="8"
                                         Height="8"
                                         Fill="#FF9D45"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Center" />
                                <ContentPresenter Grid.Column="1"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="DoorBorder" Property="Background" Value="#D5113028" />
                                <Setter TargetName="DoorBorder" Property="BorderBrush" Value="#58E68A" />
                                <Setter TargetName="DoorLamp" Property="Fill" Value="#58E68A" />
                                <Setter Property="Foreground" Value="#D7FFE4" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DoorBorder" Property="Opacity" Value="0.88" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PassengerCanvasItemStyle" TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding CanvasLeft}" />
            <Setter Property="Canvas.Top" Value="{Binding CanvasTop}" />
            <Setter Property="Panel.ZIndex" Value="3" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="94" />
                <RowDefinition Height="14" />
                <RowDefinition Height="420" />
                <RowDefinition Height="14" />
                <RowDefinition Height="118" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#122D4E" BorderBrush="#2D78C5" BorderThickness="1" CornerRadius="12" Padding="11,5" Margin="0,0,18,0">
                        <TextBlock Text="NO SIMULATOR REQUIRED" Foreground="#63B9FF" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                    <Ellipse Width="12" Height="12" Fill="{Binding BoardingStateColor}" Margin="0,0,9,0" />
                    <TextBlock Text="{Binding BoardingStateLabel}" Foreground="{Binding BoardingStateColor}" FontSize="13" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition Width="1.3*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource PassengerMetricCardStyle}" Margin="0,0,7,0">
                    <StackPanel>
                        <TextBlock Text="BOOKED" Style="{StaticResource MetricLabelStyle}" />
                        <TextBlock Text="{Binding BookedPassengerCount}" Style="{StaticResource MetricValueStyle}" />
                        <TextBlock Text="{Binding CabinCapacity, StringFormat=of {0} seats}" Style="{StaticResource MetricLabelStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource PassengerMetricCardStyle}" Margin="7,0">
                    <StackPanel>
                        <TextBlock Text="SEATED" Style="{StaticResource MetricLabelStyle}" />
                        <TextBlock Text="{Binding BoardedPassengerCount}" Style="{StaticResource MetricValueStyle}" Foreground="#58E68A" />
                        <TextBlock Text="Boarding complete" Style="{StaticResource MetricLabelStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource PassengerMetricCardStyle}" Margin="7,0">
                    <StackPanel>
                        <TextBlock Text="IN CABIN" Style="{StaticResource MetricLabelStyle}" />
                        <TextBlock Text="{Binding WalkingPassengerCount}" Style="{StaticResource MetricValueStyle}" Foreground="#F0C64E" />
                        <TextBlock Text="Walking to seats" Style="{StaticResource MetricLabelStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource PassengerMetricCardStyle}" Margin="7,0">
                    <StackPanel>
                        <TextBlock Text="REMAINING" Style="{StaticResource MetricLabelStyle}" />
                        <TextBlock Text="{Binding RemainingPassengerCount}" Style="{StaticResource MetricValueStyle}" />
                        <TextBlock Text="{Binding WaitingPassengerCount, StringFormat={}{0} outside}" Style="{StaticResource MetricLabelStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource PassengerMetricCardStyle}" Margin="7,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="20" /></Grid.RowDefinitions>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="BOARDING PROGRESS" Style="{StaticResource MetricLabelStyle}" />
                                <TextBlock Text="{Binding BoardingProgress, StringFormat={}{0:F0}%}" Style="{StaticResource MetricValueStyle}" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right">
                                <TextBlock Text="PREVIEW ETA" Style="{StaticResource MetricLabelStyle}" HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding BoardingEta}" FontSize="18" Foreground="#F0C64E" HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>
                        <ProgressBar Grid.Row="1" Minimum="0" Maximum="100" Value="{Binding BoardingProgress, Mode=OneWay}" Height="7" Foreground="#2088FF" Background="#1D2B3E" />
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0" Padding="16,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="42" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="42" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Live Cabin" Style="{StaticResource SectionTitleStyle}" />
                                <Border Background="#142A46" BorderBrush="#2B639E" BorderThickness="1" CornerRadius="10" Padding="9,3" Margin="12,1,0,0">
                                    <TextBlock Text="FF777 PREVIEW LAYOUT" Foreground="#63B9FF" FontSize="10" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding ActiveDoorSummary}" Foreground="#58E68A" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <Viewbox Grid.Row="1" Stretch="Uniform">
                            <Canvas Width="1033" Height="230" ClipToBounds="False">
                                <Border Canvas.Left="0" Canvas.Top="0" Width="1033" Height="192" Panel.ZIndex="0">
                                    <Border.Background>
                                        <ImageBrush ImageSource="pack://application:,,,/FreeFlight.CabinControl;component/Assets/Ff777CabinLayout.png"
                                                    Viewbox="0,62,1033,192"
                                                    ViewboxUnits="Absolute"
                                                    Stretch="Fill" />
                                    </Border.Background>
                                </Border>

                                <ItemsControl Canvas.Left="0"
                                              Canvas.Top="0"
                                              Width="1033"
                                              Height="230"
                                              ItemsSource="{Binding PassengerMarkers}"
                                              ItemContainerStyle="{StaticResource PassengerCanvasItemStyle}"
                                              Panel.ZIndex="3">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Width="{Binding MarkerSize}"
                                                  Height="{Binding MarkerSize}"
                                                  ToolTip="{Binding ToolTip}">
                                                <Ellipse x:Name="PassengerDot"
                                                         Fill="#33B8E8"
                                                         Stroke="#D9F6FF"
                                                         StrokeThickness="0.8"
                                                         Opacity="0.76" />
                                                <Ellipse x:Name="WalkingRing"
                                                         Stroke="#FFFFFF"
                                                         StrokeThickness="1.2"
                                                         Fill="Transparent"
                                                         Visibility="Collapsed" />
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding CabinClassName}" Value="First">
                                                    <Setter TargetName="PassengerDot" Property="Fill" Value="#C978ED" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CabinClassName}" Value="Business">
                                                    <Setter TargetName="PassengerDot" Property="Fill" Value="#2E90FF" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CabinClassName}" Value="Economy">
                                                    <Setter TargetName="PassengerDot" Property="Fill" Value="#21CED8" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsWalking}" Value="True">
                                                    <Setter TargetName="PassengerDot" Property="Opacity" Value="1" />
                                                    <Setter TargetName="WalkingRing" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ToggleButton Canvas.Left="148"
                                              Canvas.Top="192"
                                              Panel.ZIndex="5"
                                              Content="L1"
                                              IsChecked="{Binding L1DoorOpen}"
                                              Style="{StaticResource DoorToggleStyle}"
                                              ToolTip="Open or close passenger door L1" />
                                <ToggleButton Canvas.Left="391"
                                              Canvas.Top="192"
                                              Panel.ZIndex="5"
                                              Content="L2"
                                              IsChecked="{Binding L2DoorOpen}"
                                              Style="{StaticResource DoorToggleStyle}"
                                              ToolTip="Open or close passenger door L2" />
                            </Canvas>
                        </Viewbox>

                        <Grid Grid.Row="2">
                            <TextBlock Text="{Binding DoorRoutingSummary}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="#C978ED" Margin="0,0,5,0" /><TextBlock Text="First" Style="{StaticResource MutedTextStyle}" Margin="0,0,12,0" />
                                <Ellipse Width="8" Height="8" Fill="#2E90FF" Margin="0,0,5,0" /><TextBlock Text="Business" Style="{StaticResource MutedTextStyle}" Margin="0,0,12,0" />
                                <Ellipse Width="8" Height="8" Fill="#21CED8" Margin="0,0,5,0" /><TextBlock Text="Economy" Style="{StaticResource MutedTextStyle}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,0" Padding="17,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36" />
                            <RowDefinition Height="78" />
                            <RowDefinition Height="62" />
                            <RowDefinition Height="62" />
                            <RowDefinition Height="56" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Boarding Setup" Style="{StaticResource SectionTitleStyle}" />

                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions><RowDefinition Height="30" /><RowDefinition /></Grid.RowDefinitions>
                            <TextBlock Text="Booked passengers" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding BookedPassengerCount}" HorizontalAlignment="Right" FontSize="18" Foreground="#55AEFF" />
                            <Slider Grid.Row="1"
                                    Minimum="1"
                                    Maximum="{Binding CabinCapacity}"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    IsEnabled="{Binding CanEditPassengerLoad}"
                                    Value="{Binding BookedPassengerCount}" />
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,4,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="50%" Command="{Binding SetLoadPresetCommand}" CommandParameter="50" IsEnabled="{Binding CanEditPassengerLoad}" Style="{StaticResource SecondaryButtonStyle}" MinHeight="34" Padding="8,4" Margin="0,0,4,0" />
                            <Button Grid.Column="1" Content="75%" Command="{Binding SetLoadPresetCommand}" CommandParameter="75" IsEnabled="{Binding CanEditPassengerLoad}" Style="{StaticResource SecondaryButtonStyle}" MinHeight="34" Padding="8,4" Margin="4,0" />
                            <Button Grid.Column="2" Content="100%" Command="{Binding SetLoadPresetCommand}" CommandParameter="100" IsEnabled="{Binding CanEditPassengerLoad}" Style="{StaticResource SecondaryButtonStyle}" MinHeight="34" Padding="8,4" Margin="4,0,0,0" />
                        </Grid>

                        <Grid Grid.Row="3">
                            <Grid.RowDefinitions><RowDefinition Height="24" /><RowDefinition /></Grid.RowDefinitions>
                            <TextBlock Text="Passenger doors" Style="{StaticResource MutedTextStyle}" />
                            <StackPanel Grid.Row="1" Orientation="Horizontal">
                                <ToggleButton Content="L1" IsChecked="{Binding L1DoorOpen}" Style="{StaticResource DoorToggleStyle}" Margin="0,0,8,0" />
                                <ToggleButton Content="L2" IsChecked="{Binding L2DoorOpen}" Style="{StaticResource DoorToggleStyle}" />
                                <TextBlock Text="{Binding L1PassengerCount, StringFormat=L1 {0}}" Style="{StaticResource MutedTextStyle}" Margin="14,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding L2PassengerCount, StringFormat=L2 {0}}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="4" Margin="0,7,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="74" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <TextBlock Text="Speed" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding SpeedOptions}"
                                      SelectedItem="{Binding SelectedSpeedOption}"
                                      DisplayMemberPath="Label" />
                        </Grid>

                        <Grid Grid.Row="5" VerticalAlignment="Bottom">
                            <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="44" /></Grid.RowDefinitions>
                            <Button Grid.Row="0" Command="{Binding StartPauseCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding PrimaryActionGlyph}" FontFamily="Segoe Fluent Icons" FontSize="15" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding PrimaryActionLabel}" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Row="1" Content="Reset Preview" Command="{Binding ResetCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,8,0,0" MinHeight="36" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="1.85*" /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0" Padding="16,12">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="28" /><RowDefinition /></Grid.RowDefinitions>
                        <TextBlock Text="Cabin Manifest" Style="{StaticResource SectionTitleStyle}" FontSize="16" />
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"><TextBlock Text="FIRST" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding FirstClassCount}" FontSize="20" Foreground="#C978ED" /></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Text="BUSINESS" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding BusinessClassCount}" FontSize="20" Foreground="#2E90FF" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="ECONOMY" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding EconomyClassCount}" FontSize="20" Foreground="#21CED8" /></StackPanel>
                        </Grid>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,0" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Latest Activity" Style="{StaticResource SectionTitleStyle}" FontSize="16" />
                            <TextBlock Text="Local preview events" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0" />
                        </StackPanel>
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding ActivityLog}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="#B7C4D7" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,1" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
