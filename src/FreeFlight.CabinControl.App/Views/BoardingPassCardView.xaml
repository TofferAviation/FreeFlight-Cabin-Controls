<UserControl x:Class="FreeFlight.CabinControl.App.Views.BoardingPassCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="560" MinHeight="260">
    <Border Background="#F5F7FA" CornerRadius="13" BorderBrush="#D7DEE8" BorderThickness="1" Padding="22,17">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="1" /><ColumnDefinition Width="132" /></Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="0,0,18,0">
                <Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="50" /><RowDefinition Height="*" /><RowDefinition Height="52" /></Grid.RowDefinitions>
                <Grid>
                    <StackPanel Orientation="Horizontal"><TextBlock Text="BRITISH AIRWAYS" Foreground="#123B79" FontWeight="Bold" FontSize="17" /><Path Data="M0,8 C18,0 35,0 54,5 C43,8 35,13 27,22 C29,15 22,10 0,8Z" Fill="#D7192D" Width="55" Height="25" Stretch="Fill" Margin="10,-2,0,0" /></StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="{Binding SelectedPassenger.CabinMarketingName}" Foreground="#111827" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" /><Border Width="31" Height="31" CornerRadius="16" Background="#173C86" Margin="11,0,0,0"><TextBlock Text="one&#x0a;world" Foreground="White" FontSize="7" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></StackPanel>
                </Grid>
                <StackPanel Grid.Row="1"><TextBlock Text="NAME OF PASSENGER" Foreground="#5B6575" FontSize="8" /><TextBlock Text="{Binding SelectedPassenger.FullNameUpper}" Foreground="#111827" FontSize="18" FontWeight="Bold" /></StackPanel>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*" /><ColumnDefinition Width="0.7*" /><ColumnDefinition Width="0.6*" /><ColumnDefinition Width="0.55*" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="FLIGHT" Foreground="#5B6575" FontSize="8" /><TextBlock Text="{Binding FlightNumber}" Foreground="#111827" FontWeight="SemiBold" /><StackPanel Orientation="Horizontal" Margin="0,15,0,0"><TextBlock Text="{Binding OriginIata}" Foreground="#111827" FontSize="26" FontWeight="SemiBold" /><TextBlock Text="→" Foreground="#111827" FontSize="20" Margin="15,3" /><TextBlock Text="{Binding DestinationIata}" Foreground="#111827" FontSize="26" FontWeight="SemiBold" /></StackPanel><TextBlock Text="{Binding RouteSummary}" Foreground="#5B6575" FontSize="7" TextTrimming="CharacterEllipsis" /></StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0"><TextBlock Text="GATE" Foreground="#5B6575" FontSize="8" /><TextBlock Text="{Binding GateNumber}" Foreground="#111827" FontSize="25" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel>
                    <StackPanel Grid.Column="2" Margin="8,0"><TextBlock Text="SEAT" Foreground="#5B6575" FontSize="8" /><TextBlock Text="{Binding SelectedPassenger.SeatNumber}" Foreground="#111827" FontSize="25" FontWeight="SemiBold" Margin="0,4,0,0" /><TextBlock Text="BOARDING" Foreground="#5B6575" FontSize="8" Margin="0,15,0,0" /><TextBlock Text="{Binding BoardingBeginsAt}" Foreground="#111827" FontSize="17" FontWeight="SemiBold" /></StackPanel>
                    <StackPanel Grid.Column="3" Margin="8,0"><TextBlock Text="GROUP" Foreground="#5B6575" FontSize="8" /><TextBlock Text="{Binding SelectedPassenger.BoardingGroup}" Foreground="#111827" FontSize="25" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel>
                </Grid>
                <Grid Grid.Row="3" Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="DATE" Foreground="#5B6575" FontSize="8" /><TextBlock Text="24 MAY 2024" Foreground="#111827" FontWeight="SemiBold" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="DEPARTS" Foreground="#5B6575" FontSize="8" /><TextBlock Text="{Binding ScheduledDeparture}" Foreground="#111827" FontWeight="SemiBold" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="CLASS" Foreground="#5B6575" FontSize="8" /><TextBlock Text="{Binding SelectedPassenger.CabinMarketingName}" Foreground="#111827" FontWeight="SemiBold" FontSize="10" /></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="SEQ" Foreground="#5B6575" FontSize="8" /><TextBlock Text="{Binding SelectedPassenger.SequenceNumber}" Foreground="#111827" FontWeight="SemiBold" /></StackPanel></Grid>
            </Grid>
            <Rectangle Grid.Column="1" Fill="#80909EAF" StrokeDashArray="5,4" />
            <StackPanel Grid.Column="2" Margin="17,0,0,0" HorizontalAlignment="Center">
                <TextBlock Text="{Binding FlightNumber}" Foreground="#111827" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" />
                <TextBlock Text="BOARDING PASS" Foreground="#5B6575" FontSize="8" HorizontalAlignment="Center" Margin="0,2,0,8" />
                <ItemsControl ItemsSource="{Binding SelectedPassenger.QrCells}" Width="100" Height="100">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="21" Columns="21" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate><Border><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="White" /><Style.Triggers><DataTrigger Binding="{Binding IsDark}" Value="True"><Setter Property="Background" Value="#111111" /></DataTrigger></Style.Triggers></Style></Border.Style></Border></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding SelectedPassenger.BookingReference}" Foreground="#111827" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" Margin="0,9,0,0" />
                <TextBlock Text="{Binding SelectedPassenger.TicketNumber, StringFormat=ETKT {0}}" Foreground="#5B6575" FontSize="8" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding SelectedPassenger.ClubMembershipLabel}" Foreground="#173C86" FontSize="8" TextAlignment="Center" TextWrapping="Wrap" Margin="0,7,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
