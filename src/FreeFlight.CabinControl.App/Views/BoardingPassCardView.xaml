<UserControl x:Class="FreeFlight.CabinControl.App.Views.BoardingPassCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="620"
             MinHeight="250"
             FontFamily="Consolas, Courier New">
    <UserControl.Resources>
        <Style x:Key="TicketLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#696760" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>
        <Style x:Key="TicketValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#24231F" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>
        <Style x:Key="LargeTicketValue" TargetType="TextBlock" BasedOn="{StaticResource TicketValue}">
            <Setter Property="FontSize" Value="28" />
        </Style>
    </UserControl.Resources>

    <Border Background="#F1EEE4"
            BorderBrush="#B8B4AA"
            BorderThickness="1"
            CornerRadius="7"
            ClipToBounds="True">
        <Grid>
            <Rectangle Fill="#18FFFFFF" />
            <Grid Margin="18,13">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3.6*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="1.28*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,16,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="72" />
                        <RowDefinition Height="45" />
                        <RowDefinition Height="93" />
                        <RowDefinition Height="34" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding SelectedPassenger.BoardingBarcodeCells}"
                                          Width="175"
                                          Height="45"
                                          HorizontalAlignment="Left">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="9" Columns="58" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDark}" Value="True">
                                                            <Setter Property="Background" Value="#272620" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding SelectedPassenger.TicketNumber}"
                                       Style="{StaticResource TicketLabel}"
                                       Margin="3,3,0,0" />
                        </StackPanel>

                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="135" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="BRITISH AIRWAYS"
                                               Foreground="#272620"
                                               FontFamily="Georgia"
                                               FontWeight="Bold"
                                               FontSize="14" />
                                    <Path Data="M0,8 C18,0 35,0 54,5 C43,8 35,13 27,22 C29,15 22,10 0,8Z"
                                          Fill="#272620"
                                          Width="38"
                                          Height="18"
                                          Stretch="Fill"
                                          Margin="8,-1,0,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding SelectedPassenger.CabinMarketingName, Mode=OneWay}"
                                           Style="{StaticResource TicketLabel}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="PASSENGER" Style="{StaticResource TicketLabel}" />
                                <TextBlock Text="{Binding SelectedPassenger.FullNameUpper}"
                                           Style="{StaticResource TicketValue}"
                                           FontSize="15"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding FlightDateShort}"
                                           Style="{StaticResource TicketLabel}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="125" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.ColumnSpan="3" Height="1" Fill="#9A968B" VerticalAlignment="Top" />
                        <Rectangle Grid.ColumnSpan="3" Height="1" Fill="#9A968B" VerticalAlignment="Bottom" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="FLIGHT" Style="{StaticResource TicketLabel}" />
                            <TextBlock Text="{Binding FlightNumber}" Style="{StaticResource TicketValue}" FontSize="18" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="DATE" Style="{StaticResource TicketLabel}" />
                            <TextBlock Text="{Binding FlightDateShort}" Style="{StaticResource TicketValue}" FontSize="15" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="FROM / TO" Style="{StaticResource TicketLabel}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding OriginIata}" Style="{StaticResource TicketValue}" FontSize="20" />
                                <TextBlock Text="  &gt;  " Style="{StaticResource TicketValue}" FontSize="17" />
                                <TextBlock Text="{Binding DestinationIata}" Style="{StaticResource TicketValue}" FontSize="20" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.85*" />
                            <ColumnDefinition Width="1.05*" />
                            <ColumnDefinition Width="1.05*" />
                            <ColumnDefinition Width="0.95*" />
                            <ColumnDefinition Width="0.95*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,10,9,5">
                            <TextBlock Text="GATE" Style="{StaticResource TicketLabel}" />
                            <TextBlock Text="{Binding GateNumber}" Style="{StaticResource LargeTicketValue}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="9,10,9,5">
                            <TextBlock Text="BOARD AT" Style="{StaticResource TicketLabel}" />
                            <TextBlock Text="{Binding BoardingBeginsAt}" Style="{StaticResource LargeTicketValue}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="9,10,9,5">
                            <TextBlock Text="GATE CLOSE" Style="{StaticResource TicketLabel}" />
                            <TextBlock Text="{Binding GateClosesAt}" Style="{StaticResource LargeTicketValue}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="9,10,9,5">
                            <TextBlock Text="SEAT" Style="{StaticResource TicketLabel}" />
                            <TextBlock Text="{Binding SelectedPassenger.SeatNumber}" Style="{StaticResource LargeTicketValue}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4" Margin="9,10,0,5">
                            <TextBlock Text="GROUP" Style="{StaticResource TicketLabel}" />
                            <TextBlock Text="{Binding SelectedPassenger.BoardingGroup, StringFormat=GROUP {0}}"
                                       Style="{StaticResource TicketValue}"
                                       FontSize="18"
                                       Margin="0,7,0,0" />
                        </StackPanel>
                        <Rectangle Grid.Column="1" Width="1" Fill="#9A968B" HorizontalAlignment="Left" Margin="0,8" />
                        <Rectangle Grid.Column="2" Width="1" Fill="#9A968B" HorizontalAlignment="Left" Margin="0,8" />
                        <Rectangle Grid.Column="3" Width="1" Fill="#9A968B" HorizontalAlignment="Left" Margin="0,8" />
                        <Rectangle Grid.Column="4" Width="1" Fill="#9A968B" HorizontalAlignment="Left" Margin="0,8" />
                    </Grid>

                    <Grid Grid.Row="3">
                        <Rectangle Height="1" Fill="#9A968B" VerticalAlignment="Top" />
                        <Rectangle Height="1" Fill="#9A968B" VerticalAlignment="Bottom" />
                        <TextBlock Text="{Binding SelectedPassenger.CabinMarketingName}"
                                   Style="{StaticResource TicketValue}"
                                   FontSize="17"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SelectedPassenger.CheckedBags, StringFormat='BAGS  {0}/0'}"
                                   Style="{StaticResource TicketValue}"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SelectedPassenger.ClubMembershipLabel}"
                                   Style="{StaticResource TicketLabel}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Grid Grid.Row="4" Margin="0,6,0,0">
                        <TextBlock Text="{Binding SelectedPassenger.BookingReference, StringFormat=BOOKING  {0}}"
                                   Style="{StaticResource TicketLabel}" />
                        <TextBlock Text="{Binding SelectedPassenger.SequenceNumber, StringFormat=SEQ  {0}}"
                                   Style="{StaticResource TicketLabel}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding SelectedPassenger.TicketNumber, StringFormat=ETKT  {0}}"
                                   Style="{StaticResource TicketLabel}"
                                   HorizontalAlignment="Right" />
                    </Grid>
                </Grid>

                <Rectangle Grid.Column="1" Fill="#8D8980" StrokeDashArray="5,4" />

                <Grid Grid.Column="2" Margin="15,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48" />
                        <RowDefinition Height="54" />
                        <RowDefinition Height="42" />
                        <RowDefinition Height="70" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{Binding FlightNumber}" Style="{StaticResource TicketValue}" FontSize="18" />
                            <TextBlock Text="{Binding FlightDateShort}" Style="{StaticResource TicketLabel}" />
                        </StackPanel>
                        <Border Width="28" Height="28" CornerRadius="14" Background="#272620" HorizontalAlignment="Right">
                            <TextBlock Text="one&#x0a;world"
                                       Foreground="#F1EEE4"
                                       FontFamily="Segoe UI"
                                       FontSize="6"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <StackPanel Grid.Row="1">
                        <Border Height="1" Background="#9A968B" Margin="0,0,0,5" />
                        <TextBlock Text="{Binding SelectedPassenger.FullNameUpper}"
                                   Style="{StaticResource TicketValue}"
                                   FontSize="13"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{StaticResource TicketLabel}">
                            <Run Text="{Binding OriginIata, Mode=OneWay}" /><Run Text=" &gt; " /><Run Text="{Binding DestinationIata, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <Grid Grid.Row="2">
                        <Rectangle Height="1" Fill="#9A968B" VerticalAlignment="Top" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="SEAT" Style="{StaticResource TicketLabel}" />
                            <TextBlock Text="{Binding SelectedPassenger.SeatNumber}" Style="{StaticResource TicketValue}" FontSize="22" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="DEPARTS" Style="{StaticResource TicketLabel}" />
                            <TextBlock Text="{Binding ScheduledDeparture}" Style="{StaticResource TicketValue}" FontSize="18" />
                        </StackPanel>
                    </Grid>
                    <ItemsControl Grid.Row="3"
                                  ItemsSource="{Binding SelectedPassenger.BoardingBarcodeCells}"
                                  Height="49"
                                  Margin="0,10,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="9" Columns="58" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDark}" Value="True">
                                                    <Setter Property="Background" Value="#272620" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Grid.Row="4" Margin="0,3,0,0">
                        <TextBlock Text="{Binding SelectedPassenger.SequenceNumber, StringFormat=SEQ {0}}"
                                   Style="{StaticResource TicketLabel}" />
                        <TextBlock Text="{Binding SelectedPassenger.BookingReference}"
                                   Style="{StaticResource TicketLabel}"
                                   HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding SelectedPassenger.TicketNumber}"
                                   Style="{StaticResource TicketLabel}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Bottom" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
