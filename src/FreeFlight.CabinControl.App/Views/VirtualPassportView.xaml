<UserControl x:Class="FreeFlight.CabinControl.App.Views.VirtualPassportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="PassportCard" TargetType="Border">
            <Setter Property="Background" Value="#F4EFE4" />
            <Setter Property="BorderBrush" Value="#D7C8AF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,8,14">
            <Border Background="#112A4D73" BorderBrush="#395D84" BorderThickness="1" CornerRadius="18" Padding="28,23" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="EMBER · PILOT KEEPSAKE" Foreground="#8EC8E4" FontSize="10" FontWeight="SemiBold" />
                        <TextBlock Text="Virtual Passport" Foreground="White" FontSize="31" FontWeight="SemiBold" Margin="0,5,0,0" />
                        <TextBlock Text="Each arrival is created from a confirmed ACARS PIREP and dated in the destination airport's local time." Foreground="#C5D7E5" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="SIMULATION RECORD · NOT VALID FOR TRAVEL OR IDENTIFICATION" Foreground="#80A8C2" FontSize="9" FontWeight="SemiBold" Margin="0,15,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="26,0,0,0">
                        <Border Background="#1E50718A" BorderBrush="#4F86A5" BorderThickness="1" CornerRadius="12" Padding="16,10" Margin="0,0,10,0">
                            <StackPanel><TextBlock Text="{Binding Entries.Count}" Foreground="White" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center" /><TextBlock Text="ARRIVALS" Foreground="#B9D5E6" FontSize="8" FontWeight="SemiBold" /></StackPanel>
                        </Border>
                        <Border Background="#1E50718A" BorderBrush="#4F86A5" BorderThickness="1" CornerRadius="12" Padding="16,10">
                            <StackPanel><TextBlock Text="{Binding CountryCount}" Foreground="White" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center" /><TextBlock Text="COUNTRIES" Foreground="#B9D5E6" FontSize="8" FontWeight="SemiBold" /></StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="{Binding StatusMessage}" Foreground="#7896AA" FontSize="10" Margin="4,0,4,14" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding Entries}" Visibility="{Binding HasEntries, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource PassportCard}" Background="{Binding CardBackground}" Width="318" Margin="0,0,15,15" Padding="20" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><RotateTransform Angle="{Binding RotationDegrees}" /></Border.RenderTransform>
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid>
                                    <TextBlock Text="VIRTUAL ARRIVAL" Foreground="#756A59" FontSize="9" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding AirportCode}" Foreground="#2D2922" FontSize="24" FontWeight="Bold" HorizontalAlignment="Right" />
                                </Grid>
                                <Border Grid.Row="1" BorderBrush="{Binding StampTone}" BorderThickness="3" CornerRadius="76" Width="148" Height="148" Margin="0,13" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="{Binding InkOpacity}">
                                    <Grid>
                                        <Ellipse Stroke="{Binding StampTone}" StrokeThickness="1" Margin="8" />
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="ARRIVED" Foreground="{Binding StampTone}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding ArrivalDate}" Foreground="{Binding StampTone}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding ArrivalTime}" Foreground="{Binding StampTone}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            <TextBlock Text="EMBER SIM" Foreground="{Binding StampTone}" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <Canvas IsHitTestVisible="False" ClipToBounds="True" Opacity="{Binding WearOpacity}">
                                            <Ellipse Fill="#F4EFE4" Width="34" Height="9" Canvas.Left="-5" Canvas.Top="42" />
                                            <Ellipse Fill="#F4EFE4" Width="18" Height="7" Canvas.Left="98" Canvas.Top="22" />
                                            <Ellipse Fill="#F4EFE4" Width="43" Height="8" Canvas.Left="81" Canvas.Top="111" />
                                            <Rectangle Fill="#F4EFE4" Width="25" Height="5" Canvas.Left="17" Canvas.Top="125" />
                                        </Canvas>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Row="2">
                                    <TextBlock Text="{Binding LocationLabel}" Foreground="#2D2922" FontSize="15" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding AirportName}" Foreground="#756A59" FontSize="10" TextAlignment="Center" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding FlightNumber}" Foreground="#756A59" FontSize="9" FontWeight="SemiBold" TextAlignment="Center" Margin="0,8,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Background="#142A4150" BorderBrush="#365A71" BorderThickness="1" CornerRadius="16" Padding="30" MinHeight="170" Visibility="{Binding HasEntries, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Your first virtual arrival is waiting" Foreground="White" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="Complete an ACARS flight in Ember. Once BAV confirms its PIREP, your arrival will be recorded here with the destination-local date." Foreground="#AEC3D2" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" Width="390" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
