<UserControl x:Class="FreeFlight.CabinControl.App.Views.FlightLoggerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#020817">
    <Grid>
        <Border Background="#050D18"
                BorderBrush="#263A52"
                BorderThickness="1"
                CornerRadius="16"
                ClipToBounds="True"
                Cursor="Hand"
                MouseLeftButtonUp="Promo_OnMouseLeftButtonUp"
                ToolTip="Open FlightLogger in your default browser">
            <Image Source="pack://application:,,,/FreeFlight.CabinControl;component/Assets/FlightLoggerPromo.jpg"
                   Stretch="Uniform"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   SnapsToDevicePixels="True"
                   RenderOptions.BitmapScalingMode="HighQuality" />
        </Border>

        <Border HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,26,24"
                Padding="10"
                Background="#D9071426"
                BorderBrush="#36516F"
                BorderThickness="1"
                CornerRadius="12">
            <Button Content="Open FlightLogger  ↗"
                    Click="OpenFlightLogger_Click"
                    Style="{StaticResource PrimaryButtonStyle}"
                    MinWidth="180"
                    Height="40"
                    Padding="14,5" />
        </Border>
    </Grid>
</UserControl>
