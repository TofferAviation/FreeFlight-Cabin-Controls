<UserControl x:Class="FreeFlight.CabinControl.App.Views.FlightLoggerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="786"
             d:DesignWidth="1239">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>
            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="#132B4D"
                    BorderBrush="#2E8FFF"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="14,7">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE774;"
                               FontFamily="Segoe Fluent Icons"
                               Foreground="#55B8FF"
                               FontSize="15"
                               VerticalAlignment="Center" />
                    <TextBlock Text="COMMUNITY SPOTLIGHT"
                               Margin="8,0,0,0"
                               Foreground="#A8D9FF"
                               FontSize="11"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Style="{StaticResource CardStyle}"
                Padding="0"
                Background="#020915"
                BorderBrush="#244C78"
                ClipToBounds="True">
            <Grid>
                <Image Tag="FlightLoggerPromo"
                       Source="pack://application:,,,/FreeFlight.CabinControl;component/Assets/FlightLoggerPromo.png"
                       Stretch="Uniform"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       SnapsToDevicePixels="True" />
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.7*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1*" MinWidth="310" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="18,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="19" Background="#113A67" VerticalAlignment="Top">
                        <TextBlock Text="&#xE81E;"
                                   FontFamily="Segoe Fluent Icons"
                                   Foreground="#42B8FF"
                                   FontSize="19"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Your real flights, one personal logbook" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Use FlightLogger to record real-life flying, review journeys and keep your aviation history available across devices."
                                   Margin="0,5,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   LineHeight="19" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="18,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Opens in your browser" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1"
                               Text="FreeFlight does not send simulator, passenger or flight-session data to FlightLogger."
                               Margin="0,5,0,10"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12"
                               TextWrapping="Wrap" />
                    <Grid Grid.Row="2" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding WebsiteLabel}"
                                   VerticalAlignment="Center"
                                   Foreground="#78C8FF"
                                   FontSize="12" />
                        <Button Content="Open FlightLogger"
                                Command="{Binding OpenFlightLoggerCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Right"
                                MinWidth="190"
                                Height="42"
                                Padding="17,6"
                                ToolTip="Open https://flightlogger.app/ in your default browser" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
