<UserControl x:Class="FreeFlight.CabinControl.App.Views.FlightLoggerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="PERSONAL AVIATION" Foreground="{DynamicResource PrimaryBrush}" FontSize="10" FontWeight="SemiBold" /><TextBlock Text="FlightLogger" Style="{StaticResource PageTitleStyle}" Margin="0,4,0,0" /><TextBlock Text="Keep your real-world flying separate from your Ember ACARS and BAV pilot records." Style="{StaticResource PageSubtitleStyle}" /></StackPanel>
        <Grid Grid.Row="1" Margin="0,24,0,0" VerticalAlignment="Top"><Grid.ColumnDefinitions><ColumnDefinition Width="1.22*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions><Border Style="{StaticResource HeroPanelStyle}" Padding="30" Margin="0,0,12,0"><StackPanel><TextBlock Text="A separate logbook for real flying" Foreground="White" FontSize="29" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="FlightLogger is an optional external service for keeping a personal record of real-world journeys. It is not connected to your BAV flight plan, Ember telemetry, passenger list or account session." Foreground="#DDF3FF" FontSize="14" TextWrapping="Wrap" LineHeight="21" Margin="0,14,0,0" /><Border Background="#2600162B" BorderBrush="#48FFFFFF" BorderThickness="1" CornerRadius="12" Padding="13" Margin="0,24,0,0"><TextBlock Text="Your BAV career and ACARS data remain inside British Airways Virtual." Foreground="White" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" /></Border></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="28"><StackPanel VerticalAlignment="Center"><Border Width="54" Height="54" CornerRadius="27" Background="{DynamicResource InfoSurfaceBrush}" BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="1"><TextBlock Text="&#xE774;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource PrimaryBrush}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="Open FlightLogger" Style="{StaticResource SectionTitleStyle}" FontSize="22" Margin="0,18,0,0" /><TextBlock Text="FlightLogger opens securely in your default browser. Ember sends no data to it." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" LineHeight="19" Margin="0,7,0,0" /><TextBlock Text="{Binding WebsiteLabel}" Foreground="{DynamicResource PrimaryBrush}" FontSize="12" Margin="0,20,0,0" /><Button Content="Open FlightLogger" Command="{Binding OpenFlightLoggerCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,12,0,0" /></StackPanel></Border></Grid>
    </Grid>
</UserControl>
