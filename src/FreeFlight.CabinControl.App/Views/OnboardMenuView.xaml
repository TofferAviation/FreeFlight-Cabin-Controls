<UserControl x:Class="FreeFlight.CabinControl.App.Views.OnboardMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="OnboardRouteButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="47" />
            <Setter Property="Foreground" Value="#E9F2FF" />
            <Setter Property="Background" Value="#071426" />
            <Setter Property="BorderBrush" Value="#29445F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#4D9BEA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OnboardProductCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#041529" />
            <Setter Property="BorderBrush" Value="#29445F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Hidden"
                  HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalOnly"
                  Margin="0,-13,0,0">
        <Grid MinWidth="960" Margin="0,0,0,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="102" />
                <RowDefinition Height="62" />
                <RowDefinition Height="624" />
                <RowDefinition Height="116" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" ClipToBounds="True">
                <Border.Background>
                    <ImageBrush ImageSource="pack://application:,,,/FreeFlight.CabinControl;component/Assets/Catering/HighLifeCafeMenuAtlas.png"
                                Viewbox="0.1680,0.0801,0.8314,0.1065"
                                ViewboxUnits="RelativeToBoundingBox"
                                Stretch="Fill" />
                </Border.Background>
            </Border>

            <Grid Grid.Row="1" Margin="0,10,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="304" />
                    <ColumnDefinition Width="304" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Margin="0,0,6,0" Command="{Binding SelectOnboardMenuRouteCommand}" CommandParameter="ShortHaul">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource OnboardRouteButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOnboardShortHaulMenuSelected}" Value="True">
                                    <Setter Property="Background" Value="#0878F9" />
                                    <Setter Property="BorderBrush" Value="#248DFF" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✈" FontSize="21" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Text="Flight A – Short &amp; Medium Haul (Europe)" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="1" Margin="6,0,0,0" Command="{Binding SelectOnboardMenuRouteCommand}" CommandParameter="LongHaul">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource OnboardRouteButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOnboardLongHaulMenuSelected}" Value="True">
                                    <Setter Property="Background" Value="#0878F9" />
                                    <Setter Property="BorderBrush" Value="#248DFF" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✈" FontSize="21" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Text="Flight B – Long Haul (Intercontinental)" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <TextBlock Grid.Column="2"
                           Text="{Binding TotalPassengerSpend, StringFormat=Cabin sales so far: {0}}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="#3AFF83"
                           FontSize="12" />
            </Grid>

            <ItemsControl Grid.Row="2" ItemsSource="{Binding OnboardMenuCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="2" Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource OnboardProductCardStyle}" Margin="5,5,7,9">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="187" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border ClipToBounds="True">
                                    <Border.Background>
                                        <ImageBrush ImageSource="pack://application:,,,/FreeFlight.CabinControl;component/Assets/Catering/HighLifeCafeMenuAtlas.png"
                                                    Viewbox="{Binding ImageViewbox}"
                                                    ViewboxUnits="RelativeToBoundingBox"
                                                    Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>

                                <Grid Grid.Row="1" Margin="15,10,15,10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="27" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" Foreground="White" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <Border Width="18" Height="18" Margin="7,0,0,0" CornerRadius="9" Background="#1DB965"
                                                Visibility="{Binding IsVegetarian, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="V" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1"
                                               Text="{Binding Description}"
                                               Foreground="#B8CCE0"
                                               FontSize="12"
                                               LineHeight="18"
                                               TextWrapping="Wrap"
                                               Margin="0,5,0,0" />

                                    <Grid Grid.Row="2">
                                        <TextBlock Text="{Binding AvailabilityLabel}" Foreground="{Binding AvailabilityColor}" FontSize="12" VerticalAlignment="Bottom" />
                                        <TextBlock Text="{Binding PriceLabel}" Foreground="#FFD153" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Grid.Row="3" Margin="5,10,7,0" CornerRadius="8" ClipToBounds="True">
                <Border.Background>
                    <ImageBrush ImageSource="pack://application:,,,/FreeFlight.CabinControl;component/Assets/Catering/HighLifeCafeMenuAtlas.png"
                                Viewbox="0.1803,0.8574,0.8073,0.1065"
                                ViewboxUnits="RelativeToBoundingBox"
                                Stretch="Fill" />
                </Border.Background>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
