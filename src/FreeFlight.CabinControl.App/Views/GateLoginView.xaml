<UserControl x:Class="FreeFlight.CabinControl.App.Views.GateLoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid ClipToBounds="True">
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0.32" GradientOrigin="0.5,0.32" RadiusX="0.82" RadiusY="0.92">
                <GradientStop Color="#173E70" Offset="0" />
                <GradientStop Color="#071A34" Offset="0.46" />
                <GradientStop Color="#020B19" Offset="1" />
            </RadialGradientBrush>
        </Grid.Background>

        <Canvas Opacity="0.13" IsHitTestVisible="False">
            <Rectangle Width="1180" Height="220" Canvas.Top="430" Fill="#163354" />
            <Rectangle Width="1050" Height="8" Canvas.Left="50" Canvas.Top="432" Fill="#55769D" />
            <Rectangle Width="150" Height="280" Canvas.Left="75" Canvas.Top="305" Fill="#294769" />
            <Rectangle Width="150" Height="280" Canvas.Left="280" Canvas.Top="305" Fill="#294769" />
            <Rectangle Width="150" Height="280" Canvas.Left="485" Canvas.Top="305" Fill="#294769" />
            <Rectangle Width="150" Height="280" Canvas.Left="690" Canvas.Top="305" Fill="#294769" />
            <Rectangle Width="150" Height="280" Canvas.Left="895" Canvas.Top="305" Fill="#294769" />
            <TextBlock Text="B42" Canvas.Left="935" Canvas.Top="350" FontSize="58" FontWeight="Bold" Foreground="#7991AB" />
        </Canvas>
        <Rectangle Fill="#59020A17" />

        <Grid Margin="30,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="46" />
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="11" Height="11" Fill="#66D65C" />
                    <TextBlock Text="Gate System Online" Margin="9,0,0,0" Foreground="#CBD7E6" FontSize="14" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="&#xE823;" FontFamily="Segoe Fluent Icons" FontSize="19" Foreground="#AEBED1" Margin="0,0,9,0" />
                    <TextBlock Text="{Binding CurrentTime}" FontSize="20" Foreground="#CBD7E6" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" Width="490" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Width="330" Height="65"
                       Source="pack://application:,,,/FreeFlight.CabinControl;component/Assets/AirlineLogos/BAW.png"
                       Stretch="Uniform"
                       Tag="GateLoginBritishAirwaysWordmark" />
                <TextBlock Text="FreeFlight Gate Operations" FontSize="17" Foreground="#A8B7CA" HorizontalAlignment="Center" Margin="0,-3,0,24" />

                <Border Style="{StaticResource CardStyle}" Padding="32,25">
                    <Grid>
                        <Grid Visibility="{Binding IsSignedOut, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <Border Width="68" Height="68" CornerRadius="34" Background="#163B70" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons" FontSize="34" Foreground="#59A4FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Staff Sign In" FontSize="27" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,15,0,4" />
                                <Rectangle Width="38" Height="3" Fill="#2B85FF" HorizontalAlignment="Center" Margin="0,5,0,18" />

                                <TextBlock Text="Employee ID" FontSize="13" Margin="0,0,0,5" />
                                <TextBox Text="{Binding EmployeeId, UpdateSourceTrigger=PropertyChanged}" Height="43" />

                                <TextBlock Text="Password" FontSize="13" Margin="0,16,0,5" />
                                <PasswordBox x:Name="PasswordInput"
                                             PasswordChanged="PasswordInput_OnPasswordChanged"
                                             Height="43" Padding="12,8"
                                             Background="#071426" Foreground="White"
                                             BorderBrush="{StaticResource BorderBrush}"
                                             CaretBrush="#398EFF" FontSize="14" />

                                <TextBlock Text="Station" FontSize="13" Margin="0,16,0,5" />
                                <ComboBox ItemsSource="{Binding Stations}" SelectedItem="{Binding SelectedStation}" Height="43" />

                                <CheckBox IsChecked="{Binding RememberStation}" Content="Remember this station" Foreground="#D6E0EC" Margin="0,14,0,0" />
                                <Button Command="{Binding SignInCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,20,0,0" Height="54">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE72A;" FontFamily="Segoe Fluent Icons" FontSize="20" Margin="0,0,12,0" />
                                        <TextBlock Text="Sign In" FontSize="16" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" TextAlignment="Center" Foreground="#93A8C1" FontSize="11" Margin="0,12,0,0" />
                                <TextBlock Text="Demo access · credentials are never stored" TextAlignment="Center" Foreground="#5F7897" FontSize="10" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>

                        <Grid Visibility="{Binding IsAuthenticated, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <Border Width="74" Height="74" CornerRadius="37" Background="#164C34" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE930;" FontFamily="Segoe Fluent Icons" FontSize="35" Foreground="#65E692" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Gate Session Active" FontSize="27" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,17,0,5" />
                                <TextBlock Text="{Binding SignedInStaff}" FontSize="17" Foreground="#65E692" HorizontalAlignment="Center" />
                                <Border Background="#6F071426" BorderBrush="#29435F" BorderThickness="1" CornerRadius="7" Padding="16" Margin="0,22,0,0">
                                    <StackPanel>
                                        <TextBlock Text="STATION" Foreground="#7890AC" FontSize="10" />
                                        <TextBlock Text="{Binding SelectedStation.DisplayName}" FontSize="16" Margin="0,3,0,0" />
                                        <TextBlock Text="Gate Desk, manifest, boarding passes and cabin access are unlocked." TextWrapping="Wrap" Foreground="#9DB0C7" FontSize="12" Margin="0,12,0,0" />
                                    </StackPanel>
                                </Border>
                                <Button Command="{Binding SignOutCommand}" Content="Sign Out and Lock Gate Workspace" Style="{StaticResource SecondaryButtonStyle}" Margin="0,20,0,0" Height="50" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,17,0,0">
                    <TextBlock Text="&#xEA18;" FontFamily="Segoe Fluent Icons" Foreground="#9BAEC4" Margin="0,0,8,0" />
                    <TextBlock Text="Authorised personnel preview" Foreground="#8EA1B8" FontSize="12" />
                </StackPanel>
            </StackPanel>

            <Grid Grid.Row="2">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/FreeFlight.CabinControl;component/Assets/FreeFlightBrand.png" Width="48" Height="32" Stretch="Uniform" />
                    <StackPanel Margin="7,0,0,0"><TextBlock Text="FREEFLIGHT" FontWeight="SemiBold" FontSize="13" /><TextBlock Text="GATE OPERATIONS" FontSize="8" Foreground="#8FA3BA" /></StackPanel>
                </StackPanel>
                <TextBlock Text="{Binding DataContext.Settings.Version, RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#8FA3BA" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
