<UserControl x:Class="FreeFlight.CabinControl.App.Views.UpdatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="194" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Clear, verified updates without interrupting a live operation." Style="{StaticResource PageSubtitleStyle}" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.06*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="1.24*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="INSTALLED ON THIS PC" Style="{StaticResource MetricLabelStyle}" />
                            <TextBlock Text="{Binding CurrentVersion}" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                        <Border Style="{StaticResource StatusPillStyle}" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="10,5">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource SuccessBrush}" FontSize="12" /><TextBlock Text="Auto-check" Style="{StaticResource MetricLabelStyle}" Margin="6,0,0,0" /></StackPanel>
                        </Border>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding Status}" TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}" Margin="0,10,0,0" />
                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button Content="Check now" Command="{Binding CheckCommand}" Style="{StaticResource SecondaryButtonStyle}" MinWidth="126" />
                        <Button Content="Install &amp; restart" Command="{Binding InstallCommand}" IsEnabled="{Binding CanInstall}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="168" Margin="10,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{DynamicResource PremiumHeroBrush}" BorderBrush="#459ACB" BorderThickness="1" CornerRadius="{DynamicResource CardCornerRadius}" Padding="{DynamicResource CardPadding}" Effect="{StaticResource HeroShadowEffect}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Ellipse Width="190" Height="190" Fill="#18FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,-90,-70,0" IsHitTestVisible="False" />
                    <StackPanel>
                        <TextBlock Text="LATEST STABLE RELEASE" Foreground="#CDEBFF" FontSize="10" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding AvailableVersionNumber}" Foreground="White" FontSize="30" FontWeight="SemiBold" Margin="0,3,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="{Binding ReleaseBriefing}" Foreground="#E6F5FF" FontSize="14" LineHeight="21" TextWrapping="Wrap" Margin="0,10,78,0" />
                    <Button Grid.Row="2" Content="Open release page" Command="{Binding OpenReleaseCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" MinWidth="151" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="20">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="13" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Release briefing" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="Features, improvements and fixes are grouped here as soon as an update is found." Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button Content="Read full history" Style="{StaticResource SecondaryButtonStyle}" MinWidth="145" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OpenChangelogButton_Click" />
                </Grid>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <ItemsControl ItemsSource="{Binding ReleaseSections}" Visibility="{Binding HasReleaseSections, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{Binding AccentBrush}" BorderThickness="1" CornerRadius="12" Padding="15,12" Margin="0,0,0,11">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <Border Width="30" Height="30" CornerRadius="15" Background="{Binding IconBackground}" BorderBrush="{Binding AccentBrush}" BorderThickness="1" VerticalAlignment="Top"><TextBlock Text="{Binding Icon}" FontFamily="Segoe Fluent Icons" Foreground="{Binding AccentBrush}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Foreground="{Binding AccentBrush}" />
                                                <ItemsControl ItemsSource="{Binding Items}" Margin="0,8,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,8">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="13" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                                <TextBlock Text="•" Foreground="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}" FontWeight="Bold" />
                                                                <StackPanel Grid.Column="1">
                                                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedTextStyle}" FontSize="12" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding Changelog}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" LineHeight="20" Visibility="{Binding HasReleaseSections, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
