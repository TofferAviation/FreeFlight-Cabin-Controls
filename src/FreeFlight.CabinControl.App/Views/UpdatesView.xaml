<UserControl x:Class="FreeFlight.CabinControl.App.Views.UpdatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="180" /><RowDefinition Height="16" /><RowDefinition /></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" /><TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitleStyle}" /></StackPanel>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid><StackPanel><TextBlock Text="Installed Version" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding CurrentVersion}" FontSize="30" FontWeight="SemiBold" Foreground="#8FC8FF" /></StackPanel><ToggleButton IsChecked="{Binding AutomaticallyCheckForUpdates}" Style="{StaticResource PillToggleStyle}" HorizontalAlignment="Right" ToolTip="Automatically check the stable channel at startup" /></Grid><TextBlock Grid.Row="1" Text="{Binding Status}" TextWrapping="Wrap" Foreground="#AFC2D8" Margin="0,12,0,0" /><StackPanel Grid.Row="2" Orientation="Horizontal"><Button Content="Check Now" Command="{Binding CheckCommand}" Style="{StaticResource SecondaryButtonStyle}" MinWidth="140" /><Button Content="Install &amp; Restart" Command="{Binding InstallCommand}" IsEnabled="{Binding CanInstall}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="180" Margin="10,0,0,0" /></StackPanel></Grid></Border>
            <Border Grid.Column="2" Style="{StaticResource CardStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock Text="{Binding AvailableVersion}" FontSize="18" FontWeight="SemiBold" /><TextBlock Grid.Row="1" Text="{Binding ReleaseNotes}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="#AFC2D8" Margin="0,10,0,0" /><Button Grid.Row="2" Content="Open Release Page" Command="{Binding OpenReleaseCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" /></Grid></Border>
        </Grid>
        <Border Grid.Row="4" Style="{StaticResource CardStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition /></Grid.RowDefinitions><TextBlock Text="Bundled Changelog" Style="{StaticResource SectionTitleStyle}" /><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding Changelog}" TextWrapping="Wrap" Foreground="#AFC2D8" FontFamily="Consolas" FontSize="12" LineHeight="19" /></ScrollViewer></Grid></Border>
    </Grid>
</UserControl>
