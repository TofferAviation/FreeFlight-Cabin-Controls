                                <Button Canvas.Left="431" Canvas.Top="675" Width="281" Height="70" Style="{StaticResource CacpHotspotStyle}" Content="MAIN MENU" Command="{Binding MainMenuCommand}" />
                                <Button Canvas.Left="794" Canvas.Top="677" Width="290" Height="69" Style="{StaticResource CacpHotspotStyle}" Content="PREVIOUS MENU" Command="{Binding PreviousMenuCommand}" />
                            </Canvas>

                            <Canvas Width="1536" Height="1024" Visibility="{Binding SelectedPanel, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Cabin Temperature}">
                                <Image Source="pack://application:,,,/FreeFlight.CabinControl;component/Assets/CacpPages/04_Cabin_Temperature.png" Width="1536" Height="1024" />
