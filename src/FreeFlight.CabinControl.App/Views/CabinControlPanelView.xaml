<UserControl x:Class="FreeFlight.CabinControl.App.Views.CabinControlPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="820" d:DesignWidth="1200">
    <UserControl.Resources>
        <Style x:Key="CacpHotspotStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HitZone" Background="Transparent" BorderBrush="Transparent" BorderThickness="3" CornerRadius="4">
                            <TextBlock x:Name="PressedLabel" Text="{TemplateBinding Content}" Opacity="0" Foreground="#FFFDFC"
                                       FontFamily="Consolas" FontSize="26" FontWeight="SemiBold" TextAlignment="Center"
                                       TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HitZone" Property="Background" Value="#12000000" />
                                <Setter TargetName="HitZone" Property="BorderBrush" Value="#55747B83" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HitZone" Property="Background" Value="#E85B6066" />
                                <Setter TargetName="HitZone" Property="BorderBrush" Value="#EDEFF2F4" />
                                <Setter TargetName="PressedLabel" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CacpReadoutStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A6F4D7" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="31" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="QueueButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Margin" Value="0,5,0,0" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="620" /></Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <StackPanel><TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" /><TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitleStyle}" /></StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Ellipse Width="13" Height="13" Fill="{StaticResource WarningBrush}" Margin="0,0,10,0" /><TextBlock Text="{Binding Status.ConnectionLabel}" Foreground="{StaticResource WarningBrush}" FontSize="14" FontWeight="SemiBold" /></StackPanel>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="306" /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#090C11" BorderBrush="#3B4654" BorderThickness="1" CornerRadius="11" ClipToBounds="True">
                    <Viewbox Stretch="Uniform">
                        <Grid Width="1536" Height="1024">
                            <!-- Main menu: the supplied FF777 render is the exact visual source. -->
                            <Canvas Width="1536" Height="1024" Visibility="{Binding SelectedPanel, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Main Menu}">
                                <Image Source="pack://application:,,,/FreeFlight.CabinControl;component/Assets/CacpPages/01_Main_Menu.png" Width="1536" Height="1024" />
                                <Button Canvas.Left="430" Canvas.Top="319" Width="206" Height="91" Style="{StaticResource CacpHotspotStyle}" Content="LIGHTING&#x0a;CONTROL" Command="{Binding SelectPanelCommand}" CommandParameter="Lighting Control" />
                                <Button Canvas.Left="658" Canvas.Top="319" Width="206" Height="92" Style="{StaticResource CacpHotspotStyle}" Content="SERVICE CALL /&#x0a;CHIME" Command="{Binding SelectPanelCommand}" CommandParameter="Service Call / Chime" />
                                <Button Canvas.Left="431" Canvas.Top="426" Width="205" Height="89" Style="{StaticResource CacpHotspotStyle}" Content="CABIN&#x0a;TEMPERATURE" Command="{Binding SelectPanelCommand}" CommandParameter="Cabin Temperature" />
                                <Button Canvas.Left="658" Canvas.Top="428" Width="204" Height="89" Style="{StaticResource CacpHotspotStyle}" Content="WATER / WASTE&#x0a;STATUS" Command="{Binding SelectPanelCommand}" CommandParameter="Water / Waste Status" />
                                <Button Canvas.Left="431" Canvas.Top="533" Width="205" Height="90" Style="{StaticResource CacpHotspotStyle}" Content="PASSENGER&#x0a;ADDRESS" Command="{Binding SelectPanelCommand}" CommandParameter="Passenger Address" />
                                <Button Canvas.Left="658" Canvas.Top="533" Width="204" Height="90" Style="{StaticResource CacpHotspotStyle}" Content="CABIN DOOR&#x0a;STATUS" Command="{Binding SelectPanelCommand}" CommandParameter="Cabin Door Status" />
                                <Button Canvas.Left="431" Canvas.Top="641" Width="205" Height="91" Style="{StaticResource CacpHotspotStyle}" Content="DISPLAY&#x0a;CONTROLS" Command="{Binding SelectPanelCommand}" CommandParameter="Display Controls" />
                                <Button Canvas.Left="658" Canvas.Top="642" Width="204" Height="91" Style="{StaticResource CacpHotspotStyle}" Content="BOARDING&#x0a;MUSIC" Command="{Binding SelectPanelCommand}" CommandParameter="Boarding Music" />
                                <Button Canvas.Left="881" Canvas.Top="644" Width="206" Height="90" Style="{StaticResource CacpHotspotStyle}" Content="SPECIAL&#x0a;FUNCTIONS" Command="{Binding SelectPanelCommand}" CommandParameter="Special Functions" />
                            </Canvas>

                            <Canvas Width="1536" Height="1024" Visibility="{Binding SelectedPanel, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Lighting Control}">
                                <Image Source="pack://application:,,,/FreeFlight.CabinControl;component/Assets/CacpPages/02_Lighting_Control.png" Width="1536" Height="1024" />
                                <Button Canvas.Left="432" Canvas.Top="321" Width="204" Height="89" Style="{StaticResource CacpHotspotStyle}" Content="CABIN&#x0a;LIGHTING" Command="{Binding ExecuteActionCommand}" CommandParameter="Lighting:Cabin Lighting" />
                                <Button Canvas.Left="654" Canvas.Top="321" Width="201" Height="89" Style="{StaticResource CacpHotspotStyle}" Content="ENTRY WAY&#x0a;LIGHTS" Command="{Binding ExecuteActionCommand}" CommandParameter="Lighting:Entry Way Lights" />
                                <Button Canvas.Left="432" Canvas.Top="426" Width="204" Height="89" Style="{StaticResource CacpHotspotStyle}" Content="READING&#x0a;LIGHTS" Command="{Binding ExecuteActionCommand}" CommandParameter="Lighting:Reading Lights" />
                                <Button Canvas.Left="653" Canvas.Top="427" Width="202" Height="89" Style="{StaticResource CacpHotspotStyle}" Content="GALLEY&#x0a;LIGHTS" Command="{Binding ExecuteActionCommand}" CommandParameter="Lighting:Galley Lights" />
                                <Button Canvas.Left="432" Canvas.Top="532" Width="204" Height="90" Style="{StaticResource CacpHotspotStyle}" Content="LAVATORY&#x0a;LIGHTS" Command="{Binding ExecuteActionCommand}" CommandParameter="Lighting:Lavatory Lights" />
                                <Button Canvas.Left="654" Canvas.Top="533" Width="201" Height="90" Style="{StaticResource CacpHotspotStyle}" Content="WORK&#x0a;LIGHTS" Command="{Binding ExecuteActionCommand}" CommandParameter="Lighting:Work Lights" />
                                <Border Canvas.Left="918" Canvas.Top="448" Width="145" Height="51" Background="#FF2C455C"><TextBlock Text="{Binding SelectedLightingArea}" Style="{StaticResource CacpReadoutStyle}" FontSize="24" TextWrapping="Wrap" /></Border>
                                <Button Canvas.Left="479" Canvas.Top="669" Width="248" Height="67" Style="{StaticResource CacpHotspotStyle}" Content="MAIN MENU" Command="{Binding MainMenuCommand}" />
                                <Button Canvas.Left="791" Canvas.Top="670" Width="256" Height="67" Style="{StaticResource CacpHotspotStyle}" Content="PREVIOUS MENU" Command="{Binding PreviousMenuCommand}" />
                            </Canvas>

                            <Canvas Width="1536" Height="1024" Visibility="{Binding SelectedPanel, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Service Call / Chime}">
