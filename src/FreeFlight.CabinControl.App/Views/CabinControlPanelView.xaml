<UserControl x:Class="FreeFlight.CabinControl.App.Views.CabinControlPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="820" d:DesignWidth="1200">
    <UserControl.Resources>
        <LinearGradientBrush x:Key="CacpBezelBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#343431" Offset="0" />
            <GradientStop Color="#171816" Offset="0.52" />
            <GradientStop Color="#252522" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CacpKeyBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E7EBEF" Offset="0" />
            <GradientStop Color="#B6C0CB" Offset="1" />
        </LinearGradientBrush>
        <Style x:Key="CacpKeyStyle" TargetType="Button">
            <Setter Property="Margin" Value="7" />
            <Setter Property="MinHeight" Value="57" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Key" Background="{StaticResource CacpKeyBrush}" BorderBrush="#F8FAFC" BorderThickness="2" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <Border.Effect><DropShadowEffect Color="#020304" BlurRadius="3" ShadowDepth="3" Opacity="0.85" /></Border.Effect>
                            <TextBlock x:Name="Label" Text="{TemplateBinding Content}" Foreground="#263442" FontFamily="Consolas" FontSize="13" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Key" Property="Background" Value="#D5DAE0" /></Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Key" Property="Background" Value="#646A71" />
                                <Setter TargetName="Key" Property="BorderBrush" Value="#A9B0B8" />
                                <Setter TargetName="Label" Property="Foreground" Value="#FFFDFB" />
                                <Setter TargetName="Key" Property="RenderTransform"><Setter.Value><TranslateTransform Y="2" /></Setter.Value></Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CacpNavStyle" TargetType="Button" BasedOn="{StaticResource CacpKeyStyle}">
            <Setter Property="MinHeight" Value="42" /><Setter Property="Margin" Value="7,5" />
        </Style>
        <Style x:Key="CacpTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A8F2D9" /><Setter Property="FontFamily" Value="Consolas" /><Setter Property="FontSize" Value="22" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style x:Key="CacpLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D9E4E8" /><Setter Property="FontFamily" Value="Consolas" /><Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="CacpValueStyle" TargetType="TextBlock" BasedOn="{StaticResource CacpLabelStyle}">
            <Setter Property="Foreground" Value="#A8F2D9" /><Setter Property="FontSize" Value="20" /><Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="CacpPageStyle" TargetType="Grid">
            <Setter Property="Margin" Value="8" />
        </Style>
        <Style x:Key="QueueButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Margin" Value="0,5,0,0" /><Setter Property="MinHeight" Value="36" /><Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="620" /></Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <StackPanel><TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" /><TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitleStyle}" /></StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Ellipse Width="13" Height="13" Fill="{StaticResource WarningBrush}" Margin="0,0,10,0" /><TextBlock Text="{Binding Status.ConnectionLabel}" Foreground="{StaticResource WarningBrush}" FontSize="14" FontWeight="SemiBold" /></StackPanel>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="306" /></Grid.ColumnDefinitions>

                <!-- Fully coded panel: no photographic wall or raster CACP page is used. -->
                <Border Grid.Column="0" Background="{StaticResource CacpBezelBrush}" BorderBrush="#555650" BorderThickness="2" CornerRadius="22" Padding="24,15">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="*" /><RowDefinition Height="42" /></Grid.RowDefinitions>
                        <TextBlock Text="C A B I N   A R E A   C O N T R O L   P A N E L" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="#AAA69E" />
                        <Border Grid.Row="1" Margin="18,0" Background="#293D52" BorderBrush="#090B0C" BorderThickness="10" CornerRadius="7" Padding="6">
                            <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="7" ShadowDepth="2" Opacity="0.9" /></Border.Effect>
                            <Grid>
                                <!-- MAIN MENU -->
                                <Grid Style="{StaticResource CacpPageStyle}" Visibility="{Binding SelectedPanel, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Main Menu}">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <StackPanel><TextBlock Text="MAIN MENU" Style="{StaticResource CacpTitleStyle}" /><Border Height="2" Background="#A8F2D9" /></StackPanel>
                                    <Grid Grid.Row="1" Margin="12,7,12,0">
                                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource CacpKeyStyle}" Content="LIGHTING&#x0a;CONTROL" Command="{Binding SelectPanelCommand}" CommandParameter="Lighting Control" />
                                        <Button Grid.Column="1" Style="{StaticResource CacpKeyStyle}" Content="SERVICE CALL /&#x0a;CHIME" Command="{Binding SelectPanelCommand}" CommandParameter="Service Call / Chime" />
                                        <Button Grid.Row="1" Style="{StaticResource CacpKeyStyle}" Content="CABIN&#x0a;TEMPERATURE" Command="{Binding SelectPanelCommand}" CommandParameter="Cabin Temperature" />
                                        <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource CacpKeyStyle}" Content="WATER / WASTE&#x0a;STATUS" Command="{Binding SelectPanelCommand}" CommandParameter="Water / Waste Status" />
                                        <Button Grid.Row="2" Style="{StaticResource CacpKeyStyle}" Content="PASSENGER&#x0a;ADDRESS" Command="{Binding SelectPanelCommand}" CommandParameter="Passenger Address" />
                                        <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource CacpKeyStyle}" Content="CABIN DOOR&#x0a;STATUS" Command="{Binding SelectPanelCommand}" CommandParameter="Cabin Door Status" />
                                        <Button Grid.Row="3" Style="{StaticResource CacpKeyStyle}" Content="DISPLAY&#x0a;CONTROLS" Command="{Binding SelectPanelCommand}" CommandParameter="Display Controls" />
                                        <Button Grid.Row="3" Grid.Column="1" Style="{StaticResource CacpKeyStyle}" Content="BOARDING&#x0a;MUSIC" Command="{Binding SelectPanelCommand}" CommandParameter="Boarding Music" />
                                        <Button Grid.Row="3" Grid.Column="2" Style="{StaticResource CacpKeyStyle}" Content="SPECIAL&#x0a;FUNCTIONS" Command="{Binding SelectPanelCommand}" CommandParameter="Special Functions" />
                                    </Grid>
                                </Grid>

                                <!-- LIGHTING CONTROL -->
                                <Grid Style="{StaticResource CacpPageStyle}" Visibility="{Binding SelectedPanel, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Lighting Control}">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <StackPanel><TextBlock Text="LIGHTING CONTROL" Style="{StaticResource CacpTitleStyle}" /><Border Height="2" Background="#A8F2D9" /></StackPanel>
                                    <Grid Grid.Row="1" Margin="10,7"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid><Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <Button Style="{StaticResource CacpKeyStyle}" Content="CABIN&#x0a;LIGHTING" Command="{Binding ExecuteActionCommand}" CommandParameter="Lighting:Cabin Lighting" /><Button Grid.Column="1" Style="{StaticResource CacpKeyStyle}" Content="ENTRY WAY&#x0a;LIGHTS" Command="{Binding ExecuteActionCommand}" CommandParameter="Lighting:Entry Way Lights" />
                                            <Button Grid.Row="1" Style="{StaticResource CacpKeyStyle}" Content="READING&#x0a;LIGHTS" Command="{Binding ExecuteActionCommand}" CommandParameter="Lighting:Reading Lights" /><Button Grid.Row="1" Grid.Column="1" Style="{StaticResource CacpKeyStyle}" Content="GALLEY&#x0a;LIGHTS" Command="{Binding ExecuteActionCommand}" CommandParameter="Lighting:Galley Lights" />
                                            <Button Grid.Row="2" Style="{StaticResource CacpKeyStyle}" Content="LAVATORY&#x0a;LIGHTS" Command="{Binding ExecuteActionCommand}" CommandParameter="Lighting:Lavatory Lights" /><Button Grid.Row="2" Grid.Column="1" Style="{StaticResource CacpKeyStyle}" Content="WORK&#x0a;LIGHTS" Command="{Binding ExecuteActionCommand}" CommandParameter="Lighting:Work Lights" />
                                        </Grid>
                                        <Border Grid.Column="1" BorderBrush="#A8F2D9" BorderThickness="2" CornerRadius="4" Margin="15,35,8,35"><StackPanel VerticalAlignment="Center"><TextBlock Text="CURRENT AREA" Style="{StaticResource CacpLabelStyle}" Foreground="#A8F2D9" FontSize="16" HorizontalAlignment="Center" /><TextBlock Text="—" Style="{StaticResource CacpValueStyle}" HorizontalAlignment="Center" /><TextBlock Text="{Binding SelectedLightingArea}" Style="{StaticResource CacpValueStyle}" FontSize="17" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" /></StackPanel></Border>
                                    </Grid>
                                    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><Button Style="{StaticResource CacpNavStyle}" Content="MAIN MENU" Command="{Binding MainMenuCommand}" /><Button Grid.Column="1" Style="{StaticResource CacpNavStyle}" Content="PREVIOUS MENU" Command="{Binding PreviousMenuCommand}" /></Grid>
                                </Grid>

                                <!-- SERVICE CALL / CHIME -->
                                <Grid Style="{StaticResource CacpPageStyle}" Visibility="{Binding SelectedPanel, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Service Call / Chime}">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <StackPanel><TextBlock Text="SERVICE CALL / CHIME" Style="{StaticResource CacpTitleStyle}" /><Border Height="2" Background="#A8F2D9" /></StackPanel>
                                    <Grid Grid.Row="1" Margin="20,12"><Grid.RowDefinitions><RowDefinition /><RowDefinition Height="2" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="PASSENGER CALLS" Style="{StaticResource CacpLabelStyle}" Margin="0,5" /><TextBlock Text="LAVATORY CALLS" Style="{StaticResource CacpLabelStyle}" Margin="0,5" /><TextBlock Text="ATTENDANT CHIME" Style="{StaticResource CacpLabelStyle}" Margin="0,5" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="ENABLED" Style="{StaticResource CacpValueStyle}" FontSize="15" Margin="0,5" /><TextBlock Text="ENABLED" Style="{StaticResource CacpValueStyle}" FontSize="15" Margin="0,5" /><TextBlock Text="{Binding AttendantChimeStatus}" Style="{StaticResource CacpValueStyle}" FontSize="15" Margin="0,5" /></StackPanel></Grid>
                                        <Border Grid.Row="1" Background="#A8F2D9" />
                                        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><Button Style="{StaticResource CacpKeyStyle}" Content="RESET CALLS" Command="{Binding ExecuteActionCommand}" CommandParameter="Calls:Reset" /><Button Grid.Column="1" Style="{StaticResource CacpKeyStyle}" Content="CHIME ON" Command="{Binding ExecuteActionCommand}" CommandParameter="Chime:On" /><Button Grid.Column="2" Style="{StaticResource CacpKeyStyle}" Content="CHIME OFF" Command="{Binding ExecuteActionCommand}" CommandParameter="Chime:Off" /></Grid>
                                        <TextBlock Grid.Row="3" Text="NO ACTIVE CALLS" Style="{StaticResource CacpLabelStyle}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                    </Grid>
                                    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><Button Style="{StaticResource CacpNavStyle}" Content="MAIN MENU" Command="{Binding MainMenuCommand}" /><Button Grid.Column="1" Style="{StaticResource CacpNavStyle}" Content="PREVIOUS MENU" Command="{Binding PreviousMenuCommand}" /></Grid>
                                </Grid>

                                <!-- CABIN TEMPERATURE -->
                                <Grid Style="{StaticResource CacpPageStyle}" Visibility="{Binding SelectedPanel, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Cabin Temperature}">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel><TextBlock Text="CABIN TEMPERATURE" Style="{StaticResource CacpTitleStyle}" /><Border Height="2" Background="#A8F2D9" /></StackPanel>
                                    <Grid Grid.Row="1" Margin="16,8"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="2" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <Grid><Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition /></Grid.ColumnDefinitions><Button Style="{StaticResource CacpKeyStyle}" Content="ZONE 1" Command="{Binding ExecuteActionCommand}" CommandParameter="Temp:Zone 1" /><TextBlock Grid.Column="1" Text="{Binding Zone1TemperatureC, StringFormat={}{0}°C}" Style="{StaticResource CacpValueStyle}" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" /><Button Grid.Row="1" Style="{StaticResource CacpKeyStyle}" Content="ZONE 2" Command="{Binding ExecuteActionCommand}" CommandParameter="Temp:Zone 2" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Zone2TemperatureC, StringFormat={}{0}°C}" Style="{StaticResource CacpValueStyle}" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" /><Button Grid.Row="2" Style="{StaticResource CacpKeyStyle}" Content="ZONE 3" Command="{Binding ExecuteActionCommand}" CommandParameter="Temp:Zone 3" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Zone3TemperatureC, StringFormat={}{0}°C}" Style="{StaticResource CacpValueStyle}" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid>
                                        <Border Grid.Column="1" Background="#A8F2D9" />
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="14,0,0,0"><TextBlock Text="SELECTED SET TEMPERATURE" Style="{StaticResource CacpLabelStyle}" Foreground="#A8F2D9" HorizontalAlignment="Center" /><TextBlock Text="{Binding SelectedTemperatureC, StringFormat={}{0}°C}" Style="{StaticResource CacpValueStyle}" FontSize="43" HorizontalAlignment="Center" Margin="0,4,0,6" /><Button Style="{StaticResource CacpKeyStyle}" Content="▲  INCREASE" Command="{Binding ExecuteActionCommand}" CommandParameter="Temp:Increase" /><Button Style="{StaticResource CacpKeyStyle}" Content="▼  DECREASE" Command="{Binding ExecuteActionCommand}" CommandParameter="Temp:Decrease" /><TextBlock Text="CONTROL — AUTOMATIC" Style="{StaticResource CacpLabelStyle}" Foreground="#A8F2D9" HorizontalAlignment="Center" /></StackPanel>
                                    </Grid>
                                    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><Button Style="{StaticResource CacpNavStyle}" Content="MAIN MENU" Command="{Binding MainMenuCommand}" /><Button Grid.Column="1" Style="{StaticResource CacpNavStyle}" Content="PREVIOUS MENU" Command="{Binding PreviousMenuCommand}" /></Grid>
                                </Grid>

                                <!-- WATER / WASTE STATUS -->
                                <Grid Style="{StaticResource CacpPageStyle}" Visibility="{Binding SelectedPanel, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Water / Waste Status}">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel><TextBlock Text="WATER / WASTE STATUS" Style="{StaticResource CacpTitleStyle}" /><Border Height="2" Background="#A8F2D9" /></StackPanel>
                                    <Grid Grid.Row="1" Margin="20,10"><Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition Height="2" /><RowDefinition /><RowDefinition /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="2.2*" /><ColumnDefinition Width="0.6*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="POTABLE WATER" Style="{StaticResource CacpValueStyle}" FontSize="16" VerticalAlignment="Center" /><ProgressBar Grid.Column="1" Value="78" Foreground="#9BE8D1" Background="#192B3B" Height="22" Margin="8" /><TextBlock Grid.Column="2" Text="78%" Style="{StaticResource CacpValueStyle}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="1" Text="FWD WASTE" Style="{StaticResource CacpValueStyle}" FontSize="16" VerticalAlignment="Center" /><ProgressBar Grid.Row="1" Grid.Column="1" Value="22" Foreground="#9BE8D1" Background="#192B3B" Height="22" Margin="8" /><TextBlock Grid.Row="1" Grid.Column="2" Text="22%" Style="{StaticResource CacpValueStyle}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="2" Text="AFT WASTE" Style="{StaticResource CacpValueStyle}" FontSize="16" VerticalAlignment="Center" /><ProgressBar Grid.Row="2" Grid.Column="1" Value="31" Foreground="#9BE8D1" Background="#192B3B" Height="22" Margin="8" /><TextBlock Grid.Row="2" Grid.Column="2" Text="31%" Style="{StaticResource CacpValueStyle}" VerticalAlignment="Center" />
                                        <Border Grid.Row="3" Grid.ColumnSpan="3" Background="#A8F2D9" />
                                        <TextBlock Grid.Row="4" Grid.ColumnSpan="3" Text="SYSTEM NORMAL" Style="{StaticResource CacpValueStyle}" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Grid Grid.Row="5" Grid.ColumnSpan="3"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><Button Style="{StaticResource CacpKeyStyle}" Content="LAVATORY&#x0a;STATUS" Command="{Binding ExecuteActionCommand}" CommandParameter="Lavatory status" /><Button Grid.Column="1" Style="{StaticResource CacpKeyStyle}" Content="INOPERATIVE&#x0a;CONTROL" Command="{Binding ExecuteActionCommand}" CommandParameter="Inoperative control" /></Grid>
                                    </Grid>
                                    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><Button Style="{StaticResource CacpNavStyle}" Content="MAIN MENU" Command="{Binding MainMenuCommand}" /><Button Grid.Column="1" Style="{StaticResource CacpNavStyle}" Content="PREVIOUS MENU" Command="{Binding PreviousMenuCommand}" /></Grid>
                                </Grid>

                                <!-- PASSENGER ADDRESS -->
                                <Grid Style="{StaticResource CacpPageStyle}" Visibility="{Binding SelectedPanel, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Passenger Address}">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel><TextBlock Text="PASSENGER ADDRESS" Style="{StaticResource CacpTitleStyle}" /><Border Height="2" Background="#A8F2D9" /></StackPanel>
                                    <Grid Grid.Row="1" Margin="16,12"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="0.5*" /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                        <TextBlock Text="PA VOLUME" Style="{StaticResource CacpValueStyle}" FontSize="17" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding PaVolumeLevel, StringFormat=—  {0}}" Style="{StaticResource CacpValueStyle}" VerticalAlignment="Center" /><Button Grid.Column="2" Style="{StaticResource CacpKeyStyle}" Content="VOLUME UP" Command="{Binding ExecuteActionCommand}" CommandParameter="PA:VolumeUp" /><Button Grid.Column="3" Style="{StaticResource CacpKeyStyle}" Content="VOLUME DOWN" Command="{Binding ExecuteActionCommand}" CommandParameter="PA:VolumeDown" />
                                        <TextBlock Grid.Row="1" Text="AMBIENT NOISE&#x0a;SENSOR" Style="{StaticResource CacpValueStyle}" FontSize="17" VerticalAlignment="Center" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AmbientNoiseSensorStatus, StringFormat=—  {0}}" Style="{StaticResource CacpValueStyle}" VerticalAlignment="Center" /><Button Grid.Row="1" Grid.Column="2" Style="{StaticResource CacpKeyStyle}" Content="SENSOR ON" Command="{Binding ExecuteActionCommand}" CommandParameter="PA:SensorOn" /><Button Grid.Row="1" Grid.Column="3" Style="{StaticResource CacpKeyStyle}" Content="SENSOR OFF" Command="{Binding ExecuteActionCommand}" CommandParameter="PA:SensorOff" />
                                        <TextBlock Grid.Row="2" Text="AUTOMATIC&#x0a;VOLUME" Style="{StaticResource CacpValueStyle}" FontSize="17" VerticalAlignment="Center" /><TextBlock Grid.Row="2" Grid.Column="1" Text="—  ON" Style="{StaticResource CacpValueStyle}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="3" Text="PA SYSTEM STATUS" Style="{StaticResource CacpValueStyle}" FontSize="17" VerticalAlignment="Center" /><TextBlock Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" Text="PA SYSTEM NORMAL" Style="{StaticResource CacpLabelStyle}" FontSize="17" VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><Button Style="{StaticResource CacpNavStyle}" Content="MAIN MENU" Command="{Binding MainMenuCommand}" /><Button Grid.Column="1" Style="{StaticResource CacpNavStyle}" Content="PREVIOUS MENU" Command="{Binding PreviousMenuCommand}" /></Grid>
                                </Grid>

                                <!-- CABIN DOOR STATUS -->
                                <Grid Style="{StaticResource CacpPageStyle}" Visibility="{Binding SelectedPanel, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Cabin Door Status}">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel><TextBlock Text="CABIN DOOR STATUS" Style="{StaticResource CacpTitleStyle}" /><Border Height="2" Background="#A8F2D9" /></StackPanel>
                                    <Grid Grid.Row="1" Margin="55,12"><Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition Height="2" /><RowDefinition /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <TextBlock Text="1L" Style="{StaticResource CacpLabelStyle}" FontSize="20" /><TextBlock Grid.Column="1" Text="UNKNOWN" Style="{StaticResource CacpValueStyle}" Foreground="#FFC75C" FontSize="17" /><TextBlock Grid.Column="2" Text="1R" Style="{StaticResource CacpLabelStyle}" FontSize="20" /><TextBlock Grid.Column="3" Text="UNKNOWN" Style="{StaticResource CacpValueStyle}" Foreground="#FFC75C" FontSize="17" />
                                        <TextBlock Grid.Row="1" Text="2L" Style="{StaticResource CacpLabelStyle}" FontSize="20" /><TextBlock Grid.Row="1" Grid.Column="1" Text="UNKNOWN" Style="{StaticResource CacpValueStyle}" Foreground="#FFC75C" FontSize="17" /><TextBlock Grid.Row="1" Grid.Column="2" Text="2R" Style="{StaticResource CacpLabelStyle}" FontSize="20" /><TextBlock Grid.Row="1" Grid.Column="3" Text="UNKNOWN" Style="{StaticResource CacpValueStyle}" Foreground="#FFC75C" FontSize="17" />
                                        <TextBlock Grid.Row="2" Text="3L" Style="{StaticResource CacpLabelStyle}" FontSize="20" /><TextBlock Grid.Row="2" Grid.Column="1" Text="UNKNOWN" Style="{StaticResource CacpValueStyle}" Foreground="#FFC75C" FontSize="17" /><TextBlock Grid.Row="2" Grid.Column="2" Text="3R" Style="{StaticResource CacpLabelStyle}" FontSize="20" /><TextBlock Grid.Row="2" Grid.Column="3" Text="UNKNOWN" Style="{StaticResource CacpValueStyle}" Foreground="#FFC75C" FontSize="17" />
                                        <TextBlock Grid.Row="3" Text="4L" Style="{StaticResource CacpLabelStyle}" FontSize="20" /><TextBlock Grid.Row="3" Grid.Column="1" Text="UNKNOWN" Style="{StaticResource CacpValueStyle}" Foreground="#FFC75C" FontSize="17" /><TextBlock Grid.Row="3" Grid.Column="2" Text="4R" Style="{StaticResource CacpLabelStyle}" FontSize="20" /><TextBlock Grid.Row="3" Grid.Column="3" Text="UNKNOWN" Style="{StaticResource CacpValueStyle}" Foreground="#FFC75C" FontSize="17" />
                                        <TextBlock Grid.Row="4" Text="5L" Style="{StaticResource CacpLabelStyle}" FontSize="20" /><TextBlock Grid.Row="4" Grid.Column="1" Text="UNKNOWN" Style="{StaticResource CacpValueStyle}" Foreground="#FFC75C" FontSize="17" /><TextBlock Grid.Row="4" Grid.Column="2" Text="5R" Style="{StaticResource CacpLabelStyle}" FontSize="20" /><TextBlock Grid.Row="4" Grid.Column="3" Text="UNKNOWN" Style="{StaticResource CacpValueStyle}" Foreground="#FFC75C" FontSize="17" />
                                        <Border Grid.Row="5" Grid.ColumnSpan="4" Background="#A8F2D9" /><TextBlock Grid.Row="6" Grid.ColumnSpan="4" Text="TELEMETRY OFFLINE" Style="{StaticResource CacpValueStyle}" Foreground="#FFC75C" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><Button Style="{StaticResource CacpNavStyle}" Content="MAIN MENU" Command="{Binding MainMenuCommand}" /><Button Grid.Column="1" Style="{StaticResource CacpNavStyle}" Content="PREVIOUS MENU" Command="{Binding PreviousMenuCommand}" /></Grid>
                                </Grid>

                                <!-- DISPLAY CONTROLS -->
                                <Grid Style="{StaticResource CacpPageStyle}" Visibility="{Binding SelectedPanel, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Display Controls}">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel><TextBlock Text="DISPLAY CONTROLS" Style="{StaticResource CacpTitleStyle}" /><Border Height="2" Background="#A8F2D9" /></StackPanel>
                                    <Grid Grid.Row="1" Margin="12,8"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="1.6*" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <StackPanel><Button Style="{StaticResource CacpKeyStyle}" Content="BRIGHTNESS&#x0a;UP" Command="{Binding ExecuteActionCommand}" CommandParameter="Display:BrightnessUp" /><Button Style="{StaticResource CacpKeyStyle}" Content="BRIGHTNESS&#x0a;DOWN" Command="{Binding ExecuteActionCommand}" CommandParameter="Display:BrightnessDown" /><Button Style="{StaticResource CacpKeyStyle}" Content="DAY MODE" Command="{Binding ExecuteActionCommand}" CommandParameter="Display:Day" /><Button Style="{StaticResource CacpKeyStyle}" Content="NIGHT MODE" Command="{Binding ExecuteActionCommand}" CommandParameter="Display:Night" /></StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0"><TextBlock Text="BRIGHTNESS" Style="{StaticResource CacpLabelStyle}" FontSize="18" HorizontalAlignment="Center" /><TextBlock Text="{Binding DisplayBrightness, StringFormat={}{0}%}" Style="{StaticResource CacpValueStyle}" FontSize="30" HorizontalAlignment="Center" /><Grid Height="28" Margin="0,6"><ProgressBar Value="{Binding DisplayBrightness, Mode=OneWay}" Foreground="#9BE8D1" Background="#192B3B" /><UniformGrid Columns="10" IsHitTestVisible="False"><Border BorderBrush="#D9EEF0" BorderThickness="0,0,1,0" /><Border BorderBrush="#D9EEF0" BorderThickness="0,0,1,0" /><Border BorderBrush="#D9EEF0" BorderThickness="0,0,1,0" /><Border BorderBrush="#D9EEF0" BorderThickness="0,0,1,0" /><Border BorderBrush="#D9EEF0" BorderThickness="0,0,1,0" /><Border BorderBrush="#D9EEF0" BorderThickness="0,0,1,0" /><Border BorderBrush="#D9EEF0" BorderThickness="0,0,1,0" /><Border BorderBrush="#D9EEF0" BorderThickness="0,0,1,0" /><Border BorderBrush="#D9EEF0" BorderThickness="0,0,1,0" /><Border /></UniformGrid></Grid><TextBlock Text="STATUS" Style="{StaticResource CacpLabelStyle}" FontSize="18" HorizontalAlignment="Center" Margin="0,25,0,3" /><Border Height="1" Background="#DDE8EA" /><TextBlock Text="{Binding DisplayStatus}" Style="{StaticResource CacpValueStyle}" FontSize="18" HorizontalAlignment="Center" Margin="0,6" /></StackPanel>
                                        <StackPanel Grid.Column="2"><Button Style="{StaticResource CacpKeyStyle}" Content="SCREEN&#x0a;CLEAN" Command="{Binding ExecuteActionCommand}" CommandParameter="Display:ScreenClean" /><Button Style="{StaticResource CacpKeyStyle}" Content="DISPLAY&#x0a;OFF" Command="{Binding ExecuteActionCommand}" CommandParameter="Display:Off" /></StackPanel>
                                    </Grid>
                                    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><Button Style="{StaticResource CacpNavStyle}" Content="MAIN MENU" Command="{Binding MainMenuCommand}" /><Button Grid.Column="1" Style="{StaticResource CacpNavStyle}" Content="PREVIOUS MENU" Command="{Binding PreviousMenuCommand}" /></Grid>
                                </Grid>

                                <!-- BOARDING MUSIC -->
                                <Grid Style="{StaticResource CacpPageStyle}" Visibility="{Binding SelectedPanel, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Boarding Music}">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel><TextBlock Text="BOARDING MUSIC" Style="{StaticResource CacpTitleStyle}" /><Border Height="2" Background="#A8F2D9" /></StackPanel>
                                    <Grid Grid.Row="1" Margin="45,12,45,3"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="BOARDING MUSIC" Style="{StaticResource CacpLabelStyle}" Margin="0,3" /><TextBlock Text="VOLUME" Style="{StaticResource CacpLabelStyle}" Margin="0,3" /><TextBlock Text="SOURCE" Style="{StaticResource CacpLabelStyle}" Margin="0,3" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding BoardingMusicStatus, StringFormat=—  {0}}" Style="{StaticResource CacpValueStyle}" FontSize="15" Margin="0,3" /><TextBlock Text="{Binding BoardingMusicLevel, StringFormat=—  {0}}" Style="{StaticResource CacpValueStyle}" FontSize="15" Margin="0,3" /><TextBlock Text="{Binding SelectedBoardingProgram, StringFormat=—  PROGRAM {0}}" Style="{StaticResource CacpValueStyle}" FontSize="15" Margin="0,3" /></StackPanel></Grid>
                                    <Grid Grid.Row="2" Margin="20,0"><Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><Button Style="{StaticResource CacpKeyStyle}" Content="MUSIC ON" Command="{Binding ExecuteActionCommand}" CommandParameter="Music:On" /><Button Grid.Column="1" Style="{StaticResource CacpKeyStyle}" Content="VOLUME UP" Command="{Binding ExecuteActionCommand}" CommandParameter="Music:VolumeUp" /><Button Grid.Column="2" Style="{StaticResource CacpKeyStyle}" Content="PROGRAM 1" Command="{Binding ExecuteActionCommand}" CommandParameter="Music:Program1" /><Button Grid.Row="1" Style="{StaticResource CacpKeyStyle}" Content="MUSIC OFF" Command="{Binding ExecuteActionCommand}" CommandParameter="Music:Off" /><Button Grid.Row="1" Grid.Column="1" Style="{StaticResource CacpKeyStyle}" Content="VOLUME DOWN" Command="{Binding ExecuteActionCommand}" CommandParameter="Music:VolumeDown" /><Button Grid.Row="1" Grid.Column="2" Style="{StaticResource CacpKeyStyle}" Content="PROGRAM 2" Command="{Binding ExecuteActionCommand}" CommandParameter="Music:Program2" /></Grid>
                                    <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><Button Style="{StaticResource CacpNavStyle}" Content="MAIN MENU" Command="{Binding MainMenuCommand}" /><Button Grid.Column="1" Style="{StaticResource CacpNavStyle}" Content="PREVIOUS MENU" Command="{Binding PreviousMenuCommand}" /></Grid>
                                </Grid>

                                <!-- SPECIAL FUNCTIONS -->
                                <Grid Style="{StaticResource CacpPageStyle}" Visibility="{Binding SelectedPanel, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Special Functions}">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel><TextBlock Text="SPECIAL FUNCTIONS" Style="{StaticResource CacpTitleStyle}" /><Border Height="2" Background="#A8F2D9" /></StackPanel>
                                    <Grid Grid.Row="1" Margin="16,8"><Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition Width="1.15*" /></Grid.ColumnDefinitions><Button Style="{StaticResource CacpKeyStyle}" Content="CABIN READY" Command="{Binding ExecuteActionCommand}" CommandParameter="Cabin ready" /><Button Grid.Column="1" Style="{StaticResource CacpKeyStyle}" Content="CREW REST" Command="{Binding ExecuteActionCommand}" CommandParameter="Crew rest" /><Button Grid.Row="1" Style="{StaticResource CacpKeyStyle}" Content="SMOKING&#x0a;ASSIGNMENTS" Command="{Binding ExecuteActionCommand}" CommandParameter="Smoking assignments" /><Button Grid.Row="1" Grid.Column="1" Style="{StaticResource CacpKeyStyle}" Content="SYSTEM&#x0a;MESSAGES" Command="{Binding ExecuteActionCommand}" CommandParameter="System messages" /><Button Grid.Row="2" Style="{StaticResource CacpKeyStyle}" Content="FUNCTION&#x0a;LOCKOUTS" Command="{Binding ExecuteActionCommand}" CommandParameter="Function lockouts" /><Button Grid.Row="2" Grid.Column="1" Style="{StaticResource CacpKeyStyle}" Content="CABIN STATUS" Command="{Binding ExecuteActionCommand}" CommandParameter="Cabin status" /><Border Grid.Row="2" Grid.Column="2" BorderBrush="#A8F2D9" BorderThickness="1" Margin="10" Padding="8"><TextBlock Text="NO ACTIVE MESSAGES" Style="{StaticResource CacpLabelStyle}" Foreground="#A8F2D9" TextAlignment="Center" VerticalAlignment="Center" /></Border></Grid>
                                    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><Button Style="{StaticResource CacpNavStyle}" Content="MAIN MENU" Command="{Binding MainMenuCommand}" /><Button Grid.Column="1" Style="{StaticResource CacpNavStyle}" Content="PREVIOUS MENU" Command="{Binding PreviousMenuCommand}" /></Grid>
                                </Grid>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="2" Margin="18,0"><TextBlock Text="BOEING 777" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontStyle="Italic" FontWeight="Bold" Foreground="#77766E" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Ellipse Width="8" Height="8" Fill="#55564F" Margin="0,0,6,0" /><Ellipse Width="8" Height="8" Fill="#30312D" Margin="0,0,18,0" /></StackPanel></Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel><TextBlock Text="Safety Video Test" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="British Airways first-release media source" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,8" /></StackPanel>
                        <Border Grid.Row="1" Height="148" Background="#020711" BorderBrush="#40526A" BorderThickness="1" CornerRadius="7" ClipToBounds="True"><Grid><Image Source="{Binding SafetyVideoThumbnailUrl, Mode=OneWay}" Stretch="UniformToFill" Opacity="0.72" /><Border Background="#55000818" /><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Button Width="52" Height="52" Content="▶" FontSize="20" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding OpenSafetyVideoCommand}" ToolTip="Open the YouTube test preview" /><TextBlock Text="{Binding SafetyVideoTitle}" Foreground="White" FontWeight="SemiBold" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Width="230" Margin="0,7,0,0" /></StackPanel></Grid></Border>
                        <StackPanel Grid.Row="2" Margin="0,6,0,3"><Button Style="{StaticResource PrimaryButtonStyle}" Content="Open YouTube Preview" Command="{Binding OpenSafetyVideoCommand}" /><TextBlock Text="{Binding SafetyVideoPreviewStatus}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,5,0,0" /></StackPanel>
                        <StackPanel Grid.Row="3"><Button Style="{StaticResource QueueButtonStyle}" Content="Stage safety video for aircraft" Command="{Binding QueueCommand}" CommandParameter="Safety demonstration video" /><Button Style="{StaticResource QueueButtonStyle}" Content="Stage boarding passenger address" Command="{Binding QueueCommand}" CommandParameter="Boarding passenger address" /></StackPanel>
                        <StackPanel Grid.Row="4" Margin="0,9,0,0"><Grid><TextBlock Text="BRIDGE QUEUE" Style="{StaticResource MutedTextStyle}" FontWeight="SemiBold" /><TextBlock Text="{Binding QueueDepth, StringFormat={}{0} staged}" HorizontalAlignment="Right" Foreground="#52B7FF" /></Grid><ListBox ItemsSource="{Binding ActivityQueue}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" Margin="0,4,0,0" /></StackPanel>
                        <StackPanel Grid.Row="5"><TextBlock Text="{Binding LastAction}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,4,0,7" /><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><Button Style="{StaticResource SecondaryButtonStyle}" Content="Clear" Command="{Binding ClearQueueCommand}" Margin="0,0,5,0" /><Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" Content="Save" Command="{Binding SaveCommand}" Margin="5,0,0,0" /></Grid></StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
