<UserControl x:Class="FreeFlight.CabinControl.App.Views.CabinControlPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="820" d:DesignWidth="1200"
             TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <UserControl.Resources>
        <!-- Reference artwork is a blueprint only. Every visible panel part is live WPF. -->
        <LinearGradientBrush x:Key="CacpBezelBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#393936" Offset="0" />
            <GradientStop Color="#242421" Offset="0.24" />
            <GradientStop Color="#151613" Offset="0.60" />
            <GradientStop Color="#292925" Offset="1" />
        </LinearGradientBrush>
        <RadialGradientBrush x:Key="CacpScreenBrush" Center="0.48,0.44" GradientOrigin="0.46,0.38" RadiusX="0.78" RadiusY="0.92">
            <GradientStop Color="#334C64" Offset="0" />
            <GradientStop Color="#2B435A" Offset="0.52" />
            <GradientStop Color="#21364B" Offset="1" />
        </RadialGradientBrush>
        <LinearGradientBrush x:Key="CacpKeyBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E8EDF2" Offset="0" />
            <GradientStop Color="#CFD7E0" Offset="0.48" />
            <GradientStop Color="#B5C0CC" Offset="1" />
        </LinearGradientBrush>
        <Style x:Key="CacpKeyStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Shadow" Margin="3,4,0,0" Background="#26313D" CornerRadius="3" Opacity="0.92" />
                            <Border x:Name="Key" Margin="0,0,3,4" Background="{StaticResource CacpKeyBrush}"
                                    BorderBrush="#F5F8FB" BorderThickness="2" CornerRadius="2" Padding="{TemplateBinding Padding}">
                                <TextBlock x:Name="Label" Text="{TemplateBinding Content}" Foreground="#1E3041"
                                           FontFamily="OCR A Extended, Consolas" FontSize="24" FontWeight="Normal"
                                           TextAlignment="Center" TextWrapping="Wrap" LineHeight="29"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Key" Property="Background" Value="#CBD2DA" /></Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Key" Property="Background" Value="#666C72" />
                                <Setter TargetName="Key" Property="BorderBrush" Value="#AEB5BC" />
                                <Setter TargetName="Label" Property="Foreground" Value="#FFFDFB" />
                                <Setter TargetName="Key" Property="RenderTransform"><Setter.Value><TranslateTransform Y="3" /></Setter.Value></Setter>
                                <Setter TargetName="Shadow" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CacpNavStyle" TargetType="Button" BasedOn="{StaticResource CacpKeyStyle}"><Setter Property="Padding" Value="8,3" /></Style>
        <Style x:Key="CacpTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A6EBD8" /><Setter Property="FontFamily" Value="OCR A Extended, Consolas" />
            <Setter Property="FontSize" Value="42" /><Setter Property="FontWeight" Value="Normal" />
            <Setter Property="TextAlignment" Value="Center" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CacpLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D8E2E8" /><Setter Property="FontFamily" Value="OCR A Extended, Consolas" />
            <Setter Property="FontSize" Value="25" /><Setter Property="FontWeight" Value="Normal" /><Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CacpValueStyle" TargetType="TextBlock" BasedOn="{StaticResource CacpLabelStyle}"><Setter Property="Foreground" Value="#A6EBD8" /></Style>
        <Style x:Key="CacpProgressStyle" TargetType="ProgressBar">
            <Setter Property="Background" Value="#24394E" /><Setter Property="Foreground" Value="#A6EBD8" />
            <Setter Property="BorderBrush" Value="#E5ECEE" /><Setter Property="BorderThickness" Value="2" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                    <Grid x:Name="PART_Track" Margin="3"><Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" /></Grid>
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="QueueButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Margin" Value="0,5,0,0" /><Setter Property="MinHeight" Value="36" /><Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="620" /></Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <StackPanel><TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" /><TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitleStyle}" /></StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse Width="13" Height="13" Fill="{Binding Status.ConnectionColor}" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding Status.ConnectionLabel}" Foreground="{Binding Status.ConnectionColor}" FontSize="14" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="306" /></Grid.ColumnDefinitions>

                <!-- Fixed reference geometry: 1040 x 812 panel with a 732 x 512 live LCD. -->
                <Viewbox x:Name="CacpPanelViewbox" Grid.Column="0" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Canvas Width="1040" Height="812">
                        <Border Canvas.Left="0" Canvas.Top="0" Width="1040" Height="812" Background="#090A09" BorderBrush="#50504B" BorderThickness="3" CornerRadius="29" />
                        <Border Canvas.Left="7" Canvas.Top="7" Width="1026" Height="798" Background="{StaticResource CacpBezelBrush}" BorderBrush="#181916" BorderThickness="3" CornerRadius="25" />
                        <Border Canvas.Left="17" Canvas.Top="17" Width="1006" Height="778" Background="Transparent" BorderBrush="#44443F" BorderThickness="1" CornerRadius="20" Opacity="0.75" />
                        <TextBlock Canvas.Left="0" Canvas.Top="54" Width="1040" Height="42" Text="C A B I N   A R E A   C O N T R O L   P A N E L"
                                   Foreground="#AAA79F" FontFamily="Segoe UI" FontSize="27" FontWeight="SemiBold" TextAlignment="Center" VerticalAlignment="Center" />
                        <Border Canvas.Left="123" Canvas.Top="111" Width="794" Height="570" Background="#060707" BorderBrush="#1A1B19" BorderThickness="8" CornerRadius="18">
                            <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="13" ShadowDepth="3" Opacity="0.92" /></Border.Effect>
                        </Border>
                        <Border Canvas.Left="139" Canvas.Top="127" Width="762" Height="538" Background="#111715" BorderBrush="#30322E" BorderThickness="4" CornerRadius="7" />

                        <Grid Canvas.Left="162" Canvas.Top="142" Width="716" Height="512" ClipToBounds="True" Background="{StaticResource CacpScreenBrush}">
                            <Grid.Effect><DropShadowEffect Color="#4B86A8" BlurRadius="10" ShadowDepth="0" Opacity="0.20" /></Grid.Effect>

                            <!-- CSCP MAIN MENU -->
                            <Canvas Width="716" Height="512" Visibility="{Binding SelectedPanel, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=CSCP Main Menu}">
                                <TextBlock Canvas.Left="0" Canvas.Top="4" Width="716" Height="51" Text="CSCP MAIN MENU" Style="{StaticResource CacpTitleStyle}" />
                                <Border Canvas.Left="0" Canvas.Top="54" Width="716" Height="3" Background="#A6EBD8" />
                                <Button Canvas.Left="51" Canvas.Top="226" Width="289" Height="69" Style="{StaticResource CacpKeyStyle}" Content="CABIN CONTROLS" Command="{Binding SelectPanelCommand}" CommandParameter="Main Menu" />
                                <Button Canvas.Left="379" Canvas.Top="226" Width="289" Height="69" Style="{StaticResource CacpKeyStyle}" Content="CABIN MAINTENANCE" Command="{Binding ExecuteActionCommand}" CommandParameter="Cabin maintenance" />
                                <Border Canvas.Left="0" Canvas.Top="444" Width="716" Height="3" Background="#A6EBD8" />
                                <Button Canvas.Left="47" Canvas.Top="455" Width="272" Height="47" Style="{StaticResource CacpNavStyle}" Content="MAIN MENU" Command="{Binding MainMenuCommand}" />
                                <Button Canvas.Left="399" Canvas.Top="455" Width="272" Height="47" Style="{StaticResource CacpNavStyle}" Content="PREVIOUS MENU" Command="{Binding PreviousMenuCommand}" />
                            </Canvas>

                            <!-- CABIN CONTROLS MAIN MENU -->
                            <Canvas Width="716" Height="512" Visibility="{Binding SelectedPanel, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Main Menu}">
                                <TextBlock Canvas.Left="0" Canvas.Top="4" Width="716" Height="51" Text="CABIN CONTROLS MAIN MENU" Style="{StaticResource CacpTitleStyle}" FontSize="34" />
                                <Border Canvas.Left="0" Canvas.Top="54" Width="716" Height="3" Background="#A6EBD8" />
                                <Button Canvas.Left="51" Canvas.Top="86" Width="289" Height="62" Style="{StaticResource CacpKeyStyle}" Content="LIGHTING" Command="{Binding SelectPanelCommand}" CommandParameter="Lighting Control" />
                                <Button Canvas.Left="379" Canvas.Top="86" Width="289" Height="62" Style="{StaticResource CacpKeyStyle}" Content="SERVICE CALL / CHIME" Command="{Binding SelectPanelCommand}" CommandParameter="Service Call / Chime" />
                                <Button Canvas.Left="51" Canvas.Top="158" Width="289" Height="62" Style="{StaticResource CacpKeyStyle}" Content="CABIN TEMPERATURE" Command="{Binding SelectPanelCommand}" CommandParameter="Cabin Temperature" />
                                <Button Canvas.Left="379" Canvas.Top="158" Width="289" Height="62" Style="{StaticResource CacpKeyStyle}" Content="WATER / WASTE STATUS" Command="{Binding SelectPanelCommand}" CommandParameter="Water / Waste Status" />
                                <Button Canvas.Left="51" Canvas.Top="229" Width="289" Height="62" Style="{StaticResource CacpKeyStyle}" Content="PASSENGER ADDRESS" Command="{Binding SelectPanelCommand}" CommandParameter="Passenger Address" />
                                <Button Canvas.Left="379" Canvas.Top="229" Width="289" Height="62" Style="{StaticResource CacpKeyStyle}" Content="CABIN DOOR STATUS" Command="{Binding SelectPanelCommand}" CommandParameter="Cabin Door Status" />
                                <Button Canvas.Left="51" Canvas.Top="300" Width="289" Height="62" Style="{StaticResource CacpKeyStyle}" Content="DISPLAY CONTROLS" Command="{Binding SelectPanelCommand}" CommandParameter="Display Controls" />
                                <Button Canvas.Left="379" Canvas.Top="300" Width="289" Height="62" Style="{StaticResource CacpKeyStyle}" Content="BOARDING MUSIC" Command="{Binding SelectPanelCommand}" CommandParameter="Boarding Music" />
                                <Button Canvas.Left="51" Canvas.Top="371" Width="289" Height="62" Style="{StaticResource CacpKeyStyle}" Content="SPECIAL FUNCTIONS" Command="{Binding SelectPanelCommand}" CommandParameter="Special Functions" />
                                <Button Canvas.Left="379" Canvas.Top="371" Width="289" Height="62" Style="{StaticResource CacpKeyStyle}" Content="PANEL OVERRIDE" Command="{Binding SelectPanelCommand}" CommandParameter="System Pop-up Windows" />
                                <Border Canvas.Left="0" Canvas.Top="444" Width="716" Height="3" Background="#A6EBD8" />
                                <Button Canvas.Left="47" Canvas.Top="455" Width="272" Height="47" Style="{StaticResource CacpNavStyle}" Content="MAIN MENU" Command="{Binding MainMenuCommand}" />
                                <Button Canvas.Left="399" Canvas.Top="455" Width="272" Height="47" Style="{StaticResource CacpNavStyle}" Content="PREVIOUS MENU" Command="{Binding PreviousMenuCommand}" />
                            </Canvas>

                            <!-- LIGHTING CONTROL -->
                            <Canvas Width="716" Height="512" Visibility="{Binding SelectedPanel, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Lighting Control}">
                                <TextBlock Canvas.Left="0" Canvas.Top="4" Width="716" Height="51" Text="LIGHTING CONTROL" Style="{StaticResource CacpTitleStyle}" />
                                <Border Canvas.Left="0" Canvas.Top="54" Width="716" Height="3" Background="#A6EBD8" />
                                <Button Canvas.Left="32" Canvas.Top="78" Width="210" Height="91" Style="{StaticResource CacpKeyStyle}" Content="CABIN&#x0a;LIGHTING" Command="{Binding SelectPanelCommand}" CommandParameter="Cabin Lighting" />
                                <Button Canvas.Left="258" Canvas.Top="78" Width="207" Height="91" Style="{StaticResource CacpKeyStyle}" Content="ENTRY WAY&#x0a;LIGHTS" Command="{Binding SelectPanelCommand}" CommandParameter="Entry Way Lights" />
                                <Button Canvas.Left="32" Canvas.Top="184" Width="210" Height="91" Style="{StaticResource CacpKeyStyle}" Content="READING&#x0a;LIGHTS" Command="{Binding SelectPanelCommand}" CommandParameter="Reading Lights" />
                                <Button Canvas.Left="258" Canvas.Top="184" Width="207" Height="91" Style="{StaticResource CacpKeyStyle}" Content="GALLEY&#x0a;LIGHTS" Command="{Binding ExecuteActionCommand}" CommandParameter="Lighting:Galley Lights" />
                                <Button Canvas.Left="32" Canvas.Top="290" Width="210" Height="91" Style="{StaticResource CacpKeyStyle}" Content="LAVATORY&#x0a;LIGHTS" Command="{Binding ExecuteActionCommand}" CommandParameter="Lighting:Lavatory Lights" />
                                <Button Canvas.Left="258" Canvas.Top="290" Width="207" Height="91" Style="{StaticResource CacpKeyStyle}" Content="WORK&#x0a;LIGHTS" Command="{Binding ExecuteActionCommand}" CommandParameter="Lighting:Work Lights" />
                                <Border Canvas.Left="502" Canvas.Top="119" Width="203" Height="149" BorderBrush="#A6EBD8" BorderThickness="2" CornerRadius="6">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="CURRENT AREA" Style="{StaticResource CacpValueStyle}" FontSize="22" HorizontalAlignment="Center" />
                                        <TextBlock Text="—" Style="{StaticResource CacpValueStyle}" FontSize="24" HorizontalAlignment="Center" Margin="0,6" />
                                        <TextBlock Text="{Binding SelectedLightingArea}" Style="{StaticResource CacpValueStyle}" FontSize="21" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Canvas.Left="8" Canvas.Top="412" Width="716" Height="3" Background="#A6EBD8" />
                                <Button Canvas.Left="82" Canvas.Top="427" Width="251" Height="67" Style="{StaticResource CacpNavStyle}" Content="MAIN MENU" Command="{Binding MainMenuCommand}" />
                                <Button Canvas.Left="406" Canvas.Top="427" Width="262" Height="67" Style="{StaticResource CacpNavStyle}" Content="PREVIOUS MENU" Command="{Binding PreviousMenuCommand}" />
                            </Canvas>

                            <!-- CABIN LIGHTING -->
                            <Canvas Width="716" Height="512" Visibility="{Binding SelectedPanel, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Cabin Lighting}">
                                <TextBlock Canvas.Left="0" Canvas.Top="4" Width="716" Height="51" Text="CABIN LIGHTING" Style="{StaticResource CacpTitleStyle}" />
                                <Border Canvas.Left="0" Canvas.Top="54" Width="716" Height="3" Background="#A6EBD8" />
                                <Button Canvas.Left="51" Canvas.Top="108" Width="289" Height="68" Style="{StaticResource CacpKeyStyle}" Content="AREA: ALL CABIN" Command="{Binding ExecuteActionCommand}" CommandParameter="CabinLighting:All Cabin" />
                                <Button Canvas.Left="379" Canvas.Top="108" Width="289" Height="68" Style="{StaticResource CacpKeyStyle}" Content="SCENE: BOARDING" Command="{Binding ExecuteActionCommand}" CommandParameter="CabinLighting:Boarding" />
                                <Button Canvas.Left="51" Canvas.Top="185" Width="289" Height="68" Style="{StaticResource CacpKeyStyle}" Content="HIGH" Command="{Binding ExecuteActionCommand}" CommandParameter="CabinLighting:High" />
                                <Button Canvas.Left="379" Canvas.Top="185" Width="289" Height="68" Style="{StaticResource CacpKeyStyle}" Content="MEDIUM" Command="{Binding ExecuteActionCommand}" CommandParameter="CabinLighting:Medium" />
                                <Button Canvas.Left="51" Canvas.Top="262" Width="289" Height="68" Style="{StaticResource CacpKeyStyle}" Content="LOW" Command="{Binding ExecuteActionCommand}" CommandParameter="CabinLighting:Low" />
                                <Button Canvas.Left="379" Canvas.Top="262" Width="289" Height="68" Style="{StaticResource CacpKeyStyle}" Content="OFF" Command="{Binding ExecuteActionCommand}" CommandParameter="CabinLighting:Off" />
                                <Button Canvas.Left="51" Canvas.Top="339" Width="289" Height="68" Style="{StaticResource CacpKeyStyle}" Content="HOLD SCENE" Command="{Binding ExecuteActionCommand}" CommandParameter="CabinLighting:Hold Scene" />
                                <Button Canvas.Left="379" Canvas.Top="339" Width="289" Height="68" Style="{StaticResource CacpKeyStyle}" Content="RESUME SCENE" Command="{Binding ExecuteActionCommand}" CommandParameter="CabinLighting:Resume Scene" />
                                <Border Canvas.Left="0" Canvas.Top="444" Width="716" Height="3" Background="#A6EBD8" />
                                <Button Canvas.Left="47" Canvas.Top="455" Width="272" Height="47" Style="{StaticResource CacpNavStyle}" Content="MAIN MENU" Command="{Binding MainMenuCommand}" />
                                <Button Canvas.Left="399" Canvas.Top="455" Width="272" Height="47" Style="{StaticResource CacpNavStyle}" Content="PREVIOUS MENU" Command="{Binding PreviousMenuCommand}" />
                            </Canvas>

                            <!-- ENTRY WAY LIGHTS -->
                            <Canvas Width="716" Height="512" Visibility="{Binding SelectedPanel, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Entry Way Lights}">
                                <TextBlock Canvas.Left="0" Canvas.Top="4" Width="716" Height="51" Text="ENTRY WAY LIGHTS" Style="{StaticResource CacpTitleStyle}" />
                                <Border Canvas.Left="0" Canvas.Top="54" Width="716" Height="3" Background="#A6EBD8" />
                                <Button Canvas.Left="51" Canvas.Top="148" Width="289" Height="68" Style="{StaticResource CacpKeyStyle}" Content="AREA: FORWARD ENTRY" Command="{Binding ExecuteActionCommand}" CommandParameter="EntryLights:Forward" />
                                <Button Canvas.Left="379" Canvas.Top="148" Width="289" Height="68" Style="{StaticResource CacpKeyStyle}" Content="AREA: AFT ENTRY" Command="{Binding ExecuteActionCommand}" CommandParameter="EntryLights:Aft" />
                                <Button Canvas.Left="51" Canvas.Top="225" Width="289" Height="68" Style="{StaticResource CacpKeyStyle}" Content="ENTRY ON" Command="{Binding ExecuteActionCommand}" CommandParameter="EntryLights:On" />
                                <Button Canvas.Left="379" Canvas.Top="225" Width="289" Height="68" Style="{StaticResource CacpKeyStyle}" Content="ENTRY OFF" Command="{Binding ExecuteActionCommand}" CommandParameter="EntryLights:Off" />
                                <Button Canvas.Left="51" Canvas.Top="302" Width="289" Height="68" Style="{StaticResource CacpKeyStyle}" Content="WORK ON" Command="{Binding ExecuteActionCommand}" CommandParameter="EntryLights:Work On" />
                                <Button Canvas.Left="379" Canvas.Top="302" Width="289" Height="68" Style="{StaticResource CacpKeyStyle}" Content="WORK OFF" Command="{Binding ExecuteActionCommand}" CommandParameter="EntryLights:Work Off" />
                                <Border Canvas.Left="0" Canvas.Top="444" Width="716" Height="3" Background="#A6EBD8" />
                                <Button Canvas.Left="47" Canvas.Top="455" Width="272" Height="47" Style="{StaticResource CacpNavStyle}" Content="MAIN MENU" Command="{Binding MainMenuCommand}" />
                                <Button Canvas.Left="399" Canvas.Top="455" Width="272" Height="47" Style="{StaticResource CacpNavStyle}" Content="PREVIOUS MENU" Command="{Binding PreviousMenuCommand}" />
                            </Canvas>

                            <!-- READING LIGHTS -->
                            <Canvas Width="716" Height="512" Visibility="{Binding SelectedPanel, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Reading Lights}">
                                <TextBlock Canvas.Left="0" Canvas.Top="4" Width="716" Height="51" Text="READING LIGHTS" Style="{StaticResource CacpTitleStyle}" />
                                <Border Canvas.Left="0" Canvas.Top="54" Width="716" Height="3" Background="#A6EBD8" />
                                <Button Canvas.Left="51" Canvas.Top="148" Width="289" Height="68" Style="{StaticResource CacpKeyStyle}" Content="AREA: ALL CABIN" Command="{Binding ExecuteActionCommand}" CommandParameter="ReadingLights:All Cabin" />
                                <Button Canvas.Left="379" Canvas.Top="148" Width="289" Height="68" Style="{StaticResource CacpKeyStyle}" Content="AREA SELECTION" Command="{Binding ExecuteActionCommand}" CommandParameter="ReadingLights:Area Selection" />
                                <Button Canvas.Left="51" Canvas.Top="225" Width="289" Height="68" Style="{StaticResource CacpKeyStyle}" Content="READING LIGHTS ON" Command="{Binding ExecuteActionCommand}" CommandParameter="ReadingLights:On" />
                                <Button Canvas.Left="379" Canvas.Top="225" Width="289" Height="68" Style="{StaticResource CacpKeyStyle}" Content="READING LIGHTS OFF" Command="{Binding ExecuteActionCommand}" CommandParameter="ReadingLights:Off" />
                                <Button Canvas.Left="51" Canvas.Top="302" Width="289" Height="68" Style="{StaticResource CacpKeyStyle}" Content="RESET SELECTION" Command="{Binding ExecuteActionCommand}" CommandParameter="ReadingLights:Reset Selection" />
                                <Button Canvas.Left="379" Canvas.Top="302" Width="289" Height="68" Style="{StaticResource CacpKeyStyle}" Content="PANEL OVERRIDE" Command="{Binding SelectPanelCommand}" CommandParameter="System Pop-up Windows" />
                                <Border Canvas.Left="0" Canvas.Top="444" Width="716" Height="3" Background="#A6EBD8" />
                                <Button Canvas.Left="47" Canvas.Top="455" Width="272" Height="47" Style="{StaticResource CacpNavStyle}" Content="MAIN MENU" Command="{Binding MainMenuCommand}" />
                                <Button Canvas.Left="399" Canvas.Top="455" Width="272" Height="47" Style="{StaticResource CacpNavStyle}" Content="PREVIOUS MENU" Command="{Binding PreviousMenuCommand}" />
                            </Canvas>

                            <!-- SERVICE CALL / CHIME -->
                            <Canvas Width="716" Height="512" Visibility="{Binding SelectedPanel, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Service Call / Chime}">
                                <TextBlock Canvas.Left="0" Canvas.Top="4" Width="716" Height="51" Text="SERVICE CALL / CHIME" Style="{StaticResource CacpTitleStyle}" />
                                <Border Canvas.Left="0" Canvas.Top="54" Width="716" Height="3" Background="#A6EBD8" />
                                <TextBlock Canvas.Left="45" Canvas.Top="78" Width="280" Height="43" Text="PASSENGER CALLS" Style="{StaticResource CacpLabelStyle}" FontSize="23" />
                                <TextBlock Canvas.Left="350" Canvas.Top="78" Width="190" Height="43" Text="ENABLED" Style="{StaticResource CacpLabelStyle}" FontSize="23" />
                                <TextBlock Canvas.Left="45" Canvas.Top="126" Width="280" Height="43" Text="LAVATORY CALLS" Style="{StaticResource CacpLabelStyle}" FontSize="23" />
                                <TextBlock Canvas.Left="350" Canvas.Top="126" Width="190" Height="43" Text="ENABLED" Style="{StaticResource CacpLabelStyle}" FontSize="23" />
                                <TextBlock Canvas.Left="45" Canvas.Top="174" Width="280" Height="43" Text="ATTENDANT CHIME" Style="{StaticResource CacpLabelStyle}" FontSize="23" />
                                <TextBlock Canvas.Left="350" Canvas.Top="174" Width="190" Height="43" Text="{Binding AttendantChimeStatus}" Style="{StaticResource CacpLabelStyle}" FontSize="23" />
                                <Border Canvas.Left="21" Canvas.Top="237" Width="690" Height="3" Background="#A6EBD8" />
                                <Button Canvas.Left="31" Canvas.Top="258" Width="211" Height="87" Style="{StaticResource CacpKeyStyle}" Content="RESET CALLS" Command="{Binding ExecuteActionCommand}" CommandParameter="Calls:Reset" />
                                <Button Canvas.Left="260" Canvas.Top="258" Width="211" Height="87" Style="{StaticResource CacpKeyStyle}" Content="CHIME ON" Command="{Binding ExecuteActionCommand}" CommandParameter="Chime:On" />
                                <Button Canvas.Left="489" Canvas.Top="258" Width="211" Height="87" Style="{StaticResource CacpKeyStyle}" Content="CHIME OFF" Command="{Binding ExecuteActionCommand}" CommandParameter="Chime:Off" />
                                <TextBlock Canvas.Left="0" Canvas.Top="360" Width="716" Height="42" Text="NO ACTIVE CALLS" Style="{StaticResource CacpLabelStyle}" FontSize="26" TextAlignment="Center" />
                                <Button Canvas.Left="31" Canvas.Top="432" Width="285" Height="68" Style="{StaticResource CacpNavStyle}" Content="MAIN MENU" Command="{Binding MainMenuCommand}" />
                                <Button Canvas.Left="402" Canvas.Top="432" Width="297" Height="68" Style="{StaticResource CacpNavStyle}" Content="PREVIOUS MENU" Command="{Binding PreviousMenuCommand}" />
                            </Canvas>

                            <!-- CABIN TEMPERATURE -->
                            <Canvas Width="716" Height="512" Visibility="{Binding SelectedPanel, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Cabin Temperature}">
                                <TextBlock Canvas.Left="0" Canvas.Top="4" Width="716" Height="51" Text="CABIN TEMPERATURE" Style="{StaticResource CacpTitleStyle}" />
                                <Border Canvas.Left="0" Canvas.Top="54" Width="716" Height="3" Background="#A6EBD8" />
                                <Button Canvas.Left="32" Canvas.Top="92" Width="178" Height="76" Style="{StaticResource CacpKeyStyle}" Content="ZONE 1" Command="{Binding ExecuteActionCommand}" CommandParameter="Temp:Zone 1" />
