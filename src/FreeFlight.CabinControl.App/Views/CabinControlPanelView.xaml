                                <Button Canvas.Left="432" Canvas.Top="441" Width="174" Height="74" Style="{StaticResource CacpHotspotStyle}" Content="ZONE 2" Command="{Binding ExecuteActionCommand}" CommandParameter="Temp:Zone 2" />
                                <Button Canvas.Left="432" Canvas.Top="547" Width="174" Height="74" Style="{StaticResource CacpHotspotStyle}" Content="ZONE 3" Command="{Binding ExecuteActionCommand}" CommandParameter="Temp:Zone 3" />
                                <Border Canvas.Left="631" Canvas.Top="351" Width="108" Height="49" Background="#FF2B4359"><TextBlock Text="{Binding Zone1TemperatureC, StringFormat={}{0}°C}" Style="{StaticResource CacpReadoutStyle}" FontSize="38" /></Border>
                                <Border Canvas.Left="631" Canvas.Top="457" Width="108" Height="49" Background="#FF2B4359"><TextBlock Text="{Binding Zone2TemperatureC, StringFormat={}{0}°C}" Style="{StaticResource CacpReadoutStyle}" FontSize="38" /></Border>
                                <Border Canvas.Left="631" Canvas.Top="563" Width="108" Height="49" Background="#FF2B4359"><TextBlock Text="{Binding Zone3TemperatureC, StringFormat={}{0}°C}" Style="{StaticResource CacpReadoutStyle}" FontSize="38" /></Border>
                                <Border Canvas.Left="867" Canvas.Top="362" Width="166" Height="70" Background="#FF2A4359"><TextBlock Text="{Binding SelectedTemperatureC, StringFormat={}{0}°C}" Style="{StaticResource CacpReadoutStyle}" FontSize="55" /></Border>
                                <Button Canvas.Left="815" Canvas.Top="446" Width="243" Height="70" Style="{StaticResource CacpHotspotStyle}" Content="▲  INCREASE" Command="{Binding ExecuteActionCommand}" CommandParameter="Temp:Increase" />
                                <Button Canvas.Left="815" Canvas.Top="532" Width="243" Height="70" Style="{StaticResource CacpHotspotStyle}" Content="▼  DECREASE" Command="{Binding ExecuteActionCommand}" CommandParameter="Temp:Decrease" />
                                <Button Canvas.Left="434" Canvas.Top="677" Width="298" Height="60" Style="{StaticResource CacpHotspotStyle}" Content="MAIN MENU" Command="{Binding MainMenuCommand}" />
                                <Button Canvas.Left="780" Canvas.Top="678" Width="289" Height="60" Style="{StaticResource CacpHotspotStyle}" Content="PREVIOUS MENU" Command="{Binding PreviousMenuCommand}" />
                            </Canvas>

                            <Canvas Width="1536" Height="1024" Visibility="{Binding SelectedPanel, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Water / Waste Status}">
                                <Image Source="pack://application:,,,/FreeFlight.CabinControl;component/Assets/CacpPages/05_Water_Waste_Status.png" Width="1536" Height="1024" />
                                <Button Canvas.Left="501" Canvas.Top="578" Width="228" Height="82" Style="{StaticResource CacpHotspotStyle}" Content="LAVATORY&#x0a;STATUS" Command="{Binding ExecuteActionCommand}" CommandParameter="Lavatory status" />
                                <Button Canvas.Left="784" Canvas.Top="579" Width="226" Height="82" Style="{StaticResource CacpHotspotStyle}" Content="INOPERATIVE&#x0a;CONTROL" Command="{Binding ExecuteActionCommand}" CommandParameter="Inoperative control" />
                                <Button Canvas.Left="432" Canvas.Top="687" Width="300" Height="57" Style="{StaticResource CacpHotspotStyle}" Content="MAIN MENU" Command="{Binding MainMenuCommand}" />
                                <Button Canvas.Left="777" Canvas.Top="690" Width="296" Height="56" Style="{StaticResource CacpHotspotStyle}" Content="PREVIOUS MENU" Command="{Binding PreviousMenuCommand}" />
                            </Canvas>

                            <Canvas Width="1536" Height="1024" Visibility="{Binding SelectedPanel, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Passenger Address}">
                                <Image Source="pack://application:,,,/FreeFlight.CabinControl;component/Assets/CacpPages/06_Passenger_Address.png" Width="1536" Height="1024" />
                                <Border Canvas.Left="634" Canvas.Top="329" Width="62" Height="52" Background="#FF2A4359"><TextBlock Text="{Binding PaVolumeLevel}" Style="{StaticResource CacpReadoutStyle}" FontSize="34" /></Border>
                                <Border Canvas.Left="626" Canvas.Top="438" Width="84" Height="51" Background="#FF2A4359"><TextBlock Text="{Binding AmbientNoiseSensorStatus}" Style="{StaticResource CacpReadoutStyle}" FontSize="30" /></Border>
                                <Button Canvas.Left="723" Canvas.Top="320" Width="177" Height="87" Style="{StaticResource CacpHotspotStyle}" Content="VOLUME UP" Command="{Binding ExecuteActionCommand}" CommandParameter="PA:VolumeUp" />
                                <Button Canvas.Left="915" Canvas.Top="321" Width="179" Height="87" Style="{StaticResource CacpHotspotStyle}" Content="VOLUME DOWN" Command="{Binding ExecuteActionCommand}" CommandParameter="PA:VolumeDown" />
                                <Button Canvas.Left="723" Canvas.Top="429" Width="176" Height="86" Style="{StaticResource CacpHotspotStyle}" Content="SENSOR ON" Command="{Binding ExecuteActionCommand}" CommandParameter="PA:SensorOn" />
                                <Button Canvas.Left="915" Canvas.Top="430" Width="178" Height="86" Style="{StaticResource CacpHotspotStyle}" Content="SENSOR OFF" Command="{Binding ExecuteActionCommand}" CommandParameter="PA:SensorOff" />
                                <Button Canvas.Left="422" Canvas.Top="686" Width="236" Height="61" Style="{StaticResource CacpHotspotStyle}" Content="MAIN MENU" Command="{Binding MainMenuCommand}" />
                                <Button Canvas.Left="831" Canvas.Top="690" Width="251" Height="61" Style="{StaticResource CacpHotspotStyle}" Content="PREVIOUS MENU" Command="{Binding PreviousMenuCommand}" />
                            </Canvas>

                            <Canvas Width="1536" Height="1024" Visibility="{Binding SelectedPanel, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Cabin Door Status}">
                                <Image Source="pack://application:,,,/FreeFlight.CabinControl;component/Assets/CacpPages/07_Cabin_Door_Status.png" Width="1536" Height="1024" />
                                <Border Canvas.Left="523" Canvas.Top="322" Width="130" Height="255" Background="#FF2B445A"><StackPanel><TextBlock Text="UNKNOWN" Style="{StaticResource CacpReadoutStyle}" Foreground="#FFC866" FontSize="27" Height="51" /><TextBlock Text="UNKNOWN" Style="{StaticResource CacpReadoutStyle}" Foreground="#FFC866" FontSize="27" Height="54" /><TextBlock Text="UNKNOWN" Style="{StaticResource CacpReadoutStyle}" Foreground="#FFC866" FontSize="27" Height="54" /><TextBlock Text="UNKNOWN" Style="{StaticResource CacpReadoutStyle}" Foreground="#FFC866" FontSize="27" Height="53" /><TextBlock Text="UNKNOWN" Style="{StaticResource CacpReadoutStyle}" Foreground="#FFC866" FontSize="27" Height="51" /></StackPanel></Border>
                                <Border Canvas.Left="872" Canvas.Top="322" Width="130" Height="255" Background="#FF2B445A"><StackPanel><TextBlock Text="UNKNOWN" Style="{StaticResource CacpReadoutStyle}" Foreground="#FFC866" FontSize="27" Height="51" /><TextBlock Text="UNKNOWN" Style="{StaticResource CacpReadoutStyle}" Foreground="#FFC866" FontSize="27" Height="54" /><TextBlock Text="UNKNOWN" Style="{StaticResource CacpReadoutStyle}" Foreground="#FFC866" FontSize="27" Height="54" /><TextBlock Text="UNKNOWN" Style="{StaticResource CacpReadoutStyle}" Foreground="#FFC866" FontSize="27" Height="53" /><TextBlock Text="UNKNOWN" Style="{StaticResource CacpReadoutStyle}" Foreground="#FFC866" FontSize="27" Height="51" /></StackPanel></Border>
                                <Border Canvas.Left="586" Canvas.Top="620" Width="364" Height="48" Background="#FF2B445A"><TextBlock Text="TELEMETRY OFFLINE" Style="{StaticResource CacpReadoutStyle}" Foreground="#FFC866" FontSize="32" /></Border>
                                <Button Canvas.Left="423" Canvas.Top="672" Width="250" Height="66" Style="{StaticResource CacpHotspotStyle}" Content="MAIN MENU" Command="{Binding MainMenuCommand}" />
                                <Button Canvas.Left="835" Canvas.Top="676" Width="249" Height="65" Style="{StaticResource CacpHotspotStyle}" Content="PREVIOUS MENU" Command="{Binding PreviousMenuCommand}" />
                            </Canvas>

                            <Canvas Width="1536" Height="1024" Visibility="{Binding SelectedPanel, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Display Controls}">
                                <Image Source="pack://application:,,,/FreeFlight.CabinControl;component/Assets/CacpPages/08_Display_Controls.png" Width="1536" Height="1024" />
                                <Button Canvas.Left="419" Canvas.Top="317" Width="180" Height="81" Style="{StaticResource CacpHotspotStyle}" Content="BRIGHTNESS&#x0a;UP" Command="{Binding ExecuteActionCommand}" CommandParameter="Display:BrightnessUp" />
                                <Button Canvas.Left="419" Canvas.Top="410" Width="180" Height="79" Style="{StaticResource CacpHotspotStyle}" Content="BRIGHTNESS&#x0a;DOWN" Command="{Binding ExecuteActionCommand}" CommandParameter="Display:BrightnessDown" />
                                <Button Canvas.Left="420" Canvas.Top="501" Width="179" Height="78" Style="{StaticResource CacpHotspotStyle}" Content="DAY MODE" Command="{Binding ExecuteActionCommand}" CommandParameter="Display:Day" />
                                <Button Canvas.Left="420" Canvas.Top="592" Width="179" Height="79" Style="{StaticResource CacpHotspotStyle}" Content="NIGHT MODE" Command="{Binding ExecuteActionCommand}" CommandParameter="Display:Night" />
                                <Button Canvas.Left="917" Canvas.Top="319" Width="177" Height="82" Style="{StaticResource CacpHotspotStyle}" Content="SCREEN&#x0a;CLEAN" Command="{Binding ExecuteActionCommand}" CommandParameter="Display:ScreenClean" />
                                <Button Canvas.Left="917" Canvas.Top="416" Width="177" Height="79" Style="{StaticResource CacpHotspotStyle}" Content="DISPLAY&#x0a;OFF" Command="{Binding ExecuteActionCommand}" CommandParameter="Display:Off" />
                                <Border Canvas.Left="707" Canvas.Top="398" Width="105" Height="47" Background="#FF2A4359"><TextBlock Text="{Binding DisplayBrightness, StringFormat={}{0}%}" Style="{StaticResource CacpReadoutStyle}" FontSize="36" /></Border>
                                <Border Canvas.Left="656" Canvas.Top="603" Width="223" Height="51" Background="#FF2A4359"><TextBlock Text="{Binding DisplayStatus}" Style="{StaticResource CacpReadoutStyle}" FontSize="27" /></Border>
                                <Button Canvas.Left="420" Canvas.Top="684" Width="271" Height="59" Style="{StaticResource CacpHotspotStyle}" Content="MAIN MENU" Command="{Binding MainMenuCommand}" />
                                <Button Canvas.Left="818" Canvas.Top="686" Width="269" Height="59" Style="{StaticResource CacpHotspotStyle}" Content="PREVIOUS MENU" Command="{Binding PreviousMenuCommand}" />
                            </Canvas>

                            <Canvas Width="1536" Height="1024" Visibility="{Binding SelectedPanel, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Boarding Music}">
                                <Image Source="pack://application:,,,/FreeFlight.CabinControl;component/Assets/CacpPages/09_Boarding_Music.png" Width="1536" Height="1024" />
                                <Border Canvas.Left="695" Canvas.Top="312" Width="166" Height="146" Background="#FF2A4359"><StackPanel><TextBlock Text="{Binding BoardingMusicStatus, StringFormat=—  {0}}" Style="{StaticResource CacpReadoutStyle}" FontSize="27" Height="50" /><TextBlock Text="{Binding BoardingMusicLevel, StringFormat=—  {0}}" Style="{StaticResource CacpReadoutStyle}" FontSize="27" Height="50" /><TextBlock Text="{Binding SelectedBoardingProgram, StringFormat=—  PROGRAM {0}}" Style="{StaticResource CacpReadoutStyle}" FontSize="25" Height="46" /></StackPanel></Border>
                                <Button Canvas.Left="435" Canvas.Top="473" Width="203" Height="89" Style="{StaticResource CacpHotspotStyle}" Content="MUSIC ON" Command="{Binding ExecuteActionCommand}" CommandParameter="Music:On" />
                                <Button Canvas.Left="658" Canvas.Top="474" Width="202" Height="89" Style="{StaticResource CacpHotspotStyle}" Content="VOLUME UP" Command="{Binding ExecuteActionCommand}" CommandParameter="Music:VolumeUp" />
                                <Button Canvas.Left="882" Canvas.Top="476" Width="196" Height="89" Style="{StaticResource CacpHotspotStyle}" Content="PROGRAM 1" Command="{Binding ExecuteActionCommand}" CommandParameter="Music:Program1" />
                                <Button Canvas.Left="435" Canvas.Top="578" Width="203" Height="89" Style="{StaticResource CacpHotspotStyle}" Content="MUSIC OFF" Command="{Binding ExecuteActionCommand}" CommandParameter="Music:Off" />
                                <Button Canvas.Left="658" Canvas.Top="579" Width="202" Height="89" Style="{StaticResource CacpHotspotStyle}" Content="VOLUME DOWN" Command="{Binding ExecuteActionCommand}" CommandParameter="Music:VolumeDown" />
                                <Button Canvas.Left="882" Canvas.Top="582" Width="196" Height="87" Style="{StaticResource CacpHotspotStyle}" Content="PROGRAM 2" Command="{Binding ExecuteActionCommand}" CommandParameter="Music:Program2" />
                                <Button Canvas.Left="434" Canvas.Top="697" Width="305" Height="48" Style="{StaticResource CacpHotspotStyle}" Content="MAIN MENU" Command="{Binding MainMenuCommand}" />
                                <Button Canvas.Left="774" Canvas.Top="699" Width="302" Height="48" Style="{StaticResource CacpHotspotStyle}" Content="PREVIOUS MENU" Command="{Binding PreviousMenuCommand}" />
                            </Canvas>

                            <Canvas Width="1536" Height="1024" Visibility="{Binding SelectedPanel, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Special Functions}">
                                <Image Source="pack://application:,,,/FreeFlight.CabinControl;component/Assets/CacpPages/10_Special_Functions.png" Width="1536" Height="1024" />
                                <Button Canvas.Left="430" Canvas.Top="319" Width="233" Height="91" Style="{StaticResource CacpHotspotStyle}" Content="CABIN READY" Command="{Binding ExecuteActionCommand}" CommandParameter="Cabin ready" />
                                <Button Canvas.Left="687" Canvas.Top="320" Width="219" Height="91" Style="{StaticResource CacpHotspotStyle}" Content="CREW REST" Command="{Binding ExecuteActionCommand}" CommandParameter="Crew rest" />
                                <Button Canvas.Left="430" Canvas.Top="426" Width="233" Height="90" Style="{StaticResource CacpHotspotStyle}" Content="SMOKING&#x0a;ASSIGNMENTS" Command="{Binding ExecuteActionCommand}" CommandParameter="Smoking assignments" />
                                <Button Canvas.Left="688" Canvas.Top="427" Width="217" Height="89" Style="{StaticResource CacpHotspotStyle}" Content="SYSTEM&#x0a;MESSAGES" Command="{Binding ExecuteActionCommand}" CommandParameter="System messages" />
                                <Button Canvas.Left="430" Canvas.Top="532" Width="233" Height="90" Style="{StaticResource CacpHotspotStyle}" Content="FUNCTION&#x0a;LOCKOUTS" Command="{Binding ExecuteActionCommand}" CommandParameter="Function lockouts" />
                                <Button Canvas.Left="687" Canvas.Top="535" Width="217" Height="89" Style="{StaticResource CacpHotspotStyle}" Content="CABIN STATUS" Command="{Binding ExecuteActionCommand}" CommandParameter="Cabin status" />
                                <Button Canvas.Left="431" Canvas.Top="695" Width="210" Height="51" Style="{StaticResource CacpHotspotStyle}" Content="MAIN MENU" Command="{Binding MainMenuCommand}" />
                                <Button Canvas.Left="659" Canvas.Top="696" Width="214" Height="51" Style="{StaticResource CacpHotspotStyle}" Content="PREVIOUS MENU" Command="{Binding PreviousMenuCommand}" />
                            </Canvas>
                        </Grid>
                    </Viewbox>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel><TextBlock Text="Safety Video Test" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="British Airways first-release media source" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,8" /></StackPanel>
                        <Border Grid.Row="1" Height="148" Background="#020711" BorderBrush="#40526A" BorderThickness="1" CornerRadius="7" ClipToBounds="True">
                            <Grid>
                                <Image Source="{Binding SafetyVideoThumbnailUrl, Mode=OneWay}" Stretch="UniformToFill" Opacity="0.72" />
                                <Border Background="#55000818" />
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Button Width="52" Height="52" Content="▶" FontSize="20" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding OpenSafetyVideoCommand}" ToolTip="Open the YouTube test preview" />
                                    <TextBlock Text="{Binding SafetyVideoTitle}" Foreground="White" FontWeight="SemiBold" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Width="230" Margin="0,7,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Row="2" Margin="0,6,0,3"><Button Style="{StaticResource PrimaryButtonStyle}" Content="Open YouTube Preview" Command="{Binding OpenSafetyVideoCommand}" /><TextBlock Text="{Binding SafetyVideoPreviewStatus}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,5,0,0" /></StackPanel>
                        <StackPanel Grid.Row="3"><Button Style="{StaticResource QueueButtonStyle}" Content="Stage safety video for aircraft" Command="{Binding QueueCommand}" CommandParameter="Safety demonstration video" /><Button Style="{StaticResource QueueButtonStyle}" Content="Stage boarding passenger address" Command="{Binding QueueCommand}" CommandParameter="Boarding passenger address" /></StackPanel>
                        <StackPanel Grid.Row="4" Margin="0,9,0,0"><Grid><TextBlock Text="BRIDGE QUEUE" Style="{StaticResource MutedTextStyle}" FontWeight="SemiBold" /><TextBlock Text="{Binding QueueDepth, StringFormat={}{0} staged}" HorizontalAlignment="Right" Foreground="#52B7FF" /></Grid><ListBox ItemsSource="{Binding ActivityQueue}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" Margin="0,4,0,0" /></StackPanel>
                        <StackPanel Grid.Row="5"><TextBlock Text="{Binding LastAction}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,4,0,7" /><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><Button Style="{StaticResource SecondaryButtonStyle}" Content="Clear" Command="{Binding ClearQueueCommand}" Margin="0,0,5,0" /><Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" Content="Save" Command="{Binding SaveCommand}" Margin="5,0,0,0" /></Grid></StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
