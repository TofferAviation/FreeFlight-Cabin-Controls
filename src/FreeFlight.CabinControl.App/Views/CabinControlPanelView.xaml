                        <TextBlock Canvas.Left="0" Canvas.Top="716" Width="1040" Height="46" Text="BOEING 777" Foreground="#77766E"
                                   FontFamily="Segoe UI Black" FontSize="25" FontStyle="Italic" FontWeight="Black" TextAlignment="Center" />
                        <Ellipse Canvas.Left="827" Canvas.Top="719" Width="15" Height="15" Fill="#4A4B45" Stroke="#151612" StrokeThickness="2" />
                        <Ellipse Canvas.Left="827" Canvas.Top="748" Width="15" Height="15" Fill="#363731" Stroke="#151612" StrokeThickness="2" />
                        <Canvas Canvas.Left="884" Canvas.Top="720" Width="57" Height="57" Opacity="0.68">
                            <Ellipse Canvas.Left="15" Canvas.Top="15" Width="27" Height="27" Stroke="#9A978D" StrokeThickness="3" /><Ellipse Canvas.Left="22" Canvas.Top="22" Width="13" Height="13" Stroke="#9A978D" StrokeThickness="2" />
                            <Line X1="28.5" Y1="1" X2="28.5" Y2="12" Stroke="#9A978D" StrokeThickness="3" /><Line X1="28.5" Y1="45" X2="28.5" Y2="56" Stroke="#9A978D" StrokeThickness="3" />
                            <Line X1="1" Y1="28.5" X2="12" Y2="28.5" Stroke="#9A978D" StrokeThickness="3" /><Line X1="45" Y1="28.5" X2="56" Y2="28.5" Stroke="#9A978D" StrokeThickness="3" />
                            <Line X1="9" Y1="9" X2="16" Y2="16" Stroke="#9A978D" StrokeThickness="3" /><Line X1="41" Y1="41" X2="48" Y2="48" Stroke="#9A978D" StrokeThickness="3" />
                            <Line X1="48" Y1="9" X2="41" Y2="16" Stroke="#9A978D" StrokeThickness="3" /><Line X1="16" Y1="41" X2="9" Y2="48" Stroke="#9A978D" StrokeThickness="3" />
                        </Canvas>
                    </Canvas>
                </Viewbox>

                <Border Grid.Column="0" Panel.ZIndex="10" Tag="AnnouncementOverlay"
                        Width="{Binding ActualWidth, ElementName=CacpPanelViewbox}"
                        Height="{Binding ActualHeight, ElementName=CacpPanelViewbox}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#B3000000" CornerRadius="22"
                        Visibility="{Binding IsSafetyVideoInProgress, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Announcement in progress" Foreground="White" FontSize="30" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel><TextBlock Text="Safety Video" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="{Binding AircraftMediaEligibility}" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,8" TextWrapping="Wrap" /></StackPanel>
                        <Border Grid.Row="1" Tag="InlineSafetyVideoPreview" Height="148" Background="#020711" BorderBrush="#40526A" BorderThickness="1" CornerRadius="7" ClipToBounds="True">
                            <Grid><Border Background="#260F3158" />
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding IsSafetyVideoInProgress}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                    <Button Width="52" Height="52" Content="▶" FontSize="20" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding StartSafetyVideoCommand}" ToolTip="Play the local BA_Safety_Video.mp4" />
                                    <TextBlock Text="{Binding SafetyVideoTitle}" Foreground="White" FontWeight="SemiBold" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Width="230" Margin="0,7,0,0" />
                                    <TextBlock Text="LOCAL MP4" Foreground="#52B7FF" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                </StackPanel>
                                <MediaElement x:Name="SafetyVideoMediaElement" Tag="InlineSafetyVideoPlayer"
                                              LoadedBehavior="Manual" UnloadedBehavior="Manual"
                                              Stretch="Uniform" Volume="{Binding SafetyVideoVolume, Mode=OneWay}" ScrubbingEnabled="True"
                                              MediaEnded="HandleLocalSafetyVideoEnded"
                                              MediaFailed="HandleLocalSafetyVideoFailed"
                                              Visibility="{Binding IsSafetyVideoInProgress, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Row="2" Margin="0,6,0,3">
                            <Grid>
                                <Button Content="Start Safety Video" Command="{Binding StartSafetyVideoCommand}">
                                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding IsSafetyVideoInProgress}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                </Button>
                                <Button Style="{StaticResource PrimaryButtonStyle}" Content="Stop Safety Video" Command="{Binding StopSafetyVideoCommand}"
                                        Visibility="{Binding IsSafetyVideoInProgress, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                            <TextBlock Text="{Binding SafetyVideoPreviewStatus}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="3"><Button Style="{StaticResource QueueButtonStyle}" Content="Stage boarding passenger address" Command="{Binding QueueCommand}" CommandParameter="Boarding passenger address" /></StackPanel>
                        <StackPanel Grid.Row="4" Margin="0,9,0,0"><Grid><TextBlock Text="BRIDGE QUEUE" Style="{StaticResource MutedTextStyle}" FontWeight="SemiBold" /><TextBlock Text="{Binding QueueDepth, StringFormat={}{0} staged}" HorizontalAlignment="Right" Foreground="#52B7FF" /></Grid><ListBox ItemsSource="{Binding ActivityQueue}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" Margin="0,4,0,0" /></StackPanel>
                        <StackPanel Grid.Row="5"><TextBlock Text="{Binding LastAction}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,4,0,7" /><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><Button Style="{StaticResource SecondaryButtonStyle}" Content="Clear" Command="{Binding ClearQueueCommand}" Margin="0,0,5,0" /><Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" Content="Save" Command="{Binding SaveCommand}" Margin="5,0,0,0" /></Grid></StackPanel>
                    </Grid>
                </Border>

            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
