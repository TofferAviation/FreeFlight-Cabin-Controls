<Window x:Class="FreeFlight.CabinControl.App.Views.VamsysAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FreeFlight Account"
        Width="760"
        Height="690"
        MinWidth="680"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}">
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
        <Grid>
            <Image Source="{Binding AccountBackgroundImageUri}" Stretch="UniformToFill" Opacity="{Binding AccountBackgroundOpacity}" IsHitTestVisible="False">
                <Image.Effect><BlurEffect Radius="{Binding AccountBackgroundBlurRadius}" /></Image.Effect>
            </Image>
            <Border Background="#D906101F" />
            <Grid Margin="26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Grid Width="76" Height="76">
                        <Ellipse Fill="#173B67" Stroke="#4DA7FF" StrokeThickness="2" />
                        <TextBlock Text="{Binding VamsysAvatarInitials}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Ellipse Visibility="{Binding HasAccountProfileImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Ellipse.Fill><ImageBrush ImageSource="{Binding AccountProfileImageUri}" Stretch="UniformToFill" /></Ellipse.Fill>
                        </Ellipse>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding VamsysDisplayName}" FontSize="25" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding VamsysPilotLabel}" Foreground="#69B8FF" FontSize="13" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding VamsysRank}" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Open vAMSYS account" Command="{Binding OpenVamsysAccountCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="14,7" VerticalAlignment="Center" />
                </Grid>

                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="18,14">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="PERSONAL DETAILS" Style="{StaticResource MetricLabelStyle}" />
                            <TextBlock Text="{Binding VamsysDisplayName}" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding VamsysEmail}" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="Identity, email, privacy and pilot details are managed by vAMSYS. FreeFlight keeps only your local appearance choices."
                                   Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="20,0,0,0" />
                    </Grid>
                </Border>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="18" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardStyle}" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Profile picture" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Choose a local image used only inside FreeFlight." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,7,0,14" />
                            <Button Content="Choose picture" Command="{Binding ChooseProfileImageCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="12,6" />
                            <Button Content="Use initials" Command="{Binding RemoveProfileImageCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Page background" Style="{StaticResource SectionTitleStyle}" />
                            <Button Content="Choose background" Command="{Binding ChooseBackgroundImageCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="12,6" Margin="0,10,0,0" />
                            <Button Content="Remove background" Command="{Binding RemoveBackgroundImageCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" Margin="0,8,0,0" />
                            <TextBlock Text="Blur radius (10–20)" Style="{StaticResource MutedTextStyle}" Margin="0,14,0,0" />
                            <Slider Minimum="10" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding AccountBackgroundBlurRadius}" />
                            <TextBlock Text="Image strength (10–20%)" Style="{StaticResource MutedTextStyle}" Margin="0,9,0,0" />
                            <Slider Minimum="10" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding AccountBackgroundOpacityPercent}" />
                            <CheckBox Content="Use on all parent pages" IsChecked="{Binding ApplyAccountBackgroundAcrossPages}" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="5" Margin="0,18,0,0">
                    <Button Content="Disconnect vAMSYS" Command="{Binding DisconnectVamsysCommand}" Style="{StaticResource SecondaryButtonStyle}" Foreground="#FF8195" BorderBrush="#804052" Padding="13,6" HorizontalAlignment="Left" />
                    <Button Content="Done" IsCancel="True" Style="{StaticResource PrimaryButtonStyle}" Padding="18,6" HorizontalAlignment="Right" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
