<UserControl x:Class="FreeFlight.CabinControl.App.Views.FleetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="94" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Background="#B9071426" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="12,8" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" Fill="{Binding ConnectionColor}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding ConnectionLabel}" Foreground="{Binding ConnectionColor}" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Button Content="&#xE72C;  Refresh Fleet"
                        FontFamily="Segoe UI"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="16,6"
                        MinHeight="34" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="12" />
                <ColumnDefinition />
                <ColumnDefinition Width="12" />
                <ColumnDefinition />
                <ColumnDefinition Width="12" />
                <ColumnDefinition />
                <ColumnDefinition Width="12" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}" Padding="16,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE709;" FontFamily="Segoe Fluent Icons" FontSize="24" Foreground="#63B9FF" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel><TextBlock Text="{Binding FleetCount}" FontSize="23" FontWeight="SemiBold" /><TextBlock Text="TOTAL AIRCRAFT" Style="{StaticResource MetricLabelStyle}" /></StackPanel>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16,12">
                <StackPanel Orientation="Horizontal"><Ellipse Width="14" Height="14" Fill="#32CB7E" VerticalAlignment="Center" Margin="0,0,12,0" /><StackPanel><TextBlock Text="{Binding InServiceCount}" FontSize="23" FontWeight="SemiBold" /><TextBlock Text="IN SERVICE" Style="{StaticResource MetricLabelStyle}" /></StackPanel></StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="16,12">
                <StackPanel Orientation="Horizontal"><Ellipse Width="14" Height="14" Fill="#FFBE46" VerticalAlignment="Center" Margin="0,0,12,0" /><StackPanel><TextBlock Text="{Binding MaintenanceCount}" FontSize="23" FontWeight="SemiBold" /><TextBlock Text="MAINTENANCE" Style="{StaticResource MetricLabelStyle}" /></StackPanel></StackPanel>
            </Border>
            <Border Grid.Column="6" Style="{StaticResource CardStyle}" Padding="16,12">
                <StackPanel Orientation="Horizontal"><Ellipse Width="14" Height="14" Fill="#F26369" VerticalAlignment="Center" Margin="0,0,12,0" /><StackPanel><TextBlock Text="{Binding UnavailableCount}" FontSize="23" FontWeight="SemiBold" /><TextBlock Text="NOT DISPATCHABLE" Style="{StaticResource MetricLabelStyle}" /></StackPanel></StackPanel>
            </Border>
            <Border Grid.Column="8" Style="{StaticResource CardStyle}" Padding="16,12">
                <StackPanel Orientation="Horizontal"><Ellipse Width="14" Height="14" Fill="#5BA9FF" VerticalAlignment="Center" Margin="0,0,12,0" /><StackPanel><TextBlock Text="{Binding RestrictionCount}" FontSize="23" FontWeight="SemiBold" /><TextBlock Text="RESTRICTIONS" Style="{StaticResource MetricLabelStyle}" /></StackPanel></StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="370" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="50" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Margin="16,15,16,8">
                        <TextBlock Text="Aircraft List" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="{Binding VisibleAircraft.Count, StringFormat={}{0} shown}" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="16,0,16,9">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="34,7,12,7" ToolTip="Search by registration, aircraft type or station" />
                        <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource TextMutedBrush}" IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Grid.Row="2">
                        <ListBox ItemsSource="{Binding VisibleAircraft}"
                                 SelectedItem="{Binding SelectedAircraft, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Margin="8,0,8,8"
                                 ScrollViewer.VerticalScrollBarVisibility="Hidden">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,6" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7" Padding="10"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#B30B2244" /><Setter TargetName="ItemBorder" Property="BorderBrush" Value="#398EFF" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#14233B" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="6" Background="#152C4D" VerticalAlignment="Center"><TextBlock Text="&#xE709;" FontFamily="Segoe Fluent Icons" Foreground="#72B9FF" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                        <StackPanel Grid.Column="1" Margin="9,0,8,0"><TextBlock Text="{Binding Registration}" FontWeight="SemiBold" FontSize="15" /><TextBlock Text="{Binding AircraftType}" Style="{StaticResource MutedTextStyle}" FontSize="11" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Station}" Foreground="#8FC8FF" FontSize="10" Margin="0,3,0,0" /></StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center"><Ellipse Width="9" Height="9" Fill="{Binding DispatchStatusBrush}" HorizontalAlignment="Right" /><TextBlock Text="{Binding DispatchStatus}" Foreground="{Binding DispatchStatusBrush}" FontSize="10" Margin="0,4,0,0" /></StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="{Binding EmptyAircraftMessage}"
                                   Width="265"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding HasVisibleAircraft, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                    <Grid DataContext="{Binding SelectedAircraft}"
                          Visibility="{Binding DataContext.HasSelectedAircraft, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="98" /><RowDefinition Height="18" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid Margin="20,18,20,0">
                            <StackPanel><TextBlock Text="{Binding Registration}" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="{Binding AircraftType}" Style="{StaticResource PageSubtitleStyle}" Margin="0,2,0,0" /></StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Ellipse Width="10" Height="10" Fill="{Binding DispatchStatusBrush}" Margin="0,0,7,0" /><TextBlock Text="{Binding DispatchStatus}" Foreground="{Binding DispatchStatusBrush}" FontWeight="SemiBold" /><Button Content="Report cabin defect" Command="{Binding DataContext.OpenDefectReportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource SecondaryButtonStyle}" MinHeight="32" Padding="12,4" Margin="14,0,0,0" /></StackPanel>
                        </Grid>
                        <Grid Grid.Row="2" Margin="20,0">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Border Background="#111E37" BorderBrush="{Binding OperationalStatusBrush}" BorderThickness="1,0,0,0" CornerRadius="7" Padding="14,10"><StackPanel><TextBlock Text="OPERATIONAL STATUS" Style="{StaticResource MetricLabelStyle}" /><StackPanel Orientation="Horizontal" Margin="0,7,0,0"><Ellipse Width="10" Height="10" Fill="{Binding OperationalStatusBrush}" VerticalAlignment="Center" Margin="0,0,7,0" /><TextBlock Text="{Binding OperationalStatus}" Foreground="{Binding OperationalStatusBrush}" FontWeight="SemiBold" /></StackPanel></StackPanel></Border>
                            <Border Grid.Column="2" Background="#111E37" BorderBrush="{Binding TechnicalStatusBrush}" BorderThickness="1,0,0,0" CornerRadius="7" Padding="14,10"><StackPanel><TextBlock Text="TECHNICAL STATUS" Style="{StaticResource MetricLabelStyle}" /><StackPanel Orientation="Horizontal" Margin="0,7,0,0"><Ellipse Width="10" Height="10" Fill="{Binding TechnicalStatusBrush}" VerticalAlignment="Center" Margin="0,0,7,0" /><TextBlock Text="{Binding TechnicalStatus}" Foreground="{Binding TechnicalStatusBrush}" FontWeight="SemiBold" /></StackPanel></StackPanel></Border>
                            <Border Grid.Column="4" Background="#111E37" BorderBrush="{Binding DispatchStatusBrush}" BorderThickness="1,0,0,0" CornerRadius="7" Padding="14,10"><StackPanel><TextBlock Text="DISPATCH AVAILABILITY" Style="{StaticResource MetricLabelStyle}" /><StackPanel Orientation="Horizontal" Margin="0,7,0,0"><Ellipse Width="10" Height="10" Fill="{Binding DispatchStatusBrush}" VerticalAlignment="Center" Margin="0,0,7,0" /><TextBlock Text="{Binding DispatchStatus}" Foreground="{Binding DispatchStatusBrush}" FontWeight="SemiBold" /></StackPanel></StackPanel></Border>
                        </Grid>
                        <Grid Grid.Row="4" Margin="20,0,20,20">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.08*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="0.92*" /></Grid.ColumnDefinitions>
                            <Border Background="#66071426" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel><TextBlock Text="Operational Information" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10" /><Grid><Grid.RowDefinitions><RowDefinition Height="31" /><RowDefinition Height="31" /><RowDefinition Height="31" /><RowDefinition Height="31" /><RowDefinition Height="31" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Current station" Style="{StaticResource MutedTextStyle}" /><TextBlock Grid.Column="1" Text="{Binding Station}" /><TextBlock Grid.Row="1" Text="Next assignment" Style="{StaticResource MutedTextStyle}" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding NextFlightReference}" TextWrapping="Wrap" /><TextBlock Grid.Row="2" Text="Last flight" Style="{StaticResource MutedTextStyle}" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LastFlightLabel}" /><TextBlock Grid.Row="3" Text="Airframe hours" Style="{StaticResource MutedTextStyle}" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding FlightHours}" /><TextBlock Grid.Row="4" Text="Cycles" Style="{StaticResource MutedTextStyle}" /><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Cycles}" /></Grid></StackPanel>
                            </Border>
                            <StackPanel Grid.Column="2" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <Border Background="#66071426" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="Pilot Briefing" Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock Text="{Binding DetailStatusLabel}" Foreground="{Binding DetailStatusColor}" TextWrapping="Wrap" FontSize="11" Margin="0,7,0,10" />
                                        <TextBlock Text="ACTIVE DEFECTS" Style="{StaticResource MetricLabelStyle}" />
                                        <ItemsControl ItemsSource="{Binding ActiveDefects}" Margin="0,4,0,7"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" VerticalAlignment="Top" Margin="0,5,0,0" /><StackPanel Grid.Column="1"><TextBlock Text="{Binding Description}" FontSize="11" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Reference}" Foreground="{Binding StatusBrush}" FontSize="10" /></StackPanel></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                        <TextBlock Text="MAINTENANCE WATCH" Style="{StaticResource MetricLabelStyle}" />
                                        <ItemsControl ItemsSource="{Binding MaintenanceWatch}" Margin="0,4,0,7"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" VerticalAlignment="Top" Margin="0,5,0,0" /><StackPanel Grid.Column="1"><TextBlock Text="{Binding Description}" FontSize="11" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Due}" Foreground="{Binding StatusBrush}" FontSize="10" TextTrimming="CharacterEllipsis" /></StackPanel></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                        <TextBlock Text="RECENT ACTIVITY" Style="{StaticResource MetricLabelStyle}" />
                                        <ItemsControl ItemsSource="{Binding RecentActivity}" Margin="0,4,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" VerticalAlignment="Top" Margin="0,5,0,0" /><StackPanel Grid.Column="1"><TextBlock Text="{Binding Description}" FontSize="11" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Timestamp}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" /></StackPanel></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                    </StackPanel>
                                </Border>
                                <Border Background="#12233D" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,12,0,0">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons" Foreground="#63B9FF" FontSize="17" Margin="0,0,9,0" /><StackPanel><TextBlock Text="{Binding LastSynchronizedLabel}" Foreground="#8FC8FF" FontSize="11" /><TextBlock Text="Use Refresh Fleet before briefing." Style="{StaticResource MutedTextStyle}" FontSize="11" /></StackPanel></StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="430" Visibility="{Binding HasSelectedAircraft, Converter={StaticResource InverseBooleanToVisibilityConverter}}"><TextBlock Text="&#xE709;" FontFamily="Segoe Fluent Icons" FontSize="42" Foreground="#4275A8" HorizontalAlignment="Center" /><TextBlock Text="Select an aircraft" Style="{StaticResource SectionTitleStyle}" HorizontalAlignment="Center" Margin="0,12,0,5" /><TextBlock Text="Once your Fleet connection is configured, select an aircraft from the list to see a focused pilot briefing with its operational, technical and dispatch condition." Style="{StaticResource MutedTextStyle}" TextAlignment="Center" TextWrapping="Wrap" /></StackPanel>
                </Grid>
            </Border>
            <Border Grid.RowSpan="4"
                    Panel.ZIndex="10"
                    Background="#D9030C1A"
                    Visibility="{Binding IsDefectReportOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Width="620" MaxHeight="680" Padding="24" Background="#071426" BorderBrush="#398EFF" BorderThickness="1" CornerRadius="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid>
                            <StackPanel><TextBlock Text="Report cabin defect" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="Submit an observed issue to the selected aircraft’s permanent Fleet technical record." Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0" TextWrapping="Wrap" /></StackPanel>
                            <Button Content="&#xE8BB;" Command="{Binding CancelDefectReportCommand}" Style="{StaticResource CircleButtonStyle}" Width="34" Height="34" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="Close" />
                        </Grid>
                        <ScrollViewer Grid.Row="1" Margin="0,18,0,14" VerticalScrollBarVisibility="Hidden">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="CATEGORY" Style="{StaticResource MetricLabelStyle}" Margin="0,0,0,5" /><ComboBox ItemsSource="{Binding DefectCategories}" SelectedItem="{Binding DefectCategory}" /></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="LOCATION / SEAT" Style="{StaticResource MetricLabelStyle}" Margin="0,0,0,5" /><TextBox Text="{Binding DefectLocation, UpdateSourceTrigger=PropertyChanged}" MaxLength="24" ToolTip="For example: 12A, FWD GALLEY, L1" /></StackPanel>
                                <StackPanel Grid.Row="1" Margin="0,16,0,0"><TextBlock Text="SEVERITY" Style="{StaticResource MetricLabelStyle}" Margin="0,0,0,5" /><ComboBox ItemsSource="{Binding DefectSeverities}" SelectedItem="{Binding DefectSeverity}" /></StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,16,0,0"><TextBlock Text="DISPATCH IMPACT" Style="{StaticResource MetricLabelStyle}" Margin="0,0,0,5" /><ComboBox ItemsSource="{Binding DefectDispatchImpacts}" SelectedItem="{Binding DefectDispatchImpact}" /></StackPanel>
                                <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,16,0,0"><TextBlock Text="OBSERVED CONDITION" Style="{StaticResource MetricLabelStyle}" Margin="0,0,0,5" /><TextBox Text="{Binding DefectDescription, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="110" ToolTip="Describe the observed condition and its cabin or operational effect." /></StackPanel>
                                <Border Grid.Row="3" Grid.ColumnSpan="3" Background="#11213A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,16,0,0"><TextBlock Text="{Binding DefectReportStatus}" Foreground="{Binding DefectReportStatusColor}" TextWrapping="Wrap" FontSize="12" /></Border>
                            </Grid>
                        </ScrollViewer>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Command="{Binding CancelDefectReportCommand}" Style="{StaticResource SecondaryButtonStyle}" MinHeight="36" Padding="16,5" Margin="0,0,10,0" /><Button Content="Submit defect report" Command="{Binding SubmitDefectReportCommand}" Style="{StaticResource PrimaryButtonStyle}" MinHeight="36" Padding="16,5" /></StackPanel>
                    </Grid>
                </Border>
            </Border>
        </Grid>
    </Grid>
</UserControl>
