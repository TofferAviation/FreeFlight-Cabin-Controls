<UserControl x:Class="FreeFlight.CabinControl.App.Views.FleetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Fleet Management" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="One authoritative aircraft record shared with British Airways Virtual operations." Style="{StaticResource PageSubtitleStyle}"/></StackPanel>
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,18,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding ConnectionLabel}" Foreground="{Binding ConnectionColor}" FontWeight="SemiBold"/><TextBlock Text="{Binding ConnectionDetail}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0"/><TextBlock Text="{Binding LastSynchronizedLabel}" Foreground="#8FC8FF" FontSize="10" Margin="0,6,0,0"/></StackPanel><Button Grid.Column="1" Content="Refresh Fleet" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" Margin="18,0,0,0"/></Grid></Border>
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="15,13,15,10"><TextBlock Text="Authoritative aircraft status" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="Select an aircraft in the staff Fleet board to manage its technical record." Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Right"/></Grid><ListView Grid.Row="1" ItemsSource="{Binding Aircraft}" BorderThickness="0" Background="Transparent"><ListView.View><GridView><GridViewColumn Header="REGISTRATION" DisplayMemberBinding="{Binding Registration}" Width="120"/><GridViewColumn Header="TYPE" DisplayMemberBinding="{Binding AircraftType}" Width="230"/><GridViewColumn Header="STATION" DisplayMemberBinding="{Binding Station}" Width="90"/><GridViewColumn Header="OPERATIONS" DisplayMemberBinding="{Binding OperationalStatus}" Width="130"/><GridViewColumn Header="TECHNICAL" DisplayMemberBinding="{Binding TechnicalStatus}" Width="190"/><GridViewColumn Header="DISPATCH" DisplayMemberBinding="{Binding DispatchStatus}" Width="150"/><GridViewColumn Header="FH" DisplayMemberBinding="{Binding FlightHours}" Width="100"/><GridViewColumn Header="FC" DisplayMemberBinding="{Binding Cycles}" Width="90"/></GridView></ListView.View></ListView></Grid></Border>
    </Grid>
</UserControl>
