<UserControl x:Class="FreeFlight.CabinControl.App.Views.LiveCabinView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:FreeFlight.CabinControl.App.Views"
             mc:Ignorable="d"
             d:DesignHeight="820"
             d:DesignWidth="1200">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="112" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#3D2911"
                BorderBrush="#E9A23B"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,7"
                Visibility="{Binding SeatMapOverrideActive, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons" Foreground="#FFBD62" FontSize="14" VerticalAlignment="Center" />
                <TextBlock Text="{Binding SeatMapOverrideLabel}" Foreground="#FFD99F" FontWeight="SemiBold" FontSize="11" Margin="9,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <views:PassengerFlowView Grid.Row="2" DataContext="{Binding Passengers}" />

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.6*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="AIRCRAFT DOORS / EXITS" Foreground="#61758E" FontSize="9" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding DoorSummary}" Foreground="#C8D6E7" FontSize="11" Margin="0,5,10,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Doors}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="112" Height="78" Margin="0,0,8,0" Padding="9,7" Background="#0A1728" BorderBrush="#29415F" BorderThickness="1" CornerRadius="5">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                            <Grid>
                                                <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="Bold" Foreground="#EAF3FF" />
                                                <Ellipse Width="8" Height="8" Fill="{Binding StatusColor}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock Grid.Row="1" Text="{Binding KindLabel}" Foreground="#71869F" FontSize="8" Margin="0,3,0,0" />
                                            <TextBlock Grid.Row="2" Text="{Binding Status}" Foreground="{Binding StatusColor}" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Bottom" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="12,10">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="6" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="LAVATORIES" Foreground="#61758E" FontSize="9" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding LavatorySummary}" HorizontalAlignment="Right" Foreground="#8FA5BE" FontSize="9" />
                    </Grid>
                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Lavatories}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="105" Height="66" Margin="0,0,7,0" Padding="8,6" Background="#0A1728" BorderBrush="#29415F" BorderThickness="1" CornerRadius="5">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Id}" FontSize="10" FontWeight="SemiBold" Foreground="#EAF3FF" />
                                            <TextBlock Text="{Binding Status}" FontSize="8" Foreground="#69B8FF" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding Detail}" FontSize="8" Foreground="#71869F" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
