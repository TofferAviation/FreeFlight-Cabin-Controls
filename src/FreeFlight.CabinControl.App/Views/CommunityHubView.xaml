<UserControl x:Class="FreeFlight.CabinControl.App.Views.CommunityHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="786"
             d:DesignWidth="1239">
    <UserControl.Resources>
        <LinearGradientBrush x:Key="CrewLoungeHeroBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#172C44" Offset="0" />
            <GradientStop Color="#20273E" Offset="0.5" />
            <GradientStop Color="#291D31" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CrewLoungeGlowBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F3CE83" Offset="0" />
            <GradientStop Color="#DE9172" Offset="1" />
        </LinearGradientBrush>
        <Style x:Key="LoungeCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Background" Value="#102035" />
            <Setter Property="BorderBrush" Value="#29445E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style x:Key="LoungeSubCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#0B192B" />
            <Setter Property="BorderBrush" Value="#27435C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
        </Style>
        <Style x:Key="LoungeCaptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E9C77D" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Grid Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#193A31" BorderBrush="#4D9574" BorderThickness="1" CornerRadius="15" Padding="11,6" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#A9E39B" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="{Binding ConnectionLabel}" Foreground="#C5EFC3" FontSize="11" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Button Content="Refresh my flight" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}" MinHeight="34" Padding="12,4" FontSize="11" />
                </StackPanel>
            </Grid>

            <Border Background="{StaticResource CrewLoungeHeroBrush}" BorderBrush="#46617A" BorderThickness="1" CornerRadius="14" Padding="0" Margin="0,0,0,16" ClipToBounds="True">
                <Grid MinHeight="216">
                    <Image Source="{Binding FeaturedHeroImageSource}" Stretch="UniformToFill" Opacity="0.86" />
                    <Rectangle IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#A8172C44" Offset="0" />
                                <GradientStop Color="#6E17273D" Offset="0.53" />
                                <GradientStop Color="#98101C2D" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Ellipse Width="285" Height="285" Fill="#174B5D" Opacity="0.45" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-142,170,0" />
                    <Ellipse Width="210" Height="210" Fill="#793C51" Opacity="0.3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-58,-88" />
                    <Ellipse Width="82" Height="82" Fill="#F0C77D" Opacity="0.11" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="54,0,0,-37" />
                    <Grid Margin="26,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="308" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="BAV CREW LOUNGE" Style="{StaticResource LoungeCaptionStyle}" />
                            <TextBlock Text="{Binding WelcomeLabel}" FontSize="16" Foreground="#BBD3E6" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding FeaturedEvent.Title}" FontSize="29" FontWeight="SemiBold" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding FeaturedEvent.RouteDetail}" Foreground="#D9E5EC" FontSize="13" Margin="0,7,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                <Border Background="#183B50" BorderBrush="#4B7994" BorderThickness="1" CornerRadius="14" Padding="10,5" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding FeaturedEvent.DateLabel}" Foreground="#BDE6EF" FontSize="10" FontWeight="SemiBold" />
                                </Border>
                                <Border Background="#392945" BorderBrush="#765577" BorderThickness="1" CornerRadius="14" Padding="10,5">
                                    <TextBlock Text="{Binding FeaturedEvent.TimeLabel}" Foreground="#E4C8D7" FontSize="10" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,17,0,0">
                                <Button Content="Open crew table"
                                        Command="{Binding SelectCrewTableCommand}"
                                        CommandParameter="{Binding FeaturedEvent}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        MinHeight="34"
                                        Padding="15,4"
                                        FontSize="11" />
                                <Button Content="Open BAV calendar"
                                        Command="{Binding OpenBavEventsCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        MinHeight="34"
                                        Padding="14,4"
                                        FontSize="11"
                                        Margin="9,0,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="2" Background="#0C1A2B" BorderBrush="#517693" BorderThickness="1" CornerRadius="12" Padding="16" VerticalAlignment="Center">
                            <StackPanel>
                                <TextBlock Text="YOUR FLIGHT JACKET" Style="{StaticResource LoungeCaptionStyle}" Foreground="#A8CBE4" />
                                <Grid Margin="0,13,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="42" Height="42" CornerRadius="21" Background="{StaticResource CrewLoungeGlowBrush}">
                                        <TextBlock Text="{Binding PilotInitials}" Foreground="#172133" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PilotName}" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding PilotLabel}" Foreground="#B2CAE0" FontSize="10" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>
                                <Border Style="{StaticResource LoungeSubCardStyle}" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="NEXT BAV FLIGHT" Style="{StaticResource LoungeCaptionStyle}" Foreground="#C5D6E8" FontSize="9" />
                                        <TextBlock Text="{Binding ActiveAssignmentLabel}" FontSize="13" FontWeight="SemiBold" Margin="0,7,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding CurrentAircraftLabel}" Foreground="#E3C17E" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding ActiveAssignmentDetail}" Foreground="#9EB4C9" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="0.85*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource LoungeCardStyle}" Padding="0" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Margin="20,18,20,13">
                            <StackPanel>
                                <TextBlock Text="CREW LOUNGE" Style="{StaticResource LoungeCaptionStyle}" />
                                <TextBlock Text="{Binding ActiveTableTitle}" Style="{StaticResource SectionTitleStyle}" Margin="0,5,0,0" />
                                <TextBlock Text="{Binding ActiveTableDescription}" Style="{StaticResource MutedTextStyle}" FontSize="11" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Border Background="#1B333E" BorderBrush="#4D7E80" BorderThickness="1" CornerRadius="12" Padding="9,4" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding ChatConnectionLabel}" Foreground="#BCE3D5" FontSize="9" FontWeight="SemiBold" />
                                </Border>
                                <Button Content="Refresh"
                                        Command="{Binding RefreshChatCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        MinHeight="27"
                                        Padding="9,2"
                                        FontSize="10" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Margin="20,0,20,14" MinHeight="190">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding HasChatMessages, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsControl ItemsSource="{Binding ChatMessages}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#0B192B" BorderBrush="#27435C" BorderThickness="1" CornerRadius="10" Padding="11" Margin="0,0,0,8" MaxWidth="510">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="HorizontalAlignment" Value="Left" />
                                                        <Setter Property="Background" Value="#0B192B" />
                                                        <Setter Property="BorderBrush" Value="#27435C" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOwnMessage}" Value="True">
                                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                                                <Setter Property="Background" Value="#223B45" />
                                                                <Setter Property="BorderBrush" Value="#4A786D" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="27" Height="27" CornerRadius="14" Background="#36526C" VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding Initials}" Foreground="#E3F0F7" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                        <Grid>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding PilotName}" FontWeight="SemiBold" FontSize="11" />
                                                                <TextBlock Text="{Binding Rank}" Foreground="#A8BED1" FontSize="9" Margin="6,1,0,0" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding TimeLabel}" Foreground="#91A9C1" FontSize="9" HorizontalAlignment="Right" />
                                                        </Grid>
                                                        <TextBlock Text="{Binding Body}" Foreground="#E7EDF2" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <StackPanel Width="330" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasChatMessages, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                <TextBlock Text="☕" FontSize="28" HorizontalAlignment="Center" />
                                <TextBlock Text="A table is waiting" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding ChatStatus}" Foreground="#A8BFD2" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="0,5,0,0" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="2" Background="#0B192B" BorderBrush="#27435C" BorderThickness="1,1,0,0" Padding="14,12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="94" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding MessageDraft, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="600"
                                             MinHeight="36"
                                             Padding="10,7"
                                             Foreground="#EDF4F8"
                                             Background="#14283C"
                                             BorderBrush="#385B72"
                                             BorderThickness="1"
                                             VerticalContentAlignment="Center"
                                             ToolTip="Say hello to BAV pilots in the Crew Lounge" />
                                    <Button Grid.Column="1"
                                            Content="Send"
                                            Command="{Binding SendChatMessageCommand}"
                                            IsEnabled="{Binding CanSendCrewMessage}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            MinHeight="36"
                                            Padding="10,4"
                                            FontSize="11"
                                            Margin="8,0,0,0" />
                                </Grid>
                                <TextBlock Text="{Binding ChatStatus}" Foreground="#91ABC1" FontSize="9" Margin="2,7,2,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource LoungeCardStyle}" Padding="18" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="YOUR LOUNGE HOST" Style="{StaticResource LoungeCaptionStyle}" />
                            <TextBlock Text="{Binding HostName}" Style="{StaticResource SectionTitleStyle}" Margin="0,6,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding HostMessage}" Foreground="#AFC2D3" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" />
                            <Border Style="{StaticResource LoungeSubCardStyle}" Padding="11" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding ActiveTableCaption}" Foreground="#E8C67E" FontSize="10" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding WelcomePrompt}" Foreground="#DDE8ED" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Staff selects this room’s featured event from the published BAV calendar. Official registration stays on BAV." Foreground="#91A8BD" FontSize="9" TextWrapping="Wrap" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource LoungeCardStyle}" Padding="18" Margin="0,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="CREW PLANNING BOARD" Style="{StaticResource LoungeCaptionStyle}" Foreground="#A9E39B" />
                                    <TextBlock Text="{Binding ActiveTableTitle}" Style="{StaticResource SectionTitleStyle}" Margin="0,5,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding PlanningBoardLabel}" Foreground="#9FB5C8" FontSize="9" Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Text="{Binding TablemateCount}" Foreground="#B8E6BF" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,13,0,9" MinHeight="56">
                                <ItemsControl ItemsSource="{Binding Tablemates}" Visibility="{Binding HasTablemates, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,9">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="29" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <Border Width="24" Height="24" CornerRadius="12" Background="#36526C" VerticalAlignment="Top"><TextBlock Text="{Binding Initials}" Foreground="#E3F0F7" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                                <StackPanel Grid.Column="1" Margin="7,0,0,0">
                                                    <TextBlock Text="{Binding PilotName}" FontSize="10" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding PlanDetail}" Foreground="#AAC0D2" FontSize="9" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding UpdatedLabel}" Foreground="#829CB2" FontSize="8" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="No one has added a voluntary plan yet." Foreground="#A8BFD2" FontSize="10" TextWrapping="Wrap" VerticalAlignment="Center" Visibility="{Binding HasTablemates, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                            </Grid>
                            <StackPanel Grid.Row="2">
                                <Button Content="{Binding PlanningButtonLabel}" Command="{Binding MarkPlanningCommand}" IsEnabled="{Binding CanPlanEvent}" Style="{StaticResource SecondaryButtonStyle}" MinHeight="29" Padding="10,3" FontSize="9" />
                                <Button Content="Remove my plan" Command="{Binding RemovePlanningCommand}" IsEnabled="{Binding IsPlanning}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" MinHeight="26" Padding="9,2" FontSize="9" Margin="0,5,0,0" />
                                <TextBlock Text="{Binding PlanningStatus}" Foreground="#91ABC1" FontSize="8" TextWrapping="Wrap" Margin="0,5,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource LoungeCardStyle}" Padding="18" Margin="0,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="YOUR NOTICE BOARD" Style="{StaticResource LoungeCaptionStyle}" Foreground="#C8ACD6" />
                                    <TextBlock Text="From BAV Operations" Style="{StaticResource SectionTitleStyle}" Margin="0,5,0,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding NoticeCount}" Foreground="#D7B4E8" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,14,0,0">
                                <ItemsControl ItemsSource="{Binding Notices}" Visibility="{Binding HasNotices, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,11">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="14" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="7" Height="7" Fill="{Binding LevelColor}" VerticalAlignment="Top" Margin="0,5,0,0" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Body}" Foreground="#AAC0D2" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                    <TextBlock Text="{Binding Timestamp}" Foreground="#91A8BE" FontSize="9" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="No private BAV notices right now. When Operations has an update, it will appear here." Foreground="#A8BFD2" FontSize="11" TextWrapping="Wrap" Visibility="{Binding HasNotices, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                            </Grid>
                        </Grid>
                    </Border>

                </StackPanel>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="0.8*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource LoungeCardStyle}" Padding="0" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="19,17,19,13">
                            <StackPanel>
                                <TextBlock Text="THE LONG TABLE" Style="{StaticResource LoungeCaptionStyle}" />
                                <TextBlock Text="Published BAV events" Style="{StaticResource SectionTitleStyle}" Margin="0,5,0,0" />
                                <TextBlock Text="Open a table to meet pilots exploring an event. Plans here are voluntary; use BAV for official details and registration." Foreground="#A8BED0" FontSize="11" Margin="0,4,0,0" />
                            </StackPanel>
                            <Button Content="BAV event calendar" Command="{Binding OpenBavEventsCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" MinHeight="30" Padding="11,3" FontSize="10" />
                        </Grid>
                        <StackPanel Grid.Row="1" Margin="19,0,19,18">
                            <ItemsControl ItemsSource="{Binding Events}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource LoungeSubCardStyle}" Padding="12" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="84" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="112" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DateLabel}" Foreground="#E6C578" FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding TimeLabel}" Foreground="#AABFD0" FontSize="9" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                                    <TextBlock Text="{Binding TypeLabel}" Foreground="#B9DDA5" FontSize="9" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Margin="0,3,0,0" />
                                                    <TextBlock Text="{Binding RouteDetail}" Foreground="#B0C3D2" FontSize="10" Margin="0,4,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TableStateLabel}" Foreground="{Binding TableStateColor}" FontSize="9" TextWrapping="Wrap" TextAlignment="Right" Width="106" />
                                                    <Button Content="{Binding TableButtonLabel}"
                                                            Command="{Binding DataContext.SelectCrewTableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            MinHeight="28"
                                                            Padding="9,2"
                                                            FontSize="9"
                                                            Margin="0,7,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource LoungeCardStyle}" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="COMMUNITY PULSE" Style="{StaticResource LoungeCaptionStyle}" Foreground="#B4D7E9" />
                                <TextBlock Text="Crew flying now" Style="{StaticResource SectionTitleStyle}" Margin="0,5,0,0" />
                            </StackPanel>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#1B3548" BorderBrush="#48758E" BorderThickness="1" CornerRadius="11" Padding="8,4">
                                <TextBlock Text="LIVE BAV DATA" Foreground="#B9D9EA" FontSize="8" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,15,0,0">
                            <ItemsControl ItemsSource="{Binding LiveOperations}" Visibility="{Binding HasLiveOperations, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource LoungeSubCardStyle}" Padding="11" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="72" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding FlightNumber}" Foreground="#C0E6F0" FontSize="11" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding PilotMarker}" Foreground="#8EABC0" FontSize="8" Margin="0,3,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding RouteLabel}" FontWeight="SemiBold" FontSize="11" />
                                                    <TextBlock Text="{Binding Aircraft}" Foreground="#A6BCCA" FontSize="10" Margin="0,3,0,0" />
                                                    <TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusColor}" FontSize="9" FontWeight="SemiBold" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Width="235" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasLiveOperations, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                <TextBlock Text="No crew flights returned yet" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" />
                                <TextBlock Text="The board stays calm rather than inventing activity when BAV Operations has nothing to share." Foreground="#A6BDCE" FontSize="10" TextWrapping="Wrap" TextAlignment="Center" Margin="0,5,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
