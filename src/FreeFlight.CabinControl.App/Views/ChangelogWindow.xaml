<Window x:Class="FreeFlight.CabinControl.App.Views.ChangelogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ember · Release notes"
        Width="860"
        Height="700"
        MinWidth="620"
        MinHeight="470"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        Background="{DynamicResource AppBackgroundBrush}">
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" ClipToBounds="True" Padding="26">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="*" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="RELEASE NOTES" Style="{StaticResource PageEyebrowStyle}" />
                    <TextBlock Text="Ember update history" FontFamily="Georgia" FontSize="30" FontWeight="SemiBold" Margin="0,4,0,0" />
                    <TextBlock Text="A complete, readable record of release changes and operational safeguards." Style="{StaticResource MutedTextStyle}" Margin="0,5,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource StatusPillStyle}" Padding="12,7" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource PrimaryBrush}" FontSize="13" /><TextBlock Text="VERSIONED HISTORY" Style="{StaticResource MetricLabelStyle}" Margin="7,0,0,0" /></StackPanel>
                </Border>
            </Grid>
            <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="8">
                <RichTextBox x:Name="ChangelogDocument"
                             IsReadOnly="True"
                             IsDocumentEnabled="False"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             FontFamily="Segoe UI Variable Text, Segoe UI"
                             FontSize="13"
                             Padding="17,12" />
            </Border>
            <Button Grid.Row="4"
                    Content="Close release notes"
                    Style="{StaticResource PrimaryButtonStyle}"
                    MinWidth="164"
                    HorizontalAlignment="Right"
                    Click="CloseButton_Click" />
        </Grid>
    </Border>
</Window>
