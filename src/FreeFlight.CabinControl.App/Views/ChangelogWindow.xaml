<Window x:Class="FreeFlight.CabinControl.App.Views.ChangelogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FreeFlight Cabin Control changelog"
        Width="780"
        Height="650"
        MinWidth="560"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource AppBackgroundBrush}">
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="Bundled Changelog" FontSize="27" FontWeight="SemiBold" />
                <TextBlock Text="Changes included with this installed version" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0" />
            </StackPanel>
            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="ChangelogText"
                               TextWrapping="Wrap"
                               Foreground="#AFC2D8"
                               FontFamily="Consolas"
                               FontSize="12"
                               LineHeight="19" />
                </ScrollViewer>
            </Border>
            <Button Grid.Row="4"
                    Content="Close"
                    Style="{StaticResource PrimaryButtonStyle}"
                    MinWidth="120"
                    HorizontalAlignment="Right"
                    Click="CloseButton_Click" />
        </Grid>
    </Border>
</Window>
