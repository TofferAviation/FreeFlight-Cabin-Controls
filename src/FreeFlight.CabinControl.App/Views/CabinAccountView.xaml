<UserControl x:Class="FreeFlight.CabinControl.App.Views.CabinAccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid Visibility="{Binding IsAuthenticated, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#062B4C" Offset="0" />
                    <GradientStop Color="#0B74B7" Offset="0.58" />
                    <GradientStop Color="#A7D9F6" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <Border Width="478" Padding="34" Background="#FDFEFF" BorderBrush="#D8E2EC" BorderThickness="1" CornerRadius="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <Border Width="58" Height="58" CornerRadius="29" Background="#E9F5FF" BorderBrush="#B8DDF5" BorderThickness="1" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons" FontSize="27" Foreground="#0B73B9" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Welcome to Ember" Style="{StaticResource PageTitleStyle}" FontSize="31" HorizontalAlignment="Center" Margin="0,18,0,0" />
                    <TextBlock Text="Sign in with your BAV website account to load the flight you selected online." Style="{StaticResource PageSubtitleStyle}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" Margin="0,7,0,24" />
                    <TextBlock Text="Website email" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Height="43" />
                    <TextBlock Text="Password" FontWeight="SemiBold" FontSize="12" Margin="0,16,0,6" />
                    <PasswordBox x:Name="PasswordInput" PasswordChanged="PasswordInput_OnPasswordChanged" Height="43" Padding="12,8" Background="White" Foreground="#102A43" BorderBrush="#BFD0DF" CaretBrush="#0B73B9" FontSize="14" />
                    <CheckBox IsChecked="{Binding RememberSignIn}" Content="Remember this BAV account on this Windows PC" Margin="0,14,0,0" />
                    <TextBlock Text="Ember stores an encrypted device session only. Your BAV password is never stored." Foreground="{StaticResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0" />
                    <Button Command="{Binding SignInCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,22,0,0" Height="50" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="Sign in to Ember" FontSize="15" /><TextBlock Text="&#xE72A;" FontFamily="Segoe Fluent Icons" FontSize="17" Margin="11,0,0,0" /></StackPanel>
                    </Button>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" FontSize="11" Margin="0,13,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <ScrollViewer Visibility="{Binding IsAuthenticated, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="MY FLIGHT" Foreground="{StaticResource PrimaryBrush}" FontSize="10" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource PageTitleStyle}" Margin="0,4,0,0" />
                        <TextBlock Text="Your verified BAV account, briefing and live ACARS session." Style="{StaticResource PageSubtitleStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="48" Height="48" CornerRadius="24" Background="#E9F5FF" BorderBrush="#B8DDF5" BorderThickness="1" Margin="0,0,11,0">
                            <TextBlock Text="{Binding Initials}" Foreground="{StaticResource PrimaryDeepBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding PilotLabel}" FontWeight="SemiBold" /><TextBlock Text="Verified BAV pilot" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0" /></StackPanel>
                    </StackPanel>
                </Grid>

                <Border CornerRadius="12" Padding="24" Margin="0,0,0,16">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#06385E" Offset="0" /><GradientStop Color="#0B76B9" Offset="0.64" /><GradientStop Color="#1690CF" Offset="1" /></LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="WEBSITE FLIGHT" Foreground="#CBEAFF" FontSize="10" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding WebsiteFlightAssignmentLabel}" Foreground="White" FontSize="26" FontWeight="SemiBold" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding WebsiteFlightAssignmentDetail}" Foreground="#D7F1FF" FontSize="13" Margin="0,7,0,0" />
                            <Button Content="Refresh flight from website" Command="{Binding RefreshWebsiteFlightCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="38" Margin="0,18,0,0" HorizontalAlignment="Left" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#2500162B" BorderBrush="#45FFFFFF" BorderThickness="1" CornerRadius="9" Padding="16" VerticalAlignment="Center">
                            <StackPanel>
                                <TextBlock Text="BAV BRIEFING" Foreground="#BFE9FF" FontSize="10" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding WebsiteBriefingStatusLabel}" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,6,0,0" />
                                <TextBlock Text="{Binding WebsiteBriefingStatusDetail}" Foreground="#D7F1FF" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="ACARS SESSION" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Telemetry begins and ends with your operational flight." Style="{StaticResource MutedTextStyle}" FontSize="11" Margin="0,4,0,16" />
                            <Border Background="#F4F8FC" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="{Binding AcarsSessionLabel}" Foreground="{StaticResource SuccessBrush}" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding LastFlightCompletionLabel}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>
                            <Button Content="{Binding EndFlightButtonLabel}" Command="{Binding EndFlightCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,15,0,0" IsEnabled="{Binding IsAcarsOperating}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="OPERATIONS UPDATES" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="{Binding NotificationsSummary}" Style="{StaticResource MutedTextStyle}" FontSize="11" Margin="0,4,0,12" />
                            <ItemsControl ItemsSource="{Binding Notifications}" Visibility="{Binding HasNotifications, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,1,0,0" Padding="0,9,0,0" Margin="0,5,0,0"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" /><TextBlock Text="{Binding Body}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,3,0,0" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="There are no new operational updates." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Visibility="{Binding HasNotifications, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Margin="0,16,0,0">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button Content="Sign out of Ember" Command="{Binding SignOutCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
