<UserControl x:Class="FreeFlight.CabinControl.App.Views.CabinAccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid ClipToBounds="True">
        <Grid.Background>
            <RadialGradientBrush Center="0.52,0.25" GradientOrigin="0.52,0.25" RadiusX="0.9" RadiusY="0.95">
                <GradientStop Color="#173E70" Offset="0" />
                <GradientStop Color="#071A34" Offset="0.48" />
                <GradientStop Color="#020B19" Offset="1" />
            </RadialGradientBrush>
        </Grid.Background>
        <Grid Margin="42,34">
            <StackPanel Width="520" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Width="310" Height="64" Source="pack://application:,,,/FreeFlight.CabinControl;component/Assets/AirlineLogos/BAW.png" Stretch="Uniform" />
                <TextBlock Text="Ember Account" FontSize="18" Foreground="#A8B7CA" HorizontalAlignment="Center" Margin="0,0,0,26" />
                <Border Style="{StaticResource CardStyle}" Padding="34,28">
                    <Grid>
                        <StackPanel Visibility="{Binding IsAuthenticated, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <Border Width="70" Height="70" CornerRadius="35" Background="#163B70" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons" FontSize="35" Foreground="#59A4FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Sign in to Ember" FontSize="27" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,17,0,5" />
                            <TextBlock Text="Use the same email and password as the British Airways Virtual website. Your password is never stored." TextWrapping="Wrap" TextAlignment="Center" Foreground="#9DB0C7" FontSize="12" Margin="0,0,0,22" />
                            <TextBlock Text="Website email" FontSize="13" Margin="0,0,0,5" />
                            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Height="43" />
                            <TextBlock Text="Password" FontSize="13" Margin="0,16,0,5" />
                            <PasswordBox x:Name="PasswordInput" PasswordChanged="PasswordInput_OnPasswordChanged" Height="43" Padding="12,8" Background="#071426" Foreground="White" BorderBrush="{StaticResource BorderBrush}" CaretBrush="#398EFF" FontSize="14" />
                            <CheckBox IsChecked="{Binding RememberSignIn}" Content="Remember this BAV account on this Windows PC" Foreground="#D6E0EC" Margin="0,14,0,0" />
                            <TextBlock Text="Ember stores only an encrypted session for this Windows user — never your website password. Sign out to remove it." TextWrapping="Wrap" Foreground="#7890AC" FontSize="10" Margin="0,5,0,0" />
                            <Button Command="{Binding SignInCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,22,0,0" Height="52" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="&#xE72A;" FontFamily="Segoe Fluent Icons" FontSize="19" Margin="0,0,11,0" /><TextBlock Text="Sign in with BAV account" FontSize="15" /></StackPanel>
                            </Button>
                            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" TextAlignment="Center" Foreground="#93A8C1" FontSize="11" Margin="0,13,0,0" />
                        </StackPanel>
                        <StackPanel Visibility="{Binding IsAuthenticated, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid Width="80" Height="80" HorizontalAlignment="Center">
                                <Border CornerRadius="40" Background="#164C34"><TextBlock Text="{Binding Initials}" FontSize="26" FontWeight="Bold" Foreground="#65E692" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                <Ellipse Visibility="{Binding HasProfileImage, Converter={StaticResource BooleanToVisibilityConverter}}"><Ellipse.Fill><ImageBrush ImageSource="{Binding ProfileImageSource}" Stretch="UniformToFill" /></Ellipse.Fill></Ellipse>
                            </Grid>
                            <TextBlock Text="{Binding DisplayName}" FontSize="27" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,17,0,4" />
                            <TextBlock Text="{Binding PilotLabel}" Foreground="#65E692" FontSize="15" HorizontalAlignment="Center" />
                            <Border Background="#6F071426" BorderBrush="#29435F" BorderThickness="1" CornerRadius="7" Padding="16" Margin="0,24,0,0"><StackPanel><TextBlock Text="WEBSITE FLIGHT" Foreground="#7890AC" FontSize="10" /><TextBlock Text="{Binding WebsiteFlightAssignmentLabel}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="16" Margin="0,6,0,0" /><TextBlock Text="{Binding WebsiteFlightAssignmentDetail}" TextWrapping="Wrap" Foreground="#B4C6DB" FontSize="12" Margin="0,4,0,0" /><Button Content="Refresh BAV flight and profile" Command="{Binding RefreshWebsiteFlightCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="36" Margin="0,13,0,0" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" /></StackPanel></Border>
                            <Border Background="#6F071426" BorderBrush="#29435F" BorderThickness="1" CornerRadius="7" Padding="16" Margin="0,12,0,0"><StackPanel><TextBlock Text="FLIGHT PLAN LINK" Foreground="#7890AC" FontSize="10" /><TextBlock Text="{Binding FlightPlanLinkLabel}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="14" Margin="0,6,0,0" /><TextBlock Text="{Binding FlightPlanLinkDetail}" TextWrapping="Wrap" Foreground="#B4C6DB" FontSize="12" Margin="0,4,0,0" /></StackPanel></Border>
                            <Border Background="#6F071426" BorderBrush="#29435F" BorderThickness="1" CornerRadius="7" Padding="16" Margin="0,12,0,0"><StackPanel><TextBlock Text="ACARS FLIGHT STATUS" Foreground="#7890AC" FontSize="10" /><TextBlock Text="{Binding AcarsSessionLabel}" Foreground="#65E692" FontWeight="SemiBold" FontSize="14" Margin="0,6,0,0" /><TextBlock Text="{Binding LastFlightCompletionLabel}" TextWrapping="Wrap" Foreground="#B4C6DB" FontSize="12" Margin="0,7,0,0" /></StackPanel></Border>
                            <Border Background="#6F071426" BorderBrush="#29435F" BorderThickness="1" CornerRadius="7" Padding="16" Margin="0,12,0,0"><StackPanel><TextBlock Text="FLEET ACCESS" Foreground="#7890AC" FontSize="10" /><TextBlock Text="Your selected BAV flight is the only flight Ember can reserve an aircraft against. Pushback or engine start begins its operating clock; shutdown at the gate completes the record." TextWrapping="Wrap" Foreground="#D6E0EC" FontSize="13" Margin="0,6,0,0" /></StackPanel></Border>
                            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" TextAlignment="Center" Foreground="#93A8C1" FontSize="11" Margin="0,14,0,0" />
                            <Button Command="{Binding SignOutCommand}" Content="Sign out" Style="{StaticResource SecondaryButtonStyle}" Height="46" Margin="0,20,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
