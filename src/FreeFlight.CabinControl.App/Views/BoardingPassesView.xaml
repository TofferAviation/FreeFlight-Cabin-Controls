<UserControl x:Class="FreeFlight.CabinControl.App.Views.BoardingPassesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FreeFlight.CabinControl.App.Views">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="420" /><ColumnDefinition Width="12" /><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition Width="245" /></Grid.ColumnDefinitions>
        <Border Style="{StaticResource CardStyle}" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="58" /><RowDefinition Height="64" /><RowDefinition Height="46" /><RowDefinition Height="34" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <StackPanel><TextBlock Text="Boarding Passes" FontSize="23" FontWeight="SemiBold" /><TextBlock Text="{Binding FlightNumber, StringFormat=Manage and print boarding passes for {0}}" Style="{StaticResource MutedTextStyle}" /></StackPanel>
            <UniformGrid Grid.Row="1" Columns="4"><Border Background="#1D2C42" CornerRadius="5" Padding="8" Margin="0,0,3,0"><StackPanel><TextBlock Text="Unissued" Style="{StaticResource MutedTextStyle}" FontSize="9" /><TextBlock Text="{Binding UnissuedBoardingPasses}" FontSize="18" /></StackPanel></Border><Border Background="#15345C" CornerRadius="5" Padding="8" Margin="3,0"><StackPanel><TextBlock Text="Ready" Foreground="#55AEFF" FontSize="9" /><TextBlock Text="{Binding ReadyBoardingPasses}" FontSize="18" /></StackPanel></Border><Border Background="#173D2A" CornerRadius="5" Padding="8" Margin="3,0"><StackPanel><TextBlock Text="Printed" Foreground="#58E68A" FontSize="9" /><TextBlock Text="{Binding PrintedBoardingPasses}" FontSize="18" /></StackPanel></Border><Border Background="#48242D" CornerRadius="5" Padding="8" Margin="3,0,0,0"><StackPanel><TextBlock Text="Reprint" Foreground="#FF6666" FontSize="9" /><TextBlock Text="{Binding ReprintBoardingPasses}" FontSize="18" /></StackPanel></Border></UniformGrid>
            <TextBox Grid.Row="2" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search passengers" Margin="0,5" />
            <Border Grid.Row="3" Background="#102039" CornerRadius="5" Padding="8"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="55" /><ColumnDefinition Width="50" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions><TextBlock Text="PASSENGER" Style="{StaticResource MetricLabelStyle}" /><TextBlock Grid.Column="1" Text="SEAT" Style="{StaticResource MetricLabelStyle}" /><TextBlock Grid.Column="2" Text="GROUP" Style="{StaticResource MetricLabelStyle}" /><TextBlock Grid.Column="3" Text="STATUS" Style="{StaticResource MetricLabelStyle}" /></Grid></Border>
            <ListBox Grid.Row="4" ItemsSource="{Binding VisiblePassengers}" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Background" Value="Transparent" /></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Button Command="{Binding DataContext.SelectPassengerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" BorderBrush="#203954" BorderThickness="0,0,0,1" Padding="8,9" HorizontalContentAlignment="Stretch"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="55" /><ColumnDefinition Width="50" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions><TextBlock Text="{Binding FullName}" /><TextBlock Grid.Column="1" Text="{Binding SeatNumber}" Foreground="#8FC8FF" /><TextBlock Grid.Column="2" Text="{Binding BoardingGroup}" /><TextBlock Grid.Column="3" Text="{Binding BoardingPassStatus}" Foreground="{Binding BoardingPassStatusColor}" FontSize="9" /></Grid></Button></DataTemplate></ListBox.ItemTemplate></ListBox>
            <TextBlock Grid.Row="4" Text="{Binding PassengerListStatus}" Style="{StaticResource MutedTextStyle}" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="330" IsHitTestVisible="False" Visibility="{Binding IsPassengerListEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid></Border>

        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="105" /><RowDefinition Height="*" /><RowDefinition Height="58" /><RowDefinition Height="48" /></Grid.RowDefinitions>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="58" /><ColumnDefinition /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions><Border Width="48" Height="48" CornerRadius="24" Background="#26364D"><TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons" FontSize="23" Foreground="#8DA0B8" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding SelectedPassenger.FullName}" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="{Binding SelectedPassenger.BookingReference, StringFormat=Booking: {0}}" Style="{StaticResource MutedTextStyle}" /><TextBlock Text="{Binding SelectedPassenger.TicketNumber, StringFormat=eTicket: {0}}" Style="{StaticResource MutedTextStyle}" /></StackPanel><Grid Grid.Column="2"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="CABIN" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding SelectedPassenger.CabinMarketingName}" FontWeight="SemiBold" FontSize="11" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="SEAT" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding SelectedPassenger.SeatNumber}" FontWeight="SemiBold" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="GROUP" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding SelectedPassenger.BoardingGroup}" FontWeight="SemiBold" /></StackPanel></Grid></Grid>
            <Viewbox Grid.Row="1" Stretch="Uniform"><views:BoardingPassCardView Width="780" Height="300" /></Viewbox>
            <UniformGrid Grid.Row="2" Columns="4" Margin="0,8,0,0"><Button Content="Print Pass" Command="{Binding PrintBoardingPassCommand}" CommandParameter="{Binding SelectedPassenger}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,4,0" FontSize="12" /><Button Content="Print Bag Tags" Command="{Binding ToggleBagLoadedCommand}" CommandParameter="{Binding SelectedPassenger}" Style="{StaticResource SecondaryButtonStyle}" Margin="4,0" FontSize="11" /><Button Content="Reprint" Command="{Binding PrintBoardingPassCommand}" CommandParameter="{Binding SelectedPassenger}" Style="{StaticResource SecondaryButtonStyle}" Margin="4,0" FontSize="12" /><Button Content="Mark Issued" Command="{Binding MarkBoardingPassIssuedCommand}" CommandParameter="{Binding SelectedPassenger}" Style="{StaticResource SecondaryButtonStyle}" Margin="4,0,0,0" FontSize="12" /></UniformGrid>
            <Border Grid.Row="3" Background="#0B1B2D" CornerRadius="6" Padding="10"><Grid><TextBlock Text="Auto-issue boarding passes when printed" Style="{StaticResource MutedTextStyle}" /><TextBlock Text="{Binding OperationMessage}" Foreground="#8FC8FF" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="330" /></Grid></Border>
        </Grid></Border>

        <StackPanel Grid.Column="4">
            <Border Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,12"><StackPanel><TextBlock Text="Windows Printer" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="Select the physical or virtual printer used for dummy boarding passes." Style="{StaticResource MutedTextStyle}" Margin="0,4,0,10" TextWrapping="Wrap" /><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="38" /></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding AvailablePrinters}" SelectedItem="{Binding SelectedPrinter}" DisplayMemberPath="DisplayLabel" MinHeight="38" ToolTip="Installed and connected Windows printers" /><Button Grid.Column="1" Content="&#xE72C;" FontFamily="Segoe Fluent Icons" Command="{Binding RefreshPrintersCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="4" Margin="6,0,0,0" ToolTip="Refresh Windows printers" /></Grid><TextBlock Text="{Binding PrinterStatusMessage}" Foreground="#7FC2FF" FontSize="10" TextWrapping="Wrap" Margin="0,9,0,0" /><TextBlock Text="Printing starts only when Print Pass or Reprint is pressed." Style="{StaticResource MutedTextStyle}" FontSize="9" TextWrapping="Wrap" Margin="0,8,0,0" /></StackPanel></Border>
            <Border Style="{StaticResource CardStyle}" Padding="14"><StackPanel><TextBlock Text="Selected Ticket" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="{Binding SelectedPassenger.FullName}" Margin="0,12,0,0" /><TextBlock Text="{Binding SelectedPassenger.SeatNumber, StringFormat=Seat {0}}" Foreground="#8FC8FF" /><TextBlock Text="{Binding SelectedPassenger.BoardingPassStatus}" Foreground="{Binding SelectedPassenger.BoardingPassStatusColor}" Margin="0,8,0,0" /><TextBlock Text="{Binding SelectedPassenger.LastPrintedLabel, StringFormat=Last printed: {0}}" Style="{StaticResource MutedTextStyle}" Margin="0,5,0,0" /></StackPanel></Border>
        </StackPanel>
    </Grid>
</UserControl>
