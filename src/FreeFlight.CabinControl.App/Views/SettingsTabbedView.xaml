<UserControl x:Class="FreeFlight.CabinControl.App.Views.SettingsTabbedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SettingsTab" TargetType="RadioButton">
            <Setter Property="Height" Value="43" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="11" Padding="{TemplateBinding Padding}">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe Fluent Icons" FontSize="16" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource InfoSurfaceBrush}" /><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource InfoBorderBrush}" /><Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsCard" TargetType="Border" BasedOn="{StaticResource CardStyle}"><Setter Property="Padding" Value="19" /><Setter Property="CornerRadius" Value="15" /></Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /></Style>
        <Style x:Key="FieldHint" TargetType="TextBlock"><Setter Property="FontSize" Value="10" /><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Margin" Value="0,3,0,0" /></Style>
        <Style x:Key="AppearanceChoice" TargetType="RadioButton">
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Choice" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Choice" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Choice" Property="Background" Value="{DynamicResource InfoSurfaceBrush}" /><Setter TargetName="Choice" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" /><Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentSwatch" TargetType="RadioButton">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,9,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Ring" Background="Transparent" BorderBrush="Transparent" BorderThickness="2" CornerRadius="17" Padding="3">
                            <Ellipse Fill="{TemplateBinding Background}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" /><Setter TargetName="Ring" Property="Background" Value="{DynamicResource SurfaceBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,0,10">
            <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="PREFERENCES" Style="{StaticResource PageEyebrowStyle}" /><TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" Margin="0,4,0,0" /><TextBlock Text="Manage Ember around the way you fly, prepare the cabin and run each operation." Style="{StaticResource PageSubtitleStyle}" /></StackPanel>
                <Border Grid.Column="1" Style="{StaticResource StatusPillStyle}" VerticalAlignment="Center"><StackPanel><TextBlock Text="{Binding Version}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" /><TextBlock Text="{Binding SaveStatus}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,2,0,0" /></StackPanel></Border>
            </Grid>

            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="218" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource SettingsCard}" Padding="10">
                    <StackPanel>
                        <TextBlock Text="SETTINGS" Style="{StaticResource MetricLabelStyle}" Margin="10,4,0,10" />
                        <RadioButton GroupName="SettingsTab" Content="General" Tag="&#xE713;" Style="{StaticResource SettingsTab}" IsChecked="{Binding SelectedSection, Converter={StaticResource StringEqualsConverter}, ConverterParameter=General, Mode=OneWay}" Command="{Binding SelectSectionCommand}" CommandParameter="General" />
                        <RadioButton GroupName="SettingsTab" Content="Appearance" Tag="&#xE790;" Style="{StaticResource SettingsTab}" IsChecked="{Binding SelectedSection, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Appearance, Mode=OneWay}" Command="{Binding SelectSectionCommand}" CommandParameter="Appearance" />
                        <RadioButton GroupName="SettingsTab" Content="Flight defaults" Tag="&#xE709;" Style="{StaticResource SettingsTab}" IsChecked="{Binding SelectedSection, Converter={StaticResource StringEqualsConverter}, ConverterParameter=FlightDefaults, Mode=OneWay}" Command="{Binding SelectSectionCommand}" CommandParameter="FlightDefaults" />
                        <RadioButton GroupName="SettingsTab" Content="Data &amp; sync" Tag="&#xE895;" Style="{StaticResource SettingsTab}" IsChecked="{Binding SelectedSection, Converter={StaticResource StringEqualsConverter}, ConverterParameter=DataSync, Mode=OneWay}" Command="{Binding SelectSectionCommand}" CommandParameter="DataSync" />
                        <RadioButton GroupName="SettingsTab" Content="Device integration" Tag="&#xE772;" Style="{StaticResource SettingsTab}" IsChecked="{Binding SelectedSection, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Devices, Mode=OneWay}" Command="{Binding SelectSectionCommand}" CommandParameter="Devices" />
                        <RadioButton GroupName="SettingsTab" Content="Notifications" Tag="&#xEA8F;" Style="{StaticResource SettingsTab}" IsChecked="{Binding SelectedSection, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Notifications, Mode=OneWay}" Command="{Binding SelectSectionCommand}" CommandParameter="Notifications" />
                        <RadioButton GroupName="SettingsTab" Content="Privacy &amp; security" Tag="&#xE72E;" Style="{StaticResource SettingsTab}" IsChecked="{Binding SelectedSection, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Privacy, Mode=OneWay}" Command="{Binding SelectSectionCommand}" CommandParameter="Privacy" />
                        <RadioButton GroupName="SettingsTab" Content="About Ember" Tag="&#xE946;" Style="{StaticResource SettingsTab}" IsChecked="{Binding SelectedSection, Converter={StaticResource StringEqualsConverter}, ConverterParameter=About, Mode=OneWay}" Command="{Binding SelectSectionCommand}" CommandParameter="About" />
                    </StackPanel>
                </Border>

                <Grid Grid.Column="2">
                    <StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=General}">
                        <TextBlock Text="General" Style="{StaticResource SectionTitleStyle}" FontSize="25" /><TextBlock Text="Core app and personal workspace preferences." Style="{StaticResource PageSubtitleStyle}" FontSize="13" Margin="0,3,0,16" />
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,10,0"><StackPanel><TextBlock Text="WORKSPACE" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="Display name" Style="{StaticResource FieldLabel}" Margin="0,15,0,6" /><TextBox Text="{Binding UserDisplayName, UpdateSourceTrigger=PropertyChanged}" /><Grid Margin="0,18,0,0"><TextBlock Text="Launch with Windows" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" /><ToggleButton IsChecked="{Binding LaunchWithWindows}" Style="{StaticResource PillToggleStyle}" HorizontalAlignment="Right" /></Grid><Grid Margin="0,12,0,0"><TextBlock Text="Start minimised" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" /><ToggleButton IsChecked="{Binding StartMinimized}" Style="{StaticResource PillToggleStyle}" HorizontalAlignment="Right" /></Grid><Grid Margin="0,12,0,0"><TextBlock Text="Minimise to tray" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" /><ToggleButton IsChecked="{Binding MinimizeToTray}" Style="{StaticResource PillToggleStyle}" HorizontalAlignment="Right" /></Grid></StackPanel></Border>
                            <Border Grid.Column="1" Style="{StaticResource SettingsCard}"><StackPanel><TextBlock Text="CABIN COMPANION" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="Start cabin immersion automatically" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0,15,45,0" /><ToggleButton IsChecked="{Binding StartCabinImmersionAutomatically}" Style="{StaticResource PillToggleStyle}" HorizontalAlignment="Right" Margin="0,-20,0,0" /><Border Style="{StaticResource InfoRowStyle}" Margin="0,25,0,0"><StackPanel><TextBlock Text="LOCAL PREFERENCES" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="Changes remain local to this PC and do not interrupt an active ACARS flight." Style="{StaticResource FieldHint}" /></StackPanel></Border></StackPanel></Border>
                        </Grid>
                    </StackPanel>

                    <StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Appearance}">
                        <TextBlock Text="Appearance" Style="{StaticResource SectionTitleStyle}" FontSize="25" />
                        <TextBlock Text="Tailor Ember around the way you fly — with richer visual depth, clear controls and no impact on your live operation." Style="{StaticResource PageSubtitleStyle}" FontSize="13" Margin="0,3,0,16" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.08*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="THEME &amp; ACCENT" Style="{StaticResource MetricLabelStyle}" />
                                    <TextBlock Text="Theme mode" Style="{StaticResource FieldLabel}" Margin="0,15,0,7" />
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton GroupName="ThemeMode" Content="☀  Light" Tag="Light" Style="{StaticResource AppearanceChoice}" IsChecked="{Binding Theme, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Light, Mode=OneWay}" Checked="ThemeModeButton_Click" />
                                        <RadioButton GroupName="ThemeMode" Content="◐  Dark" Tag="Dark" Style="{StaticResource AppearanceChoice}" IsChecked="{Binding Theme, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Dark, Mode=OneWay}" Checked="ThemeModeButton_Click" />
                                        <RadioButton GroupName="ThemeMode" Content="◉  Auto" Tag="Auto" Style="{StaticResource AppearanceChoice}" IsChecked="{Binding Theme, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Auto, Mode=OneWay}" Checked="ThemeModeButton_Click" />
                                    </StackPanel>
                                    <TextBlock Text="Accent colour" Style="{StaticResource FieldLabel}" Margin="0,18,0,6" />
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton GroupName="AccentPreset" Tag="BAV Blue" Background="#1476FF" ToolTip="BAV Blue" Style="{StaticResource AccentSwatch}" IsChecked="{Binding AccentPreset, Converter={StaticResource StringEqualsConverter}, ConverterParameter=BAV Blue, Mode=OneWay}" Checked="AccentPresetButton_Click" />
                                        <RadioButton GroupName="AccentPreset" Tag="Crimson" Background="#D93D62" ToolTip="Crimson" Style="{StaticResource AccentSwatch}" IsChecked="{Binding AccentPreset, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Crimson, Mode=OneWay}" Checked="AccentPresetButton_Click" />
                                        <RadioButton GroupName="AccentPreset" Tag="Violet" Background="#7C63D9" ToolTip="Violet" Style="{StaticResource AccentSwatch}" IsChecked="{Binding AccentPreset, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Violet, Mode=OneWay}" Checked="AccentPresetButton_Click" />
                                        <RadioButton GroupName="AccentPreset" Tag="Emerald" Background="#168D70" ToolTip="Emerald" Style="{StaticResource AccentSwatch}" IsChecked="{Binding AccentPreset, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Emerald, Mode=OneWay}" Checked="AccentPresetButton_Click" />
                                        <RadioButton GroupName="AccentPreset" Tag="Amber" Background="#C87813" ToolTip="Amber" Style="{StaticResource AccentSwatch}" IsChecked="{Binding AccentPreset, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Amber, Mode=OneWay}" Checked="AccentPresetButton_Click" />
                                        <RadioButton GroupName="AccentPreset" Tag="Slate" Background="#60748C" ToolTip="Slate" Style="{StaticResource AccentSwatch}" IsChecked="{Binding AccentPreset, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Slate, Mode=OneWay}" Checked="AccentPresetButton_Click" />
                                    </StackPanel>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="112" /><ColumnDefinition Width="*" /><ColumnDefinition Width="128" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Custom colour" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding AccentColor, UpdateSourceTrigger=PropertyChanged}" ToolTip="Custom accent hexadecimal colour, for example #1476FF" />
                                        <Button Grid.Column="2" Content="Apply custom" Click="ApplyCustomAccentButton_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" />
                                    </Grid>
                                    <TextBlock Text="Choose a bright preset instantly, or use a personal hex colour for Ember's live accents and actions." Style="{StaticResource FieldHint}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <TextBlock Text="READABILITY &amp; LAYOUT" Style="{StaticResource MetricLabelStyle}" />
                                    <TextBlock Text="Text and control scale" Style="{StaticResource FieldLabel}" Margin="0,15,0,7" />
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton GroupName="UiScale" Content="90%" Tag="90" Style="{StaticResource AppearanceChoice}" IsChecked="{Binding UiScalePercent, Converter={StaticResource StringEqualsConverter}, ConverterParameter=90, Mode=OneWay}" Checked="UiScaleButton_Click" />
                                        <RadioButton GroupName="UiScale" Content="100%" Tag="100" Style="{StaticResource AppearanceChoice}" IsChecked="{Binding UiScalePercent, Converter={StaticResource StringEqualsConverter}, ConverterParameter=100, Mode=OneWay}" Checked="UiScaleButton_Click" />
                                        <RadioButton GroupName="UiScale" Content="110%" Tag="110" Style="{StaticResource AppearanceChoice}" IsChecked="{Binding UiScalePercent, Converter={StaticResource StringEqualsConverter}, ConverterParameter=110, Mode=OneWay}" Checked="UiScaleButton_Click" />
                                        <RadioButton GroupName="UiScale" Content="125%" Tag="125" Style="{StaticResource AppearanceChoice}" IsChecked="{Binding UiScalePercent, Converter={StaticResource StringEqualsConverter}, ConverterParameter=125, Mode=OneWay}" Checked="UiScaleButton_Click" />
                                    </StackPanel>
                                    <TextBlock Text="Card density" Style="{StaticResource FieldLabel}" Margin="0,16,0,7" />
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton GroupName="CardDensity" Content="Comfortable" Tag="Comfortable" Style="{StaticResource AppearanceChoice}" IsChecked="{Binding CardDensity, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Comfortable, Mode=OneWay}" Checked="CardDensityButton_Click" />
                                        <RadioButton GroupName="CardDensity" Content="Compact" Tag="Compact" Style="{StaticResource AppearanceChoice}" IsChecked="{Binding CardDensity, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Compact, Mode=OneWay}" Checked="CardDensityButton_Click" />
                                        <RadioButton GroupName="CardDensity" Content="Spacious" Tag="Spacious" Style="{StaticResource AppearanceChoice}" IsChecked="{Binding CardDensity, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Spacious, Mode=OneWay}" Checked="CardDensityButton_Click" />
                                    </StackPanel>
                                    <Grid Margin="0,13,0,0"><TextBlock Text="Compact mode" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" /><ToggleButton IsChecked="{Binding CompactMode}" Checked="AppearanceControlChanged" Unchecked="AppearanceControlChanged" Style="{StaticResource PillToggleStyle}" HorizontalAlignment="Right" /></Grid>
                                    <Grid Margin="0,13,0,0"><TextBlock Text="Rounded corners" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" /><ToggleButton IsChecked="{Binding UseRoundedCorners}" Checked="AppearanceControlChanged" Unchecked="AppearanceControlChanged" Style="{StaticResource PillToggleStyle}" HorizontalAlignment="Right" /></Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="NAVIGATION" Style="{StaticResource MetricLabelStyle}" />
                                    <TextBlock Text="Sidebar style" Style="{StaticResource FieldLabel}" Margin="0,15,0,7" />
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton GroupName="SidebarStyle" Content="Full labels" Tag="Full labels" Style="{StaticResource AppearanceChoice}" IsChecked="{Binding SidebarStyle, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Full labels, Mode=OneWay}" Checked="SidebarStyleButton_Click" />
                                        <RadioButton GroupName="SidebarStyle" Content="Icons only" Tag="Icons only" Style="{StaticResource AppearanceChoice}" IsChecked="{Binding SidebarStyle, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Icons only, Mode=OneWay}" Checked="SidebarStyleButton_Click" />
                                        <RadioButton GroupName="SidebarStyle" Content="Auto" Tag="Auto (adaptive)" Style="{StaticResource AppearanceChoice}" IsChecked="{Binding SidebarStyle, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Auto (adaptive), Mode=OneWay}" Checked="SidebarStyleButton_Click" />
                                    </StackPanel>
                                    <TextBlock Text="Auto adapts the sidebar to compact navigation when the Ember window becomes narrow." Style="{StaticResource FieldHint}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <TextBlock Text="OVERVIEW ARTWORK" Style="{StaticResource MetricLabelStyle}" />
                                    <Grid Margin="0,15,0,0"><TextBlock Text="Show aircraft artwork" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" /><ToggleButton IsChecked="{Binding ShowBackgroundArtwork}" Checked="AppearanceControlChanged" Unchecked="AppearanceControlChanged" Style="{StaticResource PillToggleStyle}" HorizontalAlignment="Right" /></Grid>
                                    <Grid Margin="0,13,0,0"><TextBlock Text="Ambient backdrop" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" /><ToggleButton IsChecked="{Binding ShowAmbientBackdrop}" Checked="AppearanceControlChanged" Unchecked="AppearanceControlChanged" Style="{StaticResource PillToggleStyle}" HorizontalAlignment="Right" /></Grid>
                                    <TextBlock Text="Dashboard image style" Style="{StaticResource FieldLabel}" Margin="0,13,0,7" />
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton GroupName="DashboardStyle" Content="Aircraft" Tag="Aircraft &amp; sky" Style="{StaticResource AppearanceChoice}" IsChecked="{Binding DashboardImageStyle, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Aircraft &amp; sky, Mode=OneWay}" Checked="DashboardStyleButton_Click" />
                                        <RadioButton GroupName="DashboardStyle" Content="Subtle" Tag="Subtle aircraft" Style="{StaticResource AppearanceChoice}" IsChecked="{Binding DashboardImageStyle, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Subtle aircraft, Mode=OneWay}" Checked="DashboardStyleButton_Click" />
                                        <RadioButton GroupName="DashboardStyle" Content="Minimal" Tag="Minimal" Style="{StaticResource AppearanceChoice}" IsChecked="{Binding DashboardImageStyle, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Minimal, Mode=OneWay}" Checked="DashboardStyleButton_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Style="{StaticResource SettingsCard}" Margin="0,10,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="VISUAL DEPTH" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="Choose the level of premium lighting, hover response and card elevation used throughout Ember." Style="{StaticResource FieldHint}" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><RadioButton GroupName="VisualEffects" Content="Signature" Tag="Signature" Style="{StaticResource AppearanceChoice}" IsChecked="{Binding VisualEffectsProfile, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Signature, Mode=OneWay}" Checked="VisualEffectsButton_Click" /><RadioButton GroupName="VisualEffects" Content="Immersive" Tag="Immersive" Style="{StaticResource AppearanceChoice}" IsChecked="{Binding VisualEffectsProfile, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Immersive, Mode=OneWay}" Checked="VisualEffectsButton_Click" Margin="0" /></StackPanel></Grid></Border>
                        <Border Style="{StaticResource InfoRowStyle}" Margin="0,10,0,0"><StackPanel><TextBlock Text="APPLIES LIVE" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="Your selected appearance updates Overview, iGate and the active Ember workspace. It is saved on this PC only and does not restart, alter or submit your current flight." Style="{StaticResource FieldHint}" /></StackPanel></Border>
                    </StackPanel>

                    <StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=FlightDefaults}">
                        <TextBlock Text="Flight defaults" Style="{StaticResource SectionTitleStyle}" FontSize="25" /><TextBlock Text="Set safe fallback values while the website flight briefing is still arriving." Style="{StaticResource PageSubtitleStyle}" FontSize="13" Margin="0,3,0,16" />
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,10,0"><StackPanel><TextBlock Text="DEFAULT FLIGHT" Style="{StaticResource MetricLabelStyle}" /><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="74" /><ColumnDefinition Width="74" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,7,0"><TextBlock Text="Flight number" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" /><TextBox Text="{Binding GateFlightNumber, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><StackPanel Grid.Column="1" Margin="0,0,7,0"><TextBlock Text="Origin" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" /><TextBox Text="{Binding GateOriginIata, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Destination" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" /><TextBox Text="{Binding GateDestinationIata, UpdateSourceTrigger=PropertyChanged}" /></StackPanel></Grid><Grid Margin="0,13,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,6,0"><TextBlock Text="Departure gate" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" /><TextBox Text="{Binding GateNumber, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="Arrival gate" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" /><TextBox Text="{Binding ArrivalGateNumber, UpdateSourceTrigger=PropertyChanged}" /></StackPanel></Grid><Grid Margin="0,16,0,0"><TextBlock Text="Assign gates automatically" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" /><ToggleButton IsChecked="{Binding AutomaticGateAssignment}" Style="{StaticResource PillToggleStyle}" HorizontalAlignment="Right" /></Grid><Grid Margin="0,12,0,0"><TextBlock Text="Use automatic gate timing" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" /><ToggleButton IsChecked="{Binding AutomaticGateTiming}" Style="{StaticResource PillToggleStyle}" HorizontalAlignment="Right" /></Grid></StackPanel></Border>
                            <Border Grid.Column="1" Style="{StaticResource SettingsCard}"><StackPanel><TextBlock Text="CABIN &amp; TURNAROUND" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="Cabin profile" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" /><ComboBox ItemsSource="{Binding CabinLayoutProfiles}" SelectedItem="{Binding SelectedCabinLayoutProfile}" DisplayMemberPath="Name" /><TextBlock Text="{Binding SelectedCabinLayoutProfile.Description}" Style="{StaticResource FieldHint}" /><Grid Margin="0,15,0,0"><TextBlock Text="Turnaround duration" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" /><ComboBox ItemsSource="{Binding TurnaroundDurations}" SelectedItem="{Binding TurnaroundMinutes}" Width="112" HorizontalAlignment="Right" /></Grid><Grid Margin="0,12,0,0"><TextBlock Text="Boarding start" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" /><ComboBox ItemsSource="{Binding BoardingStartOffsets}" SelectedItem="{Binding BoardingStartMinutesBeforeDeparture}" Width="112" HorizontalAlignment="Right" /></Grid><Grid Margin="0,12,0,0"><TextBlock Text="Final boarding" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" /><ComboBox ItemsSource="{Binding FinalBoardingOffsets}" SelectedItem="{Binding FinalBoardingMinutesBeforeDeparture}" Width="112" HorizontalAlignment="Right" /></Grid><Grid Margin="0,12,0,0"><TextBlock Text="Gate close" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" /><ComboBox ItemsSource="{Binding GateCloseOffsets}" SelectedItem="{Binding GateCloseMinutesBeforeDeparture}" Width="112" HorizontalAlignment="Right" /></Grid></StackPanel></Border>
                        </Grid>
                    </StackPanel>

                    <StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=DataSync}">
                        <TextBlock Text="Data &amp; sync" Style="{StaticResource SectionTitleStyle}" FontSize="25" /><TextBlock Text="Manage local sync behaviour while BAV remains the source of operational flight and fleet data." Style="{StaticResource PageSubtitleStyle}" FontSize="13" Margin="0,3,0,16" />
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,10,0"><StackPanel><TextBlock Text="FLEET DATA" Style="{StaticResource MetricLabelStyle}" /><Grid Margin="0,15,0,0"><TextBlock Text="Synchronise automatically" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" /><ToggleButton IsChecked="{Binding FleetAutoSync}" Style="{StaticResource PillToggleStyle}" HorizontalAlignment="Right" /></Grid><TextBlock Text="Refresh interval (seconds)" Style="{StaticResource FieldLabel}" Margin="0,15,0,6" /><TextBox Text="{Binding FleetSyncIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" /><TextBlock Text="Preferred registration" Style="{StaticResource FieldLabel}" Margin="0,15,0,6" /><TextBox Text="{Binding SelectedFleetRegistration, UpdateSourceTrigger=PropertyChanged}" /><TextBlock Text="{Binding FleetApiBaseUrl}" Foreground="{DynamicResource PrimaryBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,12,0,0" /></StackPanel></Border>
                            <Border Grid.Column="1" Style="{StaticResource SettingsCard}"><StackPanel><TextBlock Text="UPDATES" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="Built-in updater" Style="{StaticResource SectionTitleStyle}" FontSize="17" Margin="0,5,0,0" /><TextBlock Text="Ember delivers hotfixes through the in-app updater." Style="{StaticResource FieldHint}" /><Grid Margin="0,18,0,0"><TextBlock Text="Check automatically" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" /><ToggleButton IsChecked="{Binding AutomaticallyCheckForUpdates}" Style="{StaticResource PillToggleStyle}" HorizontalAlignment="Right" /></Grid><Button Content="Check for Ember updates" Click="CheckForUpdatesButton_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0,18,0,0" /><Button Content="Preview updater status" Click="PreviewUpdateButton_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,9,0,0" /></StackPanel></Border>
                        </Grid>
                        <Border Style="{StaticResource SettingsCard}" Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="SAYINTENTIONS CABIN EVENTS" Style="{StaticResource MetricLabelStyle}" />
                                    <TextBlock Text="File clear cabin-equipment faults from the active local SayIntentions flight against the aircraft reserved for this BAV website flight." Style="{StaticResource FieldHint}" TextWrapping="Wrap" Margin="0,7,36,0" />
                                    <TextBlock Text="Your personal SayIntentions key is read only in memory from the local active-flight session. Ember never saves, logs or sends it to BAV." Foreground="{DynamicResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,8,36,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Width="178">
                                    <ToggleButton IsChecked="{Binding SayIntentionsCabinEventSync}" Style="{StaticResource PillToggleStyle}" HorizontalAlignment="Right" />
                                    <TextBlock Text="Auto-file clear technical events" Style="{StaticResource FieldLabel}" FontSize="10" TextAlignment="Right" TextWrapping="Wrap" Margin="0,7,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Devices}">
                        <TextBlock Text="Device integration" Style="{StaticResource SectionTitleStyle}" FontSize="25" /><TextBlock Text="Connect simulator telemetry, aircraft doors and the seat-belt sign to Ember's live cabin workflow." Style="{StaticResource PageSubtitleStyle}" FontSize="13" Margin="0,3,0,16" />
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,10,0"><StackPanel><TextBlock Text="SIMULATOR CONNECTION" Style="{StaticResource MetricLabelStyle}" /><Grid Margin="0,15,0,0"><TextBlock Text="X-Plane automatic connection" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" /><ToggleButton IsChecked="{Binding XPlaneAutoConnect}" Style="{StaticResource PillToggleStyle}" HorizontalAlignment="Right" /></Grid><Grid Margin="0,12,0,0"><TextBlock Text="MSFS 2024 automatic connection" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" /><ToggleButton IsChecked="{Binding Msfs2024AutoConnect}" Style="{StaticResource PillToggleStyle}" HorizontalAlignment="Right" /></Grid><Grid Margin="0,12,0,0"><TextBlock Text="Synchronise aircraft doors" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" /><ToggleButton IsChecked="{Binding SyncXPlaneDoors}" Style="{StaticResource PillToggleStyle}" HorizontalAlignment="Right" /></Grid><Grid Margin="0,12,0,0"><TextBlock Text="Synchronise seat-belt sign" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" /><ToggleButton IsChecked="{Binding SyncSimulatorSeatbeltSign}" Style="{StaticResource PillToggleStyle}" HorizontalAlignment="Right" /></Grid><Border Style="{StaticResource InfoRowStyle}" Margin="0,17,0,0"><TextBlock Text="{Binding Status.ConnectionDetail}" Foreground="{Binding Status.ConnectionColor}" FontSize="11" TextWrapping="Wrap" /></Border><Button Content="Retry connection" Command="{Binding ReconnectXPlaneCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,12,0,0" /></StackPanel></Border>
                            <Border Grid.Column="1" Style="{StaticResource SettingsCard}"><StackPanel><TextBlock Text="X-PLANE CONNECTOR" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding XPlaneExecutableLabel}" Style="{StaticResource FieldHint}" Margin="0,14,0,0" /><StackPanel Orientation="Horizontal" Margin="0,14,0,0"><Button Content="Select folder" Command="{Binding SelectXPlaneFolderCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" /><Button Content="Select X-Plane.exe" Command="{Binding SelectXPlaneExecutableCommand}" Style="{StaticResource SecondaryButtonStyle}" /></StackPanel><TextBlock Text="{Binding XPlanePluginStatus}" Style="{StaticResource FieldHint}" Margin="0,15,0,0" /><Button Content="Install or update connector" Command="{Binding InstallXPlanePluginCommand}" IsEnabled="{Binding CanInstallXPlanePlugin}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,14,0,0" /></StackPanel></Border>
                        </Grid>
                    </StackPanel>

                    <StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Notifications}">
                        <TextBlock Text="Notifications" Style="{StaticResource SectionTitleStyle}" FontSize="25" /><TextBlock Text="Control gate prompts, chimes and local printing queues." Style="{StaticResource PageSubtitleStyle}" FontSize="13" Margin="0,3,0,16" />
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,10,0"><StackPanel><TextBlock Text="CABIN ALERTS" Style="{StaticResource MetricLabelStyle}" /><Grid Margin="0,15,0,0"><TextBlock Text="Sound alerts" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" /><ToggleButton IsChecked="{Binding SoundAlerts}" Style="{StaticResource PillToggleStyle}" HorizontalAlignment="Right" /></Grid><TextBlock Text="Boarding call chime" Style="{StaticResource FieldLabel}" Margin="0,15,0,6" /><ComboBox ItemsSource="{Binding BoardingCallChimes}" SelectedItem="{Binding BoardingCallChime}" /><TextBlock Text="Boarding group order" Style="{StaticResource FieldLabel}" Margin="0,15,0,6" /><ComboBox ItemsSource="{Binding BoardingGroupOrders}" SelectedItem="{Binding BoardingGroupOrder}" /><Grid Margin="0,15,0,0"><TextBlock Text="Special assistance boards first" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0,0,45,0" /><ToggleButton IsChecked="{Binding SpecialAssistanceBoardsFirst}" Style="{StaticResource PillToggleStyle}" HorizontalAlignment="Right" /></Grid></StackPanel></Border>
                            <Border Grid.Column="1" Style="{StaticResource SettingsCard}"><StackPanel><TextBlock Text="PRINTING" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="Boarding-pass printer" Style="{StaticResource FieldLabel}" Margin="0,15,0,6" /><TextBox Text="{Binding BoardingPassPrinter, UpdateSourceTrigger=PropertyChanged}" /><Button Content="Test boarding-pass queue" Command="{Binding TestBoardingPassPrinterCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,9,0,0" /><TextBlock Text="{Binding BoardingPassPrinterStatus}" Style="{StaticResource FieldHint}" /><TextBlock Text="Bag-tag printer" Style="{StaticResource FieldLabel}" Margin="0,15,0,6" /><TextBox Text="{Binding BagTagPrinter, UpdateSourceTrigger=PropertyChanged}" /><Button Content="Test bag-tag queue" Command="{Binding TestBagTagPrinterCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,9,0,0" /><TextBlock Text="{Binding BagTagPrinterStatus}" Style="{StaticResource FieldHint}" /></StackPanel></Border>
                        </Grid>
                    </StackPanel>

                    <StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Privacy}">
                        <TextBlock Text="Privacy &amp; security" Style="{StaticResource SectionTitleStyle}" FontSize="25" /><TextBlock Text="Your website credentials remain with British Airways Virtual; Ember only stores a protected local session." Style="{StaticResource PageSubtitleStyle}" FontSize="13" Margin="0,3,0,16" />
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,10,0"><StackPanel><TextBlock Text="ACCOUNT SECURITY" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="Encrypted sign-in session" Style="{StaticResource SectionTitleStyle}" FontSize="17" Margin="0,5,0,0" /><TextBlock Text="Ember never stores the BAV website password. Account permissions and password recovery remain on the BAV website." Style="{StaticResource FieldHint}" Margin="0,9,0,0" /><Border Style="{StaticResource SuccessPillStyle}" Margin="0,18,0,0"><TextBlock Text="Account security is managed by the BAV website" Foreground="{DynamicResource SuccessTextBrush}" FontSize="10" FontWeight="SemiBold" /></Border></StackPanel></Border>
                            <Border Grid.Column="1" Style="{StaticResource SettingsCard}"><StackPanel><TextBlock Text="LOCAL RETENTION" Style="{StaticResource MetricLabelStyle}" /><Grid Margin="0,15,0,0"><TextBlock Text="Archive completed flights" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" /><ToggleButton IsChecked="{Binding AutoArchiveCompletedFlights}" Style="{StaticResource PillToggleStyle}" HorizontalAlignment="Right" /></Grid><TextBlock Text="Archive after (days)" Style="{StaticResource FieldLabel}" Margin="0,15,0,6" /><TextBox Text="{Binding ArchiveCompletedFlightsAfterDays, UpdateSourceTrigger=PropertyChanged}" /><TextBlock Text="This affects only local Ember history, never the BAV pilot record." Style="{StaticResource FieldHint}" /></StackPanel></Border>
                        </Grid>
                    </StackPanel>

                    <StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=About}">
                        <TextBlock Text="About Ember" Style="{StaticResource SectionTitleStyle}" FontSize="25" /><TextBlock Text="Product, update and support information for the British Airways Virtual flight companion." Style="{StaticResource PageSubtitleStyle}" FontSize="13" Margin="0,3,0,16" />
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource HeroPanelStyle}" Margin="0,0,10,0"><StackPanel><TextBlock Text="EMBER" Foreground="#C9EDFF" FontSize="10" FontWeight="SemiBold" /><TextBlock Text="British Airways Virtual flight companion" Foreground="White" FontSize="23" FontWeight="SemiBold" Margin="0,6,0,0" /><TextBlock Text="{Binding Version}" Foreground="#DDF3FF" FontSize="13" Margin="0,7,0,0" /><TextBlock Text="Your website flight, cabin workflow and ACARS operation in one desktop workspace." Foreground="#DDF3FF" FontSize="12" TextWrapping="Wrap" Margin="0,17,0,0" /></StackPanel></Border>
                            <Border Grid.Column="1" Style="{StaticResource SettingsCard}"><StackPanel><TextBlock Text="UPDATES &amp; SUPPORT" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding ActiveAirlinePackName}" Style="{StaticResource FieldHint}" Margin="0,15,0,0" /><Button Content="Check for Ember updates" Click="CheckForUpdatesButton_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0,17,0,0" /><Button Content="Open licence" Click="OpenLicenceButton_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,9,0,0" /></StackPanel></Border>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>

            <Border Style="{StaticResource CardStyle}" Margin="236,18,0,0" Padding="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="SAVE YOUR PREFERENCES" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="Changes remain local to this PC and do not interrupt an active flight." Style="{StaticResource FieldHint}" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Restore defaults" Command="{Binding RestoreDefaultsCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" /><Button Content="Save changes" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" /></StackPanel></Grid></Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
