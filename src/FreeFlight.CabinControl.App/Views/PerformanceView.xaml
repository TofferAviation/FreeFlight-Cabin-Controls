<UserControl x:Class="FreeFlight.CabinControl.App.Views.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Hidden">
        <StackPanel>
            <TextBlock Text="Ember Performance" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Current resource cost created by this application only" Style="{StaticResource PageSubtitleStyle}" />

            <UniformGrid Columns="4" Margin="0,18,0,14">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0"><StackPanel><TextBlock Text="APP CPU" Style="{StaticResource MutedTextStyle}"/><TextBlock Text="{Binding CpuUsage}" FontSize="27" Foreground="#55AEFF"/><TextBlock Text="Current Ember process" Style="{StaticResource MutedTextStyle}"/></StackPanel></Border>
                <Border Style="{StaticResource CardStyle}" Margin="8,0"><StackPanel><TextBlock Text="APP MEMORY" Style="{StaticResource MutedTextStyle}"/><TextBlock Text="{Binding MemoryUsage}" FontSize="27" Foreground="#58E68A"/><TextBlock Text="Working set in RAM" Style="{StaticResource MutedTextStyle}"/></StackPanel></Border>
                <Border Style="{StaticResource CardStyle}" Margin="8,0"><StackPanel><TextBlock Text="MANAGED HEAP" Style="{StaticResource MutedTextStyle}"/><TextBlock Text="{Binding ManagedHeap}" FontSize="20" Foreground="#B88CFF" TextWrapping="Wrap"/><TextBlock Text=".NET allocations used by the app" Style="{StaticResource MutedTextStyle}"/></StackPanel></Border>
                <Border Style="{StaticResource CardStyle}" Margin="8,0,0,0"><StackPanel><TextBlock Text="PROCESS DETAIL" Style="{StaticResource MutedTextStyle}"/><TextBlock Text="{Binding ProcessDetail}" FontSize="20" Foreground="#FFCB69" TextWrapping="Wrap"/><TextBlock Text="Ember threads and handles" Style="{StaticResource MutedTextStyle}"/></StackPanel></Border>
            </UniformGrid>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="175"/></Grid.RowDefinitions>
                    <Grid><StackPanel><TextBlock Text="60-second application footprint" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="Blue: app CPU % · Green: app memory MB" Style="{StaticResource MutedTextStyle}"/></StackPanel><TextBlock Text="{Binding PeakSummary}" HorizontalAlignment="Right" Foreground="#8FC8FF"/></Grid>
                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Rectangle Fill="#091629" RadiusX="6" RadiusY="6"/>
                        <Polyline Points="{Binding CpuGraphPoints}" Stroke="#42A8FF" StrokeThickness="2" Stretch="Fill" Margin="12"/>
                        <Polyline Points="{Binding MemoryGraphPoints}" Stroke="#58E68A" StrokeThickness="2" Stretch="Fill" Margin="12" Opacity="0.85"/>
                    </Grid>
                </Grid>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Measured app impact" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="{Binding Recommendation}" Foreground="{Binding RecommendationColor}" FontSize="15" TextWrapping="Wrap" LineHeight="23" Margin="0,12,0,8"/>
                        <TextBlock Text="This page intentionally excludes total system load and simulator load. Simulator FPS impact requires a controlled A/B comparison and is not inferred from unrelated process usage." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                        <Button Content="Open Log Folder" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding OpenLogFolderCommand}" HorizontalAlignment="Left" Margin="0,16,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Cabin rendering mode" Style="{StaticResource SectionTitleStyle}"/>
                        <RadioButton Content="Quality" IsChecked="{Binding IsQualityMode}" GroupName="PerformanceMode" Margin="0,15,0,4"/>
                        <TextBlock Text="Highest animation update rate" Style="{StaticResource MutedTextStyle}" Margin="22,0,0,7"/>
                        <RadioButton Content="Balanced" IsChecked="{Binding IsBalancedMode}" GroupName="PerformanceMode" Margin="0,6,0,4"/>
                        <TextBlock Text="Recommended default" Style="{StaticResource MutedTextStyle}" Margin="22,0,0,7"/>
                        <RadioButton Content="Low Impact" IsChecked="{Binding IsLowImpactMode}" GroupName="PerformanceMode" Margin="0,6,0,4"/>
                        <TextBlock Text="Reduced cabin refresh frequency" Style="{StaticResource MutedTextStyle}" Margin="22,0,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
