<UserControl x:Class="FreeFlight.CabinControl.App.Views.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="820"
             d:DesignWidth="1200">
    <UserControl.Resources>
        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="128" />
                <RowDefinition Height="16" />
                <RowDefinition Height="300" />
                <RowDefinition Height="16" />
                <RowDefinition Height="185" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse Width="12" Height="12" Fill="{Binding Status.ConnectionColor}" Margin="0,0,9,0" />
                    <TextBlock Text="{Binding Status.ConnectionLabel}" Foreground="{Binding Status.ConnectionColor}" FontSize="13" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,7,0" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="54" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="22" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="#0C1A30">
                            <TextBlock Text="&#xE950;" FontFamily="Segoe Fluent Icons" FontSize="23" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="FREEFLIGHT CPU" Style="{StaticResource MutedTextStyle}" />
                            <TextBlock Text="{Binding CpuUsage}" Style="{StaticResource MetricValueStyle}" />
                            <TextBlock Text="Cabin Controls process" Foreground="{StaticResource SuccessBrush}" FontSize="11" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="7,0" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="54" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="22" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="#0C1A30">
                            <TextBlock Text="&#xEDA2;" FontFamily="Segoe Fluent Icons" FontSize="23" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="FREEFLIGHT RAM" Style="{StaticResource MutedTextStyle}" />
                            <TextBlock Text="{Binding MemoryUsage}" Style="{StaticResource MetricValueStyle}" />
                            <TextBlock Text="Private process memory" Foreground="{StaticResource SuccessBrush}" FontSize="11" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="7,0" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="54" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="22" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="#0C1A30">
                            <TextBlock Text="&#xE7C9;" FontFamily="Segoe Fluent Icons" FontSize="23" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="SIMULATOR FPS" Style="{StaticResource MutedTextStyle}" />
                            <TextBlock Text="{Binding SimulatorFps}" Style="{StaticResource MetricValueStyle}" />
                            <TextBlock Text="Context only" Foreground="#8DA0B8" FontSize="11" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource CardStyle}" Margin="7,0,0,0" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="54" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="22" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="#0C1A30">
                            <TextBlock Text="&#xE823;" FontFamily="Segoe Fluent Icons" FontSize="23" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="TELEMETRY AGE" Style="{StaticResource MutedTextStyle}" />
                            <TextBlock Text="{Binding BridgeFrameTime}" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                            <TextBlock Text="Latest simulator frame" Foreground="#8DA0B8" FontSize="11" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.8*" />
                    <ColumnDefinition Width="0.9*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="*" /><RowDefinition Height="28" /></Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="FreeFlight resource history" Style="{StaticResource SectionTitleStyle}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Rectangle Width="20" Height="3" Fill="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="CPU" Margin="7,0,18,0" VerticalAlignment="Center" />
                                <Rectangle Width="20" Height="3" Fill="{StaticResource CyanBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="RAM" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1" Margin="10,4,4,0">
                            <Rectangle Fill="#060E1C" Stroke="{StaticResource BorderSoftBrush}" />
                            <Grid Opacity="0.45">
                                <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <Border Grid.Row="1" Grid.ColumnSpan="6" BorderBrush="#314155" BorderThickness="0,1,0,0" />
                                <Border Grid.Row="2" Grid.ColumnSpan="6" BorderBrush="#314155" BorderThickness="0,1,0,0" />
                                <Border Grid.Row="3" Grid.ColumnSpan="6" BorderBrush="#314155" BorderThickness="0,1,0,0" />
                                <Border Grid.Column="1" Grid.RowSpan="4" BorderBrush="#314155" BorderThickness="1,0,0,0" />
                                <Border Grid.Column="2" Grid.RowSpan="4" BorderBrush="#314155" BorderThickness="1,0,0,0" />
                                <Border Grid.Column="3" Grid.RowSpan="4" BorderBrush="#314155" BorderThickness="1,0,0,0" />
                                <Border Grid.Column="4" Grid.RowSpan="4" BorderBrush="#314155" BorderThickness="1,0,0,0" />
                                <Border Grid.Column="5" Grid.RowSpan="4" BorderBrush="#314155" BorderThickness="1,0,0,0" />
                            </Grid>
                            <Viewbox Stretch="Fill" Margin="0,12">
                                <Canvas Width="700" Height="150">
                                    <Polyline Stroke="{StaticResource CyanBrush}" StrokeThickness="3" Points="{Binding MemoryGraphPoints}" />
                                    <Polyline Stroke="{StaticResource PrimaryBrush}" StrokeThickness="3" Points="{Binding CpuGraphPoints}" />
                                </Canvas>
                            </Viewbox>
                        </Grid>
                        <TextBlock Grid.Row="2" Text="Last 60 samples · only the Cabin Controls process is graphed" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Text="Process cost" Style="{StaticResource SectionTitleStyle}" />
                        <StackPanel Grid.Row="1">
                            <Grid Height="52"><TextBlock Text="Managed heap" VerticalAlignment="Center" /><TextBlock Text="{Binding ManagedHeap}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#42A8FF" /></Grid>
                            <Separator Background="{StaticResource BorderSoftBrush}" />
                            <Grid Height="52"><TextBlock Text="Diagnostics sample" VerticalAlignment="Center" /><TextBlock Text="{Binding SamplingCost}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#42A8FF" /></Grid>
                            <Separator Background="{StaticResource BorderSoftBrush}" />
                            <StackPanel Margin="0,14,0,0">
                                <TextBlock Text="Process detail" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock Text="{Binding ProcessDetail}" Margin="0,5,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="6" Style="{StaticResource CardStyle}" Padding="22,18">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="54" /><ColumnDefinition Width="*" /><ColumnDefinition Width="290" /></Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" CornerRadius="21" Background="#0C1A30" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" VerticalAlignment="Top">
                        <TextBlock Text="&#xE9D2;" FontFamily="Segoe Fluent Icons" FontSize="22" Foreground="{Binding ImpactColor}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="4,0,28,0">
                        <TextBlock Text="Current FreeFlight impact" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="{Binding ImpactSummary}" Foreground="{Binding ImpactColor}" FontSize="15" FontWeight="SemiBold" Margin="0,9,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding PerformanceLossLabel}" Foreground="#8DA0B8" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="WHAT THIS PAGE MEASURES" Foreground="#61758E" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <TextBlock Text="Cabin Controls CPU · RAM · process overhead" Foreground="#B9C7D8" FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Right" />
                        <TextBlock Text="Simulator FPS is shown only as context" Foreground="#8DA0B8" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>