<UserControl x:Class="FreeFlight.CabinControl.App.Views.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="SYSTEM HEALTH" Foreground="{DynamicResource PrimaryBrush}" FontSize="10" FontWeight="SemiBold" /><TextBlock Text="Reports &amp; diagnostics" Style="{StaticResource PageTitleStyle}" Margin="0,4,0,0" /><TextBlock Text="Live Ember and simulator health information. This screen never changes a flight record." Style="{StaticResource PageSubtitleStyle}" /></StackPanel><Button Grid.Column="1" Content="Open diagnostic logs" Command="{Binding OpenLogFolderCommand}" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" /></Grid>
            <UniformGrid Columns="4" Margin="0,0,0,16"><Border Style="{StaticResource MetricCardStyle}" Padding="16" Margin="0,0,10,0"><StackPanel><TextBlock Text="EMBER CPU" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding CpuUsage}" FontSize="26" FontWeight="SemiBold" Margin="0,5,0,0" /><TextBlock Text="Current application usage" Style="{StaticResource MutedTextStyle}" FontSize="11" /></StackPanel></Border><Border Style="{StaticResource MetricCardStyle}" Padding="16" Margin="0,0,10,0"><StackPanel><TextBlock Text="EMBER MEMORY" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding MemoryUsage}" FontSize="26" FontWeight="SemiBold" Margin="0,5,0,0" /><TextBlock Text="Current application usage" Style="{StaticResource MutedTextStyle}" FontSize="11" /></StackPanel></Border><Border Style="{StaticResource MetricCardStyle}" Padding="16" Margin="0,0,10,0"><StackPanel><TextBlock Text="SIMULATOR" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding SimulatorFps}" FontSize="26" FontWeight="SemiBold" Margin="0,5,0,0" /><TextBlock Text="{Binding SimulatorProcess}" Style="{StaticResource MutedTextStyle}" FontSize="11" TextTrimming="CharacterEllipsis" /></StackPanel></Border><Border Style="{StaticResource MetricCardStyle}" Padding="16"><StackPanel><TextBlock Text="LIVE FRAME" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding BridgeFrameTime}" FontSize="22" FontWeight="SemiBold" Margin="0,7,0,0" /><TextBlock Text="Last simulator signal" Style="{StaticResource MutedTextStyle}" FontSize="11" /></StackPanel></Border></UniformGrid>
            <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="1.28*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions><Border Style="{StaticResource CardStyle}" Margin="0,0,10,0"><StackPanel><TextBlock Text="EMBER FOOTPRINT" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="The last sixty seconds of Ember's own resource use." Style="{StaticResource MutedTextStyle}" FontSize="11" Margin="0,4,0,12" /><Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" CornerRadius="12" Height="200"><Grid><Polyline Points="{Binding CpuGraphPoints}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2" Stretch="Fill" Margin="14" /><Polyline Points="{Binding MemoryGraphPoints}" Stroke="{DynamicResource SuccessBrush}" StrokeThickness="2" Stretch="Fill" Margin="14" /></Grid></Border><Grid Margin="0,10,0,0"><TextBlock Text="Blue: CPU · Green: memory" Style="{StaticResource MutedTextStyle}" FontSize="10" /><TextBlock Text="{Binding PeakSummary}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" HorizontalAlignment="Right" /></Grid></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="RECOMMENDATION" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="{Binding Recommendation}" Foreground="{Binding RecommendationColor}" FontSize="12" TextWrapping="Wrap" LineHeight="18" Margin="0,9,0,0" /><TextBlock Text="Performance mode" Style="{StaticResource MetricLabelStyle}" Margin="0,22,0,7" /><StackPanel><RadioButton Content="Quality" IsChecked="{Binding IsQualityMode}" Margin="0,3" /><RadioButton Content="Balanced" IsChecked="{Binding IsBalancedMode}" Margin="0,3" /><RadioButton Content="Low impact" IsChecked="{Binding IsLowImpactMode}" Margin="0,3" /></StackPanel><TextBlock Text="These controls only affect local Ember animation and sampling. They do not change ACARS or PIREP data." Style="{StaticResource MutedTextStyle}" FontSize="10" TextWrapping="Wrap" Margin="0,18,0,0" /></StackPanel></Border></Grid>
            <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="CONNECTION CHECKS" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="Current application dependencies, shown for support and troubleshooting." Style="{StaticResource MutedTextStyle}" FontSize="11" Margin="0,4,0,13" /><ItemsControl ItemsSource="{Binding DiagnosticEntries}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,1,0,0" Padding="0,10"><Grid><Ellipse Width="8" Height="8" VerticalAlignment="Center"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource WarningBrush}" /><Style.Triggers><DataTrigger Binding="{Binding IsReady}" Value="True"><Setter Property="Fill" Value="{DynamicResource SuccessBrush}" /></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><TextBlock Text="{Binding Message}" Margin="17,0,0,0" FontSize="12" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
