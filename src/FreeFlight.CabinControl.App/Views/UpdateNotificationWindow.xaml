<Window x:Class="FreeFlight.CabinControl.App.Views.UpdateNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FreeFlight update available"
        Width="660"
        Height="540"
        MinWidth="560"
        MinHeight="470"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="{StaticResource AppBackgroundBrush}">
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="FreeFlight update available" FontSize="27" FontWeight="SemiBold" />
                <TextBlock Text="Verified through the FreeFlight GitHub Releases channel · you choose when to install" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0" />
            </StackPanel>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="INSTALLED" Style="{StaticResource MetricLabelStyle}" />
                        <TextBlock Text="{Binding CurrentVersion}" FontSize="23" FontWeight="SemiBold" Foreground="#8FC8FF" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="AVAILABLE" Style="{StaticResource MetricLabelStyle}" />
                        <TextBlock Text="{Binding AvailableVersion}" FontSize="23" FontWeight="SemiBold" Foreground="#58E68A" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Text="What’s included" Style="{StaticResource SectionTitleStyle}" />
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding ReleaseNotes}"
                                   TextWrapping="Wrap"
                                   Foreground="#AFC2D8"
                                   FontSize="12"
                                   LineHeight="19" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Row="6"
                    Background="#181E2938"
                    BorderBrush="#C58A2B"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="13,10">
                <TextBlock Text="{Binding FlightAdvisory}"
                           Foreground="#FFCC6A"
                           TextWrapping="Wrap"
                           FontSize="12" />
            </Border>

            <Grid Grid.Row="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding Status}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="Open Changelog"
                            Style="{StaticResource SecondaryButtonStyle}"
                            MinWidth="135"
                            Click="OpenChangelogButton_Click" />
                    <Button Content="Later"
                            Style="{StaticResource SecondaryButtonStyle}"
                            MinWidth="100"
                            Margin="9,0,0,0"
                            Click="LaterButton_Click" />
                    <Button Content="{Binding InstallButtonLabel}"
                            Command="{Binding InstallCommand}"
                            IsEnabled="{Binding CanInstall}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            MinWidth="170"
                            Margin="9,0,0,0" />
                </StackPanel>
                <TextBlock Grid.Row="2"
                           Text="Cabin Control never installs an update without your confirmation."
                           Style="{StaticResource MutedTextStyle}"
                           Margin="0,10,0,0" />
            </Grid>
        </Grid>
    </Border>
</Window>
