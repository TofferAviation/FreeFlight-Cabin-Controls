<Window x:Class="FreeFlight.CabinControl.App.Views.UpdateNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ember · Update available"
        Width="1080"
        Height="740"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        Background="{DynamicResource AppBackgroundBrush}">
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="{DynamicResource SidebarGradientBrush}" BorderBrush="#365D7C" BorderThickness="0,0,0,1">
                <Grid Margin="22,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="14" Background="#1F45A9E5" BorderBrush="#628CD2" BorderThickness="1">
                            <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#DDEFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Ember" FontSize="18" FontWeight="SemiBold" Foreground="White" Margin="11,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="•" FontSize="16" Foreground="#7EC9F7" Margin="10,0" VerticalAlignment="Center" />
                        <TextBlock Text="Update available" FontSize="14" Foreground="#D8EDFF" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="OFFICIAL EMBER RELEASE CHANNEL" Style="{StaticResource MetricLabelStyle}" Foreground="#9FC8E8" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.86*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="1.32*" />
                </Grid.ColumnDefinitions>

                <Border Background="{DynamicResource SidebarGradientBrush}" BorderBrush="#326C96" BorderThickness="1" CornerRadius="20" Padding="28" ClipToBounds="True">
                    <Grid>
                        <Ellipse Width="330" Height="330" Fill="#1C4EA5E8" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-170,-180,0" IsHitTestVisible="False" />
                        <Rectangle Height="3" Fill="#E31937" Width="54" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,67,0,0" />
                        <StackPanel VerticalAlignment="Top">
                            <Border Background="#1F162B4B" BorderBrush="#3F78B4" BorderThickness="1" CornerRadius="16" Padding="11,6" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE709;" FontFamily="Segoe Fluent Icons" Foreground="#73C8FF" FontSize="13" />
                                    <TextBlock Text="UPDATE AVAILABLE" Foreground="#D7EDFF" FontSize="10" FontWeight="SemiBold" Margin="7,0,0,0" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="A better Ember is ready" FontFamily="Georgia" FontSize="38" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" Margin="0,27,0,0" />
                            <TextBlock Text="Download, apply and restart directly in Ember. Your pilot preferences and active-flight protection stay in place." Foreground="#C1D9EC" FontSize="15" LineHeight="23" TextWrapping="Wrap" Margin="0,13,0,0" />

                            <Border Background="#20152F4C" BorderBrush="#4381B2" BorderThickness="1" CornerRadius="14" Padding="18,15" Margin="0,27,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="INSTALLED" Foreground="#9DC2DF" FontSize="10" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding CurrentVersion}" Foreground="White" FontSize="27" FontWeight="SemiBold" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="&#xE72A;" FontFamily="Segoe Fluent Icons" FontSize="22" Foreground="#65B9F4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="READY NOW" Foreground="#9DC2DF" FontSize="10" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding AvailableVersionNumber}" Foreground="#62C5FF" FontSize="27" FontWeight="SemiBold" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel VerticalAlignment="Bottom">
                            <Grid Margin="0,0,0,17">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="16" Background="#2032C68B" BorderBrush="#5ED5A6" BorderThickness="1"><TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" Foreground="#76F0B8" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                <StackPanel Grid.Column="1" Margin="9,0,0,0"><TextBlock Text="No installer needed" Foreground="White" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="Update, apply and restart from this screen." Foreground="#B4CEE3" FontSize="12" Margin="0,2,0,0" /></StackPanel>
                            </Grid>
                            <Grid Margin="0,0,0,17">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="16" Background="#203B90D5" BorderBrush="#75B9E8" BorderThickness="1"><TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons" Foreground="#9BD7FF" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                <StackPanel Grid.Column="1" Margin="9,0,0,0"><TextBlock Text="Safe and verified" Foreground="White" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="The update package is verified before Ember restarts." Foreground="#B4CEE3" FontSize="12" Margin="0,2,0,0" /></StackPanel>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="16" Background="#202D7FC5" BorderBrush="#70B6E8" BorderThickness="1"><TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons" Foreground="#A8DDFF" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                <StackPanel Grid.Column="1" Margin="9,0,0,0"><TextBlock Text="Your settings are kept" Foreground="White" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="Your local preferences and account remain intact." Foreground="#B4CEE3" FontSize="12" Margin="0,2,0,0" /></StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="13" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Background="{DynamicResource PremiumHeroBrush}" BorderBrush="#469FD3" BorderThickness="1" CornerRadius="18" Padding="22,18" Effect="{StaticResource HeroShadowEffect}">
                        <Grid>
                            <Ellipse Width="220" Height="220" Fill="#20FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,-95,-75,0" />
                            <StackPanel>
                                <TextBlock Text="LATEST STABLE RELEASE" Foreground="#C8E8FB" FontSize="10" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding AvailableVersionNumber}" Foreground="White" FontSize="37" FontWeight="SemiBold" Margin="0,3,0,0" />
                                <TextBlock Text="{Binding ReleaseBriefing}" Foreground="#E1F4FF" FontSize="14" TextWrapping="Wrap" Margin="0,5,48,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Grid>
                                <TextBlock Text="What’s new" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="Clear release notes, grouped by purpose" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <Grid>
                                    <ItemsControl ItemsSource="{Binding ReleaseSections}" Visibility="{Binding HasReleaseSections, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{Binding AccentBrush}" BorderThickness="1,0,1,1" CornerRadius="12" Padding="13,11" Margin="0,0,0,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="37" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                        <Border Width="29" Height="29" CornerRadius="14.5" Background="{Binding IconBackground}" BorderBrush="{Binding AccentBrush}" BorderThickness="1" VerticalAlignment="Top">
                                                            <TextBlock Text="{Binding Icon}" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="{Binding AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{Binding AccentBrush}" />
                                                            <ItemsControl ItemsSource="{Binding Items}" Margin="0,7,0,0">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Grid Margin="0,0,0,7">
                                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="13" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                                            <TextBlock Text="•" Foreground="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}" FontWeight="Bold" />
                                                                            <StackPanel Grid.Column="1">
                                                                                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedTextStyle}" FontSize="11.5" TextWrapping="Wrap" />
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding ReleaseNotes}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" LineHeight="20" Visibility="{Binding HasReleaseSections, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Border Grid.Row="4" Background="#161B6694" BorderBrush="#4B96C7" BorderThickness="1" CornerRadius="11" Padding="13,10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="27" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#63BEF4" VerticalAlignment="Top" />
                            <TextBlock Grid.Column="1" Text="{Binding FlightAdvisory}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" TextWrapping="Wrap" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="6">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="View complete changelog" Style="{StaticResource SecondaryButtonStyle}" MinWidth="170" Click="OpenChangelogButton_Click" />
                            <Button Content="Remind me later" Style="{StaticResource SecondaryButtonStyle}" MinWidth="135" Margin="9,0,0,0" Click="LaterButton_Click" />
                            <Button Content="{Binding InstallButtonLabel}" Command="{Binding InstallCommand}" IsEnabled="{Binding CanInstall}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="194" Margin="9,0,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
