<Window x:Class="FreeFlight.CabinControl.App.Views.VamsysSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configure vAMSYS"
        Width="560"
        Height="510"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}">
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="vAMSYS Pilot API" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="Enter the public values from the attested Authorization Code + PKCE client. FreeFlight never needs a client secret or your vAMSYS password."
                           Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,20,0,0">
                <TextBlock Text="PUBLIC CLIENT ID" Style="{StaticResource MetricLabelStyle}" />
                <TextBox x:Name="ClientIdBox" Margin="0,6,0,0" Padding="10,7" />
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="14" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="VIRTUAL AIRLINE NAME" Style="{StaticResource MetricLabelStyle}" />
                    <TextBox x:Name="AirlineNameBox" Margin="0,6,0,0" Padding="10,7" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="ICAO" Style="{StaticResource MetricLabelStyle}" />
                    <TextBox x:Name="AirlineIcaoBox" Margin="0,6,0,0" Padding="10,7" MaxLength="3" CharacterCasing="Upper" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="3" Margin="0,16,0,0">
                <TextBlock Text="REGISTER THIS EXACT REDIRECT URI" Style="{StaticResource MetricLabelStyle}" />
                <Border Background="#111D2C" BorderBrush="#28405C" BorderThickness="1" CornerRadius="5" Padding="10,8" Margin="0,6,0,0">
                    <TextBlock x:Name="RedirectUriText" Foreground="#69B8FF" FontFamily="Consolas" />
                </Border>
            </StackPanel>

            <Border Grid.Row="4" Background="#1E1D1826" BorderBrush="#705C25" BorderThickness="1" CornerRadius="6" Padding="11" Margin="0,16,0,0">
                <TextBlock Text="Required scopes: identity:basic and pilot:read. The VA Owner must attest and activate the client before pilots can connect."
                           Foreground="#F0C64E" TextWrapping="Wrap" />
            </Border>

            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Open vAMSYS documentation" Click="OpenDocumentation_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" Margin="0,0,10,0" />
                <Button Content="Cancel" IsCancel="True" Style="{StaticResource SecondaryButtonStyle}" Padding="14,6" Margin="0,0,10,0" />
                <Button Content="Save &amp; Connect" Click="Save_Click" Style="{StaticResource PrimaryButtonStyle}" Padding="14,6" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
