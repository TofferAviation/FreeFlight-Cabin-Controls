<UserControl x:Class="FreeFlight.CabinControl.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="0,0,0,8"><Grid.RowDefinitions><RowDefinition Height="60" /><RowDefinition Height="260" /><RowDefinition Height="12" /><RowDefinition Height="228" /><RowDefinition Height="12" /><RowDefinition Height="145" /><RowDefinition Height="68" /></Grid.RowDefinitions>
            <StackPanel><TextBlock Text="Settings" FontSize="27" FontWeight="SemiBold" /><TextBlock Text="Configure gate operations, automation, passenger generation, and system preferences" Style="{StaticResource MutedTextStyle}" /></StackPanel>

            <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}" Padding="15"><StackPanel><TextBlock Text="SimBrief Connection" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="Import flight data and aircraft configuration." Style="{StaticResource MutedTextStyle}" Margin="0,3,0,12" /><TextBlock Text="Pilot ID" FontSize="11" /><TextBox Text="{Binding SimBriefPilotId, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" /><Grid><TextBlock Text="● Ready to connect" Foreground="#58E68A" /><TextBlock Text="Stored locally" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Right" /></Grid><TextBlock Text="Cabin Layout" FontSize="11" Margin="0,12,0,4" /><ComboBox ItemsSource="{Binding CabinLayoutProfiles}" SelectedItem="{Binding SelectedCabinLayoutProfile}" /></StackPanel></Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="15"><StackPanel><Grid><TextBlock Text="Gate Automation" FontSize="17" FontWeight="SemiBold" /><ToggleButton IsChecked="{Binding AutomaticGateTiming}" Style="{StaticResource PillToggleStyle}" HorizontalAlignment="Right" /></Grid><TextBlock Text="Control automatic gate timing and boarding calls." Style="{StaticResource MutedTextStyle}" Margin="0,3,0,10" /><Grid Height="39"><TextBlock Text="Boarding Start" VerticalAlignment="Center" /><ComboBox ItemsSource="{Binding BoardingStartOffsets}" SelectedItem="{Binding BoardingStartMinutesBeforeDeparture}" Width="130" HorizontalAlignment="Right" /><TextBlock Text="min before" HorizontalAlignment="Right" Margin="0,0,136,0" VerticalAlignment="Center" FontSize="9" Foreground="#8DA0B8" /></Grid><Grid Height="39"><TextBlock Text="Final Boarding" VerticalAlignment="Center" /><ComboBox ItemsSource="{Binding FinalBoardingOffsets}" SelectedItem="{Binding FinalBoardingMinutesBeforeDeparture}" Width="130" HorizontalAlignment="Right" /></Grid><Grid Height="39"><TextBlock Text="Gate Close" VerticalAlignment="Center" /><ComboBox ItemsSource="{Binding GateCloseOffsets}" SelectedItem="{Binding GateCloseMinutesBeforeDeparture}" Width="130" HorizontalAlignment="Right" /></Grid><Grid Height="39"><TextBlock Text="Manual Override" VerticalAlignment="Center" /><ToggleButton IsChecked="{Binding ManualGateOverride}" Style="{StaticResource PillToggleStyle}" HorizontalAlignment="Right" /></Grid></StackPanel></Border>
                <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="15"><StackPanel><TextBlock Text="Passenger Generation" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="Configure fictional preview passenger generation." Style="{StaticResource MutedTextStyle}" Margin="0,3,0,10" /><TextBlock Text="Name Region Mix" FontSize="11" /><ComboBox ItemsSource="{Binding NameRegionMixes}" SelectedItem="{Binding PassengerNameRegionMix}" Margin="0,4,0,10" /><TextBlock Text="Deterministic Seed" FontSize="11" /><Grid Margin="0,4,0,8"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="112" /></Grid.ColumnDefinitions><TextBox Text="{Binding PassengerGenerationSeed}" /><Button Grid.Column="1" Content="Randomize" Command="{Binding RandomizePassengerSeedCommand}" Style="{StaticResource SecondaryButtonStyle}" MinHeight="40" Padding="8,4" Margin="7,0,0,0" /></Grid><TextBlock Text="✓ Seed locked — tickets and identities remain consistent" Foreground="#58E68A" FontSize="10" /></StackPanel></Border>
            </Grid>

            <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}" Padding="15"><StackPanel><TextBlock Text="Boarding Rules" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="Define boarding order, groups, and closure." Style="{StaticResource MutedTextStyle}" Margin="0,3,0,10" /><TextBlock Text="Boarding Group Order" FontSize="11" /><ComboBox ItemsSource="{Binding BoardingGroupOrders}" SelectedItem="{Binding BoardingGroupOrder}" Margin="0,4,0,10" /><Grid Height="35"><TextBlock Text="Special assistance before Group 1" VerticalAlignment="Center" /><ToggleButton IsChecked="{Binding SpecialAssistanceBoardsFirst}" Style="{StaticResource PillToggleStyle}" HorizontalAlignment="Right" /></Grid><Grid Height="35"><TextBlock Text="Prevent boarding after gate close" VerticalAlignment="Center" /><ToggleButton IsChecked="{Binding PreventBoardingAfterGateClose}" Style="{StaticResource PillToggleStyle}" HorizontalAlignment="Right" /></Grid></StackPanel></Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="15"><StackPanel><TextBlock Text="Printer Setup" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="Preview boarding-pass and bag-tag printers." Style="{StaticResource MutedTextStyle}" Margin="0,3,0,10" /><TextBlock Text="Boarding Pass Printer" FontSize="11" /><Grid Margin="0,4,0,8"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="95" /></Grid.ColumnDefinitions><TextBox Text="{Binding BoardingPassPrinter}" /><Button Grid.Column="1" Content="Print Test" Command="{Binding TestBoardingPassPrinterCommand}" Style="{StaticResource SecondaryButtonStyle}" MinHeight="40" Padding="8,4" Margin="7,0,0,0" /></Grid><TextBlock Text="{Binding BoardingPassPrinterStatus}" Foreground="#58E68A" FontSize="9" /><TextBlock Text="Bag Tag Printer" FontSize="11" Margin="0,8,0,0" /><Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="95" /></Grid.ColumnDefinitions><TextBox Text="{Binding BagTagPrinter}" /><Button Grid.Column="1" Content="Print Test" Command="{Binding TestBagTagPrinterCommand}" Style="{StaticResource SecondaryButtonStyle}" MinHeight="40" Padding="8,4" Margin="7,0,0,0" /></Grid></StackPanel></Border>
                <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="15"><StackPanel><TextBlock Text="Display &amp; Sound" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="Adjust interface appearance and gate alerts." Style="{StaticResource MutedTextStyle}" Margin="0,3,0,10" /><Grid Height="39"><TextBlock Text="Theme" VerticalAlignment="Center" /><ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" Width="200" HorizontalAlignment="Right" /></Grid><Grid Height="39"><TextBlock Text="Text Size" VerticalAlignment="Center" /><ComboBox ItemsSource="{Binding UiScales}" SelectedItem="{Binding UiScalePercent}" Width="200" HorizontalAlignment="Right" /></Grid><Grid Height="39"><TextBlock Text="Sound Alerts" VerticalAlignment="Center" /><ToggleButton IsChecked="{Binding SoundAlerts}" Style="{StaticResource PillToggleStyle}" HorizontalAlignment="Right" /></Grid><Grid Height="39"><TextBlock Text="Boarding Call Chime" VerticalAlignment="Center" /><ComboBox ItemsSource="{Binding BoardingCallChimes}" SelectedItem="{Binding BoardingCallChime}" Width="200" HorizontalAlignment="Right" /></Grid></StackPanel></Border>
            </Grid>

            <Grid Grid.Row="5"><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}" Padding="15"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Flight &amp; Gate Defaults" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="Used until SimBrief supplies flight and route data." Style="{StaticResource MutedTextStyle}" /><StackPanel Orientation="Horizontal" Margin="0,9,0,0"><TextBox Text="{Binding GateFlightNumber}" Width="90" ToolTip="Flight number" /><TextBox Text="{Binding GateOriginIata}" Width="70" Margin="7,0" ToolTip="Origin" /><TextBox Text="{Binding GateDestinationIata}" Width="70" ToolTip="Destination" /></StackPanel></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="GATE" Style="{StaticResource MetricLabelStyle}" /><TextBox Text="{Binding GateNumber}" Margin="0,5,7,0" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="DEPARTURE" Style="{StaticResource MetricLabelStyle}" /><TextBox Text="{Binding ScheduledDepartureLocal}" Margin="0,5,7,0" /></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="ARCHIVE" Style="{StaticResource MetricLabelStyle}" /><ToggleButton IsChecked="{Binding AutoArchiveCompletedFlights}" Style="{StaticResource PillToggleStyle}" Margin="0,11,0,0" /></StackPanel></Grid></Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="15"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="170" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="About" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="FreeFlight Cabin Control" FontSize="15" Margin="0,9,0,0" /><TextBlock Text="{Binding Version}" Foreground="#8FC8FF" /><TextBlock Text="Gate operations run locally without X-Plane." Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0" /></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Local data only" HorizontalAlignment="Right" /><TextBlock Text="No real passenger data" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Right" /></StackPanel></Grid></Border>
            </Grid>

            <Grid Grid.Row="6" Margin="0,10,0,0"><TextBlock Text="{Binding SaveStatus}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Restore Defaults" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RestoreDefaultsCommand}" MinWidth="190" Margin="0,0,12,0" /><Button Content="Save Changes" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveCommand}" MinWidth="230" Background="#C81D2A" BorderBrush="#EC3944" /></StackPanel></Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
