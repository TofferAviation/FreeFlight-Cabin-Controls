<UserControl x:Class="FreeFlight.CabinControl.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="0,0,0,8"><Grid.RowDefinitions><RowDefinition Height="60" /><RowDefinition Height="330" /><RowDefinition Height="12" /><RowDefinition Height="228" /><RowDefinition Height="12" /><RowDefinition Height="320" /><RowDefinition Height="12" /><RowDefinition Height="190" /><RowDefinition Height="68" /></Grid.RowDefinitions>
            <StackPanel><TextBlock Text="Settings" FontSize="27" FontWeight="SemiBold" /><TextBlock Text="Configure gate operations, automation, passenger generation, and system preferences" Style="{StaticResource MutedTextStyle}" /></StackPanel>

            <Grid Grid.Row="5"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}" Padding="15"><StackPanel><TextBlock Text="SimBrief Connection" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="Import flight data and aircraft configuration." Style="{StaticResource MutedTextStyle}" Margin="0,3,0,12" /><TextBlock Text="Pilot ID" FontSize="11" /><TextBox Text="{Binding SimBriefPilotId, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" /><Grid><TextBlock Text="● Ready to connect" Foreground="#58E68A" /><TextBlock Text="Stored locally" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Right" /></Grid><TextBlock Text="Cabin Layout" FontSize="11" Margin="0,12,0,4" /><ComboBox ItemsSource="{Binding CabinLayoutProfiles}" SelectedItem="{Binding SelectedCabinLayoutProfile}" /></StackPanel></Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="15"><StackPanel><Grid><TextBlock Text="Gate Automation" FontSize="17" FontWeight="SemiBold" /><ToggleButton IsChecked="{Binding AutomaticGateTiming}" Style="{StaticResource PillToggleStyle}" HorizontalAlignment="Right" /></Grid><TextBlock Text="Control automatic gate timing and boarding calls." Style="{StaticResource MutedTextStyle}" Margin="0,3,0,6" /><Grid Height="32"><TextBlock Text="Aircraft-based Gate" VerticalAlignment="Center" /><ToggleButton IsChecked="{Binding AutomaticGateAssignment}" Style="{StaticResource PillToggleStyle}" HorizontalAlignment="Right" ToolTip="Use the SimBrief aircraft type and airport profile to choose a repeatable gate." /></Grid><Grid Height="39"><TextBlock Text="Turnaround" VerticalAlignment="Center" /><ComboBox ItemsSource="{Binding TurnaroundDurations}" SelectedItem="{Binding TurnaroundMinutes}" Width="130" HorizontalAlignment="Right" /><TextBlock Text="minutes" HorizontalAlignment="Right" Margin="0,0,136,0" VerticalAlignment="Center" FontSize="9" Foreground="#8DA0B8" /></Grid><Grid Height="39"><TextBlock Text="Boarding Start" VerticalAlignment="Center" /><ComboBox ItemsSource="{Binding BoardingStartOffsets}" SelectedItem="{Binding BoardingStartMinutesBeforeDeparture}" Width="130" HorizontalAlignment="Right" /><TextBlock Text="min before" HorizontalAlignment="Right" Margin="0,0,136,0" VerticalAlignment="Center" FontSize="9" Foreground="#8DA0B8" /></Grid><Grid Height="39"><TextBlock Text="Final Boarding" VerticalAlignment="Center" /><ComboBox ItemsSource="{Binding FinalBoardingOffsets}" SelectedItem="{Binding FinalBoardingMinutesBeforeDeparture}" Width="130" HorizontalAlignment="Right" /></Grid><Grid Height="39"><TextBlock Text="Gate Close" VerticalAlignment="Center" /><ComboBox ItemsSource="{Binding GateCloseOffsets}" SelectedItem="{Binding GateCloseMinutesBeforeDeparture}" Width="130" HorizontalAlignment="Right" /></Grid><Grid Height="39"><TextBlock Text="Manual Override" VerticalAlignment="Center" /><ToggleButton IsChecked="{Binding ManualGateOverride}" Style="{StaticResource PillToggleStyle}" HorizontalAlignment="Right" /></Grid></StackPanel></Border>
                <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="15"><StackPanel><TextBlock Text="Passenger Generation" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="Configure fictional preview passenger generation." Style="{StaticResource MutedTextStyle}" Margin="0,3,0,10" /><TextBlock Text="Name Region Mix" FontSize="11" /><ComboBox ItemsSource="{Binding NameRegionMixes}" SelectedItem="{Binding PassengerNameRegionMix}" Margin="0,4,0,10" /><TextBlock Text="Deterministic Seed" FontSize="11" /><Grid Margin="0,4,0,8"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="112" /></Grid.ColumnDefinitions><TextBox Text="{Binding PassengerGenerationSeed}" /><Button Grid.Column="1" Content="Randomize" Command="{Binding RandomizePassengerSeedCommand}" Style="{StaticResource SecondaryButtonStyle}" MinHeight="40" Padding="8,4" Margin="7,0,0,0" /></Grid><TextBlock Text="✓ Seed locked — tickets and identities remain consistent" Foreground="#58E68A" FontSize="10" /></StackPanel></Border>
            </Grid>

            <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}" Padding="15"><StackPanel><TextBlock Text="Boarding Rules" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="Define boarding order, groups, and closure." Style="{StaticResource MutedTextStyle}" Margin="0,3,0,10" /><TextBlock Text="Boarding Group Order" FontSize="11" /><ComboBox ItemsSource="{Binding BoardingGroupOrders}" SelectedItem="{Binding BoardingGroupOrder}" Margin="0,4,0,10" /><Grid Height="35"><TextBlock Text="Special assistance before Group 1" VerticalAlignment="Center" /><ToggleButton IsChecked="{Binding SpecialAssistanceBoardsFirst}" Style="{StaticResource PillToggleStyle}" HorizontalAlignment="Right" /></Grid><Grid Height="35"><TextBlock Text="Prevent boarding after gate close" VerticalAlignment="Center" /><ToggleButton IsChecked="{Binding PreventBoardingAfterGateClose}" Style="{StaticResource PillToggleStyle}" HorizontalAlignment="Right" /></Grid></StackPanel></Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="15"><StackPanel><TextBlock Text="Printer Setup" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="Choose an installed Windows boarding-pass printer from Gate Desk or Boarding Passes. Bag tags remain preview-only." Style="{StaticResource MutedTextStyle}" Margin="0,3,0,10" TextWrapping="Wrap" /><TextBlock Text="Boarding Pass Printer" FontSize="11" /><Grid Margin="0,4,0,8"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="95" /></Grid.ColumnDefinitions><TextBox Text="{Binding BoardingPassPrinter}" /><Button Grid.Column="1" Content="How to Test" Command="{Binding TestBoardingPassPrinterCommand}" Style="{StaticResource SecondaryButtonStyle}" MinHeight="40" Padding="8,4" Margin="7,0,0,0" /></Grid><TextBlock Text="{Binding BoardingPassPrinterStatus}" Foreground="#58E68A" FontSize="9" TextWrapping="Wrap" /><TextBlock Text="Bag Tag Printer" FontSize="11" Margin="0,8,0,0" /><Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="95" /></Grid.ColumnDefinitions><TextBox Text="{Binding BagTagPrinter}" /><Button Grid.Column="1" Content="Print Test" Command="{Binding TestBagTagPrinterCommand}" Style="{StaticResource SecondaryButtonStyle}" MinHeight="40" Padding="8,4" Margin="7,0,0,0" /></Grid></StackPanel></Border>
                <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="15"><StackPanel><TextBlock Text="Display &amp; Sound" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="Adjust interface appearance and gate alerts." Style="{StaticResource MutedTextStyle}" Margin="0,3,0,10" /><Grid Height="39"><TextBlock Text="Theme" VerticalAlignment="Center" /><ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" Width="200" HorizontalAlignment="Right" /></Grid><Grid Height="39"><TextBlock Text="Text Size" VerticalAlignment="Center" /><ComboBox ItemsSource="{Binding UiScales}" SelectedItem="{Binding UiScalePercent}" Width="200" HorizontalAlignment="Right" /></Grid><Grid Height="39"><TextBlock Text="Sound Alerts" VerticalAlignment="Center" /><ToggleButton IsChecked="{Binding SoundAlerts}" Style="{StaticResource PillToggleStyle}" HorizontalAlignment="Right" /></Grid><Grid Height="39"><TextBlock Text="Boarding Call Chime" VerticalAlignment="Center" /><ComboBox ItemsSource="{Binding BoardingCallChimes}" SelectedItem="{Binding BoardingCallChime}" Width="200" HorizontalAlignment="Right" /></Grid></StackPanel></Border>
            </Grid>

            <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.35*" /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}" Padding="15">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="250" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Simulator Connections" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="X-Plane uses its local Web API. MSFS 2024 connects directly through SimConnect; FSUIPC is not required." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,3,0,7" />
                            <Grid Height="30"><TextBlock Text="X-Plane auto-connect" VerticalAlignment="Center" /><ToggleButton IsChecked="{Binding XPlaneAutoConnect}" Style="{StaticResource PillToggleStyle}" HorizontalAlignment="Right" /></Grid>
                            <Grid Height="30"><TextBlock Text="MSFS 2024 auto-connect" VerticalAlignment="Center" /><ToggleButton IsChecked="{Binding Msfs2024AutoConnect}" Style="{StaticResource PillToggleStyle}" HorizontalAlignment="Right" /></Grid>
                            <Grid Height="30"><TextBlock Text="Synchronize L1 / L2 doors" VerticalAlignment="Center" /><ToggleButton IsChecked="{Binding SyncXPlaneDoors}" Style="{StaticResource PillToggleStyle}" HorizontalAlignment="Right" /></Grid>
                            <Grid Height="30"><TextBlock Text="Synchronize seat-belt sign" VerticalAlignment="Center" /><ToggleButton IsChecked="{Binding SyncSimulatorSeatbeltSign}" Style="{StaticResource PillToggleStyle}" HorizontalAlignment="Right" ToolTip="Uses the simulator annunciator when available; turn off to use the Live Cabin icon manually." /></Grid>
                            <TextBlock Text="X-PLANE INSTALLATION" Style="{StaticResource MetricLabelStyle}" Margin="0,5,0,4" />
                            <Border Height="36" Background="#071426" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10,0">
                                <TextBlock Text="{Binding XPlaneExecutableLabel}" TextTrimming="CharacterEllipsis" ToolTip="{Binding XPlaneExecutablePath}" VerticalAlignment="Center" Foreground="#AFC2D8" />
                            </Border>
                            <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <Button Content="Select Folder" Command="{Binding SelectXPlaneFolderCommand}" Style="{StaticResource SecondaryButtonStyle}" MinHeight="34" />
                                <Button Grid.Column="2" Content="Select X-Plane.exe" Command="{Binding SelectXPlaneExecutableCommand}" Style="{StaticResource SecondaryButtonStyle}" MinHeight="34" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="18,0,0,0">
                            <TextBlock Text="{Binding Status.ConnectionLabel}" Foreground="{Binding Status.ConnectionColor}" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Status.ConnectionSource}" Foreground="#8FC8FF" FontSize="10" Margin="0,3,0,0" />
                            <TextBlock Text="{Binding Status.ConnectionDetail}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" MaxHeight="76" Margin="0,4,0,12" />
                            <Grid><TextBlock Text="LOCAL API PORT" Style="{StaticResource MetricLabelStyle}" VerticalAlignment="Center" /><TextBox Text="{Binding XPlaneWebApiPort, UpdateSourceTrigger=PropertyChanged}" Width="76" Height="32" HorizontalAlignment="Right" TextAlignment="Center" ToolTip="Default X-Plane Web API port: 8086" /></Grid>
                            <Button Content="Retry Detection" Command="{Binding ReconnectXPlaneCommand}" Style="{StaticResource SecondaryButtonStyle}" MinHeight="34" Margin="0,9,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="15"><StackPanel><TextBlock Text="Live simulator inputs" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="Flight phase, altitude, illuminated seat-belt annunciator, engine state, aircraft identity and door positions. The selected X-Plane path resolves the active ACF; live doors still come from datarefs." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,3,0,10" /><Grid><TextBlock Text="CURRENT PHASE" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding Status.FlightPhase}" Foreground="#8FC8FF" FontWeight="SemiBold" HorizontalAlignment="Right" /></Grid><TextBlock Text="Custom door and seat-belt datarefs are discovered automatically; unsupported aircraft remain safely available with manual controls." Foreground="#FFCC4D" FontSize="10" TextWrapping="Wrap" Margin="0,10,0,0" /></StackPanel></Border>
            </Grid>

            <Grid Grid.Row="7"><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}" Padding="15"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="96" /><ColumnDefinition Width="96" /><ColumnDefinition Width="105" /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Flight &amp; Gate Defaults" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="Used until SimBrief supplies flight, route and aircraft data." Style="{StaticResource MutedTextStyle}" /><StackPanel Orientation="Horizontal" Margin="0,9,0,0"><TextBox Text="{Binding GateFlightNumber}" Width="90" ToolTip="Flight number" /><TextBox Text="{Binding GateOriginIata}" Width="70" Margin="7,0" ToolTip="Origin" /><TextBox Text="{Binding GateDestinationIata}" Width="70" ToolTip="Destination" /></StackPanel></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="DEP FALLBACK" Style="{StaticResource MetricLabelStyle}" /><TextBox Text="{Binding GateNumber}" Margin="0,5,7,0" ToolTip="Departure gate used when automatic assignment is unavailable." /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="ARR FALLBACK" Style="{StaticResource MetricLabelStyle}" /><TextBox Text="{Binding ArrivalGateNumber}" Margin="0,5,7,0" ToolTip="Arrival gate used when automatic assignment is unavailable." /></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="DEPARTURE" Style="{StaticResource MetricLabelStyle}" /><TextBox Text="{Binding ScheduledDepartureLocal}" Margin="0,5,7,0" /></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="ARCHIVE" Style="{StaticResource MetricLabelStyle}" /><ToggleButton IsChecked="{Binding AutoArchiveCompletedFlights}" Style="{StaticResource PillToggleStyle}" Margin="0,11,0,0" /></StackPanel></Grid></Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="15"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="170" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="About" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="FreeFlight Cabin Control" FontSize="15" Margin="0,7,0,0" /><TextBlock Text="{Binding Version}" Foreground="#8FC8FF" /><Grid Height="30" Margin="0,5,0,0"><TextBlock Text="GitHub update notifications" VerticalAlignment="Center" /><ToggleButton IsChecked="{Binding AutomaticallyCheckForUpdates}" Style="{StaticResource PillToggleStyle}" HorizontalAlignment="Right" /></Grid><StackPanel Orientation="Horizontal" Margin="0,6,0,0"><Button Content="Check GitHub Now" Click="CheckForUpdatesButton_Click" Style="{StaticResource PrimaryButtonStyle}" Height="32" Padding="12,4" /><Button Content="Preview Notification" Click="PreviewUpdateButton_Click" Style="{StaticResource SecondaryButtonStyle}" Height="32" Padding="12,4" Margin="7,0,0,0" /></StackPanel></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="GitHub Releases" HorizontalAlignment="Right" /><TextBlock Text="Checks every 30 minutes" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Right" /></StackPanel></Grid></Border>
            </Grid>

            <Grid Grid.Row="8" Margin="0,10,0,0"><TextBlock Text="{Binding SaveStatus}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Restore Defaults" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RestoreDefaultsCommand}" MinWidth="190" Margin="0,0,12,0" /><Button Content="Save Changes" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveCommand}" MinWidth="230" Background="#C81D2A" BorderBrush="#EC3944" /></StackPanel></Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
