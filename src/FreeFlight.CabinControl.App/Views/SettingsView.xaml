<UserControl x:Class="FreeFlight.CabinControl.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="PREFERENCES" Foreground="{StaticResource PrimaryBrush}" FontSize="10" FontWeight="SemiBold" /><TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" Margin="0,4,0,0" /><TextBlock Text="Choose how Ember connects to your simulator and supports each flight." Style="{StaticResource PageSubtitleStyle}" /></StackPanel><Border Grid.Column="1" Background="#F4F8FC" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" CornerRadius="8" Padding="13,8" VerticalAlignment="Center"><StackPanel><TextBlock Text="{Binding Version}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" /><TextBlock Text="{Binding SaveStatus}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" HorizontalAlignment="Right" Margin="0,2,0,0" /></StackPanel></Border></Grid>

            <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions><Border Style="{StaticResource CardStyle}" Margin="0,0,10,0"><StackPanel><TextBlock Text="SIMULATOR CONNECTION" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="Ember can run with a simulator or in its manual, fail-safe mode." Style="{StaticResource MutedTextStyle}" FontSize="11" Margin="0,4,0,14" /><Grid Height="38"><TextBlock Text="X-Plane automatic connection" VerticalAlignment="Center" FontSize="12" /><ToggleButton IsChecked="{Binding XPlaneAutoConnect}" Style="{StaticResource PillToggleStyle}" HorizontalAlignment="Right" /></Grid><Grid Height="38"><TextBlock Text="MSFS 2024 automatic connection" VerticalAlignment="Center" FontSize="12" /><ToggleButton IsChecked="{Binding Msfs2024AutoConnect}" Style="{StaticResource PillToggleStyle}" HorizontalAlignment="Right" /></Grid><Grid Height="38"><TextBlock Text="Synchronise aircraft doors" VerticalAlignment="Center" FontSize="12" /><ToggleButton IsChecked="{Binding SyncXPlaneDoors}" Style="{StaticResource PillToggleStyle}" HorizontalAlignment="Right" /></Grid><Grid Height="38"><TextBlock Text="Synchronise seat-belt sign" VerticalAlignment="Center" FontSize="12" /><ToggleButton IsChecked="{Binding SyncSimulatorSeatbeltSign}" Style="{StaticResource PillToggleStyle}" HorizontalAlignment="Right" /></Grid><Border Background="#F6F9FC" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" CornerRadius="7" Padding="11" Margin="0,10,0,0"><TextBlock Text="{Binding Status.ConnectionDetail}" Foreground="{Binding Status.ConnectionColor}" TextWrapping="Wrap" FontSize="11" /></Border><Button Content="Retry connection" Command="{Binding ReconnectXPlaneCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,12,0,0" /></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="X-PLANE" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="Select your X-Plane installation when you want Ember to install or update its local telemetry connector." Style="{StaticResource MutedTextStyle}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,13" /><TextBlock Text="{Binding XPlaneExecutableLabel}" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" FontSize="11" Margin="0,0,0,11" /><StackPanel Orientation="Horizontal"><Button Content="Select folder" Command="{Binding SelectXPlaneFolderCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" /><Button Content="Select X-Plane.exe" Command="{Binding SelectXPlaneExecutableCommand}" Style="{StaticResource SecondaryButtonStyle}" /></StackPanel><TextBlock Text="{Binding XPlanePluginStatus}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,13,0,0" /><Button Content="Install or update connector" Command="{Binding InstallXPlanePluginCommand}" IsEnabled="{Binding CanInstallXPlanePlugin}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,12,0,0" /></StackPanel></Border></Grid>

            <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions><Border Style="{StaticResource CardStyle}" Margin="0,0,10,0"><StackPanel><TextBlock Text="CABIN PROFILE" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="Use the aircraft cabin matching your assigned BAV flight." Style="{StaticResource MutedTextStyle}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,12" /><ComboBox ItemsSource="{Binding CabinLayoutProfiles}" SelectedItem="{Binding SelectedCabinLayoutProfile}" DisplayMemberPath="Name" /><TextBlock Text="{Binding SelectedCabinLayoutProfile.Description}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,10,0,0" /></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,10,0"><StackPanel><TextBlock Text="FLEET SYNC" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="The aircraft record is sourced from the BAV website while you are signed in." Style="{StaticResource MutedTextStyle}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,12" /><Grid Height="36"><TextBlock Text="Synchronise automatically" FontSize="12" VerticalAlignment="Center" /><ToggleButton IsChecked="{Binding FleetAutoSync}" Style="{StaticResource PillToggleStyle}" HorizontalAlignment="Right" /></Grid><TextBlock Text="{Binding FleetApiBaseUrl}" Foreground="{StaticResource PrimaryBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,10,0,0" /></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="APPLICATION" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="Use the appearance button in Ember's Overview header for an immediate Light or Dark switch. Hotfixes remain ready without a manual installer." Style="{StaticResource MutedTextStyle}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,12" /><Grid Height="36"><TextBlock Text="Text size" FontSize="12" VerticalAlignment="Center" /><ComboBox ItemsSource="{Binding UiScales}" SelectedItem="{Binding UiScalePercent}" Width="95" HorizontalAlignment="Right" /></Grid><Grid Height="36"><TextBlock Text="Check automatically" FontSize="12" VerticalAlignment="Center" /><ToggleButton IsChecked="{Binding AutomaticallyCheckForUpdates}" Style="{StaticResource PillToggleStyle}" HorizontalAlignment="Right" /></Grid><Button Content="Check for Ember updates" Click="CheckForUpdatesButton_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0,10,0,0" /></StackPanel></Border></Grid>

            <Border Style="{StaticResource CardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="SAVE YOUR PREFERENCES" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="Settings stay on this PC. Your website account and password are never copied into the local settings file." Style="{StaticResource MutedTextStyle}" FontSize="11" Margin="0,4,0,0" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Restore defaults" Command="{Binding RestoreDefaultsCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" /><Button Content="Save changes" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" /></StackPanel></Grid></Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
