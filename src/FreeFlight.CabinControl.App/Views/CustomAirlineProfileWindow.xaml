<Window x:Class="FreeFlight.CabinControl.App.Views.CustomAirlineProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Custom Airline Profile"
        Width="480"
        Height="425"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}">
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="26">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="26" />
                <RowDefinition Height="66" />
                <RowDefinition Height="66" />
                <RowDefinition Height="66" />
                <RowDefinition Height="*" />
                <RowDefinition Height="48" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Custom Airline" FontSize="27" FontWeight="SemiBold" />
                <TextBlock Text="Create a reusable local profile for your airline or virtual airline."
                           Style="{StaticResource MutedTextStyle}" Margin="0,5,0,0" />
            </StackPanel>

            <StackPanel Grid.Row="2">
                <TextBlock Text="Airline name" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,5" />
                <TextBox x:Name="AirlineNameTextBox" MaxLength="80" />
            </StackPanel>

            <StackPanel Grid.Row="3">
                <TextBlock Text="ICAO code" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,5" />
                <TextBox x:Name="IcaoTextBox" MaxLength="4" CharacterCasing="Upper" />
            </StackPanel>

            <StackPanel Grid.Row="4">
                <TextBlock Text="Sound-pack name" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,5" />
                <TextBox x:Name="SoundPackTextBox" MaxLength="80" Text="Custom cabin pack" />
            </StackPanel>

            <TextBlock Grid.Row="5"
                       Text="This creates the profile only. Audio media is added later through the content-pack tools."
                       Foreground="{StaticResource WarningBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />

            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" MinWidth="100" Click="CancelButton_Click" />
                <Button Content="Create Profile" Style="{StaticResource PrimaryButtonStyle}" MinWidth="145" Margin="10,0,0,0" Click="CreateButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
