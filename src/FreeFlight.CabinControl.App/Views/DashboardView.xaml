<UserControl x:Class="FreeFlight.CabinControl.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="OverviewCard" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="19,17" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style x:Key="OverviewCardHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>
        <Style x:Key="OverviewLink" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,13,0,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="OverviewMetric" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Grid Margin="0,0,0,17">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="EMBER OPERATIONS" Foreground="{StaticResource PrimaryBrush}" FontSize="10" FontWeight="SemiBold" />
                    <TextBlock Text="Ready for your next journey?" Style="{StaticResource PageTitleStyle}" Margin="0,4,0,0" />
                    <TextBlock Text="Your live cabin, service and aircraft readiness overview." Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding Operations.CurrentClockDate}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding Operations.CurrentClockTime}" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,3,0,0" />
                    <TextBlock Text="{Binding Operations.ClockSourceLabel}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" HorizontalAlignment="Right" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>

            <Border Height="252" Margin="0,0,0,17" CornerRadius="14" ClipToBounds="True" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1">
                <Grid>
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#063556" Offset="0" />
                                <GradientStop Color="#0A5A8C" Offset="0.52" />
                                <GradientStop Color="#1688C4" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Image Source="{Binding Fleet.SelectedAircraft.AircraftImageUri}" Stretch="UniformToFill" Opacity="0.72" />
                    <Border Background="#BD00182E" />
                    <Grid Margin="26,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="240" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Operations.FlightNumber}" Foreground="White" FontSize="29" FontWeight="SemiBold" />
                                <Border Background="#2BFFFFFF" BorderBrush="#4BFFFFFF" BorderThickness="1" CornerRadius="14" Padding="11,5" Margin="14,3,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Operations.GateStatusLabel}" Foreground="White" FontSize="10" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                            <Grid Margin="0,17,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="54" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Operations.OriginIata}" Foreground="White" FontSize="36" FontWeight="SemiBold" />
                                    <TextBlock Text="Departure" Foreground="#D2ECFA" FontSize="11" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="→" Foreground="#D2ECFA" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding Operations.DestinationIata}" Foreground="White" FontSize="36" FontWeight="SemiBold" />
                                    <TextBlock Text="Arrival" Foreground="#D2ECFA" FontSize="11" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding Operations.RouteSummary}" Foreground="#D2ECFA" FontSize="13" Margin="0,12,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,17,0,0">
                                <TextBlock Text="{Binding Operations.FlightDateLong}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text=" · " Foreground="#C1E3F6" FontSize="12" />
                                <TextBlock Text="{Binding Operations.ScheduledDeparture}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text=" · " Foreground="#C1E3F6" FontSize="12" />
                                <TextBlock Text="{Binding Operations.GateHeader}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#33001020" BorderBrush="#4DFFFFFF" BorderThickness="1" CornerRadius="10" Padding="17" VerticalAlignment="Center">
                            <StackPanel>
                                <TextBlock Text="ASSIGNED AIRCRAFT" Foreground="#BCE6FF" FontSize="10" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Fleet.SelectedAircraft.AircraftType}" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Fleet.SelectedAircraft.Registration}" Foreground="#D3EDFB" FontSize="13" Margin="0,3,0,0" />
                                <TextBlock Text="{Binding Fleet.FlightAssignmentLabel}" Foreground="#D3EDFB" FontSize="10" TextWrapping="Wrap" Margin="0,10,0,0" />
                                <Button Content="View flight  →" Command="{Binding NavigateCommand}" CommandParameter="CabinAccount" Style="{StaticResource SecondaryButtonStyle}" Background="#2CFFFFFF" Foreground="White" BorderBrush="#4DFFFFFF" Margin="0,14,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Grid Margin="0,0,0,17">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.03*" />
                    <ColumnDefinition Width="1.12*" />
                    <ColumnDefinition Width="1.05*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource OverviewCard}" Margin="0,0,10,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="88" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="74" Height="74" CornerRadius="37" VerticalAlignment="Top" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="2">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Catering.CurrentActivityProgressLabel}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="service" Foreground="{StaticResource TextMutedBrush}" FontSize="9" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Service progress" Style="{StaticResource OverviewCardHeading}" />
                            <TextBlock Text="{Binding Catering.CurrentActivityTitle}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Catering.CurrentActivityDetail}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,7,0,0" TextWrapping="Wrap" />
                            <ProgressBar Height="4" Margin="0,10,0,0" Minimum="0" Maximum="100" Value="{Binding Catering.CurrentActivityProgress, Mode=OneWay}" Background="{StaticResource SurfaceRaisedBrush}" Foreground="{StaticResource PrimaryBrush}" />
                            <Button Content="Open service  →" Command="{Binding NavigateCommand}" CommandParameter="Catering" Style="{StaticResource OverviewLink}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource OverviewCard}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Catering &amp; inventory" Style="{StaticResource OverviewCardHeading}" />
                        <TextBlock Text="Live stock levels and service loading." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="{Binding Catering.TotalUnits}" Style="{StaticResource OverviewMetric}" /><TextBlock Text="available items" Style="{StaticResource MutedTextStyle}" FontSize="10" /></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Text="{Binding Catering.LowStockCount}" Style="{StaticResource OverviewMetric}" /><TextBlock Text="low stock" Style="{StaticResource MutedTextStyle}" FontSize="10" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="{Binding Catering.TotalSpecialMeals}" Style="{StaticResource OverviewMetric}" /><TextBlock Text="special meals" Style="{StaticResource MutedTextStyle}" FontSize="10" /></StackPanel>
                        </Grid>
                        <Grid Margin="0,13,0,0"><TextBlock Text="{Binding Catering.CateringLoadLabel}" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="{Binding Catering.InventoryUsageLabel}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Right" /></Grid>
                        <ProgressBar Height="5" Margin="0,7,0,0" Minimum="0" Maximum="100" Value="{Binding Catering.InventoryUsagePercent, Mode=OneWay}" Background="{StaticResource SurfaceRaisedBrush}" Foreground="{StaticResource PrimaryBrush}" />
                        <Button Content="Open catering  →" Command="{Binding NavigateCommand}" CommandParameter="Catering" Style="{StaticResource OverviewLink}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource OverviewCard}">
                    <StackPanel>
                        <TextBlock Text="Passenger preferences" Style="{StaticResource OverviewCardHeading}" />
                        <TextBlock Text="Special requests and passenger care." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,11" />
                        <Grid Margin="0,0,0,8"><TextBlock Text="Passenger preferences" FontSize="11" /><TextBlock Text="{Binding Catering.PassengerPreferences.Count}" FontWeight="SemiBold" HorizontalAlignment="Right" /></Grid>
                        <Separator Background="{StaticResource BorderSoftBrush}" />
                        <Grid Margin="0,8,0,0"><TextBlock Text="Special meals" FontSize="11" /><TextBlock Text="{Binding Catering.TotalSpecialMeals}" FontWeight="SemiBold" HorizontalAlignment="Right" /></Grid>
                        <Separator Background="{StaticResource BorderSoftBrush}" />
                        <Grid Margin="0,8,0,0"><TextBlock Text="Boarded passengers" FontSize="11" /><TextBlock Text="{Binding Operations.BoardingProgressText}" FontWeight="SemiBold" HorizontalAlignment="Right" /></Grid>
                        <Button Content="View passengers  →" Command="{Binding NavigateCommand}" CommandParameter="Passengers" Style="{StaticResource OverviewLink}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,0,0,17">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="1.35*" /><ColumnDefinition Width="0.9*" /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource OverviewCard}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Aircraft status" Style="{StaticResource OverviewCardHeading}" />
                        <TextBlock Text="{Binding Fleet.SelectedAircraft.AircraftType}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Fleet.SelectedAircraft.Registration}" Style="{StaticResource OverviewMetric}" FontSize="20" Margin="0,4,0,0" />
                        <Grid Margin="0,11,0,0"><TextBlock Text="Technical" FontSize="10" Foreground="{StaticResource TextMutedBrush}" /><TextBlock Text="{Binding Fleet.SelectedAircraft.TechnicalStatus}" FontSize="10" Foreground="#58E68A" FontWeight="SemiBold" HorizontalAlignment="Right" /></Grid>
                        <Grid Margin="0,6,0,0"><TextBlock Text="Dispatch" FontSize="10" Foreground="{StaticResource TextMutedBrush}" /><TextBlock Text="{Binding Fleet.SelectedAircraft.DispatchStatus}" FontSize="10" Foreground="#58E68A" FontWeight="SemiBold" HorizontalAlignment="Right" /></Grid>
                        <Button Content="View aircraft  →" Command="{Binding NavigateCommand}" CommandParameter="Fleet" Style="{StaticResource OverviewLink}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource OverviewCard}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Maintenance" Style="{StaticResource OverviewCardHeading}" />
                        <TextBlock Text="Defects, restrictions and technical notes." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,12" />
                        <Grid><TextBlock Text="Active defects" FontSize="11" /><TextBlock Text="{Binding Fleet.SelectedOpenDefectCount}" Style="{StaticResource OverviewMetric}" FontSize="18" HorizontalAlignment="Right" /></Grid>
                        <Grid Margin="0,8,0,0"><TextBlock Text="Deferred items" FontSize="11" /><TextBlock Text="{Binding Fleet.SelectedDeferredDefectCount}" Style="{StaticResource OverviewMetric}" FontSize="18" HorizontalAlignment="Right" /></Grid>
                        <Grid Margin="0,8,0,0"><TextBlock Text="Maintenance due" FontSize="11" /><TextBlock Text="{Binding Fleet.MaintenanceWatch.Count}" Style="{StaticResource OverviewMetric}" FontSize="18" HorizontalAlignment="Right" /></Grid>
                        <Button Content="Open maintenance  →" Command="{Binding NavigateCommand}" CommandParameter="Fleet" Style="{StaticResource OverviewLink}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource OverviewCard}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Recent logbook activity" Style="{StaticResource OverviewCardHeading}" />
                        <TextBlock Text="Latest entries for the selected aircraft." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,10" />
                        <ScrollViewer Height="76" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Fleet.RecentActivity}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="60" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Timestamp}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Description}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Context}" Foreground="{StaticResource TextMutedBrush}" FontSize="9" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="Activity appears when the authoritative fleet record is available." Foreground="{StaticResource TextMutedBrush}" FontSize="9" Margin="0,4,0,0" TextWrapping="Wrap" />
                        <Button Content="Open logbook  →" Command="{Binding NavigateCommand}" CommandParameter="Fleet" Style="{StaticResource OverviewLink}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource OverviewCard}" BorderBrush="#9D3441" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Operational support" Style="{StaticResource OverviewCardHeading}" />
                        <TextBlock Text="Report a cabin or aircraft issue so the operation can remain accurate." Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0" />
                        <TextBlock Text="{Binding Operations.BaggageReconciliationLabel}" Foreground="{Binding Operations.BaggageReconciliationColor}" FontSize="10" TextWrapping="Wrap" Margin="0,12,0,0" />
                        <Button Content="Report an issue" Command="{Binding NavigateCommand}" CommandParameter="Fleet" Style="{StaticResource PrimaryButtonStyle}" Margin="0,15,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource OverviewCard}" Padding="17" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Flight readiness" Style="{StaticResource OverviewCardHeading}" />
                        <TextBlock Text="{Binding Operations.OperationMessage}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" CornerRadius="8" Padding="11,7" Margin="0,0,9,0"><TextBlock Text="{Binding Operations.SimBriefConnectionLabel}" FontSize="10" FontWeight="SemiBold" /></Border>
                        <Button Content="Refresh briefing" Command="{Binding Account.RefreshWebsiteFlightCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,9,0" />
                        <Button Content="Open iGate" Command="{Binding NavigateCommand}" CommandParameter="IportDcs" Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
