<UserControl x:Class="FreeFlight.CabinControl.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="DashboardMetricCard" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="18,16" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style x:Key="TimelineText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="TODAY'S FLIGHT" Foreground="{StaticResource PrimaryBrush}" FontSize="10" FontWeight="SemiBold" />
                    <TextBlock Text="Your operational overview" Style="{StaticResource PageTitleStyle}" Margin="0,4,0,0" />
                    <TextBlock Text="Live flight, cabin and gate information for the service selected on the BAV website." Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding CurrentClockDate}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding CurrentClockTime}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,3,0,0" />
                    <TextBlock Text="{Binding ClockSourceLabel}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" HorizontalAlignment="Right" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>

            <Border CornerRadius="12" Padding="25,22" Margin="0,0,0,16">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#073B65" Offset="0" />
                        <GradientStop Color="#0A6FAE" Offset="0.58" />
                        <GradientStop Color="#1680C1" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="210" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding FlightNumber}" Foreground="#C9EBFF" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding RouteSummary}" Foreground="White" FontSize="31" FontWeight="SemiBold" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding AircraftName}" Foreground="#D8F0FF" FontSize="14" Margin="0,7,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,17,0,0">
                            <Border Background="#2AFFFFFF" BorderBrush="#47FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10,7">
                                <TextBlock Text="{Binding SimBriefConnectionLabel}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                            <Button Content="Refresh briefing"
                                    Command="{Binding DataContext.Account.RefreshWebsiteFlightCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Background="#25FFFFFF"
                                    Foreground="White"
                                    BorderBrush="#47FFFFFF"
                                    Height="34"
                                    Margin="10,0,0,0"
                                    IsEnabled="{Binding DataContext.Account.IsBusy, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBooleanConverter}}" />
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#1C00253E" BorderBrush="#48FFFFFF" BorderThickness="1" CornerRadius="9" Padding="17" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="DEPARTURE" Foreground="#BCE6FF" FontSize="10" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ScheduledDeparture}" Foreground="White" FontSize="32" FontWeight="SemiBold" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding GateHeader}" Foreground="#E3F3FF" FontSize="11" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <UniformGrid Columns="4" Margin="0,0,0,16">
                <Border Style="{StaticResource DashboardMetricCard}">
                    <StackPanel>
                        <TextBlock Text="PASSENGERS" Style="{StaticResource MetricLabelStyle}" />
                        <TextBlock Text="{Binding TotalPassengers}" FontSize="27" FontWeight="SemiBold" Margin="0,5,0,0" />
                        <TextBlock Text="Manifest loaded" Style="{StaticResource MutedTextStyle}" FontSize="11" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource DashboardMetricCard}">
                    <StackPanel>
                        <TextBlock Text="CHECKED IN" Style="{StaticResource MetricLabelStyle}" />
                        <TextBlock Text="{Binding CheckedInPassengers}" FontSize="27" FontWeight="SemiBold" Margin="0,5,0,0" />
                        <TextBlock Text="{Binding CheckedInPercent, StringFormat={}{0}% of manifest}" Style="{StaticResource MutedTextStyle}" FontSize="11" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource DashboardMetricCard}">
                    <StackPanel>
                        <TextBlock Text="ON BOARD" Style="{StaticResource MetricLabelStyle}" />
                        <TextBlock Text="{Binding BoardedPassengers}" FontSize="27" FontWeight="SemiBold" Margin="0,5,0,0" />
                        <TextBlock Text="{Binding BoardedPercent, StringFormat={}{0}% boarded}" Style="{StaticResource MutedTextStyle}" FontSize="11" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource DashboardMetricCard}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="BAGGAGE" Style="{StaticResource MetricLabelStyle}" />
                        <TextBlock Text="{Binding LoadedBags}" FontSize="27" FontWeight="SemiBold" Margin="0,5,0,0" />
                        <TextBlock Text="{Binding BaggageReconciliationLabel}" Style="{StaticResource MutedTextStyle}" FontSize="11" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.55*" />
                    <ColumnDefinition Width="1" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,17">
                            <StackPanel>
                                <TextBlock Text="FLIGHT PROGRESS" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="{Binding TimelineContext}" Style="{StaticResource MutedTextStyle}" FontSize="11" Margin="0,3,0,0" />
                            </StackPanel>
                            <Border Background="#E9F5FF" BorderBrush="#B7DDF8" BorderThickness="1" CornerRadius="14" Padding="10,5" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TimelinePhaseLabel}" Foreground="{StaticResource PrimaryDeepBrush}" FontSize="10" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                        <Border Height="2" Background="#D7E4EF" Margin="24,21,24,0" />
                        <ItemsControl ItemsSource="{Binding TimelineEvents}" Margin="0,-18,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="6" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel HorizontalAlignment="Center">
                                        <Border Width="37" Height="37" CornerRadius="19" Background="{Binding MarkerBackground}" BorderBrush="{Binding MarkerBorderBrush}" BorderThickness="{Binding MarkerBorderThickness}">
                                            <TextBlock Text="{Binding DisplayGlyph}" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{Binding MarkerForeground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource TimelineText}" Margin="0,8,0,0" />
                                        <TextBlock Text="{Binding TimeLabel}" Style="{StaticResource TimelineText}" Foreground="{Binding TimeForeground}" Margin="0,3,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="FLIGHT READINESS" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="Live requirements for this Ember session." Style="{StaticResource MutedTextStyle}" FontSize="11" Margin="0,3,0,13" />
                        <Grid Margin="0,0,0,9"><TextBlock Text="Website briefing" FontWeight="SemiBold" FontSize="12" /><TextBlock Text="{Binding SimBriefConnectionLabel}" Foreground="{StaticResource PrimaryBrush}" FontSize="11" HorizontalAlignment="Right" /></Grid>
                        <Separator Background="{StaticResource BorderSoftBrush}" />
                        <Grid Margin="0,10,0,9"><TextBlock Text="Gate status" FontWeight="SemiBold" FontSize="12" /><TextBlock Text="{Binding GateStatusLabel}" Foreground="{Binding GateStatusColor}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" /></Grid>
                        <Separator Background="{StaticResource BorderSoftBrush}" />
                        <Grid Margin="0,10,0,9"><TextBlock Text="Cabin and baggage" FontWeight="SemiBold" FontSize="12" /><TextBlock Text="{Binding BaggageReconciliationLabel}" Foreground="{Binding BaggageReconciliationColor}" FontSize="10" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" /></Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardStyle}" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding OperationMessage}" Style="{StaticResource MutedTextStyle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="Ember checks the BAV website automatically while the briefing is being prepared. You can also refresh it here at any time." Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="My flight" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="CabinAccount" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,9,0" />
                        <Button Content="Open iGate" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="IportDcs" Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
