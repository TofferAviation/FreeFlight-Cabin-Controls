<UserControl x:Class="FreeFlight.CabinControl.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="TimelineLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" /><Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="Margin" Value="0,7,0,0" /></Style>
        <Style x:Key="MetricValue" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" /><Setter Property="FontSize" Value="27" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
        <Style x:Key="ReadinessCard" TargetType="Border"><Setter Property="Background" Value="#0B1B2D" /><Setter Property="BorderBrush" Value="#24415F" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="7" /><Setter Property="Padding" Value="8,6" /><Setter Property="Margin" Value="0,2" /></Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="0,0,0,8">
            <Grid.RowDefinitions><RowDefinition Height="184" /><RowDefinition Height="12" /><RowDefinition Height="104" /><RowDefinition Height="12" /><RowDefinition Height="294" /><RowDefinition Height="66" /></Grid.RowDefinitions>

            <Border Style="{StaticResource CardStyle}" Padding="20,14">
                <Grid><Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition /></Grid.RowDefinitions>
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TimelineTitle}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding TimelineContext}" Foreground="#8FC8FF" FontSize="10" Margin="12,2,0,0" />
                        </StackPanel>
                        <Border Background="#C51B5033" BorderBrush="#58E68A" BorderThickness="1" CornerRadius="12" Padding="14,5" HorizontalAlignment="Center"
                                Visibility="{Binding HasFlightBannerMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding FlightBannerMessage}" Foreground="#BFFFD0" FontWeight="SemiBold" />
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <StackPanel Margin="0,0,14,0">
                                <TextBlock Text="{Binding CurrentClockTime}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding ClockSourceLabel}" Foreground="#8FC8FF" FontSize="9" HorizontalAlignment="Right" />
                            </StackPanel>
                            <Border Background="#332B2607" BorderBrush="#8E7220" BorderThickness="1" CornerRadius="12" Padding="12,4">
                                <TextBlock Text="{Binding TimelinePhaseLabel}" Foreground="{Binding TimelinePhaseColor}" FontWeight="SemiBold" FontSize="11" />
                            </Border>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" Margin="22,7,22,0"><Border Height="3" Margin="38,20" Background="#31506E" VerticalAlignment="Top" />
                        <ItemsControl ItemsSource="{Binding TimelineEvents}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="6" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel HorizontalAlignment="Center">
                                        <Border Width="43" Height="43" CornerRadius="22" Background="{Binding MarkerBackground}" BorderBrush="{Binding MarkerBorderBrush}" BorderThickness="{Binding MarkerBorderThickness}">
                                            <TextBlock Text="{Binding DisplayGlyph}" FontFamily="Segoe Fluent Icons" FontSize="19" Foreground="{Binding MarkerForeground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource TimelineLabel}" FontSize="11" />
                                        <TextBlock Text="{Binding TimeLabel}" Foreground="{Binding TimeForeground}" FontSize="10" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Grid>
            </Border>

            <UniformGrid Grid.Row="2" Columns="4">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,6,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="60" /><ColumnDefinition /></Grid.ColumnDefinitions><Border Width="50" Height="50" CornerRadius="25" Background="#123760"><TextBlock Text="&#xE716;" FontFamily="Segoe Fluent Icons" Foreground="#55AEFF" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding TotalPassengers}" Style="{StaticResource MetricValue}" /><TextBlock Text="Total Passengers" /><TextBlock Text="Active manifest" Style="{StaticResource MutedTextStyle}" FontSize="9" /></StackPanel></Grid></Border>
                <Border Style="{StaticResource CardStyle}" Margin="6,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="60" /><ColumnDefinition /></Grid.ColumnDefinitions><Border Width="50" Height="50" CornerRadius="25" Background="#184728"><TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons" Foreground="#70E05B" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding CheckedInPassengers}" Style="{StaticResource MetricValue}" /><TextBlock Text="Checked In" /><TextBlock Text="{Binding CheckedInPercent, StringFormat={}{0}% of total}" Style="{StaticResource MutedTextStyle}" FontSize="9" /></StackPanel></Grid></Border>
                <Border Style="{StaticResource CardStyle}" Margin="6,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="60" /><ColumnDefinition /></Grid.ColumnDefinitions><Border Width="50" Height="50" CornerRadius="25" Background="#123760"><TextBlock Text="&#xE7C8;" FontFamily="Segoe Fluent Icons" Foreground="#55AEFF" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding BoardedPassengers}" Style="{StaticResource MetricValue}" /><TextBlock Text="Boarded" /><TextBlock Text="{Binding BoardedPercent, StringFormat={}{0}% of total}" Style="{StaticResource MutedTextStyle}" FontSize="9" /></StackPanel></Grid></Border>
                <Border Style="{StaticResource CardStyle}" Margin="6,0,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="60" /><ColumnDefinition /></Grid.ColumnDefinitions><Border Width="50" Height="50" CornerRadius="25" Background="#51252C"><TextBlock Text="&#xE719;" FontFamily="Segoe Fluent Icons" Foreground="#FF6666" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding LoadedBags}" Style="{StaticResource MetricValue}" /><TextBlock Text="Bags Loaded" /><TextBlock Text="{Binding BagsLoadedPercent, StringFormat={}{0}% of bags}" Style="{StaticResource MutedTextStyle}" FontSize="9" /></StackPanel></Grid></Border>
            </UniformGrid>

            <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="0.86*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="0.96*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="1.18*" /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}"><StackPanel><Grid Margin="0,0,0,6"><TextBlock Text="DEPARTURE TIMES" FontWeight="SemiBold" FontSize="15" /><TextBlock Text="{Binding ScheduleSourceLabel}" Foreground="#8FC8FF" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid><Grid Height="39"><TextBlock Text="Turnaround Starts" VerticalAlignment="Center" /><TextBlock Text="{Binding TurnaroundStartsAt}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid><Separator Background="#233C58" /><Grid Height="39"><TextBlock Text="Gate Opens" VerticalAlignment="Center" /><TextBlock Text="{Binding GateOpensAt}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid><Separator Background="#233C58" /><Grid Height="39"><TextBlock Text="Boarding Begins" VerticalAlignment="Center" /><TextBlock Text="{Binding BoardingBeginsAt}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid><Separator Background="#233C58" /><Grid Height="39"><TextBlock Text="Gate Closes" VerticalAlignment="Center" /><TextBlock Text="{Binding GateClosesAt}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid><Separator Background="#233C58" /><Grid Height="39"><TextBlock Text="Departure" VerticalAlignment="Center" /><TextBlock Text="{Binding ScheduledDeparture}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid></StackPanel></Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="CABIN DISTRIBUTION" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8" /><Grid Height="50"><Border Width="38" Height="38" CornerRadius="19" Background="#2B1760" HorizontalAlignment="Left"><TextBlock Text="F" Foreground="#D49BFF" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="First" Margin="48,0,0,0" VerticalAlignment="Center" /><TextBlock Text="{Binding FirstCount}" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid><Grid Height="50"><Border Width="38" Height="38" CornerRadius="19" Background="#143C78" HorizontalAlignment="Left"><TextBlock Text="CW" Foreground="#7FB8FF" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="Club World" Margin="48,0,0,0" VerticalAlignment="Center" /><TextBlock Text="{Binding ClubWorldCount}" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid><Grid Height="50"><Border Width="38" Height="38" CornerRadius="19" Background="#472075" HorizontalAlignment="Left"><TextBlock Text="W+" Foreground="#DA9CFF" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="World Traveller Plus" Margin="48,0,0,0" VerticalAlignment="Center" /><TextBlock Text="{Binding WorldTravellerPlusCount}" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid><Grid Height="50"><Border Width="38" Height="38" CornerRadius="19" Background="#143C78" HorizontalAlignment="Left"><TextBlock Text="WT" Foreground="#7FB8FF" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="World Traveller" Margin="48,0,0,0" VerticalAlignment="Center" /><TextBlock Text="{Binding WorldTravellerCount}" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid></StackPanel></Border>
                <Border Grid.Column="4" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="READINESS CHECKLIST" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8" /><Border Style="{StaticResource ReadinessCard}"><Grid><TextBlock Text="SimBrief Data" FontWeight="SemiBold" /><TextBlock Text="Route and passenger source ready" Style="{StaticResource MutedTextStyle}" Margin="0,19,0,0" /><TextBlock Text="✓ Ready" Foreground="#70E05B" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid></Border><Border Style="{StaticResource ReadinessCard}"><Grid><TextBlock Text="Passenger Data" FontWeight="SemiBold" /><TextBlock Text="{Binding TotalPassengers, StringFormat={}{0} passenger records loaded}" Style="{StaticResource MutedTextStyle}" Margin="0,19,0,0" /><TextBlock Text="✓ Ready" Foreground="#70E05B" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid></Border><Border Style="{StaticResource ReadinessCard}"><Grid><TextBlock Text="Cabin Layout" FontWeight="SemiBold" /><TextBlock Text="{Binding AircraftName}" Style="{StaticResource MutedTextStyle}" Margin="0,19,0,0" /><TextBlock Text="✓ Ready" Foreground="#70E05B" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid></Border><Border Style="{StaticResource ReadinessCard}"><Grid><TextBlock Text="Gate Status" FontWeight="SemiBold" /><TextBlock Text="{Binding ReadinessGateStatus}" Style="{StaticResource MutedTextStyle}" Margin="0,19,0,0" /><TextBlock Text="✓ Ready" Foreground="#70E05B" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid></Border></StackPanel></Border>
            </Grid>

            <Grid Grid.Row="5" Margin="0,10,0,0"><TextBlock Text="{Binding OperationMessage}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" /><Button Content="Import SimBrief Passenger List" Command="{Binding ImportSimBriefCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Margin="0,0,278,0" MinWidth="252" /><Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="GateDesk" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" MinWidth="258"><StackPanel Orientation="Horizontal"><TextBlock Text="Open Gate Workspace" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="&#xE72A;" FontFamily="Segoe Fluent Icons" FontSize="20" Margin="16,0,0,0" /></StackPanel></Button></Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
