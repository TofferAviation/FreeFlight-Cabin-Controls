<UserControl x:Class="FreeFlight.CabinControl.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- The overview deliberately owns its visual treatment.  The operational controls
             keep the shared styles while this page uses softer, layered surfaces. -->
        <Style x:Key="OverviewCard" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="#2A6D91AD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="21,20" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.22" Color="#000000" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OverviewCardHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style x:Key="OverviewLink" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,15,0,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="OverviewMetric" TargetType="TextBlock">
            <Setter Property="FontSize" Value="25" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style x:Key="OverviewIconBadge" TargetType="Border">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Background" Value="#26379BE5" />
            <Setter Property="BorderBrush" Value="#5076C5F3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,11,0" />
        </Style>
        <Style x:Key="OverviewPill" TargetType="Border">
            <Setter Property="Background" Value="#2942A5E8" />
            <Setter Property="BorderBrush" Value="#5B82CFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="11,5" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,0,9">
            <Grid Margin="1,0,1,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="EMBER OPERATIONS" Foreground="{DynamicResource PrimaryBrush}" FontSize="10" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource PageTitleStyle}" Margin="0,4,0,0">
                        <Run Text="{Binding Operations.TimeAwareGreeting, Mode=OneWay}" />
                        <Run Text=", " />
                        <Run Text="{Binding Account.DisplayName, Mode=OneWay}" />
                        <Run Text="." />
                    </TextBlock>
                    <TextBlock Text="Ready for your next journey?" Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="PEOPLE. SERVICE. A HIGHER STANDARD." Foreground="{DynamicResource PrimaryBrush}" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,0,0,5" />
                    <TextBlock Text="{Binding Operations.CurrentClockDate}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding Operations.CurrentClockTime}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,3,0,0" />
                    <TextBlock Text="{Binding Operations.ClockSourceLabel}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" HorizontalAlignment="Right" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>

            <Border Height="272" Margin="0,0,0,20" CornerRadius="22" ClipToBounds="True" BorderBrush="#406FB7E9" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="7" Opacity="0.28" Color="#000000" />
                </Border.Effect>
                <Grid>
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#06223F" Offset="0" />
                                <GradientStop Color="#0B4F7B" Offset="0.56" />
                                <GradientStop Color="#188DC8" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Ellipse Width="500" Height="500" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-118,0" Opacity="0.72">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#4879C8EE" Offset="0" />
                                <GradientStop Color="#0C79C8EE" Offset="0.56" />
                                <GradientStop Color="#0079C8EE" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="✈" FontSize="244" FontFamily="Segoe UI Symbol" Foreground="#13FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,94,-42" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform><RotateTransform Angle="-12" /></TextBlock.RenderTransform>
                    </TextBlock>
                    <Image Source="{Binding Fleet.SelectedAircraft.AircraftImageUri}" Stretch="UniformToFill" HorizontalAlignment="Right" Opacity="0.98" />
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#ED04182D" Offset="0" />
                                <GradientStop Color="#A8051B33" Offset="0.46" />
                                <GradientStop Color="#16051A31" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border VerticalAlignment="Bottom" Height="98" Opacity="0.55">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0" />
                                <GradientStop Color="#A4001025" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Grid Margin="29,25">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="246" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="ASSIGNED FLIGHT" Foreground="#C8E8FA" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Border Style="{StaticResource OverviewPill}" Margin="13,0,0,0">
                                    <TextBlock Text="{Binding Operations.GateStatusLabel}" Foreground="White" FontSize="10" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Operations.FlightNumber}" Foreground="White" FontSize="31" FontWeight="SemiBold" Margin="0,10,0,0" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="66" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.ColumnSpan="3" Height="2" Background="#76E5F4FD" VerticalAlignment="Center" Margin="52,0" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Operations.OriginIata}" Foreground="White" FontSize="39" FontWeight="SemiBold" />
                                    <TextBlock Text="Departure" Foreground="#D5EEFB" FontSize="11" />
                                </StackPanel>
                                <Border Grid.Column="1" Width="44" Height="44" CornerRadius="22" Background="#38FFFFFF" BorderBrush="#6BFFFFFF" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="✈" FontFamily="Segoe UI Symbol" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding Operations.DestinationIata}" Foreground="White" FontSize="39" FontWeight="SemiBold" />
                                    <TextBlock Text="Arrival" Foreground="#D5EEFB" FontSize="11" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <TextBlock Text="{Binding Operations.FlightDateLong}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="  ·  " Foreground="#C9E9FA" FontSize="12" />
                                <TextBlock Text="{Binding Operations.ScheduledDeparture}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="  ·  " Foreground="#C9E9FA" FontSize="12" />
                                <TextBlock Text="{Binding Operations.RouteSummary}" Foreground="#D5EEFB" FontSize="12" />
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#51061B31" BorderBrush="#67FFFFFF" BorderThickness="1" CornerRadius="18" Padding="19,17" VerticalAlignment="Center">
                            <StackPanel>
                                <TextBlock Text="YOUR AIRCRAFT" Foreground="#C7E8FA" FontSize="10" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Fleet.SelectedAircraft.AircraftType}" Foreground="White" FontSize="19" FontWeight="SemiBold" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Fleet.SelectedAircraft.Registration}" Foreground="#D5EEFB" FontSize="13" Margin="0,3,0,0" />
                                <Border Background="#26FFFFFF" BorderBrush="#3CFFFFFF" BorderThickness="1" CornerRadius="9" Padding="9,6" Margin="0,11,0,0">
                                    <TextBlock Text="{Binding Operations.TimelinePhaseLabel}" Foreground="White" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                </Border>
                                <TextBlock Text="{Binding Fleet.FlightAssignmentLabel}" Foreground="#D5EEFB" FontSize="10" TextWrapping="Wrap" Margin="0,9,0,0" />
                                <Button Content="View flight  →" Command="{Binding NavigateCommand}" CommandParameter="CabinAccount" Style="{StaticResource SecondaryButtonStyle}" Background="#36FFFFFF" Foreground="White" BorderBrush="#65FFFFFF" Margin="0,14,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.03*" />
                    <ColumnDefinition Width="1.12*" />
                    <ColumnDefinition Width="1.05*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource OverviewCard}" Margin="0,0,12,0" MinHeight="214">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="91" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid Width="84" Height="84" VerticalAlignment="Top">
                            <Ellipse Stroke="#D1E5F5" StrokeThickness="8" />
                            <Path Data="{Binding Catering.CurrentActivityProgress, Converter={StaticResource ProgressArcGeometryConverter}}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Border Width="62" Height="62" CornerRadius="31" Background="#113F9FDF" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Catering.CurrentActivityProgressLabel}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="service" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <StackPanel Grid.Column="1">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource OverviewIconBadge}"><TextBlock Text="✦" FontSize="17" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" /></Border>
                                <TextBlock Text="Service progress" Style="{StaticResource OverviewCardHeading}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding Catering.CurrentActivityTitle}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Catering.CurrentActivityDetail}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,7,0,0" TextWrapping="Wrap" />
                            <ProgressBar Height="5" Margin="0,11,0,0" Minimum="0" Maximum="100" Value="{Binding Catering.CurrentActivityProgress, Mode=OneWay}" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource PrimaryBrush}" />
                            <Button Content="Open service  →" Command="{Binding NavigateCommand}" CommandParameter="Catering" Style="{StaticResource OverviewLink}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource OverviewCard}" Margin="0,0,12,0" MinHeight="214">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource OverviewIconBadge}"><TextBlock Text="▦" FontSize="17" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" /></Border>
                            <StackPanel VerticalAlignment="Center"><TextBlock Text="Catering &amp; inventory" Style="{StaticResource OverviewCardHeading}" /><TextBlock Text="Live stock levels and service loading." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0" /></StackPanel>
                        </StackPanel>
                        <Grid Margin="0,17,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="{Binding Catering.TotalUnits}" Style="{StaticResource OverviewMetric}" /><TextBlock Text="available items" Style="{StaticResource MutedTextStyle}" FontSize="10" /></StackPanel>
                            <Border Grid.Column="1" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1,0,0,0" Padding="13,0,0,0"><StackPanel><TextBlock Text="{Binding Catering.LowStockCount}" Style="{StaticResource OverviewMetric}" /><TextBlock Text="low stock" Style="{StaticResource MutedTextStyle}" FontSize="10" /></StackPanel></Border>
                            <Border Grid.Column="2" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1,0,0,0" Padding="13,0,0,0"><StackPanel><TextBlock Text="{Binding Catering.TotalSpecialMeals}" Style="{StaticResource OverviewMetric}" /><TextBlock Text="special meals" Style="{StaticResource MutedTextStyle}" FontSize="10" /></StackPanel></Border>
                        </Grid>
                        <Grid Margin="0,15,0,0"><TextBlock Text="{Binding Catering.CateringLoadLabel}" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="{Binding Catering.InventoryUsageLabel}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Right" /></Grid>
                        <ProgressBar Height="5" Margin="0,7,0,0" Minimum="0" Maximum="100" Value="{Binding Catering.InventoryUsagePercent, Mode=OneWay}" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource PrimaryBrush}" />
                        <Button Content="Open catering  →" Command="{Binding NavigateCommand}" CommandParameter="Catering" Style="{StaticResource OverviewLink}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource OverviewCard}" MinHeight="214">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource OverviewIconBadge}"><TextBlock Text="◎" FontSize="18" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" /></Border>
                            <StackPanel VerticalAlignment="Center"><TextBlock Text="Passenger preferences" Style="{StaticResource OverviewCardHeading}" /><TextBlock Text="Special requests and passenger care." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0" /></StackPanel>
                        </StackPanel>
                        <Grid Margin="0,17,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="♥" Foreground="{DynamicResource PrimaryBrush}" FontFamily="Segoe UI Symbol" FontSize="13" /><TextBlock Grid.Column="1" Text="Passenger preferences" FontSize="11" /><TextBlock Grid.Column="2" Text="{Binding Catering.PassengerPreferences.Count}" FontWeight="SemiBold" HorizontalAlignment="Right" /></Grid>
                        <Separator Background="{DynamicResource BorderSoftBrush}" />
                        <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="✦" Foreground="{DynamicResource PrimaryBrush}" FontFamily="Segoe UI Symbol" FontSize="13" /><TextBlock Grid.Column="1" Text="Special meals" FontSize="11" /><TextBlock Grid.Column="2" Text="{Binding Catering.TotalSpecialMeals}" FontWeight="SemiBold" HorizontalAlignment="Right" /></Grid>
                        <Separator Background="{DynamicResource BorderSoftBrush}" />
                        <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="●" Foreground="{DynamicResource PrimaryBrush}" FontFamily="Segoe UI Symbol" FontSize="11" /><TextBlock Grid.Column="1" Text="Boarded passengers" FontSize="11" /><TextBlock Grid.Column="2" Text="{Binding Operations.BoardingProgressText}" FontWeight="SemiBold" HorizontalAlignment="Right" /></Grid>
                        <Button Content="View passengers  →" Command="{Binding NavigateCommand}" CommandParameter="Passengers" Style="{StaticResource OverviewLink}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="1.35*" /><ColumnDefinition Width="0.9*" /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource OverviewCard}" Margin="0,0,12,0" MinHeight="212">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal"><Border Style="{StaticResource OverviewIconBadge}"><TextBlock Text="✈" FontSize="18" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" /></Border><TextBlock Text="Aircraft status" Style="{StaticResource OverviewCardHeading}" VerticalAlignment="Center" /></StackPanel>
                        <TextBlock Text="{Binding Fleet.SelectedAircraft.AircraftType}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,12,0,0" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Fleet.SelectedAircraft.Registration}" Style="{StaticResource OverviewMetric}" FontSize="21" Margin="0,4,0,0" />
                        <Grid Margin="0,12,0,0"><TextBlock Text="Technical" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" /><TextBlock Text="{Binding Fleet.SelectedAircraft.TechnicalStatus}" FontSize="10" Foreground="#58E68A" FontWeight="SemiBold" HorizontalAlignment="Right" /></Grid>
                        <Grid Margin="0,6,0,0"><TextBlock Text="Dispatch" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" /><TextBlock Text="{Binding Fleet.SelectedAircraft.DispatchStatus}" FontSize="10" Foreground="#58E68A" FontWeight="SemiBold" HorizontalAlignment="Right" /></Grid>
                        <Button Content="View aircraft  →" Command="{Binding NavigateCommand}" CommandParameter="Fleet" Style="{StaticResource OverviewLink}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource OverviewCard}" Margin="0,0,12,0" MinHeight="212">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal"><Border Style="{StaticResource OverviewIconBadge}"><TextBlock Text="⌁" FontSize="20" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" /></Border><TextBlock Text="Maintenance" Style="{StaticResource OverviewCardHeading}" VerticalAlignment="Center" /></StackPanel>
                        <TextBlock Text="Defects, restrictions and technical notes." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,12,0,12" />
                        <Grid><TextBlock Text="Active defects" FontSize="11" /><TextBlock Text="{Binding Fleet.SelectedOpenDefectCount}" Style="{StaticResource OverviewMetric}" FontSize="18" HorizontalAlignment="Right" /></Grid>
                        <Grid Margin="0,8,0,0"><TextBlock Text="Deferred items" FontSize="11" /><TextBlock Text="{Binding Fleet.SelectedDeferredDefectCount}" Style="{StaticResource OverviewMetric}" FontSize="18" HorizontalAlignment="Right" /></Grid>
                        <Grid Margin="0,8,0,0"><TextBlock Text="Maintenance due" FontSize="11" /><TextBlock Text="{Binding Fleet.MaintenanceWatch.Count}" Style="{StaticResource OverviewMetric}" FontSize="18" HorizontalAlignment="Right" /></Grid>
                        <Button Content="Open maintenance  →" Command="{Binding NavigateCommand}" CommandParameter="Fleet" Style="{StaticResource OverviewLink}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource OverviewCard}" Margin="0,0,12,0" MinHeight="212">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal"><Border Style="{StaticResource OverviewIconBadge}"><TextBlock Text="◷" FontSize="19" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" /></Border><TextBlock Text="Recent logbook activity" Style="{StaticResource OverviewCardHeading}" VerticalAlignment="Center" /></StackPanel>
                        <TextBlock Text="Latest entries for the selected aircraft." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,10,0,10" />
                        <ScrollViewer Height="70" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Fleet.RecentActivity}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,7">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="60" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Timestamp}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Description}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Context}" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Button Content="Open logbook  →" Command="{Binding NavigateCommand}" CommandParameter="Fleet" Style="{StaticResource OverviewLink}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource OverviewCard}" MinHeight="212" BorderBrush="#99485B" Background="#151D344D">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal"><Border Width="36" Height="36" CornerRadius="18" Background="#302D95E5" BorderBrush="#885572A5" BorderThickness="1" Margin="0,0,11,0"><TextBlock Text="!" FontSize="20" FontWeight="SemiBold" Foreground="#FF8EA0" VerticalAlignment="Center" HorizontalAlignment="Center" /></Border><TextBlock Text="Operational support" Style="{StaticResource OverviewCardHeading}" VerticalAlignment="Center" /></StackPanel>
                        <TextBlock Text="Report a cabin or aircraft issue so the operation can remain accurate." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,13,0,0" />
                        <TextBlock Text="{Binding Operations.BaggageReconciliationLabel}" Foreground="{Binding Operations.BaggageReconciliationColor}" FontSize="10" TextWrapping="Wrap" Margin="0,13,0,0" />
                        <Button Content="Report an issue" Command="{Binding NavigateCommand}" CommandParameter="Fleet" Style="{StaticResource PrimaryButtonStyle}" Margin="0,16,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource OverviewCard}" Padding="20,17" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal"><Border Style="{StaticResource OverviewIconBadge}"><TextBlock Text="✓" FontSize="18" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" /></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="Flight readiness" Style="{StaticResource OverviewCardHeading}" /><TextBlock Text="{Binding Operations.OperationMessage}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" /></StackPanel></StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource OverviewPill}" Margin="0,0,10,0"><TextBlock Text="{Binding Operations.SimBriefConnectionLabel}" FontSize="10" FontWeight="SemiBold" /></Border>
                        <Button Content="Refresh briefing" Command="{Binding Account.RefreshWebsiteFlightCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" />
                        <Button Content="Open iGate" Command="{Binding NavigateCommand}" CommandParameter="IportDcs" Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
