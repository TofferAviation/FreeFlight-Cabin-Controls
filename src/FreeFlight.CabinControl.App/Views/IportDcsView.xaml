<UserControl x:Class="FreeFlight.CabinControl.App.Views.IportDcsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FreeFlight.CabinControl.App.ViewModels"
             FontFamily="Segoe UI"
             FontSize="11"
             Foreground="#252525">
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#252525" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <LinearGradientBrush x:Key="IportBarBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FDFDFD" Offset="0" />
            <GradientStop Color="#D8D8D8" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="IportButtonBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0" />
            <GradientStop Color="#D6D6D6" Offset="1" />
        </LinearGradientBrush>
        <Style x:Key="IportButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource IportButtonBrush}" />
            <Setter Property="BorderBrush" Value="#9A9A9A" />
            <Setter Property="Foreground" Value="#222222" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="MinHeight" Value="27" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" TextElement.Foreground="#252525">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" TextElement.Foreground="#252525" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#E8F8FC" /><Setter Property="BorderBrush" Value="#29B8D4" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#C5C5C5" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#E8F8FC" /><Setter Property="BorderBrush" Value="#29B8D4" /></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#C5C5C5" /><Setter Property="Foreground" Value="#000000" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="IportTab" TargetType="RadioButton">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="Foreground" Value="#282828" />
            <Setter Property="Background" Value="#E7E7E7" />
            <Setter Property="BorderBrush" Value="#B7B7B7" />
            <Setter Property="BorderThickness" Value="1,1,1,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" TextElement.Foreground="#252525">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="#252525" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="#FFFFFF" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="BorderBrush" Value="#23B8D2" /></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#EFFBFD" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IportSection" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#A8A8A8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9" />
        </Style>
        <Style x:Key="IportSectionHeader" TargetType="Border">
            <Setter Property="Background" Value="#A8A8A8" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
        <Style x:Key="IportInput" TargetType="TextBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Foreground" Value="#202020" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#88BFD0" />
            <Setter Property="CaretBrush" Value="#202020" />
        </Style>
    </UserControl.Resources>

    <Border Background="#E7E7E7" BorderBrush="#727272" BorderThickness="1" Tag="IportDcsWorkspace">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="64" /><RowDefinition Height="*" /><RowDefinition Height="53" /></Grid.RowDefinitions>

            <Border Background="{StaticResource IportBarBrush}" BorderBrush="#9A9A9A" BorderThickness="0,0,0,1">
                <Grid Margin="12,5">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="225" /><ColumnDefinition Width="174" /><ColumnDefinition /><ColumnDefinition Width="315" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Res2" FontSize="22" FontWeight="Bold" Foreground="#5C5C5C" />
                        <TextBlock Text=" iPort" FontSize="22" FontWeight="SemiBold" Foreground="#5C5C5C" />
                        <TextBlock Text="customer" FontSize="13" Foreground="#777777" VerticalAlignment="Bottom" Margin="0,0,0,7" />
                    </StackPanel>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Roles}" SelectedItem="{Binding ActiveRole}" Height="34" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="10,0,0,0">
                        <RadioButton Content="Check-In" GroupName="IportModules" Style="{StaticResource IportTab}" IsChecked="{Binding ActiveModule, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Check-In, Mode=OneWay}" Command="{Binding SelectModuleCommand}" CommandParameter="Check-In" />
                        <RadioButton Content="Boarding" GroupName="IportModules" Style="{StaticResource IportTab}" IsChecked="{Binding ActiveModule, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Boarding, Mode=OneWay}" Command="{Binding SelectModuleCommand}" CommandParameter="Boarding" />
                        <RadioButton Content="Seatmap" GroupName="IportModules" Style="{StaticResource IportTab}" IsChecked="{Binding ActiveModule, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Seatmap, Mode=OneWay}" Command="{Binding SelectModuleCommand}" CommandParameter="Seatmap" />
                        <RadioButton Content="Load Control" GroupName="IportModules" Style="{StaticResource IportTab}" IsChecked="{Binding ActiveModule, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Load Control, Mode=OneWay}" Command="{Binding SelectModuleCommand}" CommandParameter="Load Control" />
                        <RadioButton Content="Flight Monitor" GroupName="IportModules" Style="{StaticResource IportTab}" IsChecked="{Binding ActiveModule, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Flight Monitor, Mode=OneWay}" Command="{Binding SelectModuleCommand}" CommandParameter="Flight Monitor" />
                    </StackPanel>
                    <Grid Grid.Column="3" Margin="15,0,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="94" /><ColumnDefinition Width="94" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Operations.FlightNumber}" FontSize="20" FontWeight="Bold" /><TextBlock Text="{Binding Operations.AircraftName}" Foreground="#555555" /></StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="GATE" FontSize="9" Foreground="#666666" /><TextBlock Text="{Binding Operations.GateNumber}" FontSize="18" FontWeight="Bold" /></StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="STD / ETD" FontSize="9" Foreground="#666666" /><TextBlock Text="{Binding Operations.ScheduledDeparture}" FontSize="18" FontWeight="Bold" /></StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="10,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="9" /><ColumnDefinition /></Grid.ColumnDefinitions>

                <Border Background="#F6F6F6" BorderBrush="#9E9E9E" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="33" /><RowDefinition Height="126" /><RowDefinition Height="32" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <UniformGrid Columns="3"><Button Content="My Assigned" Style="{StaticResource IportButton}" /><Button Content="My Flights" Style="{StaticResource IportButton}" FontWeight="SemiBold" /><Button Content="Seatmap" Style="{StaticResource IportButton}" Command="{Binding SelectModuleCommand}" CommandParameter="Seatmap" /></UniformGrid>
                        <Grid Grid.Row="1" Margin="9,8"><Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="88" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <TextBlock Text="Boardingpoint:" VerticalAlignment="Center" /><TextBox Grid.Column="1" Text="{Binding BoardingPoint, Mode=OneWay}" Style="{StaticResource IportInput}" IsReadOnly="True" />
                            <TextBlock Grid.Row="1" Text="Dest/Car/Fltnr:" VerticalAlignment="Center" /><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Operations.DestinationIata, Mode=OneWay}" Style="{StaticResource IportInput}" IsReadOnly="True" />
                            <TextBlock Grid.Row="2" Text="Time Window:" VerticalAlignment="Center" /><TextBox Grid.Row="2" Grid.Column="1" Text="+1 hrs / +12 hrs" Style="{StaticResource IportInput}" IsReadOnly="True" />
                        </Grid>
                        <Border Grid.Row="2" Background="#DEDEDE" BorderBrush="#A2A2A2" BorderThickness="0,1"><Grid Margin="7,0"><Grid.ColumnDefinitions><ColumnDefinition Width="76" /><ColumnDefinition Width="78" /><ColumnDefinition Width="55" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="Flight" FontWeight="Bold" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="STD/ETD" FontWeight="Bold" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="Dest." FontWeight="Bold" VerticalAlignment="Center" /><TextBlock Grid.Column="3" Text="Gate" FontWeight="Bold" VerticalAlignment="Center" /></Grid></Border>
                        <ListBox Grid.Row="3" ItemsSource="{Binding Flights}" SelectedItem="{Binding SelectedFlight}" Background="#FFFFFF" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="MinHeight" Value="34" /><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#20B7D0" /><Setter Property="Foreground" Value="White" /></Trigger></Style.Triggers></Style></ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate><DataTemplate><Grid Margin="5,3" TextElement.Foreground="#252525"><Grid.ColumnDefinitions><ColumnDefinition Width="17" /><ColumnDefinition Width="60" /><ColumnDefinition Width="77" /><ColumnDefinition Width="45" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="{Binding StatusGlyph}" Foreground="{Binding StatusColor}" FontWeight="Bold" /><TextBlock Grid.Column="1" Text="{Binding FlightNumber}" FontWeight="SemiBold" /><TextBlock Grid.Column="2" Text="{Binding DepartureTime}" /><TextBlock Grid.Column="3" Text="{Binding Destination}" /><TextBlock Grid.Column="4" Text="{Binding Gate}" /><TextBlock Grid.Column="4" Text="&#xE785;" FontFamily="Segoe Fluent Icons" HorizontalAlignment="Right" Foreground="#1372B4" /></Grid></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Background="#F9F9F9" BorderBrush="#939393" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="83" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid Margin="10,7"><Grid.RowDefinitions><RowDefinition Height="31" /><RowDefinition /></Grid.RowDefinitions>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="75" /><ColumnDefinition Width="70" /><ColumnDefinition Width="75" /><ColumnDefinition Width="70" /><ColumnDefinition Width="80" /><ColumnDefinition Width="70" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Operations.FlightNumber}" FontSize="18" FontWeight="Bold" /><TextBlock Grid.Column="1" Text="{Binding Operations.FlightDateShort}" FontWeight="SemiBold" /><TextBlock Grid.Column="2" Text="{Binding Operations.OriginIata}" FontWeight="SemiBold" /><TextBlock Grid.Column="3" Text="STD" /><TextBlock Grid.Column="4" Text="{Binding Operations.ScheduledDeparture}" FontWeight="Bold" /><TextBlock Grid.Column="5" Text="ETD" /><TextBlock Grid.Column="6" Text="{Binding Operations.ScheduledDeparture}" FontWeight="Bold" /><TextBlock Grid.Column="7" Text="{Binding Operations.DestinationIata, StringFormat=DEST  {0}}" HorizontalAlignment="Right" FontWeight="Bold" />
                            </Grid>
                            <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="180" /><ColumnDefinition Width="170" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="{Binding Operations.AircraftName}" /><TextBlock Text="{Binding Operations.DetectedAircraftIcao}" FontWeight="SemiBold" /></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock><Run Text="Status:  " /><Run Text="{Binding StatusLabel, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock><TextBlock><Run Text="Boarding:  " /><Run Text="{Binding Operations.BoardingBeginsAt, Mode=OneWay}" /></TextBlock><TextBlock><Run Text="Gate:  " /><Run Text="{Binding Operations.GateNumber, Mode=OneWay}" FontWeight="Bold" /></TextBlock></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock><Run Text="Checked-In:  " /><Run Text="{Binding Operations.CheckedInPassengers, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock><TextBlock><Run Text="Booked:  " /><Run Text="{Binding Operations.TotalPassengers, Mode=OneWay}" /></TextBlock><TextBlock><Run Text="Available:  " /><Run Text="{Binding StandbyPassengers, Mode=OneWay}" /></TextBlock></StackPanel>
                                <TextBlock Grid.Column="3" Text="{Binding WbStatusLabel}" Foreground="#D60000" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Grid>

                        <Grid Grid.Row="1" Margin="8,0,8,8">
                            <Grid Visibility="{Binding ActiveModule, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Check-In}">
                                <Grid.RowDefinitions><RowDefinition Height="76" /><RowDefinition Height="28" /><RowDefinition /></Grid.RowDefinitions>
                                <Border Style="{StaticResource IportSection}"><Grid><Grid.RowDefinitions><RowDefinition Height="22" /><RowDefinition /></Grid.RowDefinitions><TextBlock Text="Swipe Passport, National ID Card, Frequent Flyer Card or enter the following:" Foreground="#1AACC5" FontWeight="SemiBold" /><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="145" /><ColumnDefinition /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions><TextBlock Text="Passenger name / seat / bag" VerticalAlignment="Center" /><TextBox Grid.Column="1" Text="{Binding PassengerLookup, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource IportInput}" /><Button Grid.Column="2" Content="Find" Command="{Binding FindPassengerCommand}" Style="{StaticResource IportButton}" Margin="5,0,0,0" /></Grid></Grid></Border>
                                <Border Grid.Row="1" Background="#D5D5D5" BorderBrush="#9D9D9D" BorderThickness="1,0,1,1"><Grid Margin="7,0"><Grid.ColumnDefinitions><ColumnDefinition Width="45" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="90" /><ColumnDefinition Width="80" /><ColumnDefinition Width="62" /><ColumnDefinition Width="80" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions><TextBlock Text="PAX" FontWeight="Bold" /><TextBlock Grid.Column="1" Text="Passenger Name" FontWeight="Bold" /><TextBlock Grid.Column="2" Text="Booking" FontWeight="Bold" /><TextBlock Grid.Column="3" Text="Class" FontWeight="Bold" /><TextBlock Grid.Column="4" Text="Seat" FontWeight="Bold" /><TextBlock Grid.Column="5" Text="Bags" FontWeight="Bold" /><TextBlock Grid.Column="6" Text="Status" FontWeight="Bold" /></Grid></Border>
                                <ListBox Grid.Row="2" ItemsSource="{Binding Operations.VisiblePassengers}" SelectedItem="{Binding SelectedPassenger, Mode=OneWay}" Background="White" BorderBrush="#A0A0A0" BorderThickness="1,0,1,1" VirtualizingPanel.IsVirtualizing="True"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Button Command="{Binding DataContext.SelectPassengerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" Foreground="#252525" BorderBrush="#D4D4D4" BorderThickness="0,0,0,1" HorizontalContentAlignment="Stretch" Padding="6,5"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="45" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="90" /><ColumnDefinition Width="80" /><ColumnDefinition Width="62" /><ColumnDefinition Width="80" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions><TextBlock Text="{Binding PassengerNumber}" Foreground="#252525" /><TextBlock Grid.Column="1" Text="{Binding FullName}" Foreground="#252525" FontWeight="SemiBold" /><TextBlock Grid.Column="2" Text="{Binding BookingReference}" Foreground="#252525" /><TextBlock Grid.Column="3" Text="{Binding CabinCode}" Foreground="#252525" /><TextBlock Grid.Column="4" Text="{Binding SeatNumber}" Foreground="#252525" FontWeight="Bold" /><TextBlock Grid.Column="5" Text="{Binding CheckedBags}" Foreground="#252525" /><TextBlock Grid.Column="6" Text="{Binding CheckInLabel}" Foreground="{Binding CheckInColor}" FontWeight="SemiBold" /></Grid></Button></DataTemplate></ListBox.ItemTemplate></ListBox>
                            </Grid>

                            <Grid Visibility="{Binding ActiveModule, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Boarding}">
                                <Grid.RowDefinitions><RowDefinition Height="112" /><RowDefinition Height="42" /><RowDefinition Height="76" /><RowDefinition /></Grid.RowDefinitions>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><Border BorderBrush="#E00000" BorderThickness="4" CornerRadius="15" Margin="20,8"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="Not boarded" Foreground="#D00000" FontSize="14" /><TextBlock Text="{Binding NotBoardedPassengers}" Foreground="#D00000" FontSize="42" /></StackPanel></Border><Border Grid.Column="1" BorderBrush="#008D00" BorderThickness="4" CornerRadius="15" Margin="20,8"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="Boarded" Foreground="#008D00" FontSize="14" /><TextBlock Text="{Binding Operations.BoardedPassengers}" Foreground="#008D00" FontSize="42" /></StackPanel></Border></Grid>
                                <Border Grid.Row="1" Style="{StaticResource IportSectionHeader}"><TextBlock Text="Quick scan boarding" Foreground="White" FontWeight="Bold" /></Border>
                                <Border Grid.Row="2" Style="{StaticResource IportSection}" Padding="8"><Grid><Grid.RowDefinitions><RowDefinition Height="22" /><RowDefinition /></Grid.RowDefinitions><TextBlock Text="Manual boarding" FontWeight="Bold" /><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions><TextBlock Text="Boarding number / Seat" VerticalAlignment="Center" /><TextBox Grid.Column="1" Text="{Binding ManualBoardingInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource IportInput}" /><Button Grid.Column="2" Content="Board" Command="{Binding ManualBoardCommand}" Style="{StaticResource IportButton}" Margin="6,0,0,0" /></Grid></Grid></Border>
                                <ListBox Grid.Row="3" ItemsSource="{Binding Operations.VisiblePassengers}" Background="White" BorderBrush="#A2A2A2" BorderThickness="1" VirtualizingPanel.IsVirtualizing="True"><ListBox.ItemTemplate><DataTemplate><Button Command="{Binding DataContext.SelectPassengerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" Foreground="#252525" BorderThickness="0,0,0,1" BorderBrush="#D7D7D7" Padding="6" HorizontalContentAlignment="Stretch"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="95" /><ColumnDefinition /><ColumnDefinition Width="70" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions><TextBlock Text="{Binding PassengerNumber}" Foreground="#252525" /><TextBlock Grid.Column="1" Text="{Binding FullName}" Foreground="#252525" /><TextBlock Grid.Column="2" Text="{Binding SeatNumber}" Foreground="#252525" FontWeight="Bold" /><TextBlock Grid.Column="3" Text="{Binding BoardingLabel}" Foreground="{Binding BoardingColor}" FontWeight="SemiBold" /></Grid></Button></DataTemplate></ListBox.ItemTemplate></ListBox>
                            </Grid>

                            <Grid Visibility="{Binding ActiveModule, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Seatmap}">
                                <Grid.RowDefinitions><RowDefinition Height="54" /><RowDefinition /></Grid.RowDefinitions>
                                <Border Style="{StaticResource IportSection}"><Grid><TextBlock Text="Graphical seatmap — select a seat to focus its passenger" FontSize="16" FontWeight="SemiBold" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="Checked-in " /><TextBlock Text="{Binding Operations.CheckedInPassengers}" FontWeight="Bold" /><TextBlock Text="   Boarded " Margin="12,0,0,0" /><TextBlock Text="{Binding Operations.BoardedPassengers}" FontWeight="Bold" /></StackPanel></Grid></Border>
                                <ScrollViewer Grid.Row="1" Background="#FFFFFF" BorderBrush="#9E9E9E" BorderThickness="1" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Operations.PassengerRecords}" Margin="12"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel IsItemsHost="True" ItemWidth="54" ItemHeight="42" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Width="48" Height="35" Margin="2" Command="{Binding DataContext.SelectPassengerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="{Binding BoardingColor}" BorderBrush="#707070" Foreground="White" FontWeight="Bold" ToolTip="{Binding FullName}"><TextBlock Text="{Binding SeatNumber}" /></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                            </Grid>

                            <Grid Visibility="{Binding ActiveModule, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Load Control}">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <Grid><Grid.RowDefinitions><RowDefinition Height="34" /><RowDefinition Height="*" /><RowDefinition Height="128" /></Grid.RowDefinitions><Border Style="{StaticResource IportSectionHeader}"><TextBlock Text="Dry Operating Weight" Foreground="White" FontWeight="Bold" /></Border><Border Grid.Row="1" Style="{StaticResource IportSection}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Crew" /><TextBlock Text="DOW" Margin="0,18,0,0" /><TextBlock Text="+ Traffic Load" Margin="0,15,0,0" /><Separator Margin="0,12" /><TextBlock Text="ZFW" FontWeight="Bold" /><TextBlock Text="+ Take Off Fuel" Margin="0,18,0,0" /><Separator Margin="0,12" /><TextBlock Text="TOW" FontWeight="Bold" /></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="4 / 12" /><TextBlock Text="{Binding DryOperatingWeightKg, StringFormat={}{0:N0} kg}" Margin="0,18,0,0" /><TextBlock Text="{Binding TrafficLoadKg, StringFormat={}{0:N0} kg}" Margin="0,15,0,0" /><Separator Margin="0,12" /><TextBlock Text="{Binding ZeroFuelWeightKg, StringFormat={}{0:N0} kg}" FontWeight="Bold" /><TextBlock Text="{Binding TakeoffFuelKg, StringFormat={}{0:N0} kg}" Margin="0,18,0,0" /><Separator Margin="0,12" /><TextBlock Text="{Binding TakeoffWeightKg, StringFormat={}{0:N0} kg}" FontWeight="Bold" /></StackPanel></Grid></Border><Border Grid.Row="2" Style="{StaticResource IportSection}" Margin="0,8,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Passenger" FontWeight="Bold" /><TextBlock Text="Actual distribution" Margin="0,8,0,0" /><TextBlock Text="Actual counts" /></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="{Binding LoadFactorLabel}" FontWeight="Bold" /><TextBlock Text="{Binding BoardingCounterSummary}" Margin="0,8,0,0" /><TextBlock Text="{Binding Operations.CheckedInPassengers, StringFormat=Total {0}}" /></StackPanel></Grid></Border></Grid>
                                <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="34" /><RowDefinition Height="*" /><RowDefinition Height="128" /></Grid.RowDefinitions><Border Style="{StaticResource IportSectionHeader}"><TextBlock Text="Envelope" Foreground="White" FontWeight="Bold" /></Border><Border Grid.Row="1" Style="{StaticResource IportSection}"><Grid><Canvas Margin="30,20,20,35" Background="#FAFAFA"><Line X1="0" Y1="230" X2="430" Y2="230" Stroke="#404040" /><Line X1="0" Y1="0" X2="0" Y2="230" Stroke="#404040" /><Polyline Points="10,210 80,75 245,30 410,95 360,210 10,210" Stroke="#C8A619" Fill="#18E2C64E" StrokeThickness="2" /><Polyline Points="10,210 150,130 330,165 360,210" Stroke="#288C32" StrokeThickness="2" /><Line X1="215" Y1="10" X2="215" Y2="225" Stroke="#26B4D0" StrokeDashArray="3,3" /><Ellipse Canvas.Left="208" Canvas.Top="153" Width="14" Height="14" Fill="#F2A000" Stroke="#7A4B00" /><TextBlock Canvas.Left="180" Canvas.Top="235" Text="% MAC" /><TextBlock Canvas.Left="-23" Canvas.Top="95" Text="Weight" RenderTransformOrigin="0.5,0.5"><TextBlock.RenderTransform><RotateTransform Angle="-90" /></TextBlock.RenderTransform></TextBlock></Canvas></Grid></Border><Border Grid.Row="2" Style="{StaticResource IportSection}" Margin="0,8,0,0"><StackPanel><TextBlock Text="Options" FontWeight="Bold" /><TextBlock Text="NOTOC needed:  No" Margin="0,11,0,0" /><TextBlock Text="Flight variation:  BA standard" /><TextBlock Text="Pax weights:  84 / 18 kg" /></StackPanel></Border></Grid>
                            </Grid>

                            <Grid Visibility="{Binding ActiveModule, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Flight Monitor}">
                                <Grid.RowDefinitions><RowDefinition Height="132" /><RowDefinition Height="30" /><RowDefinition /></Grid.RowDefinitions>
                                <Border Style="{StaticResource IportSection}"><Grid><TextBlock Text="{Binding Operations.FlightNumber, StringFormat=Monitoring {0}}" Foreground="#17AFC8" FontWeight="Bold" FontSize="15" VerticalAlignment="Top" /><Canvas Margin="16,36,16,12" Background="#F9F9F9"><Line X1="0" Y1="44" X2="760" Y2="44" Stroke="#202020" StrokeThickness="2" /><Line X1="0" Y1="28" X2="520" Y2="28" Stroke="#18AFC7" StrokeThickness="18" /><Line X1="520" Y1="17" X2="520" Y2="58" Stroke="#D90000" StrokeThickness="2" /><Line X1="610" Y1="21" X2="610" Y2="60" Stroke="#009645" StrokeThickness="4" /><TextBlock Canvas.Left="0" Canvas.Top="5" Text="-48h" /><TextBlock Canvas.Left="190" Canvas.Top="5" Text="-24h" /><TextBlock Canvas.Left="385" Canvas.Top="5" Text="-6h" /><TextBlock Canvas.Left="506" Canvas.Top="2" Text="STD" FontWeight="Bold" /><TextBlock Canvas.Left="595" Canvas.Top="2" Text="NOW" Foreground="#008A40" FontWeight="Bold" /></Canvas></Grid></Border>
                                <Border Grid.Row="1" Background="#D5D5D5" BorderBrush="#9D9D9D" BorderThickness="1,0"><Grid Margin="7,0"><Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="74" /><ColumnDefinition /><ColumnDefinition Width="75" /><ColumnDefinition Width="150" /><ColumnDefinition Width="75" /></Grid.ColumnDefinitions><TextBlock Text="Date" FontWeight="Bold" /><TextBlock Grid.Column="1" Text="Time" FontWeight="Bold" /><TextBlock Grid.Column="2" Text="Monitoring Event" FontWeight="Bold" /><TextBlock Grid.Column="3" Text="Status" FontWeight="Bold" /><TextBlock Grid.Column="4" Text="Agent" FontWeight="Bold" /><TextBlock Grid.Column="5" Text="Remark" FontWeight="Bold" /></Grid></Border>
                                <ListBox Grid.Row="2" ItemsSource="{Binding MonitorEvents}" Background="White" BorderBrush="#9D9D9D" BorderThickness="1,0,1,1"><ListBox.ItemTemplate><DataTemplate><Grid Margin="6,4" TextElement.Foreground="#252525"><Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="74" /><ColumnDefinition /><ColumnDefinition Width="75" /><ColumnDefinition Width="150" /><ColumnDefinition Width="75" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Date}" Foreground="#252525" /><TextBlock Grid.Column="1" Text="{Binding Time}" Foreground="#252525" /><TextBlock Grid.Column="2" Text="{Binding Event}" Foreground="#252525" /><TextBlock Grid.Column="3" Text="●" Foreground="#249A34" FontWeight="Bold" /><TextBlock Grid.Column="4" Text="{Binding Agent}" Foreground="#252525" /><TextBlock Grid.Column="5" Text="{Binding Status}" Foreground="#252525" /></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2" Background="{StaticResource IportBarBrush}" BorderBrush="#9A9A9A" BorderThickness="0,1,0,0">
                <Grid Margin="10,5"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="420" /><ColumnDefinition Width="250" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal"><Button Content="F1-Help" Style="{StaticResource IportButton}" MinWidth="82" /><Button Content="F2-Action" Style="{StaticResource IportButton}" MinWidth="92" Margin="4,0,0,0" Command="{Binding ToggleGateCommand}" /><Button Content="F4-Seatmap" Style="{StaticResource IportButton}" MinWidth="100" Margin="4,0,0,0" Command="{Binding SelectModuleCommand}" CommandParameter="Seatmap" /><Button Content="F5-Refresh" Style="{StaticResource IportButton}" MinWidth="95" Margin="4,0,0,0" Command="{Binding RefreshCommand}" /><Button Content="F10-Check In" Style="{StaticResource IportButton}" MinWidth="105" Margin="4,0,0,0" Command="{Binding CheckInCommand}" /><Button Content="F11-Print BP" Style="{StaticResource IportButton}" MinWidth="105" Margin="4,0,0,0" Command="{Binding PrintCommand}" /></StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding CommandStatus}" Foreground="#444444" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding CommandStatus}" />
                    <Grid Grid.Column="2"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="iPort Version  6.2.7" FontWeight="SemiBold" /><TextBlock Text="{Binding SignedInUser, StringFormat=User  {0}}" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding BoardingPointLabel, StringFormat=Boarding Point  {0}}" /><TextBlock Text="Domain  FREEFLIGHT +" /></StackPanel></Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
