<UserControl x:Class="FreeFlight.CabinControl.App.Views.IportDcsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackgroundBrush}">
    <UserControl.Resources>
        <Style x:Key="WorkspaceCard" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style x:Key="WorkspaceLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <Style x:Key="WorkspaceValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="27" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style x:Key="WorkspaceInput" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,8" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style x:Key="WorkspaceTab" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,17,16,14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe Fluent Icons" FontSize="15" Margin="0,0,8,0" />
                                <ContentPresenter />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WorkspaceRow" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" /></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#290B73B9" /></Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Tag="IportDcsWorkspace" Background="{DynamicResource AppBackgroundBrush}">
    <Grid ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="26,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" Background="{DynamicResource PrimaryBrush}" CornerRadius="17" Margin="0,0,10,0">
                        <TextBlock Text="i" Foreground="White" FontFamily="Georgia" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="iGATE" FontWeight="SemiBold" FontSize="17" />
                        <TextBlock Text="OPERATIONS" Style="{StaticResource WorkspaceLabel}" FontSize="8" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Operations.FlightNumber}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Operations.RouteSummary}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="More tools" Command="{Binding ToggleServiceMenuCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,9,0" />
                    <Border Style="{StaticResource SuccessPillStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <StackPanel>
                                <TextBlock Text="WEBSITE FLIGHT" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource SuccessTextBrush}" />
                                <TextBlock Text="{Binding Operations.SimBriefConnectionLabel}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="18,0">
                <RadioButton GroupName="Workspace" Style="{StaticResource WorkspaceTab}" Tag="&#xE77B;" Content="Check-in" IsChecked="{Binding ActiveModule, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Check-In, Mode=OneWay}" Command="{Binding SelectModuleCommand}" CommandParameter="Check-In" />
                <RadioButton GroupName="Workspace" Style="{StaticResource WorkspaceTab}" Tag="&#xE8A5;" Content="Boarding" IsChecked="{Binding ActiveModule, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Boarding, Mode=OneWay}" Command="{Binding SelectModuleCommand}" CommandParameter="Boarding" />
                <RadioButton GroupName="Workspace" Style="{StaticResource WorkspaceTab}" Tag="&#xE9D9;" Content="Load &amp; trim" IsChecked="{Binding ActiveModule, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Load Control, Mode=OneWay}" Command="{Binding SelectModuleCommand}" CommandParameter="Load Control" />
                <RadioButton GroupName="Workspace" Style="{StaticResource WorkspaceTab}" Tag="&#xE9D2;" Content="Flight monitor" IsChecked="{Binding ActiveModule, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Flight Monitor, Mode=OneWay}" Command="{Binding SelectModuleCommand}" CommandParameter="Flight Monitor" />
                <Button Content="Refresh flight" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="20,9,0,9" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="26,22,26,26">
                <Grid Visibility="{Binding ActiveModule, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Check-In}">
                    <Grid.RowDefinitions><RowDefinition Height="132" /><RowDefinition Height="18" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Style="{StaticResource HeroPanelStyle}" Padding="24">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="PASSENGER OPERATIONS" Foreground="#B9DBF1" FontSize="10" FontWeight="SemiBold" />
                                <TextBlock Text="Ready to welcome your passengers" Foreground="White" FontFamily="Georgia" FontSize="27" Margin="0,5,0,0" />
                                <TextBlock Text="Every action is recorded against the flight selected on the pilot website." Foreground="#D2E7F5" FontSize="12" Margin="0,7,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="28,0,0,0" VerticalAlignment="Center"><TextBlock Text="GATE" Foreground="#B9DBF1" FontSize="10" FontWeight="SemiBold" /><TextBlock Text="{Binding Operations.GateNumber}" Foreground="White" FontSize="28" FontWeight="SemiBold" /></StackPanel>
                            <StackPanel Grid.Column="2" Margin="28,0,0,0" VerticalAlignment="Center"><TextBlock Text="BOARDING" Foreground="#B9DBF1" FontSize="10" FontWeight="SemiBold" /><TextBlock Text="{Binding Operations.BoardingBeginsAt}" Foreground="White" FontSize="21" FontWeight="SemiBold" /></StackPanel>
                            <StackPanel Grid.Column="3" Margin="28,0,0,0" VerticalAlignment="Center"><TextBlock Text="STATUS" Foreground="#B9DBF1" FontSize="10" FontWeight="SemiBold" /><TextBlock Text="{Binding StatusLabel}" Foreground="#87E7BD" FontSize="13" FontWeight="SemiBold" MaxWidth="130" TextWrapping="Wrap" /></StackPanel>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.9*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource WorkspaceCard}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="24" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Grid>
                                    <StackPanel><TextBlock Text="PASSENGER LIST" Style="{StaticResource WorkspaceLabel}" /><TextBlock Text="Find and prepare passengers" FontFamily="Georgia" FontSize="23" Margin="0,4,0,0" /></StackPanel>
                                    <TextBlock Text="{Binding Operations.TotalPassengers, StringFormat={}{0} RECORDS}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" FontSize="11" />
                                </Grid>
                                <Grid Grid.Row="1" Margin="0,16,0,12"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="112" /></Grid.ColumnDefinitions><TextBox Text="{Binding PassengerLookup, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WorkspaceInput}" VerticalContentAlignment="Center" ToolTip="Passenger, booking, seat or bag" /><Button Grid.Column="1" Content="Find" Command="{Binding FindPassengerCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0" VerticalAlignment="Stretch" /></Grid>
                                <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="75" /><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /><ColumnDefinition Width="70" /><ColumnDefinition Width="68" /><ColumnDefinition Width="84" /></Grid.ColumnDefinitions><TextBlock Text="PAX" Style="{StaticResource WorkspaceLabel}" /><TextBlock Grid.Column="1" Text="PASSENGER" Style="{StaticResource WorkspaceLabel}" /><TextBlock Grid.Column="2" Text="CABIN" Style="{StaticResource WorkspaceLabel}" /><TextBlock Grid.Column="3" Text="SEAT" Style="{StaticResource WorkspaceLabel}" /><TextBlock Grid.Column="4" Text="BAGS" Style="{StaticResource WorkspaceLabel}" /><TextBlock Grid.Column="5" Text="STATUS" Style="{StaticResource WorkspaceLabel}" /></Grid>
                                <ListBox Grid.Row="3" ItemsSource="{Binding Operations.VisiblePassengers}" SelectedItem="{Binding SelectedPassenger}" ItemContainerStyle="{StaticResource WorkspaceRow}" BorderThickness="0" Background="Transparent" Margin="0,7,0,0"><ListBox.ItemTemplate><DataTemplate><Grid Margin="8,10"><Grid.ColumnDefinitions><ColumnDefinition Width="67" /><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /><ColumnDefinition Width="70" /><ColumnDefinition Width="68" /><ColumnDefinition Width="84" /></Grid.ColumnDefinitions><TextBlock Text="{Binding PassengerNumber}" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Grid.Column="1" Text="{Binding FullName}" FontWeight="SemiBold" /><TextBlock Grid.Column="2" Text="{Binding CabinCode}" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Grid.Column="3" Text="{Binding SeatNumber}" FontWeight="SemiBold" /><TextBlock Grid.Column="4" Text="{Binding CheckedBags}" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Grid.Column="5" Text="{Binding CheckInLabel}" Foreground="{Binding CheckInColor}" FontWeight="SemiBold" /></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
                                <TextBlock Grid.Row="3" Text="{Binding Operations.PassengerListStatus}" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380" IsHitTestVisible="False" Visibility="{Binding Operations.IsPassengerListEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="2">
                            <Border Style="{StaticResource WorkspaceCard}" Margin="0,0,0,14"><StackPanel><TextBlock Text="FLIGHT PROGRESS" Style="{StaticResource WorkspaceLabel}" /><TextBlock Text="{Binding Operations.FlightNumber}" FontFamily="Georgia" FontSize="22" Margin="0,5,0,12" /><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="CHECKED IN" Style="{StaticResource WorkspaceLabel}" /><TextBlock Text="{Binding Operations.CheckedInPassengers}" Style="{StaticResource WorkspaceValue}" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="BOARDED" Style="{StaticResource WorkspaceLabel}" /><TextBlock Text="{Binding Operations.BoardedPassengers}" Style="{StaticResource WorkspaceValue}" /></StackPanel></Grid><ProgressBar Minimum="0" Maximum="{Binding Operations.TotalPassengers, Mode=OneWay}" Value="{Binding Operations.CheckedInPassengers, Mode=OneWay}" Height="7" Margin="0,14,0,8" Foreground="{DynamicResource PrimaryBrush}" Background="{DynamicResource SurfaceRaisedBrush}" /><TextBlock Text="{Binding Operations.BoardingStatusLabel}" Foreground="{Binding Operations.BoardingStatusColor}" FontSize="11" FontWeight="SemiBold" /></StackPanel></Border>
                            <Border Style="{StaticResource WorkspaceCard}"><StackPanel><TextBlock Text="SELECTED PASSENGER" Style="{StaticResource WorkspaceLabel}" /><TextBlock Text="{Binding SelectedPassenger.FullName, TargetNullValue=Choose a passenger}" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,4" /><TextBlock Text="Choose a record, then check in or print the boarding pass." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,12" /><Button Content="Check in" Command="{Binding CheckInCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,8" /><Button Content="Print boarding pass" Command="{Binding PrintCommand}" Style="{StaticResource SecondaryButtonStyle}" /></StackPanel></Border>
                        </StackPanel>
                    </Grid>
                </Grid>

                <Grid Visibility="{Binding ActiveModule, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Boarding}">
                    <Grid.RowDefinitions><RowDefinition Height="132" /><RowDefinition Height="18" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Style="{StaticResource HeroPanelStyle}" Padding="24"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="BOARDING CONTROL" Foreground="#B9DBF1" FontSize="10" FontWeight="SemiBold" /><TextBlock Text="Bring the cabin on board" Foreground="White" FontFamily="Georgia" FontSize="28" Margin="0,5,0,0" /><TextBlock Text="Boarding state stays synchronised with Ember's live cabin engine." Foreground="#D2E7F5" FontSize="12" Margin="0,7,0,0" /></StackPanel><Button Grid.Column="1" Content="{Binding Operations.GateActionLabel}" Command="{Binding ToggleGateCommand}" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Center" /></Grid></Border>
                    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource WorkspaceCard}"><StackPanel><TextBlock Text="READY TO BOARD" Style="{StaticResource WorkspaceLabel}" /><TextBlock Text="{Binding NotBoardedPassengers}" Style="{StaticResource WorkspaceValue}" Margin="0,5,0,0" /><TextBlock Text="Passengers still at the gate" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" /></StackPanel></Border>
                        <Border Grid.Column="2" Style="{StaticResource WorkspaceCard}"><StackPanel><TextBlock Text="ON BOARD" Style="{StaticResource WorkspaceLabel}" /><TextBlock Text="{Binding Operations.BoardedPassengers}" Style="{StaticResource WorkspaceValue}" Margin="0,5,0,0" /><TextBlock Text="Awaiting cabin completion" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" /></StackPanel></Border>
                        <Border Grid.Column="4" Style="{StaticResource WorkspaceCard}"><StackPanel><TextBlock Text="BAG RECONCILIATION" Style="{StaticResource WorkspaceLabel}" /><TextBlock Text="{Binding Operations.BaggageReconciliationLabel}" Foreground="{Binding Operations.BaggageReconciliationColor}" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0" /><TextBlock Text="The final load sheet checks actual bags and passenger status." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,7,0,0" /></StackPanel></Border>
                    </Grid>
                    <Border Grid.Row="2" Style="{StaticResource WorkspaceCard}" Margin="0,140,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="MANUAL BOARDING" Style="{StaticResource WorkspaceLabel}" /><TextBlock Text="Find a passenger by name, reference, number or seat, then board them." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,5,0,0" /></StackPanel><TextBox Grid.Column="1" Text="{Binding ManualBoardingInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WorkspaceInput}" Margin="12,0" VerticalAlignment="Center" /><Button Grid.Column="2" Content="Board passenger" Command="{Binding ManualBoardCommand}" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Center" /></Grid></Border>
                </Grid>

                <Grid Tag="IportLoadControlWorkspace" Visibility="{Binding ActiveModule, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Load Control}">
                    <Grid.RowDefinitions><RowDefinition Height="150" /><RowDefinition Height="18" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Style="{StaticResource HeroPanelStyle}" Padding="24">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="270" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="iGATE LOAD &amp; TRIM" Foreground="#B9DBF1" FontSize="10" FontWeight="SemiBold" />
                                <TextBlock Text="Final aircraft weight, made clear" Foreground="White" FontFamily="Georgia" FontSize="28" Margin="0,5,0,0" />
                                <TextBlock Text="Combines the selected aircraft, actual passenger and bag load, and live fuel figures."
                                           Foreground="#D2E7F5" FontSize="12" Margin="0,7,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="#2500162B" BorderBrush="#48FFFFFF" BorderThickness="1" CornerRadius="10" Padding="16" VerticalAlignment="Center">
                                <StackPanel>
                                    <TextBlock Text="FINAL AIRCRAFT WEIGHT" Foreground="#C9EDFF" FontSize="10" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding FinalAircraftWeightKg, StringFormat={}{0:N0} kg}" Foreground="White" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,0" />
                                    <TextBlock Text="{Binding FinalAircraftWeightLabel}" Foreground="{Binding FinalAircraftWeightStatusColor}" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <Border Style="{StaticResource WorkspaceCard}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="WEIGHT SUMMARY" Style="{StaticResource WorkspaceLabel}" />
                                    <TextBlock Text="Live aircraft weights" FontFamily="Georgia" FontSize="23" Margin="0,5,0,14" />
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ZERO FUEL" Style="{StaticResource WorkspaceLabel}" /><TextBlock Text="{Binding ZeroFuelWeightKg, StringFormat={}{0:N0} kg}" Style="{StaticResource WorkspaceValue}" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="FINAL TAKE-OFF" Style="{StaticResource WorkspaceLabel}" /><TextBlock Text="{Binding FinalAircraftWeightKg, StringFormat={}{0:N0} kg}" Style="{StaticResource WorkspaceValue}" /></StackPanel></Grid>
                                    <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="LANDING" Style="{StaticResource WorkspaceLabel}" /><TextBlock Text="{Binding LandingWeightKg, StringFormat={}{0:N0} kg}" FontSize="19" FontWeight="SemiBold" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="TRAFFIC LOAD" Style="{StaticResource WorkspaceLabel}" /><TextBlock Text="{Binding TrafficLoadKg, StringFormat={}{0:N0} kg}" FontSize="19" FontWeight="SemiBold" /></StackPanel></Grid>
                                    <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="8" Padding="12" Margin="0,20,0,0"><StackPanel><TextBlock Text="{Binding WbStatusLabel}" Foreground="{Binding WbStatusColor}" FontWeight="SemiBold" /><TextBlock Text="{Binding BaggageLoadLabel}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0" /></StackPanel></Border>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource WorkspaceCard}">
                                <StackPanel>
                                    <TextBlock Text="AIRCRAFT LOADING ASSUMPTIONS" Style="{StaticResource WorkspaceLabel}" />
                                    <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="DRY OPERATING" Style="{StaticResource WorkspaceLabel}" /><TextBox Text="{Binding DryOperatingWeightKg, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WorkspaceInput}" Margin="0,5,8,0" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="DRY INDEX" Style="{StaticResource WorkspaceLabel}" /><TextBox Text="{Binding DryOperatingIndex, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WorkspaceInput}" Margin="0,5,8,0" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="AUTHOR. EXTRA LOAD" Style="{StaticResource WorkspaceLabel}" /><TextBox Text="{Binding AdditionalWeightKg, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WorkspaceInput}" Margin="0,5,0,0" /></StackPanel></Grid>
                                    <TextBlock Text="These controlled assumptions recalculate the final aircraft weight immediately and are carried with this flight workspace." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Border Style="{StaticResource WorkspaceCard}" Margin="0,0,0,14"><StackPanel><TextBlock Text="FUEL" Style="{StaticResource WorkspaceLabel}" /><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="TAKE-OFF" Style="{StaticResource WorkspaceLabel}" /><TextBox Text="{Binding TakeoffFuelKg, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WorkspaceInput}" Margin="0,5,8,0" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="TAXI" Style="{StaticResource WorkspaceLabel}" /><TextBox Text="{Binding TaxiFuelKg, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WorkspaceInput}" Margin="0,5,8,0" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="TRIP" Style="{StaticResource WorkspaceLabel}" /><TextBox Text="{Binding TripFuelKg, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WorkspaceInput}" Margin="0,5,0,0" /></StackPanel></Grid></StackPanel></Border>
                            <Border Style="{StaticResource WorkspaceCard}"><StackPanel><TextBlock Text="FINAL LOAD SHEET" Style="{StaticResource WorkspaceLabel}" /><TextBlock Text="{Binding LoadSheetReadinessLabel}" Foreground="{Binding LoadSheetReadinessColor}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,7,0,6" /><TextBlock Text="Finalising protects the live passenger-and-baggage figures used for this weight calculation." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,13" /><Button Content="Finalize load sheet" Command="{Binding FinalizeLoadSheetCommand}" IsEnabled="{Binding CanFinalizeLoadSheet}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,8" /><Button Content="Export final load plan" Command="{Binding ExportFinalLoadPlanCommand}" IsEnabled="{Binding IsLoadSheetFinalized}" Style="{StaticResource SecondaryButtonStyle}" /></StackPanel></Border>
                        </StackPanel>
                    </Grid>
                </Grid>

                <Grid Visibility="{Binding ActiveModule, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Flight Monitor}">
                    <Grid.RowDefinitions><RowDefinition Height="132" /><RowDefinition Height="18" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Style="{StaticResource HeroPanelStyle}" Padding="24"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="FLIGHT MONITOR" Foreground="#B9DBF1" FontSize="10" FontWeight="SemiBold" /><TextBlock Text="A single operational picture" Foreground="White" FontFamily="Georgia" FontSize="28" Margin="0,5,0,0" /><TextBlock Text="Monitor the service selected on the pilot website through the active ACARS session." Foreground="#D2E7F5" FontSize="12" Margin="0,7,0,0" /></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding CurrentClock}" Foreground="White" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Right" /><TextBlock Text="LOCAL OPERATIONS TIME" Foreground="#B9DBF1" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right" /></StackPanel></Grid></Border>
                    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource WorkspaceCard}"><StackPanel><TextBlock Text="FLIGHT STATUS" Style="{StaticResource WorkspaceLabel}" /><TextBlock Text="{Binding Operations.FlightNumber}" FontFamily="Georgia" FontSize="25" Margin="0,5,0,4" /><TextBlock Text="{Binding Operations.RouteSummary}" Foreground="{DynamicResource TextSecondaryBrush}" /><Grid Margin="0,24,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="GATE" Style="{StaticResource WorkspaceLabel}" /><TextBlock Text="{Binding Operations.GateNumber}" Style="{StaticResource WorkspaceValue}" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="SCHEDULED" Style="{StaticResource WorkspaceLabel}" /><TextBlock Text="{Binding Operations.ScheduledDeparture}" Style="{StaticResource WorkspaceValue}" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="AIRCRAFT" Style="{StaticResource WorkspaceLabel}" /><TextBlock Text="{Binding Operations.DetectedAircraftIcao}" FontSize="22" FontWeight="SemiBold" /></StackPanel></Grid></StackPanel></Border>
                        <Border Grid.Column="2" Style="{StaticResource WorkspaceCard}"><StackPanel><TextBlock Text="OPERATIONS TIMELINE" Style="{StaticResource WorkspaceLabel}" /><TextBlock Text="{Binding Operations.TimelinePhaseLabel}" Foreground="{Binding Operations.TimelinePhaseColor}" FontSize="18" FontWeight="SemiBold" Margin="0,7,0,12" /><ItemsControl ItemsSource="{Binding MonitorEvents}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Ellipse Width="8" Height="8" Fill="{Binding Color}" VerticalAlignment="Top" Margin="0,4,0,0" /><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" /><TextBlock Text="{Binding Detail}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" /></StackPanel></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                    </Grid>
                </Grid>

                <Grid Visibility="{Binding IsLoadControlPlaceholder, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border Style="{StaticResource WorkspaceCard}" MaxWidth="620" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,70,0,0">
                        <StackPanel>
                            <TextBlock Text="iGATE LOAD CONTROL" Style="{StaticResource WorkspaceLabel}" />
                            <TextBlock Text="{Binding PlaceholderTitle}" FontFamily="Georgia" FontSize="28" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding PlaceholderDescription}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,10,0,18" />
                            <Button Content="Return to load &amp; trim" Command="{Binding SelectModuleCommand}" CommandParameter="Load Control" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Visibility="{Binding IsServicePlaceholder, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border Style="{StaticResource WorkspaceCard}" MaxWidth="620" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,70,0,0">
                        <StackPanel>
                            <TextBlock Text="iGATE SERVICE" Style="{StaticResource WorkspaceLabel}" />
                            <TextBlock Text="{Binding PlaceholderTitle}" FontFamily="Georgia" FontSize="28" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding PlaceholderDescription}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,10,0,18" />
                            <Button Content="Return to check-in" Command="{Binding SelectModuleCommand}" CommandParameter="Check-In" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="26,0">
            <Grid><TextBlock Text="{Binding CommandStatus}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" /><TextBlock Text="iGate · Ember operations workspace" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
        </Border>

        <Border Tag="IportServiceMenu" Panel.ZIndex="10" Visibility="{Binding IsServiceMenuOpen, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,65,30,0" Width="255" Style="{StaticResource WorkspaceCard}">
            <StackPanel><TextBlock Text="iGATE TOOLS" Style="{StaticResource WorkspaceLabel}" /><TextBlock Text="Additional operational workspaces" FontSize="15" FontWeight="SemiBold" Margin="0,5,0,10" /><ItemsControl ItemsSource="{Binding ServiceMenuEntries}"><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Label}" Command="{Binding DataContext.SelectServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,3" HorizontalContentAlignment="Left" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
        </Border>
    </Grid>
    </Border>
</UserControl>
