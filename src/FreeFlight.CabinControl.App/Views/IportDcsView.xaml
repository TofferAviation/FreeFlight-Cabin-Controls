<UserControl x:Class="FreeFlight.CabinControl.App.Views.IportDcsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F6FA">
    <UserControl.Resources>
        <DropShadowEffect x:Key="Shadow" BlurRadius="20" ShadowDepth="4" Opacity="0.10" Color="#102A43" />
        <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#062B4C" Offset="0" /><GradientStop Color="#0767A5" Offset="0.58" /><GradientStop Color="#173D61" Offset="1" /></LinearGradientBrush>
        <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="#D9E3ED" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="20" /><Setter Property="Effect" Value="{StaticResource Shadow}" /></Style>
        <Style x:Key="Label" TargetType="TextBlock"><Setter Property="FontSize" Value="10" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="#587087" /></Style>
        <Style x:Key="Value" TargetType="TextBlock"><Setter Property="FontSize" Value="27" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="#102A43" /></Style>
        <Style x:Key="Tab" TargetType="RadioButton"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="0,0,0,2" /><Setter Property="Foreground" Value="#587087" /><Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Padding" Value="16,17,16,14" /><Setter Property="Cursor" Value="Hand" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><StackPanel Orientation="Horizontal"><TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe Fluent Icons" FontSize="15" Margin="0,0,8,0" /><ContentPresenter /></StackPanel></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#EEF6FC" /></Trigger><Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="#075D99" /><Setter Property="BorderBrush" Value="#0B83CC" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="Input" TargetType="TextBox"><Setter Property="Background" Value="#F9FBFD" /><Setter Property="BorderBrush" Value="#C9D8E5" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="11,8" /><Setter Property="Foreground" Value="#102A43" /></Style>
        <Style x:Key="Outline" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}"><Setter Property="MinHeight" Value="38" /><Setter Property="Padding" Value="15,6" /><Setter Property="FontSize" Value="12" /></Style>
        <Style x:Key="Action" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}"><Setter Property="MinHeight" Value="38" /><Setter Property="Padding" Value="15,6" /><Setter Property="FontSize" Value="12" /></Style>
        <Style x:Key="Row" TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="#E7EDF3" /><Setter Property="BorderThickness" Value="0,0,0,1" /><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F2F8FC" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#E1F2FC" /></Trigger></Style.Triggers></Style>
    </UserControl.Resources>

    <Grid ClipToBounds="True">
        <Grid.RowDefinitions><RowDefinition Height="76" /><RowDefinition Height="56" /><RowDefinition Height="*" /><RowDefinition Height="34" /></Grid.RowDefinitions>
        <Border Background="White" BorderBrush="#D9E3ED" BorderThickness="0,0,0,1"><Grid Margin="26,0"><Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="*" /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="34" Height="34" Background="#075D99" CornerRadius="17" Margin="0,0,10,0"><TextBlock Text="E" Foreground="White" FontFamily="Georgia" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel><TextBlock Text="EMBER" FontWeight="SemiBold" FontSize="17" Foreground="#102A43" /><TextBlock Text="OPERATIONS" Style="{StaticResource Label}" FontSize="8" /></StackPanel></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Operations.FlightNumber}" FontSize="20" FontWeight="SemiBold" Foreground="#102A43" /><TextBlock Text="{Binding Operations.RouteSummary}" FontSize="12" Foreground="#587087" /></StackPanel><Border Grid.Column="2" Background="#EFF8F4" BorderBrush="#CAE8D8" BorderThickness="1" CornerRadius="8" Padding="12,7" VerticalAlignment="Center" HorizontalAlignment="Right"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="#1A9C64" Margin="0,0,8,0" VerticalAlignment="Center" /><StackPanel><TextBlock Text="WEBSITE FLIGHT" FontSize="9" FontWeight="SemiBold" Foreground="#126D47" /><TextBlock Text="{Binding Operations.SimBriefConnectionLabel}" FontSize="11" Foreground="#2B6C51" /></StackPanel></StackPanel></Border></Grid></Border>
        <Border Grid.Row="1" Background="White" BorderBrush="#D9E3ED" BorderThickness="0,0,0,1"><StackPanel Orientation="Horizontal" Margin="18,0"><RadioButton GroupName="Workspace" Style="{StaticResource Tab}" Tag="&#xE77B;" Content="Check-in" IsChecked="{Binding ActiveModule, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Check-In, Mode=OneWay}" Command="{Binding SelectModuleCommand}" CommandParameter="Check-In" /><RadioButton GroupName="Workspace" Style="{StaticResource Tab}" Tag="&#xE8A5;" Content="Boarding" IsChecked="{Binding ActiveModule, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Boarding, Mode=OneWay}" Command="{Binding SelectModuleCommand}" CommandParameter="Boarding" /><RadioButton GroupName="Workspace" Style="{StaticResource Tab}" Tag="&#xE9D9;" Content="Load &amp; trim" IsChecked="{Binding ActiveModule, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Load Control, Mode=OneWay}" Command="{Binding SelectModuleCommand}" CommandParameter="Load Control" /><RadioButton GroupName="Workspace" Style="{StaticResource Tab}" Tag="&#xE9D2;" Content="Flight monitor" IsChecked="{Binding ActiveModule, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Flight Monitor, Mode=OneWay}" Command="{Binding SelectModuleCommand}" CommandParameter="Flight Monitor" /><Button Content="Refresh flight" Command="{Binding RefreshCommand}" Style="{StaticResource Outline}" Margin="20,9,0,9" /></StackPanel></Border>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Margin="26,22,26,26">
            <Grid Visibility="{Binding ActiveModule, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Check-In}"><Grid.RowDefinitions><RowDefinition Height="132" /><RowDefinition Height="18" /><RowDefinition Height="*" /></Grid.RowDefinitions><Border Background="{StaticResource HeroBrush}" CornerRadius="14" Padding="24" Effect="{StaticResource Shadow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="PASSENGER OPERATIONS" Style="{StaticResource Label}" Foreground="#B9DBF1" /><TextBlock Text="Ready to welcome your passengers" Foreground="White" FontFamily="Georgia" FontSize="27" Margin="0,5,0,0" /><TextBlock Text="Every action is recorded against the flight selected in the pilot website." Foreground="#D2E7F5" FontSize="12" Margin="0,7,0,0" /></StackPanel><StackPanel Grid.Column="1" Margin="28,0,0,0" VerticalAlignment="Center"><TextBlock Text="GATE" Style="{StaticResource Label}" Foreground="#B9DBF1" /><TextBlock Text="{Binding Operations.GateNumber}" Foreground="White" FontSize="28" FontWeight="SemiBold" /></StackPanel><StackPanel Grid.Column="2" Margin="28,0,0,0" VerticalAlignment="Center"><TextBlock Text="BOARDING" Style="{StaticResource Label}" Foreground="#B9DBF1" /><TextBlock Text="{Binding Operations.BoardingBeginsAt}" Foreground="White" FontSize="21" FontWeight="SemiBold" /></StackPanel><StackPanel Grid.Column="3" Margin="28,0,0,0" VerticalAlignment="Center"><TextBlock Text="STATUS" Style="{StaticResource Label}" Foreground="#B9DBF1" /><TextBlock Text="{Binding StatusLabel}" Foreground="#87E7BD" FontSize="13" FontWeight="SemiBold" MaxWidth="130" TextWrapping="Wrap" /></StackPanel></Grid></Border><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.9*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions><Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="49" /><RowDefinition Height="24" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid><StackPanel><TextBlock Text="PASSENGER LIST" Style="{StaticResource Label}" /><TextBlock Text="Find and prepare passengers" FontFamily="Georgia" FontSize="23" Foreground="#102A43" Margin="0,4,0,0" /></StackPanel><TextBlock Text="{Binding Operations.TotalPassengers, StringFormat={}{0} RECORDS}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#075D99" FontWeight="SemiBold" FontSize="11" /></Grid><Grid Grid.Row="1" Margin="0,16,0,8"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="112" /></Grid.ColumnDefinitions><TextBox Text="{Binding PassengerLookup, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" VerticalContentAlignment="Center" ToolTip="Passenger, booking, seat or bag" /><Button Grid.Column="1" Content="Find" Command="{Binding FindPassengerCommand}" Style="{StaticResource Action}" Margin="8,0,0,0" /></Grid><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="75" /><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /><ColumnDefinition Width="70" /><ColumnDefinition Width="68" /><ColumnDefinition Width="84" /></Grid.ColumnDefinitions><TextBlock Text="PAX" Style="{StaticResource Label}" /><TextBlock Grid.Column="1" Text="PASSENGER" Style="{StaticResource Label}" /><TextBlock Grid.Column="2" Text="CABIN" Style="{StaticResource Label}" /><TextBlock Grid.Column="3" Text="SEAT" Style="{StaticResource Label}" /><TextBlock Grid.Column="4" Text="BAGS" Style="{StaticResource Label}" /><TextBlock Grid.Column="5" Text="STATUS" Style="{StaticResource Label}" /></Grid><ListBox Grid.Row="3" ItemsSource="{Binding Operations.VisiblePassengers}" SelectedItem="{Binding SelectedPassenger}" ItemContainerStyle="{StaticResource Row}" BorderThickness="0" Background="Transparent" Margin="0,7,0,0"><ListBox.ItemTemplate><DataTemplate><Grid Margin="8,10"><Grid.ColumnDefinitions><ColumnDefinition Width="67" /><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /><ColumnDefinition Width="70" /><ColumnDefinition Width="68" /><ColumnDefinition Width="84" /></Grid.ColumnDefinitions><TextBlock Text="{Binding PassengerNumber}" Foreground="#587087" /><TextBlock Grid.Column="1" Text="{Binding FullName}" FontWeight="SemiBold" Foreground="#102A43" /><TextBlock Grid.Column="2" Text="{Binding CabinCode}" Foreground="#587087" /><TextBlock Grid.Column="3" Text="{Binding SeatNumber}" FontWeight="SemiBold" Foreground="#102A43" /><TextBlock Grid.Column="4" Text="{Binding CheckedBags}" Foreground="#587087" /><TextBlock Grid.Column="5" Text="{Binding CheckInLabel}" Foreground="{Binding CheckInColor}" FontWeight="SemiBold" /></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Grid.Row="3" Text="{Binding Operations.PassengerListStatus}" Foreground="#587087" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380" IsHitTestVisible="False" Visibility="{Binding Operations.IsPassengerListEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" /></Grid></Border><StackPanel Grid.Column="2"><Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="FLIGHT PROGRESS" Style="{StaticResource Label}" /><TextBlock Text="{Binding Operations.FlightNumber}" FontFamily="Georgia" FontSize="22" Foreground="#102A43" Margin="0,5,0,12" /><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="CHECKED IN" Style="{StaticResource Label}" /><TextBlock Text="{Binding Operations.CheckedInPassengers}" Style="{StaticResource Value}" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="BOARDED" Style="{StaticResource Label}" /><TextBlock Text="{Binding Operations.BoardedPassengers}" Style="{StaticResource Value}" /></StackPanel></Grid><ProgressBar Minimum="0" Maximum="{Binding Operations.TotalPassengers, Mode=OneWay}" Value="{Binding Operations.CheckedInPassengers, Mode=OneWay}" Height="7" Margin="0,14,0,8" Foreground="#0B83CC" Background="#E6EEF4" /><TextBlock Text="{Binding Operations.BoardingStatusLabel}" Foreground="{Binding Operations.BoardingStatusColor}" FontSize="11" FontWeight="SemiBold" /></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="SELECTED PASSENGER" Style="{StaticResource Label}" /><TextBlock Text="{Binding SelectedPassenger.FullName, TargetNullValue=Choose a passenger}" FontSize="16" FontWeight="SemiBold" Foreground="#102A43" Margin="0,5,0,4" /><TextBlock Text="Choose a record, then check in or print the boarding pass." Foreground="#587087" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,12" /><Button Content="Check in" Command="{Binding CheckInCommand}" Style="{StaticResource Action}" Margin="0,0,0,8" /><Button Content="Print boarding pass" Command="{Binding PrintCommand}" Style="{StaticResource Outline}" /></StackPanel></Border></StackPanel></Grid></Grid>
            <Grid Visibility="{Binding ActiveModule, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Boarding}"><Grid.RowDefinitions><RowDefinition Height="132" /><RowDefinition Height="18" /><RowDefinition Height="*" /></Grid.RowDefinitions><Border Background="{StaticResource HeroBrush}" CornerRadius="14" Padding="24" Effect="{StaticResource Shadow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="BOARDING CONTROL" Style="{StaticResource Label}" Foreground="#B9DBF1" /><TextBlock Text="Bring the cabin on board" Foreground="White" FontFamily="Georgia" FontSize="28" Margin="0,5,0,0" /><TextBlock Text="Boarding state stays synchronised with Ember's live cabin engine." Foreground="#D2E7F5" FontSize="12" Margin="0,7,0,0" /></StackPanel><Button Grid.Column="1" Content="{Binding Operations.GateActionLabel}" Command="{Binding ToggleGateCommand}" Style="{StaticResource Action}" VerticalAlignment="Center" Background="White" Foreground="#075D99" BorderBrush="#D4EAF8" /></Grid></Border><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="READY TO BOARD" Style="{StaticResource Label}" /><TextBlock Text="{Binding NotBoardedPassengers}" Style="{StaticResource Value}" Margin="0,5,0,0" /><TextBlock Text="Passengers still at the gate" Foreground="#587087" FontSize="11" /></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="ON BOARD" Style="{StaticResource Label}" /><TextBlock Text="{Binding Operations.BoardedPassengers}" Style="{StaticResource Value}" Margin="0,5,0,0" /><TextBlock Text="Awaiting cabin completion" Foreground="#587087" FontSize="11" /></StackPanel></Border><Border Grid.Column="4" Style="{StaticResource Card}"><StackPanel><TextBlock Text="BAG RECONCILIATION" Style="{StaticResource Label}" /><TextBlock Text="{Binding Operations.BaggageReconciliationLabel}" Foreground="{Binding Operations.BaggageReconciliationColor}" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0" /><TextBlock Text="The final load sheet checks actual bags and passenger status." Foreground="#587087" FontSize="11" Margin="0,7,0,0" /></StackPanel></Border></Grid></Grid>
            <Grid Visibility="{Binding ActiveModule, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Load Control}"><Grid.RowDefinitions><RowDefinition Height="132" /><RowDefinition Height="18" /><RowDefinition Height="*" /></Grid.RowDefinitions><Border Background="{StaticResource HeroBrush}" CornerRadius="14" Padding="24" Effect="{StaticResource Shadow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="LOAD &amp; TRIM" Style="{StaticResource Label}" Foreground="#B9DBF1" /><TextBlock Text="A clear, live load-control workspace" Foreground="White" FontFamily="Georgia" FontSize="28" Margin="0,5,0,0" /><TextBlock Text="Weights use the selected aircraft, live passengers and loaded baggage." Foreground="#D2E7F5" FontSize="12" Margin="0,7,0,0" /></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding LoadSheetLabel}" Foreground="#87E7BD" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right" /><TextBlock Text="{Binding LoadSheetReadinessLabel}" Foreground="#D2E7F5" FontSize="11" Margin="0,5,0,0" /></StackPanel></Grid></Border><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.25*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="WEIGHT SUMMARY" Style="{StaticResource Label}" /><TextBlock Text="Live aircraft weights" FontFamily="Georgia" FontSize="23" Foreground="#102A43" Margin="0,5,0,14" /><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ZERO FUEL" Style="{StaticResource Label}" /><TextBlock Text="{Binding ZeroFuelWeightKg, StringFormat={}{0:N0} kg}" Style="{StaticResource Value}" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="TAKE-OFF" Style="{StaticResource Label}" /><TextBlock Text="{Binding TakeoffWeightKg, StringFormat={}{0:N0} kg}" Style="{StaticResource Value}" /></StackPanel></Grid><Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="LANDING" Style="{StaticResource Label}" /><TextBlock Text="{Binding LandingWeightKg, StringFormat={}{0:N0} kg}" FontSize="19" FontWeight="SemiBold" Foreground="#102A43" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="TRAFFIC LOAD" Style="{StaticResource Label}" /><TextBlock Text="{Binding TrafficLoadKg, StringFormat={}{0:N0} kg}" FontSize="19" FontWeight="SemiBold" Foreground="#102A43" /></StackPanel></Grid><Border Background="#F6F9FC" CornerRadius="8" Padding="12" Margin="0,20,0,0"><StackPanel><TextBlock Text="{Binding WbStatusLabel}" Foreground="{Binding WbStatusColor}" FontWeight="SemiBold" /><TextBlock Text="{Binding BaggageLoadLabel}" Foreground="#587087" FontSize="11" Margin="0,4,0,0" /></StackPanel></Border></StackPanel></Border><StackPanel Grid.Column="2"><Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="FUEL" Style="{StaticResource Label}" /><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="TAKE-OFF" Style="{StaticResource Label}" /><TextBox Text="{Binding TakeoffFuelKg, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" Margin="0,5,8,0" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="TRIP" Style="{StaticResource Label}" /><TextBox Text="{Binding TripFuelKg, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" Margin="0,5,0,0" /></StackPanel></Grid></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="LOAD SHEET" Style="{StaticResource Label}" /><TextBlock Text="{Binding LoadSheetReadinessLabel}" Foreground="{Binding LoadSheetReadinessColor}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,7,0,13" /><Button Content="Finalize load sheet" Command="{Binding FinalizeLoadSheetCommand}" IsEnabled="{Binding CanFinalizeLoadSheet}" Style="{StaticResource Action}" Margin="0,0,0,8" /><Button Content="Export final load plan" Command="{Binding ExportFinalLoadPlanCommand}" IsEnabled="{Binding IsLoadSheetFinalized}" Style="{StaticResource Outline}" /></StackPanel></Border></StackPanel></Grid></Grid>
            <Grid Visibility="{Binding ActiveModule, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Flight Monitor}"><Grid.RowDefinitions><RowDefinition Height="132" /><RowDefinition Height="18" /><RowDefinition Height="*" /></Grid.RowDefinitions><Border Background="{StaticResource HeroBrush}" CornerRadius="14" Padding="24" Effect="{StaticResource Shadow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="FLIGHT MONITOR" Style="{StaticResource Label}" Foreground="#B9DBF1" /><TextBlock Text="A single operational picture" Foreground="White" FontFamily="Georgia" FontSize="28" Margin="0,5,0,0" /><TextBlock Text="Monitor the service selected from your BAV website through the active ACARS session." Foreground="#D2E7F5" FontSize="12" Margin="0,7,0,0" /></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding CurrentClock}" Foreground="White" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Right" /><TextBlock Text="LOCAL OPERATIONS TIME" Style="{StaticResource Label}" Foreground="#B9DBF1" HorizontalAlignment="Right" /></StackPanel></Grid></Border><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="FLIGHT STATUS" Style="{StaticResource Label}" /><TextBlock Text="{Binding Operations.FlightNumber}" FontFamily="Georgia" FontSize="25" Foreground="#102A43" Margin="0,5,0,4" /><TextBlock Text="{Binding Operations.RouteSummary}" Foreground="#587087" /><Grid Margin="0,24,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="GATE" Style="{StaticResource Label}" /><TextBlock Text="{Binding Operations.GateNumber}" Style="{StaticResource Value}" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="SCHEDULED" Style="{StaticResource Label}" /><TextBlock Text="{Binding Operations.ScheduledDeparture}" Style="{StaticResource Value}" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="AIRCRAFT" Style="{StaticResource Label}" /><TextBlock Text="{Binding Operations.DetectedAircraftIcao}" FontSize="22" FontWeight="SemiBold" Foreground="#102A43" /></StackPanel></Grid></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="OPERATIONS TIMELINE" Style="{StaticResource Label}" /><TextBlock Text="{Binding Operations.TimelinePhaseLabel}" Foreground="{Binding Operations.TimelinePhaseColor}" FontSize="18" FontWeight="SemiBold" Margin="0,7,0,12" /><ItemsControl ItemsSource="{Binding MonitorEvents}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Ellipse Width="8" Height="8" Fill="{Binding Color}" VerticalAlignment="Top" Margin="0,4,0,0" /><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#102A43" /><TextBlock Text="{Binding Detail}" Foreground="#587087" FontSize="11" TextWrapping="Wrap" /></StackPanel></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></Grid></Grid>
        </Grid></ScrollViewer>
        <Border Grid.Row="3" Background="White" BorderBrush="#D9E3ED" BorderThickness="0,1,0,0" Padding="26,0"><Grid><TextBlock Text="{Binding CommandStatus}" Foreground="#587087" FontSize="11" VerticalAlignment="Center" /><TextBlock Text="Ember Operations · connected pilot workspace" Foreground="#7A8DA1" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid></Border>
    </Grid>
</UserControl>
