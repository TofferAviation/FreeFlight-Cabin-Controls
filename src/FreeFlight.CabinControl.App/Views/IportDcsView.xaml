<UserControl x:Class="FreeFlight.CabinControl.App.Views.IportDcsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FreeFlight.CabinControl.App.ViewModels"
             FontFamily="Segoe UI"
             FontSize="11"
             Foreground="#252525">
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#252525" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <LinearGradientBrush x:Key="IportBarBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FDFDFD" Offset="0" />
            <GradientStop Color="#D8D8D8" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="IportButtonBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0" />
            <GradientStop Color="#D6D6D6" Offset="1" />
        </LinearGradientBrush>
        <Style x:Key="IportButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource IportButtonBrush}" />
            <Setter Property="BorderBrush" Value="#9A9A9A" />
            <Setter Property="Foreground" Value="#222222" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="MinHeight" Value="27" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" TextElement.Foreground="#252525">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" TextElement.Foreground="#252525" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#E8F8FC" /><Setter Property="BorderBrush" Value="#29B8D4" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#C5C5C5" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#E8F8FC" /><Setter Property="BorderBrush" Value="#29B8D4" /></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#C5C5C5" /><Setter Property="Foreground" Value="#000000" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="IportTab" TargetType="RadioButton">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="Foreground" Value="#282828" />
            <Setter Property="Background" Value="#E7E7E7" />
            <Setter Property="BorderBrush" Value="#B7B7B7" />
            <Setter Property="BorderThickness" Value="1,1,1,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" TextElement.Foreground="#252525">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="#252525" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="#FFFFFF" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="BorderBrush" Value="#23B8D2" /></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#EFFBFD" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IportSection" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#A8A8A8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9" />
        </Style>
        <Style x:Key="IportSectionHeader" TargetType="Border">
            <Setter Property="Background" Value="#A8A8A8" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
        <Style x:Key="IportInput" TargetType="TextBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Foreground" Value="#202020" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#88BFD0" />
            <Setter Property="CaretBrush" Value="#202020" />
        </Style>
        <Style x:Key="IportComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#202020" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#88BFD0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="IportMenuButton" TargetType="Button">
            <Setter Property="Height" Value="25" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="#13B8D5" />
            <Setter Property="BorderBrush" Value="#4CC9DE" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#70DAE9" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#BFEFF5" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Modifiers="Alt" Key="C" Command="{Binding SelectModuleCommand}" CommandParameter="Check-In" />
        <KeyBinding Modifiers="Alt" Key="G" Command="{Binding SelectModuleCommand}" CommandParameter="Gate Control" />
        <KeyBinding Modifiers="Alt" Key="B" Command="{Binding SelectModuleCommand}" CommandParameter="Boarding" />
        <KeyBinding Modifiers="Alt" Key="W" Command="{Binding SelectModuleCommand}" CommandParameter="Lost &amp; Found" />
        <KeyBinding Modifiers="Alt" Key="L" Command="{Binding SelectModuleCommand}" CommandParameter="Load Control" />
        <KeyBinding Modifiers="Alt" Key="F" Command="{Binding SelectModuleCommand}" CommandParameter="Flight Monitor" />
        <KeyBinding Modifiers="Alt" Key="D" Command="{Binding SelectModuleCommand}" CommandParameter="Database mgt" />
        <KeyBinding Modifiers="Alt" Key="A" Command="{Binding SelectModuleCommand}" CommandParameter="Autoinformation" />
        <KeyBinding Modifiers="Alt" Key="M" Command="{Binding SelectModuleCommand}" CommandParameter="My Account" />
        <KeyBinding Modifiers="Alt" Key="S" Command="{Binding SelectModuleCommand}" CommandParameter="Support" />
        <KeyBinding Modifiers="Alt" Key="R" Command="{Binding SelectModuleCommand}" CommandParameter="Res2 Support" />
        <KeyBinding Modifiers="Alt" Key="T" Command="{Binding SelectModuleCommand}" CommandParameter="Messages" />
    </UserControl.InputBindings>

    <Border Background="#E7E7E7" BorderBrush="#727272" BorderThickness="1" Tag="IportDcsWorkspace">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="*" /><RowDefinition Height="82" /></Grid.RowDefinitions>

            <Border Background="{StaticResource IportBarBrush}" BorderBrush="#9A9A9A" BorderThickness="0,0,0,1">
                <Grid Margin="12,5">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="225" /><ColumnDefinition Width="174" /><ColumnDefinition /><ColumnDefinition Width="315" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Res2" FontSize="22" FontWeight="Bold" Foreground="#5C5C5C" />
                        <TextBlock Text=" iPort" FontSize="22" FontWeight="SemiBold" Foreground="#5C5C5C" />
                        <TextBlock Text="{Binding IportProductLabel}" FontSize="13" Foreground="#777777" VerticalAlignment="Bottom" Margin="0,0,0,7" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Height="34"
                            Margin="0,2"
                            Padding="11,0"
                            Background="#07182D"
                            BorderBrush="#5D758D"
                            Foreground="White"
                            Command="{Binding ToggleServiceMenuCommand}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="22" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding ActiveServiceLabel}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="&#xE70D;" FontFamily="Segoe Fluent Icons" Foreground="#5AC5DF" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="10,0,0,0" Visibility="{Binding IsCustomerServiceTabsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <RadioButton GroupName="IportModules" Style="{StaticResource IportTab}" IsChecked="{Binding ActiveModule, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Check-In, Mode=OneWay}" Command="{Binding SelectModuleCommand}" CommandParameter="Check-In"><TextBlock Text="Check-In" Foreground="#151515" /></RadioButton>
                        <RadioButton GroupName="IportModules" Style="{StaticResource IportTab}" IsChecked="{Binding ActiveModule, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Boarding, Mode=OneWay}" Command="{Binding SelectModuleCommand}" CommandParameter="Boarding"><TextBlock Text="Boarding" Foreground="#151515" /></RadioButton>
                        <RadioButton GroupName="IportModules" Style="{StaticResource IportTab}" IsChecked="{Binding ActiveModule, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Seatmap, Mode=OneWay}" Command="{Binding SelectModuleCommand}" CommandParameter="Seatmap"><TextBlock Text="Seatmap" Foreground="#151515" /></RadioButton>
                        <RadioButton GroupName="IportModules" Style="{StaticResource IportTab}" IsChecked="{Binding ActiveModule, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Load Control, Mode=OneWay}" Command="{Binding SelectModuleCommand}" CommandParameter="Load Control"><TextBlock Text="Load Control" Foreground="#151515" /></RadioButton>
                        <RadioButton GroupName="IportModules" Style="{StaticResource IportTab}" IsChecked="{Binding ActiveModule, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Flight Monitor, Mode=OneWay}" Command="{Binding SelectModuleCommand}" CommandParameter="Flight Monitor"><TextBlock Text="Flight Monitor" Foreground="#151515" /></RadioButton>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="10,0,0,0" Visibility="{Binding IsLoadControlService, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <RadioButton GroupName="IportLoadModules" Style="{StaticResource IportTab}" Padding="6,0" IsChecked="{Binding ActiveModule, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Load Control, Mode=OneWay}" Command="{Binding SelectModuleCommand}" CommandParameter="Load Control"><TextBlock Text="W&amp;B Overview" Foreground="#151515" FontSize="10" /></RadioButton>
                        <RadioButton GroupName="IportLoadModules" Style="{StaticResource IportTab}" Padding="6,0" IsChecked="{Binding ActiveModule, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Load Control — Passenger, Mode=OneWay}" Command="{Binding SelectModuleCommand}" CommandParameter="Load Control — Passenger"><TextBlock Text="Passenger" Foreground="#151515" FontSize="10" /></RadioButton>
                        <RadioButton GroupName="IportLoadModules" Style="{StaticResource IportTab}" Padding="6,0" IsChecked="{Binding ActiveModule, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Load Control — Deadload, Mode=OneWay}" Command="{Binding SelectModuleCommand}" CommandParameter="Load Control — Deadload"><TextBlock Text="Deadload" Foreground="#151515" FontSize="10" /></RadioButton>
                        <RadioButton GroupName="IportLoadModules" Style="{StaticResource IportTab}" Padding="6,0" IsChecked="{Binding ActiveModule, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Load Control — Load Distribution, Mode=OneWay}" Command="{Binding SelectModuleCommand}" CommandParameter="Load Control — Load Distribution"><TextBlock Text="Load Distribution" Foreground="#151515" FontSize="10" /></RadioButton>
                        <RadioButton GroupName="IportLoadModules" Style="{StaticResource IportTab}" Padding="6,0" IsChecked="{Binding ActiveModule, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Load Control — Documents, Mode=OneWay}" Command="{Binding SelectModuleCommand}" CommandParameter="Load Control — Documents"><TextBlock Text="Documents" Foreground="#151515" FontSize="10" /></RadioButton>
                        <RadioButton GroupName="IportLoadModules" Style="{StaticResource IportTab}" Padding="6,0" IsChecked="{Binding ActiveModule, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Load Control — P/W summary, Mode=OneWay}" Command="{Binding SelectModuleCommand}" CommandParameter="Load Control — P/W summary"><TextBlock Text="P/W summary" Foreground="#151515" FontSize="10" /></RadioButton>
                    </StackPanel>
                    <Grid Grid.Column="3" Margin="15,0,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="94" /><ColumnDefinition Width="94" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Operations.FlightNumber}" FontSize="20" FontWeight="Bold" /><TextBlock Text="{Binding Operations.AircraftName}" Foreground="#555555" /></StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="GATE" FontSize="9" Foreground="#666666" /><TextBlock Text="{Binding Operations.GateNumber}" FontSize="18" FontWeight="Bold" /></StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="STD / ETD" FontSize="9" Foreground="#666666" /><TextBlock Text="{Binding Operations.ScheduledDeparture}" FontSize="18" FontWeight="Bold" /></StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="10,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="246" /><ColumnDefinition Width="6" /><ColumnDefinition /></Grid.ColumnDefinitions>

                <Border Background="#F6F6F6" BorderBrush="#9E9E9E" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="33" /><RowDefinition Height="126" /><RowDefinition Height="32" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <UniformGrid Columns="3"><Button Style="{StaticResource IportButton}"><TextBlock Text="My Assigned" Foreground="#151515" /></Button><Button Style="{StaticResource IportButton}" FontWeight="SemiBold"><TextBlock Text="My Flights" Foreground="#151515" /></Button><Button Style="{StaticResource IportButton}" Command="{Binding SelectModuleCommand}" CommandParameter="Seatmap"><TextBlock Text="Seatmap" Foreground="#151515" /></Button></UniformGrid>
                        <Grid Grid.Row="1" Margin="9,8"><Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="88" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <TextBlock Text="Boardingpoint:" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding BoardingPoint, Mode=OneWay}" Style="{StaticResource IportInput}" IsReadOnly="True" Visibility="{Binding IsCustomerServiceTabsVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBox Grid.Column="1" Text="{Binding BoardingPoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource IportInput}" MaxLength="4" Visibility="{Binding IsLoadControlService, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock Grid.Row="1" Text="Dest/Car/Fltnr:" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Operations.DestinationIata, Mode=OneWay}" Style="{StaticResource IportInput}" IsReadOnly="True" Visibility="{Binding IsCustomerServiceTabsVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Destination, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource IportInput}" MaxLength="4" Visibility="{Binding IsLoadControlService, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock Grid.Row="2" Text="Time Window:" VerticalAlignment="Center" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="+1 hrs / +12 hrs" Style="{StaticResource IportInput}" IsReadOnly="True" Visibility="{Binding IsCustomerServiceTabsVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ComboBox Grid.Row="2" Grid.Column="1" Height="28" SelectedIndex="0" Style="{StaticResource IportComboBox}" Visibility="{Binding IsLoadControlService, Converter={StaticResource BooleanToVisibilityConverter}}"><ComboBoxItem><TextBlock Text="{Binding Operations.FlightDateShort}" Foreground="#202020" /></ComboBoxItem></ComboBox>
                        </Grid>
                        <Border Grid.Row="2" Background="#DEDEDE" BorderBrush="#A2A2A2" BorderThickness="0,1"><Grid Margin="7,0"><Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="72" /><ColumnDefinition Width="68" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="Flight" FontWeight="Bold" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="STD/ETD" FontWeight="Bold" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="Dest.Gate" FontWeight="Bold" VerticalAlignment="Center" /><TextBlock Grid.Column="3" Text="STS" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" /></Grid></Border>
                        <ListBox Grid.Row="3" ItemsSource="{Binding Flights}" SelectedItem="{Binding SelectedFlight}" Background="#FFFFFF" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="MinHeight" Value="34" /><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#20B7D0" /><Setter Property="Foreground" Value="White" /></Trigger></Style.Triggers></Style></ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate><DataTemplate><Border Background="{Binding RowBackground}" Padding="5,3"><Grid TextElement.Foreground="#252525"><Grid.ColumnDefinitions><ColumnDefinition Width="17" /><ColumnDefinition Width="53" /><ColumnDefinition Width="70" /><ColumnDefinition Width="42" /><ColumnDefinition Width="42" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="{Binding StatusGlyph}" Foreground="{Binding StatusColor}" FontWeight="Bold" /><TextBlock Grid.Column="1" Text="{Binding FlightNumber}" Foreground="#151515" FontWeight="SemiBold" /><TextBlock Grid.Column="2" Text="{Binding DepartureTime}" Foreground="#151515" /><TextBlock Grid.Column="3" Text="{Binding Destination}" Foreground="#151515" /><TextBlock Grid.Column="4" Text="{Binding Gate}" Foreground="#151515" /><Border Grid.Column="5" Width="19" Height="22" HorizontalAlignment="Right" Background="#D8B82F" BorderBrush="#777777" BorderThickness="1"><TextBlock Text="&#xE785;" FontFamily="Segoe Fluent Icons" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#125E9A" /></Border></Grid></Border></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Background="#F9F9F9" BorderBrush="#939393" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="{Binding IportHeaderHeight}" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid Margin="10,7" Visibility="{Binding IsCustomerServiceTabsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"><Grid.RowDefinitions><RowDefinition Height="31" /><RowDefinition /></Grid.RowDefinitions>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="75" /><ColumnDefinition Width="70" /><ColumnDefinition Width="75" /><ColumnDefinition Width="70" /><ColumnDefinition Width="80" /><ColumnDefinition Width="70" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Operations.FlightNumber}" FontSize="18" FontWeight="Bold" /><TextBlock Grid.Column="1" Text="{Binding Operations.FlightDateShort}" FontWeight="SemiBold" /><TextBlock Grid.Column="2" Text="{Binding Operations.OriginIata}" FontWeight="SemiBold" /><TextBlock Grid.Column="3" Text="STD" /><TextBlock Grid.Column="4" Text="{Binding Operations.ScheduledDeparture}" FontWeight="Bold" /><TextBlock Grid.Column="5" Text="ETD" /><TextBlock Grid.Column="6" Text="{Binding Operations.ScheduledDeparture}" FontWeight="Bold" /><TextBlock Grid.Column="7" Text="{Binding Operations.DestinationIata, StringFormat=DEST  {0}}" HorizontalAlignment="Right" FontWeight="Bold" />
                            </Grid>
                            <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="180" /><ColumnDefinition Width="170" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="{Binding Operations.AircraftName}" /><TextBlock Text="{Binding Operations.DetectedAircraftIcao}" FontWeight="SemiBold" /></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock><Run Text="Status:  " /><Run Text="{Binding StatusLabel, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock><TextBlock><Run Text="Boarding:  " /><Run Text="{Binding Operations.BoardingBeginsAt, Mode=OneWay}" /></TextBlock><TextBlock><Run Text="Gate:  " /><Run Text="{Binding Operations.GateNumber, Mode=OneWay}" FontWeight="Bold" /></TextBlock></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock><Run Text="Checked-In:  " /><Run Text="{Binding Operations.CheckedInPassengers, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock><TextBlock><Run Text="Booked:  " /><Run Text="{Binding Operations.TotalPassengers, Mode=OneWay}" /></TextBlock><TextBlock><Run Text="Available:  " /><Run Text="{Binding StandbyPassengers, Mode=OneWay}" /></TextBlock></StackPanel>
                                <TextBlock Grid.Column="3" Text="{Binding WbStatusLabel}" Foreground="#D60000" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Grid>

                        <Grid Margin="7,3" Visibility="{Binding IsLoadControlService, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.RowDefinitions><RowDefinition Height="22" /><RowDefinition Height="22" /><RowDefinition Height="22" /><RowDefinition Height="49" /><RowDefinition /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="58" /><ColumnDefinition Width="98" /><ColumnDefinition Width="82" /><ColumnDefinition Width="82" /><ColumnDefinition Width="70" /><ColumnDefinition Width="82" /><ColumnDefinition Width="82" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Flights[1].FlightNumber}" FontSize="13" FontWeight="Bold" /><TextBlock Grid.Column="1" Text="{Binding Operations.FlightDateShort}" /><TextBlock Grid.Column="2" Text="LHR-LAX" /><TextBlock Grid.Column="3" Text="{Binding Flights[1].DepartureTime, StringFormat=STD  {0}}" /><TextBlock Grid.Column="4" Text="{Binding Flights[1].DepartureTime, StringFormat=ETD  {0}}" /><TextBlock Grid.Column="5" Text="CTOT  --" /><TextBlock Grid.Column="6" Text="STA  13:35z" /><TextBlock Grid.Column="7" Text="ETA  13:35z" /><TextBlock Grid.Column="8" Text="+" FontWeight="Bold" HorizontalAlignment="Right" />
                            <TextBlock Grid.Row="1" Text="{Binding Flights[2].FlightNumber}" FontSize="13" FontWeight="Bold" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Operations.FlightDateShort}" /><TextBlock Grid.Row="1" Grid.Column="2" Text="LHR-LAS" /><TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Flights[2].DepartureTime, StringFormat=STD  {0}}" /><TextBlock Grid.Row="1" Grid.Column="4" Text="{Binding Flights[2].DepartureTime, StringFormat=ETD  {0}}" /><TextBlock Grid.Row="1" Grid.Column="5" Text="CTOT  --" /><TextBlock Grid.Row="1" Grid.Column="6" Text="STA  15:10z" /><TextBlock Grid.Row="1" Grid.Column="7" Text="ETA  15:10z" /><TextBlock Grid.Row="1" Grid.Column="8" Text="+" FontWeight="Bold" HorizontalAlignment="Right" />
                            <Border Grid.Row="2" Grid.ColumnSpan="9" Background="#F4F4F4" BorderBrush="#C8C8C8" BorderThickness="0,1,0,1" />
                            <TextBlock Grid.Row="2" Text="▶" Foreground="#18B4CF" FontSize="10" VerticalAlignment="Center" /><TextBlock Grid.Row="2" Margin="15,0,0,0" Text="{Binding Operations.FlightNumber}" FontSize="14" FontWeight="Bold" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Operations.FlightDateShort}" FontWeight="Bold" /><StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal"><TextBlock Text="{Binding BoardingPoint}" FontWeight="Bold" /><TextBlock Text="-" /><TextBlock Text="{Binding Destination}" FontWeight="Bold" /></StackPanel><TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding Operations.ScheduledDeparture, StringFormat=STD  {0}}" FontWeight="Bold" /><TextBlock Grid.Row="2" Grid.Column="4" Text="{Binding Operations.ScheduledDeparture, StringFormat=ETD  {0}}" FontWeight="Bold" /><TextBlock Grid.Row="2" Grid.Column="5" Text="CTOT  --" FontWeight="Bold" /><TextBlock Grid.Row="2" Grid.Column="6" Text="STA  21:15z" FontWeight="Bold" /><TextBlock Grid.Row="2" Grid.Column="7" Text="ETA  21:15z" FontWeight="Bold" /><TextBlock Grid.Row="2" Grid.Column="8" Text="−" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right" />
                            <Grid Grid.Row="3" Grid.ColumnSpan="9" Margin="0,3,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="180" /><ColumnDefinition Width="180" /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Operations.AircraftName}" FontWeight="SemiBold" /><TextBlock Text="{Binding Operations.DetectedAircraftIcao}" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Status:  Flight open" /><TextBlock Text="{Binding Operations.BoardingBeginsAt, StringFormat=Boarding:  {0}}" /><TextBlock Text="{Binding Operations.GateNumber, StringFormat=Gate:  {0}}" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{Binding Operations.CheckedInPassengers, StringFormat=Checked-In:  {0}}" /><TextBlock Text="{Binding Operations.TotalPassengers, StringFormat=Booked:  {0}}" /></StackPanel><Border Grid.Column="3" Width="18" Height="18" CornerRadius="9" Background="#E40000" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock Text="i" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></Grid>
                            <Border Grid.Row="4" Grid.ColumnSpan="9" BorderBrush="#A0A0A0" BorderThickness="0,1,0,0">
                                <Grid Margin="0,3,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="205" /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel Grid.Column="1"><TextBlock Text="{Binding Operations.CheckedInPassengers, StringFormat=Total Checked-In:   {0}}" /><TextBlock Text="{Binding Operations.TotalPassengers, StringFormat=Total Booked:      {0}}" /></StackPanel></Grid>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1" Margin="8,0,8,8">
                            <Grid Visibility="{Binding ActiveModule, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Check-In}">
                                <Grid.RowDefinitions><RowDefinition Height="76" /><RowDefinition Height="28" /><RowDefinition /></Grid.RowDefinitions>
