                            <Grid Visibility="{Binding IsServicePlaceholder, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border Background="#FFFFFF" BorderBrush="#A4A4A4" BorderThickness="1" Padding="30">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="{Binding PlaceholderTitle}" Foreground="#1C1C1C" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" /><TextBlock Text="{Binding PlaceholderDescription}" Foreground="#4D4D4D" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="600" Margin="0,12,0,0" /></StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2" Background="{StaticResource IportBarBrush}" BorderBrush="#9A9A9A" BorderThickness="0,1,0,0" Tag="IportSystemFooter">
                <Grid Margin="10,4">
                    <Grid.RowDefinitions><RowDefinition Height="31" /><RowDefinition /></Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="625" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Grid>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsCustomerServiceTabsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"><Button Style="{StaticResource IportButton}" MinWidth="82"><TextBlock Text="F1-Help" Foreground="#151515" /></Button><Button Style="{StaticResource IportButton}" MinWidth="92" Margin="4,0,0,0" Command="{Binding ToggleGateCommand}"><TextBlock Text="F2-Action" Foreground="#151515" /></Button><Button Style="{StaticResource IportButton}" MinWidth="100" Margin="4,0,0,0" Command="{Binding SelectModuleCommand}" CommandParameter="Seatmap"><TextBlock Text="F4-Seatmap" Foreground="#151515" /></Button><Button Style="{StaticResource IportButton}" MinWidth="95" Margin="4,0,0,0" Command="{Binding RefreshCommand}"><TextBlock Text="F5-Refresh" Foreground="#151515" /></Button><Button Style="{StaticResource IportButton}" MinWidth="105" Margin="4,0,0,0" Command="{Binding CheckInCommand}"><TextBlock Text="F10-Check In" Foreground="#151515" /></Button><Button Style="{StaticResource IportButton}" MinWidth="105" Margin="4,0,0,0" Command="{Binding PrintCommand}"><TextBlock Text="F11-Print BP" Foreground="#151515" /></Button></StackPanel>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsLoadControlService, Converter={StaticResource BooleanToVisibilityConverter}}"><Button Style="{StaticResource IportButton}" MinWidth="72"><TextBlock Text="F1-Help" Foreground="#151515" /></Button><Button Style="{StaticResource IportButton}" MinWidth="82" Margin="4,0,0,0" Command="{Binding LoadActionCommand}" CommandParameter="Load Control action menu opened."><TextBlock Text="F2-Action" Foreground="#151515" /></Button><Button Style="{StaticResource IportButton}" MinWidth="88" Margin="4,0,0,0" Command="{Binding LoadActionCommand}" CommandParameter="Free-text load message opened."><TextBlock Text="F3-Free text" Foreground="#151515" /></Button><Button Style="{StaticResource IportButton}" MinWidth="118" Margin="4,0,0,0" Command="{Binding LoadActionCommand}" CommandParameter="Load sheet finalized for the active flight."><TextBlock Text="Finalize load sheet" Foreground="#151515" /></Button><Button Style="{StaticResource IportButton}" MinWidth="94" Margin="4,0,0,0" Command="{Binding LoadActionCommand}" CommandParameter="Load message sent through ACARS."><TextBlock Text="Send ACARS" Foreground="#151515" /></Button><Button Style="{StaticResource IportButton}" MinWidth="96" Margin="4,0,0,0" Command="{Binding LoadActionCommand}" CommandParameter="Trip information saved."><TextBlock Text="Save trip info" Foreground="#151515" /></Button></StackPanel>
                        </Grid>
                        <TextBlock Grid.Column="1" Text="{Binding CommandStatus}" Foreground="#444444" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding CommandStatus}" />
                    </Grid>
                    <Border Grid.Row="1" Background="#F7F7F7" BorderBrush="#B7B7B7" BorderThickness="1,1,1,0" Tag="IportStatusStrip">
                        <Grid Margin="8,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="215" /><ColumnDefinition Width="270" /><ColumnDefinition /><ColumnDefinition Width="62" /><ColumnDefinition Width="62" /></Grid.ColumnDefinitions>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="78" /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="iPort Version" FontWeight="Bold" /><TextBlock Text="User" FontWeight="Bold" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="v4.40.0 r25584" /><TextBlock Text="{Binding SignedInUser}" /></StackPanel></Grid>
                            <Grid Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="104" /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Boarding Point" FontWeight="Bold" /><TextBlock Text="Local time" FontWeight="Bold" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding BoardingPointLabel}" /><TextBlock Text="{Binding CurrentClock}" /></StackPanel></Grid>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom"><TextBlock Text="Domain" FontWeight="Bold" /><TextBlock Text="RES2  +" Margin="54,0,0,0" /></StackPanel>
                            <Button Grid.Column="3" Style="{StaticResource IportButton}" Margin="4,0" Command="{Binding LoadActionCommand}" CommandParameter="Printer status opened." Tag="IportPrinterControl"><TextBlock Text="&#xE749;" FontFamily="Segoe Fluent Icons" FontSize="23" Foreground="#626B70" /></Button>
                            <Button Grid.Column="4" Style="{StaticResource IportButton}" Margin="4,0" Command="{Binding LoadActionCommand}" CommandParameter="Local iPort session remains active." Tag="IportPowerControl"><TextBlock Text="&#xE7E8;" FontFamily="Segoe Fluent Icons" FontSize="24" Foreground="#626B70" /></Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.RowSpan="3"
                    Width="230"
                    Margin="237,43,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="#13B8D5"
                    BorderBrush="#DA2020"
                    BorderThickness="1"
                    Panel.ZIndex="100"
                    Tag="IportServiceMenu"
                    Visibility="{Binding IsServiceMenuOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl ItemsSource="{Binding ServiceMenuEntries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Border Height="24" Background="#0EAAC8" Padding="10,2" Visibility="{Binding IsHeader, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding Label}" Foreground="#07384A" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                                </Border>
                                <Button Style="{StaticResource IportMenuButton}"
                                        Command="{Binding DataContext.SelectServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding IsService, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="62" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" Foreground="#07384A" FontSize="13" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding Shortcut}" Foreground="#07384A" FontSize="12" HorizontalAlignment="Right" /></Grid>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Grid>
    </Border>
</UserControl>
