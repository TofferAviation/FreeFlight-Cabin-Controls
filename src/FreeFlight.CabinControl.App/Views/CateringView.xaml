<UserControl x:Class="FreeFlight.CabinControl.App.Views.CateringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ServiceTabStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="13,5" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTab}" Value="Menu"><Setter Property="Background" Value="{DynamicResource PrimaryBrush}" /><Setter Property="Foreground" Value="White" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ServiceItemCard" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,9,9" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="ONBOARD" Foreground="{DynamicResource PrimaryBrush}" FontSize="10" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding PageHeading}" Style="{StaticResource PageTitleStyle}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding PageDescription}" Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource SuccessPillStyle}" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{Binding CateringOverviewColor}" Margin="0,0,7,0" VerticalAlignment="Center" /><TextBlock Text="{Binding CateringLoadLabel}" Foreground="{DynamicResource SuccessTextBrush}" FontSize="10" FontWeight="SemiBold" /></StackPanel></Border>
            </Grid>

            <Border Style="{StaticResource HeroPanelStyle}" Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="255" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding MenuBrandLabel}" Foreground="#C9EDFF" FontSize="10" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding MenuExperienceTitle}" Foreground="White" FontSize="28" FontWeight="SemiBold" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding MenuExperienceSubtitle}" Foreground="#DCF2FF" FontSize="13" TextWrapping="Wrap" Margin="0,7,0,0" />
                        <TextBlock Text="{Binding ProfileLabel}" Foreground="#C9EDFF" FontSize="11" Margin="0,17,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="#2500162B" BorderBrush="#48FFFFFF" BorderThickness="1" CornerRadius="9" Padding="15" VerticalAlignment="Center"><StackPanel><TextBlock Text="FLIGHT CATERING" Foreground="#C9EDFF" FontSize="10" FontWeight="SemiBold" /><TextBlock Text="{Binding FlightNumber}" Foreground="White" FontSize="19" FontWeight="SemiBold" Margin="0,5,0,0" /><TextBlock Text="{Binding RouteLabel}" Foreground="#DDF3FF" FontSize="12" Margin="0,4,0,0" /><TextBlock Text="{Binding AircraftLabel}" Foreground="#DDF3FF" FontSize="11" Margin="0,3,0,0" /></StackPanel></Border>
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Button Content="Menu" Command="{Binding SelectTabCommand}" CommandParameter="Menu" Style="{StaticResource ServiceTabStyle}" />
                <Button Content="Service progress" Command="{Binding SelectTabCommand}" CommandParameter="Progress" Style="{StaticResource SecondaryButtonStyle}" MinHeight="34" Padding="13,5" Margin="0,0,7,0" />
                <Button Content="Inventory" Command="{Binding SelectTabCommand}" CommandParameter="Inventory" Style="{StaticResource SecondaryButtonStyle}" MinHeight="34" Padding="13,5" Margin="0,0,7,0" />
                <Button Content="Passenger preferences" Command="{Binding SelectTabCommand}" CommandParameter="Preferences" Style="{StaticResource SecondaryButtonStyle}" MinHeight="34" Padding="13,5" Margin="0,0,7,0" />
                <Button Content="Special meals" Command="{Binding SelectTabCommand}" CommandParameter="Special" Style="{StaticResource SecondaryButtonStyle}" MinHeight="34" Padding="13,5" />
            </StackPanel>

            <Grid Visibility="{Binding IsMenuVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Margin="0,0,0,14"><StackPanel Orientation="Horizontal"><TextBlock Text="Menu for" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" Margin="0,0,8,0" /><ItemsControl ItemsSource="{Binding Cabins}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Name}" Command="{Binding DataContext.SelectCabinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Name}" Style="{StaticResource SecondaryButtonStyle}" MinHeight="32" Padding="10,4" Margin="0,0,6,0" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="{Binding ServiceBandLabel}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" /></StackPanel></Grid>
                <ItemsControl Grid.Row="1" ItemsSource="{Binding VisibleMenuItems}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource ServiceItemCard}" Width="252"><StackPanel><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" /><Grid Margin="0,14,0,0"><TextBlock Text="{Binding PriceLabel}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" FontSize="12" /><TextBlock Text="{Binding AvailabilityLabel}" Foreground="{Binding AvailabilityColor}" HorizontalAlignment="Right" FontSize="11" /></Grid></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </Grid>

            <Grid Visibility="{Binding IsProgressVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.16*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0"><StackPanel><TextBlock Text="CURRENT SERVICE" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="{Binding CurrentActivityTitle}" Foreground="{DynamicResource PrimaryBrush}" FontSize="15" FontWeight="SemiBold" Margin="0,7,0,0" /><TextBlock Text="{Binding CurrentActivityDetail}" Style="{StaticResource MutedTextStyle}" FontSize="11" Margin="0,4,0,16" /><ProgressBar Value="{Binding CurrentActivityProgress, Mode=OneWay}" Maximum="100" Height="8" /><Grid Margin="0,7,0,0"><TextBlock Text="{Binding CurrentActivitySubtitle}" Style="{StaticResource MutedTextStyle}" FontSize="11" /><TextBlock Text="{Binding CurrentActivityProgressLabel}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="11" /></Grid><StackPanel Orientation="Horizontal" Margin="0,20,0,0"><Button Content="{Binding HoldButtonLabel}" Command="{Binding ToggleServiceHoldCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" /><Button Content="Skip service" Command="{Binding SkipServiceCommand}" Style="{StaticResource SecondaryButtonStyle}" /></StackPanel></StackPanel></Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="CABIN ACTIVITY" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="{Binding MealServiceStatus}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,10,0,0" /><TextBlock Text="{Binding DrinkServiceStatus}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,8,0,0" /><TextBlock Text="{Binding LavatoryQueueStatus}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,8,0,0" /><Border Style="{StaticResource InfoRowStyle}" Margin="0,16,0,0"><StackPanel><TextBlock Text="NEXT" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" /><TextBlock Text="{Binding NextServiceDisplayTitle}" FontWeight="SemiBold" FontSize="13" Margin="0,5,0,0" /><TextBlock Text="{Binding NextServiceEtaLabel}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,3,0,0" /></StackPanel></Border></StackPanel></Border>
            </Grid>

            <Border Style="{StaticResource CardStyle}" Visibility="{Binding IsInventoryVisible, Converter={StaticResource BooleanToVisibilityConverter}}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid><StackPanel><TextBlock Text="INVENTORY" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="{Binding InventoryStatus}" Style="{StaticResource MutedTextStyle}" FontSize="11" Margin="0,3,0,0" /></StackPanel><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><TextBlock Text="{Binding InventoryUsageLabel}" Foreground="{DynamicResource PrimaryBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" /><Button Content="Reset inventory" Command="{Binding ResetInventoryCommand}" Style="{StaticResource SecondaryButtonStyle}" /></StackPanel></Grid><ListBox Grid.Row="1" ItemsSource="{Binding VisibleInventory}" BorderThickness="0" Background="Transparent" Margin="0,16,0,0" Height="350"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,0,0,1" Padding="0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="100" /><ColumnDefinition Width="100" /><ColumnDefinition Width="95" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" /><TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" TextTrimming="CharacterEllipsis" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding TargetQuantity, StringFormat=Loaded {0}}" FontSize="11" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="{Binding Used, StringFormat=Used {0}}" FontSize="11" VerticalAlignment="Center" /><TextBlock Grid.Column="3" Text="{Binding AvailabilityLabel}" Foreground="{Binding AvailabilityColor}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" /></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>

            <Border Style="{StaticResource CardStyle}" Visibility="{Binding IsPreferencesVisible, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel><TextBlock Text="PASSENGER PREFERENCES" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="Meal selections carried from the currently loaded flight." Style="{StaticResource MutedTextStyle}" FontSize="11" Margin="0,3,0,13" /><ListBox ItemsSource="{Binding VisiblePassengerPreferences}" BorderThickness="0" Background="Transparent" Height="390"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,0,0,1" Padding="0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="75" /><ColumnDefinition Width="1.3*" /><ColumnDefinition Width="1.5*" /><ColumnDefinition Width="1.1*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Seat}" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" /><TextBlock Grid.Column="2" Text="{Binding MealSelection}" FontSize="12" /><TextBlock Grid.Column="3" Text="{Binding SpecialMeal}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" /></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border>

            <Border Style="{StaticResource CardStyle}" Visibility="{Binding IsSpecialMealsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel><TextBlock Text="SPECIAL MEALS" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="{Binding TotalSpecialMeals, StringFormat={}{0} dietary requests recorded for this flight}" Style="{StaticResource MutedTextStyle}" FontSize="11" Margin="0,3,0,13" /><ItemsControl ItemsSource="{Binding SpecialMeals}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,0,0,1" Padding="0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="1.2*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Seat}" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" /><TextBlock Grid.Column="2" Text="{Binding SpecialMeal}" Foreground="{DynamicResource PrimaryBrush}" FontSize="12" FontWeight="SemiBold" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
