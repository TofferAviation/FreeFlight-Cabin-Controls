<UserControl x:Class="FreeFlight.CabinControl.App.Views.CateringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <SolidColorBrush x:Key="BaInk" Color="#102A50"/>
        <SolidColorBrush x:Key="BaBlue" Color="#0766CE"/>
        <SolidColorBrush x:Key="BaPanel" Color="#06233F"/>
        <SolidColorBrush x:Key="BaLine" Color="#B7C9DD"/>
        <Style x:Key="BaTab" TargetType="Button">
            <Setter Property="Height" Value="50"/><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="12,6"/>
            <Setter Property="Background" Value="#F7FAFD"/><Setter Property="Foreground" Value="#102A50"/>
            <Setter Property="BorderBrush" Value="#AFC3D9"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="chrome" Property="Opacity" Value="0.88"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="DarkCard" TargetType="Border"><Setter Property="Background" Value="#05223D"/><Setter Property="BorderBrush" Value="#163E61"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="7"/><Setter Property="Padding" Value="14"/></Style>
        <Style x:Key="WhiteCard" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#CBD8E6"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="5"/><Setter Property="Padding" Value="10"/></Style>
        <Style x:Key="DarkHeading" TargetType="TextBlock"><Setter Property="Foreground" Value="White"/><Setter Property="FontSize" Value="19"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
        <Style x:Key="InkHeading" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource BaInk}"/><Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
        <Style x:Key="PaleText" TargetType="TextBlock"><Setter Property="Foreground" Value="#AFC7DE"/><Setter Property="FontSize" Value="12"/></Style>
        <Style x:Key="TableHeader" TargetType="TextBlock"><Setter Property="Foreground" Value="#7895B1"/><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style x:Key="TableRow" TargetType="Border"><Setter Property="BorderBrush" Value="#143A5C"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="Padding" Value="7,6"/></Style>
        <Style x:Key="ServiceProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="11"/><Setter Property="Background" Value="#294B69"/><Setter Property="Foreground" Value="#42DF92"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Grid ClipToBounds="True"><Border Background="{TemplateBinding Background}" CornerRadius="2"/><Border x:Name="PART_Track"/><Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2" HorizontalAlignment="Left"/></Grid></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="HeaderActionButton" TargetType="Button" BasedOn="{StaticResource BaTab}">
            <Setter Property="Height" Value="43"/><Setter Property="MinWidth" Value="156"/><Setter Property="Margin" Value="8,0,0,0"/><Setter Property="Background" Value="#EAF3FB"/><Setter Property="BorderBrush" Value="#2F6FAD"/><Setter Property="Foreground" Value="#173A63"/>
        </Style>
        <Style x:Key="FooterInfoText" TargetType="TextBlock"><Setter Property="Foreground" Value="#173A63"/><Style.Triggers><DataTrigger Binding="{Binding IsProgressVisible}" Value="True"><Setter Property="Foreground" Value="#E5EEF7"/></DataTrigger></Style.Triggers></Style>
        <Style x:Key="FooterSeparatorText" TargetType="TextBlock"><Setter Property="Foreground" Value="#8AA0B6"/></Style>
        <Style x:Key="CabinPhotoButton" TargetType="Button"><Setter Property="Height" Value="68"/><Setter Property="Margin" Value="0,0,0,7"/><Setter Property="Padding" Value="0"/><Setter Property="BorderBrush" Value="#7FB4E7"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="#0C3157"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" ClipToBounds="True"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="chrome" Property="BorderBrush" Value="#55AEFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter><Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="BorderBrush" Value="#78BFFF"/><Setter Property="BorderThickness" Value="2"/></DataTrigger></Style.Triggers></Style>
        <DataTemplate x:Key="CabinPhotoTemplate">
            <Button Style="{StaticResource CabinPhotoButton}" Command="{Binding DataContext.SelectCabinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Name}">
                <Grid><Rectangle><Rectangle.Fill><ImageBrush ImageSource="pack://application:,,,/FreeFlight.CabinControl;component/Assets/Catering/CabinClassesAtlas.png" Viewbox="{Binding ImageViewbox}" ViewboxUnits="RelativeToBoundingBox" Stretch="UniformToFill"/></Rectangle.Fill></Rectangle><Rectangle Fill="#8E031A31"/><Border Width="9" HorizontalAlignment="Left" Background="{Binding AccentColor}"/><StackPanel Margin="20,0,8,0" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" Foreground="White" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding PassengerLabel}" Foreground="#C8D9E9"/></StackPanel></Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Background="#F4F8FC">
        <Border Background="#F4F8FC">
            <Grid MinHeight="780">
                <Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="48"/></Grid.RowDefinitions>

                <!-- Page heading -->
                <Border Grid.Row="0" Height="92" BorderBrush="#C5D5E5" BorderThickness="0,0,0,1">
                    <Grid>
                        <Image Source="pack://application:,,,/FreeFlight.CabinControl;component/Assets/Catering/AircraftHeader.png" Width="720" Height="92" HorizontalAlignment="Center" Stretch="Fill" Opacity="0.78"><Image.Style><Style TargetType="Image"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsProgressVisible}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Image.Style></Image>
                        <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#F8FBFE" Offset="0"/><GradientStop Color="#66F1F7FB" Offset="0.34"/><GradientStop Color="#11FFFFFF" Offset="0.58"/><GradientStop Color="#AAF8FBFE" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
                        <Grid Margin="22,10">
                            <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding PageHeading}" Foreground="{StaticResource BaInk}" FontSize="31" FontWeight="SemiBold"/><TextBlock Text="{Binding PageDescription}" Foreground="#29486C" FontSize="15" Margin="0,2,0,0"/></StackPanel>
                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsProgressVisible}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="A TASTE OF A" Foreground="#173A66" FontFamily="Georgia" FontSize="12" HorizontalAlignment="Center"/><TextBlock Text="BRIGHTER JOURNEY" Foreground="#173A66" FontFamily="Georgia" FontSize="15"/><TextBlock Text="BRITISH AIRWAYS" Foreground="#153B6B" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                            <Grid HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="{Binding IsProgressVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.RowDefinitions><RowDefinition Height="43"/><RowDefinition Height="27"/></Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Border Background="#EAF3FB" BorderBrush="#2F6FAD" BorderThickness="1" CornerRadius="5" Padding="13,0" Height="43"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Auto Progress" Foreground="#173A63" FontSize="14" FontWeight="SemiBold" Margin="0,0,13,0"/><ToggleButton IsChecked="{Binding AutoProgress}" Style="{StaticResource PillToggleStyle}"/></StackPanel></Border>
                                    <Button Command="{Binding ToggleTimingEditorCommand}" Style="{StaticResource HeaderActionButton}"><TextBlock Text="⚙  Adjust Timings" Foreground="#173A63" FontSize="14" FontWeight="SemiBold"/></Button>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="{Binding IsTimingEditorVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="Service timing:" Foreground="#496581" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <Button Content="−15" Command="{Binding AdvanceServiceTimingCommand}" Padding="7,1" Height="23"/>
                                    <TextBlock Text="{Binding ServiceTimingOffsetLabel}" Foreground="#173A63" FontWeight="SemiBold" MinWidth="105" TextAlignment="Center" VerticalAlignment="Center"/>
                                    <Button Content="+15" Command="{Binding DelayServiceTimingCommand}" Padding="7,1" Height="23"/>
                                    <Button Content="Reset" Command="{Binding ResetServiceTimingCommand}" Padding="7,1" Height="23" Margin="5,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Tabs -->
                <UniformGrid Grid.Row="1" Columns="5" Margin="0,7">
                    <Button Command="{Binding SelectTabCommand}" CommandParameter="Menu"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource BaTab}"><Style.Triggers><DataTrigger Binding="{Binding IsMenuVisible}" Value="True"><Setter Property="Background" Value="#1769C9"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#1769C9"/></DataTrigger></Style.Triggers></Style></Button.Style><TextBlock Text="🍴  Menu Selection" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
                    <Button Command="{Binding SelectTabCommand}" CommandParameter="Progress"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource BaTab}"><Style.Triggers><DataTrigger Binding="{Binding IsProgressVisible}" Value="True"><Setter Property="Background" Value="#1769C9"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#1769C9"/></DataTrigger></Style.Triggers></Style></Button.Style><TextBlock Text="◷  Service Progress" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
                    <Button Command="{Binding SelectTabCommand}" CommandParameter="Inventory"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource BaTab}"><Style.Triggers><DataTrigger Binding="{Binding IsInventoryVisible}" Value="True"><Setter Property="Background" Value="#1769C9"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#1769C9"/></DataTrigger></Style.Triggers></Style></Button.Style><TextBlock Text="▣  Inventory" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
                    <Button Command="{Binding SelectTabCommand}" CommandParameter="Preferences"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource BaTab}"><Style.Triggers><DataTrigger Binding="{Binding IsPreferencesVisible}" Value="True"><Setter Property="Background" Value="#1769C9"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#1769C9"/></DataTrigger></Style.Triggers></Style></Button.Style><TextBlock Text="●  Passenger Preferences" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
                    <Button Command="{Binding SelectTabCommand}" CommandParameter="Special"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource BaTab}"><Style.Triggers><DataTrigger Binding="{Binding IsSpecialMealsVisible}" Value="True"><Setter Property="Background" Value="#1769C9"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#1769C9"/></DataTrigger></Style.Triggers></Style></Button.Style><TextBlock Text="♡  Special Meals" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
                </UniformGrid>

                <Grid Grid.Row="2">
                    <!-- MENU SELECTION -->
                    <Grid Visibility="{Binding IsMenuVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="380"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource DarkCard}" Margin="0,0,5,0" Padding="16">
                            <StackPanel><TextBlock Text="Flight Catering Overview" Style="{StaticResource DarkHeading}"/><Rectangle Height="1" Fill="#315270" Margin="0,8,0,10"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Flight" Style="{StaticResource PaleText}" Margin="0,0,0,9"/><TextBlock Text="Route" Style="{StaticResource PaleText}" Margin="0,0,0,9"/><TextBlock Text="Aircraft" Style="{StaticResource PaleText}" Margin="0,0,0,9"/><TextBlock Text="Flight Time" Style="{StaticResource PaleText}" Margin="0,0,0,9"/><TextBlock Text="Dep. Time" Style="{StaticResource PaleText}" Margin="0,0,0,9"/><TextBlock Text="Catering Cycle" Style="{StaticResource PaleText}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding FlightNumber}" Foreground="White" Margin="0,0,0,9"/><TextBlock Text="{Binding RouteLabel}" Foreground="White" Margin="0,0,0,9" TextTrimming="CharacterEllipsis" ToolTip="{Binding RouteLabel}"/><TextBlock Text="{Binding AircraftLabel}" Foreground="White" Margin="0,0,0,9" TextTrimming="CharacterEllipsis" ToolTip="{Binding AircraftLabel}"/><TextBlock Text="{Binding DurationLabel}" Foreground="White" Margin="0,0,0,9"/><TextBlock Text="{Binding DepartureLabel}" Foreground="White" Margin="0,0,0,9"/><TextBlock Text="{Binding CateringCycleLabel}" Foreground="White" TextWrapping="Wrap"/></StackPanel></Grid>
                                <Border Background="#123D60" CornerRadius="6" Padding="10" Margin="0,15"><Grid><Ellipse Fill="{Binding CateringOverviewColor}" Width="36" Height="36" HorizontalAlignment="Left"/><TextBlock Text="{Binding CateringOverviewSymbol}" Foreground="White" FontSize="21" HorizontalAlignment="Left" Margin="11,3,0,0"/><StackPanel Margin="48,0,0,0"><TextBlock Text="{Binding CateringOverviewTitle}" Foreground="White" FontWeight="SemiBold"/><TextBlock Text="{Binding CateringOverviewDescription}" Style="{StaticResource PaleText}" TextWrapping="Wrap"/></StackPanel></Grid></Border>
                                <TextBlock Text="Cabin Classes on this Aircraft" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/><ItemsControl ItemsSource="{Binding Cabins}" ItemTemplate="{StaticResource CabinPhotoTemplate}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource DarkCard}" Margin="5,0,0,0" Padding="12">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="2.1*"/><RowDefinition Height="44"/><RowDefinition Height="1.35*"/><RowDefinition Height="1.7*"/></Grid.RowDefinitions>
                                <Grid><StackPanel VerticalAlignment="Center" Margin="0,0,180,0"><TextBlock Text="{Binding MenuExperienceTitle}" Foreground="White" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding MenuExperienceSubtitle}" Style="{StaticResource PaleText}" FontSize="14" TextWrapping="Wrap"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="{Binding MenuBrandLabel}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="NoWrap"/><Rectangle Width="34" Height="25" Margin="8,0,0,0"><Rectangle.Fill><ImageBrush ImageSource="pack://application:,,,/FreeFlight.CabinControl;component/Assets/AirlineLogos/BAW.png" Viewbox="0.76,0,0.24,1" ViewboxUnits="RelativeToBoundingBox" Stretch="UniformToFill"/></Rectangle.Fill></Rectangle></StackPanel></Grid>
                                <Border Grid.Row="1" CornerRadius="6" ClipToBounds="True" Margin="0,5,0,7"><Grid><Image Source="pack://application:,,,/FreeFlight.CabinControl;component/Assets/Catering/DiningHero.png" Stretch="Fill"/><Rectangle Fill="#18000000"/><Rectangle Width="390" HorizontalAlignment="Right"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#00000000" Offset="0"/><GradientStop Color="#D5000710" Offset="0.32"/><GradientStop Color="#F5000710" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle><StackPanel HorizontalAlignment="Right" Width="315" Margin="0,0,24,0" VerticalAlignment="Center"><TextBlock Text="{Binding MenuHeroTitle}" Foreground="White" FontFamily="Georgia" FontSize="24" TextWrapping="Wrap"/><TextBlock Text="{Binding MenuHeroDescription}" Foreground="White" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Grid></Border>
                                <ItemsControl Grid.Row="2" ItemsSource="{Binding CourseOptions}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Command="{Binding DataContext.SelectCourseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Name}" Height="38" Margin="2" Foreground="White" BorderBrush="#315778" IsEnabled="{Binding IsAvailable}"><Button.Style><Style TargetType="Button"><Setter Property="Background" Value="#0D3153"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="#125DA5"/><Setter Property="BorderBrush" Value="#5CB7FF"/></DataTrigger><DataTrigger Binding="{Binding IsAvailable}" Value="False"><Setter Property="Opacity" Value="0.48"/></DataTrigger></Style.Triggers></Style></Button.Style><TextBlock Text="{Binding DisplayName}" Foreground="White" FontSize="10" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" TextAlignment="Center"/></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                <Border Grid.Row="3" Background="#F4F7FA" CornerRadius="5" Padding="8" Margin="0,5"><ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly"><ItemsControl ItemsSource="{Binding VisibleMenuItems}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource WhiteCard}" Margin="3" Width="252"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition/></Grid.ColumnDefinitions><Rectangle RadiusX="4" RadiusY="4"><Rectangle.Fill><ImageBrush ImageSource="pack://application:,,,/FreeFlight.CabinControl;component/Assets/Catering/MenuDishesAtlas.png" Viewbox="{Binding ThumbnailViewbox}" ViewboxUnits="RelativeToBoundingBox" Stretch="UniformToFill"/></Rectangle.Fill></Rectangle><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="{Binding Name}" Foreground="#14263E" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Description}" Foreground="#5D6C7C" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"/><Border Background="#DDF5EA" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left" Margin="0,8,0,0"><TextBlock Text="{Binding StockStatus}" Foreground="#168C55" FontSize="10"/></Border></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Border>
                                <Grid Grid.Row="4" Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource DarkCard}" Margin="0,0,4,0"><StackPanel><Grid><TextBlock Text="{Binding PassengerOrdersHeading}" Style="{StaticResource DarkHeading}" FontSize="15"/><TextBlock Text="View All" Foreground="#64B7FF" HorizontalAlignment="Right"/></Grid><Grid Margin="0,9,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="85"/></Grid.ColumnDefinitions><TextBlock Text="Seat" Style="{StaticResource TableHeader}"/><TextBlock Grid.Column="1" Text="Passenger" Style="{StaticResource TableHeader}"/><TextBlock Grid.Column="2" Text="Order" Style="{StaticResource TableHeader}"/><TextBlock Grid.Column="3" Text="Status" Style="{StaticResource TableHeader}"/></Grid><ItemsControl ItemsSource="{Binding VisiblePassengerPreferences}"><ItemsControl.ItemTemplate><DataTemplate><Grid Height="22"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="85"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Seat}" Foreground="White"/><TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#D6E2EE" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="2" Text="{Binding MealSelection}" Foreground="#D6E2EE" TextTrimming="CharacterEllipsis"/><StackPanel Grid.Column="3" Orientation="Horizontal"><TextBlock Text="{Binding StatusSymbol}" Foreground="{Binding StatusColor}" Margin="0,0,5,0"/><TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}"/></StackPanel></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource DarkCard}" Margin="4,0,0,0"><StackPanel><Grid><TextBlock Text="Service Notes" Style="{StaticResource DarkHeading}" FontSize="15"/><TextBlock Text="✎  Edit" Foreground="#64B7FF" HorizontalAlignment="Right"/></Grid><TextBlock Text="{Binding ServiceNoteOne}" Style="{StaticResource PaleText}" Margin="0,10,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding ServiceNoteTwo}" Style="{StaticResource PaleText}" Margin="0,8,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding ServiceNoteThree}" Style="{StaticResource PaleText}" Margin="0,8,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding ServiceNoteFour}" Style="{StaticResource PaleText}" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></Border></Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- SERVICE PROGRESS -->
                    <Grid Visibility="{Binding IsProgressVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions><RowDefinition Height="174"/><RowDefinition Height="*"/></Grid.RowDefinitions>

                        <Border Style="{StaticResource DarkCard}" Padding="16,12" Margin="0,0,0,5">
                            <Grid>
                                <Border Height="2" Background="#7EA3C5" Margin="55,0" VerticalAlignment="Center"/>
                                <ItemsControl ItemsSource="{Binding ServicePhases}" VerticalAlignment="Stretch">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2,0">
                                                <Grid.RowDefinitions><RowDefinition Height="45"/><RowDefinition Height="39"/><RowDefinition Height="42"/><RowDefinition Height="22"/></Grid.RowDefinitions>
                                                <TextBlock Text="{Binding Icon}" Foreground="#B9D9F2" FontFamily="Segoe UI Symbol, Segoe UI Emoji" FontSize="{Binding IconSize}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Grid Grid.Row="1">
                                                    <Border Height="2" Background="{Binding ConnectorColor}" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                                                    <Ellipse Fill="{Binding NodeFill}" Stroke="{Binding NodeStroke}" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Width" Value="15"/><Setter Property="Height" Value="15"/><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="Active"><Setter Property="Width" Value="31"/><Setter Property="Height" Value="31"/><Setter Property="StrokeThickness" Value="3"/></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                                                    </Ellipse>
                                                    <Ellipse Width="9" Height="9" Fill="#05223D" HorizontalAlignment="Center" VerticalAlignment="Center"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="Active"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse>
                                                </Grid>
                                                <TextBlock Grid.Row="2" Text="{Binding Name}" Foreground="White" TextAlignment="Center" TextWrapping="Wrap" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Row="3" Text="{Binding StatusDetail}" Foreground="{Binding Color}" TextAlignment="Center" FontSize="10.5" VerticalAlignment="Top"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" Margin="0,5,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.18*"/><ColumnDefinition Width="0.97*"/></Grid.ColumnDefinitions>

                            <Border Style="{StaticResource DarkCard}" Margin="0,0,5,0" Padding="16,12">
                                <Grid><Grid.RowDefinitions><RowDefinition Height="35"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <TextBlock Text="Service Status" Style="{StaticResource DarkHeading}"/>
                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Cabins}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#0B3154" BorderBrush="#23527A" BorderThickness="1" CornerRadius="5" Margin="0,3" ClipToBounds="True">
                                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.02*"/><ColumnDefinition Width="1.42*"/></Grid.ColumnDefinitions>
                                                        <Grid>
                                                            <Rectangle><Rectangle.Fill><ImageBrush ImageSource="pack://application:,,,/FreeFlight.CabinControl;component/Assets/Catering/CabinClassesAtlas.png" Viewbox="{Binding ImageViewbox}" ViewboxUnits="RelativeToBoundingBox" Stretch="UniformToFill"/></Rectangle.Fill></Rectangle>
                                                            <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#D205223D" Offset="0"/><GradientStop Color="#8805223D" Offset="0.72"/><GradientStop Color="#2205223D" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
                                                            <Border Width="8" HorizontalAlignment="Left" Background="{Binding AccentColor}"/>
                                                            <StackPanel Margin="22,0,8,0" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" Foreground="White" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding ServicePassengerLabel}" Foreground="#D4E1ED" FontSize="12.5"/></StackPanel>
                                                        </Grid>
                                                        <Grid Grid.Column="1" Margin="15,8,13,8"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="22"/></Grid.RowDefinitions>
                                                            <TextBlock Text="{Binding ServiceLabel}" Foreground="#E1EBF4" FontSize="13.5" VerticalAlignment="Center"/>
                                                            <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="55"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                                                                <ProgressBar Value="{Binding ServiceProgress, Mode=OneWay}" Maximum="100" Style="{StaticResource ServiceProgressBar}" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding ServiceProgressLabel}" Foreground="White" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="2" Text="›" Foreground="#B9DCF8" FontSize="30" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,-7,0,0"/>
                                                            </Grid>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource DarkCard}" Margin="5,0,0,0" Padding="0" ClipToBounds="True">
                                <Grid><Grid.RowDefinitions><RowDefinition Height="1.48*"/><RowDefinition Height="1.02*"/></Grid.RowDefinitions>
                                    <Grid ClipToBounds="True">
                                        <Image Source="pack://application:,,,/FreeFlight.CabinControl;component/Assets/Catering/ServiceActivity.png" Stretch="UniformToFill" HorizontalAlignment="Right" Width="520"/>
                                        <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#F205223D" Offset="0"/><GradientStop Color="#DC05223D" Offset="0.43"/><GradientStop Color="#5505223D" Offset="0.82"/><GradientStop Color="#1205223D" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
                                        <Grid Margin="20,14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="27"/></Grid.RowDefinitions>
                                            <TextBlock Text="Current Activity" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
                                            <StackPanel Grid.Row="1" VerticalAlignment="Center"><TextBlock Foreground="White" FontSize="22" FontWeight="SemiBold"><Run Text="🍴  "/><Run Text="{Binding CurrentActivityTitle, Mode=OneWay}"/></TextBlock><TextBlock Text="{Binding CurrentActivitySubtitle}" Foreground="#D4E5F2" FontSize="15" Margin="0,4,0,0"/><TextBlock Text="{Binding CurrentActivityDetail}" Foreground="#D4E5F2" FontSize="13"/></StackPanel>
                                            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions><ProgressBar Value="{Binding CurrentActivityProgress, Mode=OneWay}" Maximum="100" Style="{StaticResource ServiceProgressBar}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding CurrentActivityProgressLabel}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                                        </Grid>
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="20,10,20,15"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="50"/></Grid.RowDefinitions>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <Ellipse Width="45" Height="45" Stroke="#62B9FA" StrokeThickness="2" Fill="#092C4C" HorizontalAlignment="Left"/><TextBlock Text="☕" Foreground="#79C7FF" FontFamily="Segoe UI Symbol, Segoe UI Emoji" FontSize="22" HorizontalAlignment="Left" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Next Phase" Foreground="White" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="{Binding NextServiceDisplayTitle}" Foreground="White" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0"/><TextBlock Text="{Binding NextServiceEtaLabel}" Foreground="#BFD3E5" FontSize="12.5"/></StackPanel>
                                        </Grid>
                                        <Grid Grid.Row="1" Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="{Binding HoldButtonLabel}" Command="{Binding ToggleServiceHoldCommand}" Style="{StaticResource SecondaryButtonStyle}" FontSize="12"/><Button Grid.Column="2" Content="▷  Skip to Next Phase" Command="{Binding SkipServiceCommand}" Style="{StaticResource PrimaryButtonStyle}" FontSize="12"/></Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- INVENTORY -->
                    <Grid Visibility="{Binding IsInventoryVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Height="565"><Grid.ColumnDefinitions><ColumnDefinition Width="235"/><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource DarkCard}" Margin="0,0,5,0"><StackPanel><ItemsControl ItemsSource="{Binding Cabins}" ItemTemplate="{StaticResource CabinPhotoTemplate}"/></StackPanel></Border>
                        <Border Grid.Column="1" Style="{StaticResource DarkCard}" Margin="5"><StackPanel><TextBlock Text="{Binding SelectedCabin, StringFormat={}{0} Inventory}" Style="{StaticResource DarkHeading}"/><Grid Margin="0,12,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="60"/><ColumnDefinition Width="70"/><ColumnDefinition Width="55"/><ColumnDefinition Width="85"/></Grid.ColumnDefinitions><TextBlock Text=""/><TextBlock Grid.Column="1" Text="ITEM" Style="{StaticResource TableHeader}"/><TextBlock Grid.Column="2" Text="LOADED" Style="{StaticResource TableHeader}"/><TextBlock Grid.Column="3" Text="REMAINING" Style="{StaticResource TableHeader}"/><TextBlock Grid.Column="4" Text="USED" Style="{StaticResource TableHeader}"/><TextBlock Grid.Column="5" Text="STATUS" Style="{StaticResource TableHeader}"/></Grid><ScrollViewer VerticalScrollBarVisibility="Hidden" Height="470"><ItemsControl ItemsSource="{Binding VisibleInventory}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource TableRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="60"/><ColumnDefinition Width="70"/><ColumnDefinition Width="55"/><ColumnDefinition Width="85"/></Grid.ColumnDefinitions><Rectangle Width="30" Height="30" RadiusX="3" RadiusY="3"><Rectangle.Fill><ImageBrush ImageSource="pack://application:,,,/FreeFlight.CabinControl;component/Assets/Catering/MenuDishesAtlas.png" Viewbox="{Binding ThumbnailViewbox}" ViewboxUnits="RelativeToBoundingBox" Stretch="UniformToFill"/></Rectangle.Fill></Rectangle><TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="White" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding TargetQuantity}" Foreground="#D6E2ED" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="{Binding Quantity, Mode=OneWay}" Foreground="#D6E2ED" VerticalAlignment="Center"/><TextBlock Grid.Column="4" Text="{Binding Used, Mode=OneWay}" Foreground="#D6E2ED" VerticalAlignment="Center"/><TextBlock Grid.Column="5" Text="{Binding StockStatus, Mode=OneWay}" Foreground="{Binding StockColor, Mode=OneWay}" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></StackPanel></Border>
                        <StackPanel Grid.Column="2" Margin="5,0,0,0"><Border Style="{StaticResource DarkCard}" Height="340"><StackPanel><TextBlock Text="Total Usage" Style="{StaticResource DarkHeading}"/><Grid Width="150" Height="150" Margin="0,20"><Ellipse Stroke="#294865" StrokeThickness="14"/><Ellipse Stroke="#1595F6" StrokeThickness="14" StrokeDashArray="3,1"/><Ellipse Fill="#07203A" Margin="20"/><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding InventoryUsagePercent, StringFormat={}{0:0}%}" Foreground="White" FontSize="27" HorizontalAlignment="Center"/><TextBlock Text="used" Foreground="#9AB3CA" HorizontalAlignment="Center"/></StackPanel></Grid><TextBlock Text="{Binding UsedUnits, StringFormat={}{0} items used}" Foreground="#C9D9E8" HorizontalAlignment="Center"/><TextBlock Text="●  Available" Foreground="#58E68A" Margin="7,16,0,0"/><TextBlock Text="●  Low stock" Foreground="#FFB55F" Margin="7,5,0,0"/><TextBlock Text="●  Out of stock" Foreground="#FF6373" Margin="7,5,0,0"/></StackPanel></Border><Button Content="▣  Reset Inventory" Command="{Binding ResetInventoryCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,8,0,0"/></StackPanel>
                    </Grid>

                    <!-- PASSENGER PREFERENCES -->
                    <Grid Visibility="{Binding IsPreferencesVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Height="565"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="265"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource DarkCard}" Margin="0,0,5,0"><ItemsControl ItemsSource="{Binding Cabins}" ItemTemplate="{StaticResource CabinPhotoTemplate}"/></Border>
                        <Border Grid.Column="1" Style="{StaticResource DarkCard}" Margin="5"><StackPanel><Border Background="#0A3155" CornerRadius="5" Padding="10" Margin="0,0,0,8"><TextBlock Text="Search passenger (name, seat, meal...)" Foreground="#86A4C0"/></Border><Grid Margin="6,0,6,4"><Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition/><ColumnDefinition Width="95"/></Grid.ColumnDefinitions><TextBlock Text="SEAT" Style="{StaticResource TableHeader}"/><TextBlock Grid.Column="1" Text="NAME" Style="{StaticResource TableHeader}"/><TextBlock Grid.Column="2" Text="MEAL SELECTION" Style="{StaticResource TableHeader}"/><TextBlock Grid.Column="3" Text="SPECIAL MEAL" Style="{StaticResource TableHeader}"/><TextBlock Grid.Column="4" Text="STATUS" Style="{StaticResource TableHeader}"/></Grid><ScrollViewer VerticalScrollBarVisibility="Hidden" Height="460"><ItemsControl ItemsSource="{Binding VisiblePassengerPreferences}"><ItemsControl.ItemTemplate><DataTemplate><Button Command="{Binding DataContext.SelectPassengerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch"><Border Style="{StaticResource TableRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition/><ColumnDefinition Width="95"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Seat}" Foreground="White"/><TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#D9E5EF" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="2" Text="{Binding MealSelection}" Foreground="#D9E5EF" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="3" Text="{Binding SpecialMeal}" Foreground="#58E68A"/><TextBlock Grid.Column="4" Text="{Binding Status}" Foreground="{Binding StatusColor}"/></Grid></Border></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></StackPanel></Border>
                        <Border Grid.Column="2" Style="{StaticResource DarkCard}" Margin="5,0,0,0" DataContext="{Binding SelectedPassengerPreference}"><StackPanel><Border Height="145" CornerRadius="5" ClipToBounds="True"><Grid><Rectangle><Rectangle.Fill><ImageBrush ImageSource="pack://application:,,,/FreeFlight.CabinControl;component/Assets/Catering/CabinClassesAtlas.png" Viewbox="0.5,0,0.5,0.5" ViewboxUnits="RelativeToBoundingBox" Stretch="UniformToFill"/></Rectangle.Fill></Rectangle><Rectangle Fill="#5505223D"/><TextBlock Text="{Binding Seat}" Foreground="White" FontSize="27" FontWeight="Bold" Margin="12" VerticalAlignment="Bottom"/></Grid></Border><TextBlock Text="{Binding Name}" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,0"/><TextBlock Text="{Binding Cabin}" Foreground="#7CBFFF"/><Border Background="#12375A" CornerRadius="5" Padding="8" Margin="0,12"><StackPanel><TextBlock Text="Booked Meal" Foreground="#8FA9C0" FontSize="10"/><Rectangle Height="90" Margin="0,6"><Rectangle.Fill><ImageBrush ImageSource="pack://application:,,,/FreeFlight.CabinControl;component/Assets/Catering/MenuDishesAtlas.png" Viewbox="0,0,0.333,1" ViewboxUnits="RelativeToBoundingBox" Stretch="UniformToFill"/></Rectangle.Fill></Rectangle><TextBlock Text="{Binding MealSelection}" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel></Border><TextBlock Text="DIETARY NOTES" Style="{StaticResource TableHeader}"/><TextBlock Text="{Binding SpecialMeal}" Foreground="#D8E5F0" Margin="0,4,0,14"/><Button Content="Edit Selection" Style="{StaticResource PrimaryButtonStyle}"/></StackPanel></Border>
                    </Grid>

                    <!-- SPECIAL MEALS -->
                    <Grid Visibility="{Binding IsSpecialMealsVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Height="565"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource DarkCard}" Margin="0,0,5,0"><StackPanel><Button Content="All Classes" Style="{StaticResource PrimaryButtonStyle}" HorizontalContentAlignment="Left"/><TextBlock Text="{Binding PassengerCount, StringFormat={}{0} passengers}" Foreground="#BCD0E2" Margin="12,-20,0,14"/><ItemsControl ItemsSource="{Binding Cabins}" ItemTemplate="{StaticResource CabinPhotoTemplate}"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource DarkCard}" Margin="5,0,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><UniformGrid Columns="6"><Border Background="#0A3154" CornerRadius="5" Margin="2" Padding="10"><StackPanel><TextBlock Text="Total Special Meals" Style="{StaticResource TableHeader}"/><TextBlock Text="{Binding TotalSpecialMeals}" Foreground="White" FontSize="22"/></StackPanel></Border><Border Background="#0A3154" CornerRadius="5" Margin="2" Padding="10"><StackPanel><TextBlock Text="Vegetarian" Style="{StaticResource TableHeader}"/><TextBlock Text="{Binding VegetarianMeals}" Foreground="#58E68A" FontSize="22"/></StackPanel></Border><Border Background="#0A3154" CornerRadius="5" Margin="2" Padding="10"><StackPanel><TextBlock Text="Vegan" Style="{StaticResource TableHeader}"/><TextBlock Text="{Binding VeganMeals}" Foreground="#58E68A" FontSize="22"/></StackPanel></Border><Border Background="#0A3154" CornerRadius="5" Margin="2" Padding="10"><StackPanel><TextBlock Text="Gluten Free" Style="{StaticResource TableHeader}"/><TextBlock Text="{Binding GlutenFreeMeals}" Foreground="#FFB55F" FontSize="22"/></StackPanel></Border><Border Background="#0A3154" CornerRadius="5" Margin="2" Padding="10"><StackPanel><TextBlock Text="Halal" Style="{StaticResource TableHeader}"/><TextBlock Text="{Binding HalalMeals}" Foreground="#D98CFF" FontSize="22"/></StackPanel></Border><Border Background="#0A3154" CornerRadius="5" Margin="2" Padding="10"><StackPanel><TextBlock Text="Other" Style="{StaticResource TableHeader}"/><TextBlock Text="{Binding OtherSpecialMeals}" Foreground="#6DBBFF" FontSize="22"/></StackPanel></Border></UniformGrid><Grid Grid.Row="1" Margin="7,12,7,4"><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock Text="SEAT" Style="{StaticResource TableHeader}"/><TextBlock Grid.Column="1" Text="NAME" Style="{StaticResource TableHeader}"/><TextBlock Grid.Column="2" Text="MEAL TYPE" Style="{StaticResource TableHeader}"/><TextBlock Grid.Column="3" Text="DETAILS" Style="{StaticResource TableHeader}"/><TextBlock Grid.Column="4" Text="STATUS" Style="{StaticResource TableHeader}"/></Grid><ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden"><ItemsControl ItemsSource="{Binding SpecialMeals}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource TableRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Seat}" Foreground="White"/><TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#D6E4EF"/><TextBlock Grid.Column="2" Text="{Binding SpecialMeal}" Foreground="#58E68A"/><TextBlock Grid.Column="3" Text="{Binding MealSelection}" Foreground="#D6E4EF" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="4" Text="● Loaded" Foreground="#58E68A"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Grid></Border></Grid>
                </Grid>

                <!-- Footer -->
                <Border Grid.Row="3" BorderThickness="0,1,0,0" Margin="0,8,0,0"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#F8FBFE"/><Setter Property="BorderBrush" Value="#CBD9E6"/><Style.Triggers><DataTrigger Binding="{Binding IsProgressVisible}" Value="True"><Setter Property="Background" Value="#06233F"/><Setter Property="BorderBrush" Value="#1C4C73"/></DataTrigger></Style.Triggers></Style></Border.Style><Grid Margin="12,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="●" Foreground="#42DF92"/><TextBlock Text="{Binding ConnectionLabel}" Foreground="#42DF92" Margin="6,0,14,0"/><TextBlock Text="|" Style="{StaticResource FooterSeparatorText}"/><TextBlock Text="{Binding SimBriefFooterLabel}" Style="{StaticResource FooterInfoText}" Margin="14,0"/><TextBlock Text="|" Style="{StaticResource FooterSeparatorText}"/><TextBlock Text="{Binding PassengerCount, StringFormat={}{0} Passengers}" Style="{StaticResource FooterInfoText}" Margin="14,0"/><TextBlock Text="|" Style="{StaticResource FooterSeparatorText}"/><TextBlock Text="{Binding CabinCrewCount, StringFormat=Cabin Crew: {0}}" Style="{StaticResource FooterInfoText}" Margin="14,0"/><TextBlock Text="|" Style="{StaticResource FooterSeparatorText}"/><TextBlock Text="{Binding CateringLoadLabel}" Style="{StaticResource FooterInfoText}" Margin="14,0"/></StackPanel><TextBlock Text="Speedbird. Always." Style="{StaticResource FooterInfoText}" FontFamily="Georgia" FontStyle="Italic" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border>
            </Grid>
        </Border>
    </ScrollViewer>
</UserControl>
